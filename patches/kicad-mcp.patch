+"""
+check_routing (PowerLab patch): routing style, measured the way a reviewer looks at tracks.
+
+DRC passes tracks that are electrically fine but badly drawn. Hand routing on a motor-driver
+board left exactly those: a run drawn as one slanted line at an odd angle, a short kink just
+before a pad, square 90-degree corners on JTAG lines, and two same-net pads side by side joined
+by a track looping round them. This reports, per the lab rules (powerlab-pcb-design-rules 3.4):
+- off_angle: a straight segment that isn't at 0, 45 or 90 degrees (arcs are fine: high-speed
+  traces bend in arcs);
+- corner: a bend of more than 45 degrees (90-degree and sharper corners), where two tracks of
+  a net meet with no pad or via there;
+- kink: a short segment between two bends (a jog or a staircase step);
+- detour: two pads of a net joined by tracks much longer than the straight line between them
+  (a loop round, a U-turn, a needless way round); with `direct`, how far apart they really are;
+- pad_entry: a track ending inside a pad away from the pad's centre;
+- solid_gnd: a GND pour or plane that connects pads solid instead of with thermal reliefs.
+It reads the saved board file, so save in KiCad first. The geometry below needs no pcbnew.
+"""
+
+import heapq
+import math
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple
+
+ANGLE_TOL = 2.0  # degrees off a multiple of 45 before a segment counts as off-angle
+MIN_SEGMENT = 0.1  # mm; shorter pieces (neck-downs inside pad fields) aren't judged
+CORNER_TOL = 3.0  # degrees above 45 before a bend counts as a corner
+KINK_LEN = 0.6  # mm; a segment shorter than max(this, 3 x width) between two bends
+TINY = 0.1  # mm; a jog piece this short is an artefact even at clean 45-degree bends
+DETOUR_RATIO = 1.5  # path / straight line ...
+DETOUR_EXTRA = 1.0  # ... and at least this many mm longer
+NEAR_PADS = 5.0  # mm; pads this close on a branched net (a rail) are judged too
+MAX_LISTED = 150
+FRAME_DIST = 6.0  # mm; parts of the segment's net this close lend it their axes (a turned part)
+KIND_ORDER = ("detour", "off_angle", "corner", "kink", "pad_entry", "solid_gnd")
+
+Point = Tuple[float, float]
+
+
+def _key(layer: str, p: Point) -> Tuple[str, int, int]:
+    return (layer, int(round(p[0] * 1000)), int(round(p[1] * 1000)))  # 1 um grid
+
+
+def _angle(a: Point, b: Point) -> float:
+    return math.degrees(math.atan2(b[1] - a[1], b[0] - a[0]))
+
+
+def _dist(a: Point, b: Point) -> float:
+    return math.hypot(b[0] - a[0], b[1] - a[1])
+
+
+def off_45(angle: float) -> float:
+    """How many degrees a direction is off the nearest multiple of 45."""
+    r = angle % 45.0
+    return min(r, 45.0 - r)
+
+
+def signed_turn(a: Point, b: Point, c: Point) -> float:
+    """The bend at b, signed: positive one way round, negative the other."""
+    d = (_angle(b, c) - _angle(a, b) + 180.0) % 360.0 - 180.0
+    return d
+
+
+def turn(a: Point, b: Point, c: Point) -> float:
+    """The bend at b on the path a -> b -> c, in degrees (0 = straight on, 180 = back)."""
+    d = abs(_angle(a, b) - _angle(b, c)) % 360.0
+    return 360.0 - d if d > 180.0 else d
+
+
+def _on_segment(p: Point, s: Dict[str, Any]) -> Optional[float]:
+    """Distance along s where p lies on it (within half its width), else None."""
+    a, b = s["a"], s["b"]
+    L = _dist(a, b)
+    if L < 1e-9:
+        return None
+    t = ((p[0] - a[0]) * (b[0] - a[0]) + (p[1] - a[1]) * (b[1] - a[1])) / (L * L)
+    if t <= 0.001 or t >= 0.999:
+        return None
+    q = (a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1]))
+    return t * L if _dist(p, q) <= s["width"] / 2 + 1e-3 else None
+
+
+def analyse(segments: Sequence[Dict[str, Any]], vias: Sequence[Dict[str, Any]],
+            pads: Sequence[Dict[str, Any]], zones: Sequence[Dict[str, Any]] = (),
+            pad_at: Any = None, params: Optional[Dict[str, Any]] = None) -> List[Dict[str, Any]]:
+    """Findings for plain data.
+
+    segments: {net, layer, a: (x, y), b: (x, y), width, id, arc?: True, length?}, mm; an arc
+      is judged only by its length (it has no angle, corner or kink)
+    vias: {net, at: (x, y)}
+    pads: {id, net, ref, pad, at: (x, y), rot?: the part's angle as a direction in board
+      coordinates (y down), half?, axis?, big?}
+    zones: {net, layer, solid: bool, rule_area: bool, at: (x, y)}
+    pad_at(net, layer, point) -> pad id whose copper holds the point, or None
+    """
+    params = params or {}
+    nets = set(params.get("nets") or [])
+    want = lambda net: not nets or net in nets  # noqa: E731
+    findings: List[Dict[str, Any]] = []
+    pad_by_id = {p["id"]: p for p in pads}
+    pads_by_net: Dict[str, List[Dict[str, Any]]] = {}
+    for p in pads:
+        pads_by_net.setdefault(p["net"], []).append(p)
+    end_pad: Dict[Tuple[str, int, int], Optional[str]] = {}
+
+    def pad_of(s: Dict[str, Any], p: Point) -> Optional[str]:
+        k = _key(s["layer"], p) + (s["net"],)
+        if k not in end_pad:
+            end_pad[k] = pad_at(s["net"], s["layer"], p) if pad_at else None
+        return end_pad[k]
+
+    via_keys = {}
+    for v in vias:
+        via_keys[(int(round(v["at"][0] * 1000)), int(round(v["at"][1] * 1000)), v["net"])] = v
+
+    def via_at(net: str, p: Point) -> bool:
+        return (int(round(p[0] * 1000)), int(round(p[1] * 1000)), net) in via_keys
+
+    # Track ends per (layer, point, net)
+    ends: Dict[Tuple[Any, ...], List[Tuple[Dict[str, Any], int]]] = {}
+    for s in segments:
+        for i, p in enumerate((s["a"], s["b"])):
+            ends.setdefault(_key(s["layer"], p) + (s["net"],), []).append((s, i))
+
+    # off_angle
+    for s in segments:
+        if not want(s["net"]) or s.get("arc"):
+            continue
+        L = _dist(s["a"], s["b"])
+        if L < MIN_SEGMENT:
+            continue
+        pa, pb = pad_of(s, s["a"]), pad_of(s, s["b"])
+        if pa and pa == pb:
+            continue  # inside one pad
+        # On the board's axes, or on the axes of a turned part the net connects nearby (the
+        # legs of a round board, a part at 30 degrees): its tracks follow its own frame.
+        mid = ((s["a"][0] + s["b"][0]) / 2, (s["a"][1] + s["b"][1]) / 2)
+        frames = {0.0} | {round(p["rot"] % 45.0, 2) for p in pads_by_net.get(s["net"], ())
+                           if p.get("rot") is not None and _dist(p["at"], mid) <= FRAME_DIST}
+        off = min(off_45(_angle(s["a"], s["b"]) - f) for f in frames)
+        if off > ANGLE_TOL:
+            findings.append(_finding("off_angle", s["net"], s["layer"], mid,
+                                     f"{L:.2f} mm at {_angle(s['a'], s['b']) % 180:.1f} deg "
+                                     f"({off:.1f} deg off 45-degree steps)", length=round(L, 3)))
+
+    # corners and kinks: where exactly two segments of a net meet, away from pads and vias
+    bends: Dict[Tuple[Any, ...], Tuple[Dict[str, Any], Dict[str, Any]]] = {}
+    for k, lst in ends.items():
+        if len(lst) != 2:
+            continue
+        (s1, i1), (s2, i2) = lst
+        p = s1["b"] if i1 else s1["a"]
+        if s1.get("arc") or s2.get("arc") or via_at(s1["net"], p) or pad_of(s1, p):
+            continue
+        a = s1["a"] if i1 else s1["b"]  # far end of s1
+        c = s2["b"] if i2 == 0 else s2["a"]  # far end of s2
+        if _dist(a, p) < 1e-6 or _dist(p, c) < 1e-6:
+            continue
+        bends[k] = (s1, s2)
+        t = turn(a, p, c)
+        if t > 45.0 + CORNER_TOL and want(s1["net"]):
+            what = "90-degree corner" if abs(t - 90) <= CORNER_TOL else (
+                "sharp corner" if t > 90 else "corner")
+            findings.append(_finding("corner", s1["net"], s1["layer"], p,
+                                     f"{what}: {t:.0f} deg bend; cut it at 45 degrees",
+                                     angle=round(t, 1)))
+    for s in segments:
+        if not want(s["net"]) or s.get("arc"):
+            continue
+        L = _dist(s["a"], s["b"])
+        if L >= max(KINK_LEN, 3 * s["width"]):
+            continue
+        ka, kb = _key(s["layer"], s["a"]) + (s["net"],), _key(s["layer"], s["b"]) + (s["net"],)
+        if ka not in bends or kb not in bends:
+            continue
+        prev = next(o for o in bends[ka] if o is not s)
+        nxt = next(o for o in bends[kb] if o is not s)
+        pa = prev["a"] if _key(s["layer"], prev["b"]) + (s["net"],) == ka else prev["b"]
+        pb = nxt["b"] if _key(s["layer"], nxt["a"]) + (s["net"],) == kb else nxt["a"]
+        t1, t2 = signed_turn(pa, s["a"], s["b"]), signed_turn(s["a"], s["b"], pb)
+        # A jog bends one way and straight back (an S); a 45-degree chamfer bends the same way twice.
+        # A clean 45/45 dog-leg that shifts a run sideways (into a fine-pitch pin) is drawn on
+        # purpose; a jog with other angles, or a sliver of a piece, is a kink.
+        clean = abs(abs(t1) - 45.0) <= CORNER_TOL and abs(abs(t2) - 45.0) <= CORNER_TOL and L >= TINY
+        if abs(t1) > 5 and abs(t2) > 5 and (t1 > 0) != (t2 > 0) and not clean:
+            mid = ((s["a"][0] + s["b"][0]) / 2, (s["a"][1] + s["b"][1]) / 2)
+            findings.append(_finding("kink", s["net"], s["layer"], mid,
+                                     f"{L:.2f} mm jog between two bends; run it straight",
+                                     length=round(L, 3)))
+
+    # pad_entry: a track end inside a pad, away from its centre (running along a long pad
+    # towards its centre is fine)
+    seen_entry = set()
+    for s in segments:
+        if not want(s["net"]):
+            continue
+        for p, q in ((s["a"], s["b"]), (s["b"], s["a"])):
+            pid = pad_of(s, p)
+            if not pid or (pid, round(p[0], 3), round(p[1], 3)) in seen_entry:
+                continue
+            if len(ends.get(_key(s["layer"], p) + (s["net"],), ())) > 1:
+                continue  # a joint between two pieces of the track, not where it ends
+            seen_entry.add((pid, round(p[0], 3), round(p[1], 3)))
+            pad = pad_by_id[pid]
+            off = _dist(p, pad["at"])
+            if off <= max(0.1, pad.get("half", 0.5) * 0.5) or pad.get("big"):
+                continue
+            if pad.get("axis") is not None and _dist(p, q) > 1e-6:
+                d = abs((_angle(q, p) - pad["axis"]) % 180.0)
+                along = min(d, 180.0 - d) < 10.0
+                to_centre = abs(_dist(q, pad["at"]) - _dist(q, p) - off) < 0.05  # p between q and the centre
+                if along and to_centre:
+                    continue
+            findings.append(_finding("pad_entry", s["net"], s["layer"], p,
+                                     f"ends {off:.2f} mm from the centre of {pad['ref']} pad "
+                                     f"{pad['pad']}; run it straight to the centre",
+                                     ref=pad["ref"]))
+
+    # detours: shortest copper path between pads of a net through its tracks and vias
+    findings += _detours(segments, vias, pads, pad_of, want)
+
+    for z in zones:
+        if z.get("rule_area") or not z.get("solid") or "GND" not in str(z["net"]).upper():
+            continue
+        if not want(z["net"]):
+            continue
+        findings.append(_finding("solid_gnd", z["net"], z["layer"], z["at"],
+                                 "GND pour connects pads solid; use thermal reliefs (spokes) "
+                                 "so the pads can be soldered", zone=z.get("name") or ""))
+    findings.sort(key=lambda f: (KIND_ORDER.index(f["kind"]), -f.get("extra", 0)))
+    return findings
+
+
+def _detours(segments, vias, pads, pad_of, want) -> List[Dict[str, Any]]:
+    graph: Dict[Any, List[Tuple[Any, float]]] = {}
+    degree: Dict[Any, int] = {}  # tracks meeting at a point: 3 or more is a branch
+
+    def link(u: Any, v: Any, w: float, track: bool = True) -> None:
+        graph.setdefault(u, []).append((v, w))
+        graph.setdefault(v, []).append((u, w))
+        if track:
+            degree[u] = degree.get(u, 0) + 1
+            degree[v] = degree.get(v, 0) + 1
+
+    by_net: Dict[str, List[Dict[str, Any]]] = {}
+    for s in segments:
+        by_net.setdefault(s["net"], []).append(s)
+    out = []
+    pad_by_id = {p["id"]: p for p in pads}
+    for net, segs in by_net.items():
+        if not net or not want(net):
+            continue
+        graph.clear()
+        degree.clear()
+        node_keys = set()
+        for s in segs:
+            ka, kb = _key(s["layer"], s["a"]), _key(s["layer"], s["b"])
+            link(ka, kb, s.get("length") or _dist(s["a"], s["b"]))
+            node_keys.update((ka, kb))
+            for p, k in ((s["a"], ka), (s["b"], kb)):
+                pid = pad_of(s, p)
+                if pid:
+                    link(k, ("pad", pid), _dist(p, pad_by_id[pid]["at"]), track=False)
+        # T-junctions onto the middle of another segment: the taps on a segment are joined
+        # in order along it, so neighbouring taps are as close as they are on the board
+        taps: Dict[int, List[Tuple[float, Any]]] = {}
+        for s in segs:
+            for p in (s["a"], s["b"]):
+                k = _key(s["layer"], p)
+                if len(graph.get(k, ())) > 1:
+                    continue
+                for o in segs:
+                    if o is s or o["layer"] != s["layer"]:
+                        continue
+                    t = _on_segment(p, o)
+                    if t is not None:
+                        taps.setdefault(id(o), []).append((t, k))
+                        break
+        for o in segs:
+            if id(o) not in taps:
+                continue
+            chain = [(0.0, _key(o["layer"], o["a"]))] + sorted(taps[id(o)], key=lambda x: x[0]) \
+                + [(_dist(o["a"], o["b"]), _key(o["layer"], o["b"]))]
+            for (t0, k0), (t1, k1) in zip(chain, chain[1:]):
+                if k0 != k1:
+                    link(k0, k1, t1 - t0)
+        for v in vias:
+            if v["net"] != net:
+                continue
+            vk = ("via", round(v["at"][0], 3), round(v["at"][1], 3))
+            for k in node_keys:
+                if (k[1], k[2]) == (int(round(v["at"][0] * 1000)), int(round(v["at"][1] * 1000))):
+                    link(vk, k, 0.0, track=False)
+        terminals = [n for n in graph if n[0] == "pad"]
+        seen = set()
+        for src in terminals:
+            dist = {src: 0.0}
+            back: Dict[Any, Any] = {}
+            heap = [(0.0, src)]
+            while heap:
+                d, u = heapq.heappop(heap)
+                if d > dist.get(u, math.inf):
+                    continue
+                if u != src and u[0] == "pad":
+                    continue  # paths end at the first pad they reach
+                for v, w in graph.get(u, ()):
+                    nd = d + w
+                    if nd < dist.get(v, math.inf):
+                        dist[v] = nd
+                        back[v] = u
+                        heapq.heappush(heap, (nd, v))
+            for dst in terminals:
+                if dst == src or dst not in dist or (dst, src) in seen:
+                    continue
+                seen.add((src, dst))
+                a, b = pad_by_id[src[1]], pad_by_id[dst[1]]
+                direct = _dist(a["at"], b["at"])
+                path = dist[dst]
+                node, branched = back.get(dst), False
+                while node is not None and node != src:
+                    branched = branched or degree.get(node, 0) >= 3
+                    node = back.get(node)
+                # A single link between two pads is judged on its own; on a branched net (a rail
+                # feeding several pads) only pads close together joined the long way round.
+                if branched:
+                    bad = direct <= NEAR_PADS and path > max(2.5 * direct, direct + 3.0)
+                else:
+                    bad = path > DETOUR_RATIO * direct + DETOUR_EXTRA
+                if bad:
+                    mid = ((a["at"][0] + b["at"][0]) / 2, (a["at"][1] + b["at"][1]) / 2)
+                    f = _finding("detour", net, "", mid,
+                                 f"{a['ref']} pad {a['pad']} to {b['ref']} pad {b['pad']}: "
+                                 f"{path:.1f} mm of track for {direct:.1f} mm apart; "
+                                 f"connect them directly", path=round(path, 2),
+                                 direct=round(direct, 2))
+                    f["extra"] = round(path - direct, 2)
+                    out.append(f)
+    return out
+
+
+def _finding(kind: str, net: str, layer: str, at: Point, detail: str, **extra: Any) -> Dict[str, Any]:
+    x, y = round(at[0], 3), round(at[1], 3)
+    f = {"kind": kind, "net": net, "layer": layer, "at": {"x": x, "y": y},
+         "link": f"kicad:at={x},{y}", "detail": detail}
+    f.update(extra)
+    return f
+
+
+def summary(findings: Iterable[Dict[str, Any]]) -> Dict[str, int]:
+    counts: Dict[str, int] = {}
+    for f in findings:
+        counts[f["kind"]] = counts.get(f["kind"], 0) + 1
+    return counts
+
+
+# ---- pcbnew adapter -------------------------------------------------------------------
+
+def check(board_path: str, params: Dict[str, Any]) -> Dict[str, Any]:
+    import pcbnew
+
+    board = pcbnew.LoadBoard(board_path)
+    mm = pcbnew.ToMM
+    segments, vias, pads, zones = [], [], [], []
+    for t in board.GetTracks():
+        if t.Type() == pcbnew.PCB_VIA_T:
+            vias.append({"net": t.GetNetname(), "at": (mm(t.GetPosition().x), mm(t.GetPosition().y))})
+        elif t.Type() in (pcbnew.PCB_TRACE_T, pcbnew.PCB_ARC_T):
+            seg = {"net": t.GetNetname(), "layer": t.GetLayerName(), "width": mm(t.GetWidth()),
+                   "a": (mm(t.GetStart().x), mm(t.GetStart().y)),
+                   "b": (mm(t.GetEnd().x), mm(t.GetEnd().y)), "id": t.m_Uuid.AsString()}
+            if t.Type() == pcbnew.PCB_ARC_T:
+                seg.update(arc=True, length=mm(t.GetLength()))
+            segments.append(seg)
+    pad_objs = {}
+    for fp in board.GetFootprints():
+        for p in fp.Pads():
+            pid = f"{fp.GetReference()}.{p.GetNumber()}.{p.m_Uuid.AsString()[:8]}"
+            size = p.GetSize()
+            half = min(mm(size.x), mm(size.y)) / 2
+            # The long side's direction in board coordinates (y down; KiCad turns pads
+            # counter-clockwise on screen); none for round or square pads.
+            axis = None
+            if abs(size.x - size.y) > 1000:
+                axis = (-p.GetOrientationDegrees() + (90.0 if size.y > size.x else 0.0)) % 180.0
+            pads.append({"id": pid, "net": p.GetNetname(), "ref": fp.GetReference(), "pad": p.GetNumber(),
+                         "rot": (-fp.GetOrientationDegrees()) % 360.0,
+                         "at": (mm(p.GetPosition().x), mm(p.GetPosition().y)), "half": half, "axis": axis,
+                         # exposed pads and large power pads take tracks anywhere on them
+                         "big": max(mm(size.x), mm(size.y)) >= 2.5})
+            pad_objs.setdefault(p.GetNetname(), []).append((pid, p))
+    for z in board.Zones():
+        bb = z.GetBoundingBox()
+        zones.append({"net": z.GetNetname(), "layer": ",".join(board.GetLayerName(l) for l in z.GetLayerSet().Seq()),
+                      "solid": z.GetPadConnection() == pcbnew.ZONE_CONNECTION_FULL,
+                      "rule_area": z.GetIsRuleArea(), "name": z.GetZoneName(),
+                      "at": (mm(bb.GetCenter().x), mm(bb.GetCenter().y))})
+
+    def pad_at(net: str, layer: str, p: Point) -> Optional[str]:
+        layer_id = board.GetLayerID(layer)
+        pt = pcbnew.VECTOR2I(pcbnew.FromMM(p[0]), pcbnew.FromMM(p[1]))
+        for pid, pad in pad_objs.get(net, ()):
+            if pad.IsOnLayer(layer_id) and pad.HitTest(pt):
+                return pid
+        return None
+
+    findings = analyse(segments, vias, pads, zones, pad_at, params)
+    counts = summary(findings)
+    limit = int(params.get("limit") or MAX_LISTED)
+    out = {"success": True, "board": board_path, "counts": counts, "total": len(findings),
+           "findings": findings[:limit],
+           "message": ("Routing style: " + ", ".join(f"{n} {k}" for k, n in counts.items())
+                       if findings else "Routing style: nothing found")}
+    if len(findings) > limit:
+        out["truncated"] = True
+        out["note"] = f"{len(findings) - limit} more not listed; pass nets or a larger limit"
+    return out
