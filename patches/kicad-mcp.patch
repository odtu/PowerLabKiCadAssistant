+    def _extract_lib_fields(
+        self, schematic_path: Path, library_name: str, symbol_name: str
+    ) -> List[Dict]:
+        """Return the injected lib symbol's fields in library order.
+
+        Each entry is ``{"name", "value", "show_name"}``. Unit sub-symbols carry
+        no properties, so every (property ...) in the block is a field of the
+        symbol itself.
+        """
+        try:
+            content = Path(schematic_path).read_text(encoding="utf-8")
+            lib_start = content.find("(lib_symbols")
+            if lib_start == -1:
+                return []
+            sym_start = content.find(
+                f'(symbol "{escape_sexpr_string(f"{library_name}:{symbol_name}")}"', lib_start
+            )
+            if sym_start == -1:
+                return []
+            sym_block = self._extract_paren_block(content, sym_start)
+            fields: List[Dict] = []
+            seen = set()
+            for m in re.finditer(
+                r"\(property\s+" + QUOTED_VALUE + r"\s+" + QUOTED_VALUE, sym_block
+            ):
+                name = unescape_sexpr_string(m.group(1))
+                if name in seen:
+                    continue
+                seen.add(name)
+                prop_block = self._extract_paren_block(sym_block, m.start())
+                prop_tokens = re.sub(QUOTED_VALUE, '""', prop_block)
+                fields.append(
+                    {
+                        "name": name,
+                        "value": unescape_sexpr_string(m.group(2)),
+                        "show_name": bool(re.search(r"\(show_name(\s+yes)?\)", prop_tokens)),
+                    }
+                )
+            return fields
+        except Exception:
+            return []
+
+    def sync_instance_fields(
+        self, schematic_path: Path, library_name: str, symbol_name: str
