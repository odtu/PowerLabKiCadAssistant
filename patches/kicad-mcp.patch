diff --git a/tests/test_schematic_text_edit.py b/tests/test_schematic_text_edit.py
new file mode 100644
index 0000000..2d98d57
--- /dev/null
+++ b/tests/test_schematic_text_edit.py
@@ -0,0 +1,76 @@
+"""PowerLab patch (#60): free schematic text can be deleted and moved, not only added."""
+
+import shutil
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parent.parent / "python"))
+
+from commands.wire_manager import WireManager  # noqa: E402
+
+EMPTY_SCH = Path(__file__).parent.parent / "python" / "templates" / "empty.kicad_sch"
+
+
+def _sheet(tmp_path: Path) -> Path:
+    sch = tmp_path / "t.kicad_sch"
+    shutil.copy(EMPTY_SCH, sch)
+    assert WireManager.add_text(sch, "Wrong note", [50, 40])
+    assert WireManager.add_text(sch, "Keep me", [50, 50])
+    return sch
+
+
+def _texts(sch: Path) -> dict:
+    return {t["text"]: t for t in WireManager.list_texts(sch)}
+
+
+def test_delete_by_text(tmp_path):
+    sch = _sheet(tmp_path)
+    result = WireManager.delete_text(sch, text="Wrong note")
+    assert result["success"], result
+    assert set(_texts(sch)) == {"Keep me"}
+
+
+def test_delete_by_uuid(tmp_path):
+    sch = _sheet(tmp_path)
+    uid = _texts(sch)["Keep me"]["uuid"]
+    assert WireManager.delete_text(sch, uuid_=uid)["success"]
+    assert set(_texts(sch)) == {"Wrong note"}
+
+
+def test_move_keeps_angle_unless_given(tmp_path):
+    sch = _sheet(tmp_path)
+    assert WireManager.move_text(sch, [60, 55], text="Keep me", angle=90)["success"]
+    moved = _texts(sch)["Keep me"]
+    assert moved["position"] == {"x": 60, "y": 55} and moved["angle"] == 90
+    assert WireManager.move_text(sch, [70, 55], text="Keep me")["success"]
+    assert _texts(sch)["Keep me"]["angle"] == 90
+
+
+def test_ambiguous_or_missing_text_changes_nothing(tmp_path):
+    sch = _sheet(tmp_path)
+    WireManager.add_text(sch, "Keep me", [80, 80])
+    before = sch.read_text(encoding="utf-8")
+    result = WireManager.delete_text(sch, text="Keep me")
+    assert not result["success"] and len(result["matches"]) == 2
+    assert not WireManager.delete_text(sch, text="Not there")["success"]
+    assert sch.read_text(encoding="utf-8") == before
+    # the position picks one
+    assert WireManager.delete_text(sch, text="Keep me", position=[80, 80])["success"]
+    assert [t["position"] for t in WireManager.list_texts(sch) if t["text"] == "Keep me"] == [
+        {"x": 50, "y": 50}
+    ]
+
+
+def test_text_boxes_are_listed_and_deleted(tmp_path):
+    sch = _sheet(tmp_path)
+    content = sch.read_text(encoding="utf-8")
+    box = (
+        '(text_box "Boxed" (exclude_from_sim no) (at 20 20 0) (size 10 5) '
+        "(stroke (width 0) (type solid)) (fill (type none)) "
+        "(effects (font (size 1.27 1.27))) (uuid \"11111111-2222-3333-4444-555555555555\"))"
+    )
+    idx = content.rindex("(sheet_instances")
+    sch.write_text(content[:idx] + box + "\n" + content[idx:], encoding="utf-8")
+    assert _texts(sch)["Boxed"]["kind"] == "text_box"
+    assert WireManager.delete_text(sch, uuid_="11111111-2222-3333-4444-555555555555")["success"]
+    assert "Boxed" not in _texts(sch)
