+    def _handle_powerlab_route_status(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """Wait for a PowerLab router run, then put its result on the board (PowerLab patch)."""
+        from commands import powerlab_route
+
+        board_path = params.get("boardPath") or self._authoritative_board_path()
+        if not board_path:
+            return {"success": False, "message": "No board", "errorDetails": "Pass boardPath"}
+        board_path = os.path.abspath(str(board_path))
+        if params.get("cancel"):
+            out = powerlab_route.cancel(board_path)
+            back = powerlab_route.put_back(board_path, self._live_kicad_board(board_path))
+            return {**out, "kicad": back} if back else out
+        st = powerlab_route.wait(board_path, float(params.get("wait", 300)))
+        state = st.get("state")
+        if state == "none":
+            return {"success": False, "message": "No PowerLab router run for this board; start one with powerlab_route"}
+        elapsed = round(st.get("updated", 0) - st.get("started", 0))
+        progress = {k: st[k] for k in ("phase", "nets", "connections", "routed", "last") if k in st}
+        if state == "running":
+            return {
+                "success": True,
+                "state": "running",
+                "elapsed_seconds": elapsed,
+                **progress,
+                "next_steps": "Still routing: call powerlab_route_status again.",
+            }
+        if state in ("failed", "cancelled"):
+            back = powerlab_route.put_back(board_path, self._live_kicad_board(board_path))
+            return {"success": False, "state": state, "message": f"The PowerLab router run {state}",
+                    "errorDetails": st.get("error", ""), "board_unchanged": True,
+                    **({"kicad": back} if back else {})}
+        report = powerlab_route.report(board_path) or {}
+        if state == "applied":
+            return {"success": True, "state": "applied", "message": "This run's result is already on the board",
+                    "report": report}
+        applied = powerlab_route.apply(board_path, self._live_kicad_board(board_path))
+        if not applied.get("success"):
+            return {**applied, "state": "done", "report": report}
+        self._reload_board_file(board_path)
+        left = len(report.get("left", []))
+        message = f"Routed {report.get('routed')} of {report.get('connections')} connections"
+        message += f" ({left} left)" if left else ""
+        if applied.get("saved_in_kicad"):
+            message += "; the result is in KiCad and saved there (no File > Revert needed)"
+        elif "kicad_error" in applied:
+            message += "; KiCad couldn't be updated, so use File > Revert to see the result"
+        else:
+            message += "; written to the board file"
+        return {
+            "success": True,
+            "state": "applied",
+            "message": message,
+            "boardPath": board_path,
+            "report": report,
+            **applied,
+            "next_steps": (
+                "Run DRC and compare with the baseline, render the board (powerlab-visual-review), "
+                "and route what is under report.left by hand or with autoroute (Freerouting). "
+                "undo_autoroute puts back the board from before this run."
+            ),
+        }
