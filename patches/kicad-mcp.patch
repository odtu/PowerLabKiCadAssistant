+"""PowerLab patch: edit_component sets pad nets (padNets), e.g. a mounting hole on GND.
+
+No tool could set the net of a pad already on the board, so plated mounting holes placed
+without a net stayed unconnected.
+"""
+
+import sys
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent.parent / "python"))
+
+pytestmark = pytest.mark.unit
+
+import pcbnew as _pcbnew_stub  # noqa: E402
+
+PTH, NPTH = "PTH", "NPTH"
+
+
+def _pad(number, attribute=PTH):
+    pad = MagicMock(name=f"pad:{number}")
+    pad.GetNumber.return_value = number
+    pad.GetAttribute.return_value = attribute
+    return pad
+
+
+def _commands(pads, nets=("GND",)):
+    from commands.component import ComponentCommands
+
+    module = MagicMock(name="footprint:HOLE1")
+    module.Pads.return_value = pads
+    board = MagicMock(name="board")
+    board.FindFootprintByReference.return_value = module
+    known = {name: f"net:{name}" for name in ("",) + tuple(nets)}
+    board.FindNet.side_effect = known.get
+
+    cmd = ComponentCommands.__new__(ComponentCommands)
+    cmd.board = board
+    cmd.library_manager = MagicMock()
+    _pcbnew_stub.reset_mock()
+    _pcbnew_stub.PAD_ATTRIB_NPTH = NPTH
+    _pcbnew_stub.NETINFO_ITEM.side_effect = lambda _board, name: f"new:{name}"
+    return cmd, board
+
+
+def test_star_puts_every_plated_pad_on_the_net():
+    pads = [_pad("1"), _pad("1"), _pad("", NPTH)]
+    cmd, _board = _commands(pads)
+
+    result = cmd.edit_component({"reference": "HOLE1", "padNets": {"*": "GND"}})
+
+    assert result["success"] is True
+    pads[0].SetNet.assert_called_once_with("net:GND")
+    pads[1].SetNet.assert_called_once_with("net:GND")
+    pads[2].SetNet.assert_not_called()
+    assert result["padNets"] == [{"pad": "1", "net": "GND"}, {"pad": "1", "net": "GND"}]
+
+
+def test_named_pad_wins_over_star_and_empty_clears():
+    pads = [_pad("1"), _pad("2"), _pad("3")]
+    cmd, _board = _commands(pads)
+
+    result = cmd.edit_component({"reference": "J9", "padNets": {"*": "GND", "2": ""}})
+
+    assert result["success"] is True
+    pads[0].SetNet.assert_called_once_with("net:GND")
+    pads[1].SetNet.assert_called_once_with("net:")
+    pads[2].SetNet.assert_called_once_with("net:GND")
+
+
+def test_missing_net_is_created():
+    pads = [_pad("1")]
+    cmd, board = _commands(pads, nets=())
+
+    result = cmd.edit_component({"reference": "HOLE1", "padNets": {"1": "CHASSIS"}})
+
+    assert result["success"] is True
+    board.Add.assert_called_once_with("new:CHASSIS")
+    pads[0].SetNet.assert_called_once_with("new:CHASSIS")
+
+
+def test_unknown_pad_fails_before_anything_changes():
+    pads = [_pad("1")]
+    cmd, _board = _commands(pads)
+
+    result = cmd.edit_component(
+        {"reference": "HOLE1", "value": "M3", "padNets": {"2": "GND"}}
+    )
+
+    assert result["success"] is False
+    assert "no pad 2" in result["errorDetails"]
