--- /dev/null
+++ b/python/commands/zone_edit.py
@@ -0,0 +1,593 @@
+"""delete_zone and edit_zone, and query_zones in live mode (PowerLab patch, #79).
+
+add_copper_pour, add_zone, query_zones and refill_zones existed, but no tool could remove
+a zone or change one, so a pour on the wrong net or layer stayed on the board. A zone is
+picked by its uuid (query_zones gives it) or by net / layer / name when only one zone
+matches. Live (KiCad open on the board) the change is made in KiCad's board through kipy
+in one commit, and the zones are refilled there; offline it is made on the loaded board
+(pcbnew), and the edited zone's old fill is dropped until refill_zones.
+
+Locked zones are kept, as delete_trace keeps locked copper: delete_zone leaves them
+unless `includeLocked`, and edit_zone won't give a locked zone a new outline unless the
+same call unlocks it (`locked: false`). KiCad 10.0.5's API reports every zone as
+unlocked, ignores a lock on update and unlocks a zone it updates, so live mode reads the
+locks from the saved file, and an edit_zone that locks, unlocks or changes a locked zone
+runs on the saved file (save, edit, revert, as LIVE_VIA_FILE_COMMANDS do).
+"""
+
+import re
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+_UUID_RE = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
+_TO_MM = {"mm": 1.0, "mil": 0.0254, "inch": 25.4}
+# KiCad 10's own layer names, for the zones' (copper) layers and filters
+_LAYER_ALIASES = {"F.Silkscreen": "F.SilkS", "B.Silkscreen": "B.SilkS"}
+COPPER_FIELDS = ("newNet", "clearance", "minThickness", "padConnection", "fillType", "thermalGap", "spokeWidth")
+# Thermal reliefs need a gap and spokes: a zone that was solid (or made by a tool that left
+# them at 0) gets KiCad's defaults when it turns thermal, else DRC reports starved thermals.
+THERMAL_DEFAULT = 0.5  # mm, gap and spoke width
+
+
+def _uuid_text(value: Any) -> str:
+    m = _UUID_RE.search(str(value or ""))
+    return m.group(0).lower() if m else str(value or "").strip().lower()
+
+
+def _layer_name(name: Any) -> str:
+    name = str(name)
+    return _LAYER_ALIASES.get(name, name)
+
+
+# --- the parts without pcbnew or kipy (unit tested on their own) ----------------------
+
+def select_zones(zones: List[Dict[str, Any]], params: Dict[str, Any], many: bool = False
+                 ) -> Tuple[List[Dict[str, Any]], Optional[Dict[str, Any]]]:
+    """The zones `params` names: by `uuid`, else by `net`, `layer` and `name` together.
+    `zones` are summaries with uuid, net, layers and name. Returns (zones, None), or
+    ([], an error response). More than one match is an error unless `many`."""
+    uuid = params.get("uuid") or params.get("zoneUuid")
+    net, layer, name = params.get("net"), params.get("layer"), params.get("name")
+    if uuid:
+        wanted = _uuid_text(uuid)
+        found = [z for z in zones if _uuid_text(z["uuid"]) == wanted]
+        if not found:
+            return [], {
+                "success": False,
+                "message": f"No zone with uuid {uuid}",
+                "errorDetails": "query_zones lists the zones with their uuids",
+                "zones": [_brief(z) for z in zones][:50],
+            }
+        return found, None
+    if net is None and not layer and not name:
+        return [], {
+            "success": False,
+            "message": "Say which zone: uuid (from query_zones), or net, layer and/or name",
+        }
+    found = [
+        z for z in zones
+        if (net is None or z["net"] == net)
+        and (not layer or _layer_name(layer) in [_layer_name(l) for l in z["layers"]])
+        and (not name or z.get("name") == name)
+    ]
+    what = ", ".join(f"{k} {v!r}" for k, v in (("net", net), ("layer", layer), ("name", name))
+                     if v is not None and v != "")
+    if not found:
+        return [], {
+            "success": False,
+            "message": f"No zone with {what}",
+            "errorDetails": "query_zones lists the zones with their uuids",
+            "zones": [_brief(z) for z in zones][:50],
+        }
+    if len(found) > 1 and not many:
+        return [], {
+            "success": False,
+            "message": f"{len(found)} zones have {what}; give the uuid of the one you mean",
+            "zones": [_brief(z) for z in found][:50],
+        }
+    return found, None
+
+
+def locked_zone_uuids(board_text: str) -> set:
+    """The uuids of the locked zones in a .kicad_pcb's text. KiCad 10.0.5's API reports
+    every zone as unlocked (and ignores a lock on update), so live mode reads the lock
+    from the saved file: `(locked yes)` among a zone's first fields, before its uuid."""
+    out = set()
+    for m in re.finditer(r"\(zone\s", board_text):
+        head = board_text[m.end():m.end() + 1500]
+        u = re.search(r'\(uuid\s+"?([0-9a-fA-F-]{36})"?\)', head)
+        if u and re.search(r"\(locked(\s+yes)?\)", head[:u.start()]):
+            out.add(u.group(1).lower())
+    return out
+
+
+def _brief(z: Dict[str, Any]) -> Dict[str, Any]:
+    keys = ("uuid", "net", "layers", "priority", "name", "isRuleArea", "locked", "boundingBox")
+    return {k: z[k] for k in keys if k in z}
+
+
+def parse_zone_changes(params: Dict[str, Any]) -> Tuple[Dict[str, Any], Optional[str]]:
+    """edit_zone's changes, checked, in mm: newNet, layers, priority, clearance,
+    minThickness, padConnection, thermalGap, spokeWidth, fillType, newName, outline (list of
+    (x, y)), locked.
+    Returns (changes, None) or ({}, an error text)."""
+    out: Dict[str, Any] = {}
+    to_mm = _TO_MM.get(params.get("unit") or "mm")
+    if to_mm is None:
+        return {}, f"unknown unit {params.get('unit')!r}; use mm, mil or inch"
+    if params.get("newNet") is not None:
+        out["newNet"] = str(params["newNet"])
+    layers = params.get("newLayers", params.get("newLayer"))
+    if layers is not None:
+        layers = [layers] if isinstance(layers, str) else list(layers)
+        if not layers or not all(isinstance(l, str) and l for l in layers):
+            return {}, "newLayers must be a layer name or a list of them, e.g. ['F.Cu', 'B.Cu']"
+        out["layers"] = [_layer_name(l) for l in layers]
+    if params.get("priority") is not None:
+        try:
+            out["priority"] = int(params["priority"])
+        except (TypeError, ValueError):
+            return {}, f"priority must be a whole number, got {params['priority']!r}"
+        if out["priority"] < 0:
+            return {}, "priority can't be negative"
+    for key, alias in (("clearance", None), ("minThickness", "minWidth"), ("thermalGap", None),
+                       ("spokeWidth", "thermalSpokeWidth")):
+        value = params.get(key, params.get(alias) if alias else None)
+        if value is None:
+            continue
+        try:
+            value = float(value) * to_mm
+        except (TypeError, ValueError):
+            return {}, f"{key} must be a number, got {value!r}"
+        if value < 0 or (key in ("minThickness", "spokeWidth") and value == 0):
+            return {}, f"{key} must be more than 0"
+        out[key] = value
+    if params.get("padConnection") is not None:
+        if params["padConnection"] not in ("thermal", "solid"):
+            return {}, "padConnection must be 'thermal' (reliefs) or 'solid'"
+        out["padConnection"] = params["padConnection"]
+    if params.get("fillType") is not None:
+        if params["fillType"] not in ("solid", "hatched"):
+            return {}, "fillType must be 'solid' or 'hatched'"
+        out["fillType"] = params["fillType"]
+    if params.get("newName") is not None:
+        out["newName"] = str(params["newName"])
+    if params.get("outline") is not None:
+        points = []
+        for p in params["outline"] or []:
+            try:
+                if isinstance(p, dict):
+                    points.append((float(p["x"]) * to_mm, float(p["y"]) * to_mm))
+                else:
+                    points.append((float(p[0]) * to_mm, float(p[1]) * to_mm))
+            except (KeyError, IndexError, TypeError, ValueError):
+                return {}, f"outline points are {{x, y}}; got {p!r}"
+        if len(points) < 3:
+            return {}, "a new outline needs at least 3 points"
+        out["outline"] = points
+    if params.get("locked") is not None:
+        out["locked"] = bool(params["locked"])
+    if not out:
+        return {}, ("Nothing to change: give newNet, newLayers, priority, clearance, "
+                    "minThickness, padConnection, thermalGap, spokeWidth, fillType, newName, "
+                    "outline or locked")
+    return out, None
+
+
+def _locked_outline_error(zone: Dict[str, Any], changes: Dict[str, Any]) -> Optional[str]:
+    if zone.get("locked") and "outline" in changes and changes.get("locked") is not False:
+        return ("The zone is locked; to give it a new outline pass locked: false too "
+                "(or unlock it in KiCad)")
+    if zone.get("isRuleArea"):
+        bad = [k for k in COPPER_FIELDS if k in changes]
+        if bad:
+            return f"{', '.join(bad)} don't apply to a rule area (keep-out)"
+    return None
+
+
+# --- offline: pcbnew -----------------------------------------------------------------
+
+def swig_zone_settings(zone: Any) -> Dict[str, Any]:
+    """The settings query_zones reports beyond net, layers and priority."""
+    import pcbnew
+
+    out: Dict[str, Any] = {}
+    try:
+        out["name"] = zone.GetZoneName()
+    except Exception:
+        pass
+    try:
+        out["isRuleArea"] = bool(zone.GetIsRuleArea())
+        out["locked"] = bool(zone.IsLocked())
+    except Exception:
+        pass
+    if out.get("isRuleArea"):
+        return out
+    try:
+        conn = zone.GetPadConnection()
+        out["padConnection"] = {
+            pcbnew.ZONE_CONNECTION_FULL: "solid",
+            pcbnew.ZONE_CONNECTION_THERMAL: "thermal",
+        }.get(conn, str(conn))
+    except Exception:
+        pass
+    try:
+        clearance = zone.GetLocalClearance()
+        if clearance is not None:
+            out["clearance"] = clearance / 1_000_000
+    except Exception:
+        pass
+    return out
+
+
+def _swig_summary(board: Any, zone: Any) -> Dict[str, Any]:
+    try:
+        seq = zone.GetLayerSet().Seq()
+        layers = [board.GetLayerName(l) for l in seq]
+    except Exception:
+        layers = [board.GetLayerName(zone.GetLayer())]
+    try:
+        bb = zone.Outline().BBox()  # GetBoundingBox is cached by the board
+    except Exception:
+        bb = zone.GetBoundingBox()
+    out = {
+        "uuid": zone.m_Uuid.AsString(),
+        "net": zone.GetNetname(),
+        "layers": layers,
+        "priority": zone.GetAssignedPriority(),
+        "boundingBox": {
+            "x1": bb.GetLeft() / 1e6, "y1": bb.GetTop() / 1e6,
+            "x2": bb.GetRight() / 1e6, "y2": bb.GetBottom() / 1e6, "unit": "mm",
+        },
+        "_zone": zone,
+    }
+    out.update(swig_zone_settings(zone))
+    return out
+
+
+def _public(z: Dict[str, Any]) -> Dict[str, Any]:
+    return {k: v for k, v in z.items() if not k.startswith("_")}
+
+
+def swig_delete_zone(board: Any, params: Dict[str, Any]) -> Dict[str, Any]:
+    from utils.board_items import delete_board_item
+
+    if not board:
+        return {"success": False, "message": "No board is loaded"}
+    zones = [_swig_summary(board, z) for z in list(board.Zones())]
+    found, err = select_zones(zones, params, many=bool(params.get("all")))
+    if err:
+        return err
+    keep = [] if params.get("includeLocked") else [z for z in found if z.get("locked")]
+    found = [z for z in found if not any(z is k for k in keep)]
+    if not found:
+        return {"success": False,
+                "message": "Only locked zones match; unlock them in KiCad first, or pass includeLocked: true"}
+    for z in found:
+        delete_board_item(board, z["_zone"])
+    board.SetModified()
+    # `refill` is for live mode; offline the fill runs in refill_zones' own process
+    hint = "; run refill_zones so the other pours fill the space" if params.get("refill") is not False else ""
+    out = {
+        "success": True,
+        "message": f"Deleted {len(found)} zone(s){hint}",
+        "deletedCount": len(found),
+        "deleted": [_brief(z) for z in found],
+    }
+    if keep:
+        out["lockedKept"] = [_brief(z) for z in keep]
+    return out
+
+
+def swig_edit_zone(board: Any, params: Dict[str, Any]) -> Dict[str, Any]:
+    import pcbnew
+
+    if not board:
+        return {"success": False, "message": "No board is loaded"}
+    changes, err_text = parse_zone_changes(params)
+    if err_text:
+        return {"success": False, "message": err_text}
+    zones = [_swig_summary(board, z) for z in list(board.Zones())]
+    found, err = select_zones(zones, params)
+    if err:
+        return err
+    target = found[0]
+    err_text = _locked_outline_error(target, changes)
+    if err_text:
+        return {"success": False, "message": err_text}
+    zone = target["_zone"]
+    nm = lambda mm: int(round(mm * 1_000_000))
+
+    if "newNet" in changes:
+        if changes["newNet"] == "":
+            zone.SetNetCode(0)
+        else:
+            nets = board.GetNetInfo().NetsByName()
+            if not nets.has_key(changes["newNet"]):
+                return {"success": False, "message": f"The board has no net {changes['newNet']!r}"}
+            zone.SetNet(nets[changes["newNet"]])
+    if "layers" in changes:
+        lset = pcbnew.LSET()
+        for name in changes["layers"]:
+            lid = board.GetLayerID(name)
+            if lid < 0:
+                return {"success": False, "message": f"Unknown layer {name!r}"}
+            if not target.get("isRuleArea") and not pcbnew.IsCopperLayer(lid):
+                return {"success": False, "message": f"{name} isn't a copper layer"}
+            lset.AddLayer(lid)
+        if len(changes["layers"]) == 1:
+            zone.SetLayer(board.GetLayerID(changes["layers"][0]))
+        else:
+            zone.SetLayerSet(lset)
+    if "priority" in changes:
+        zone.SetAssignedPriority(changes["priority"])
+    if "clearance" in changes:
+        zone.SetLocalClearance(nm(changes["clearance"]))
+    if "minThickness" in changes:
+        zone.SetMinThickness(nm(changes["minThickness"]))
+    if "padConnection" in changes:
+        zone.SetPadConnection(
+            pcbnew.ZONE_CONNECTION_FULL if changes["padConnection"] == "solid"
+            else pcbnew.ZONE_CONNECTION_THERMAL
+        )
+    if changes.get("padConnection") == "thermal" or "thermalGap" in changes or "spokeWidth" in changes:
+        gap = changes.get("thermalGap")
+        if gap is None and zone.GetThermalReliefGap() <= 0:
+            gap = THERMAL_DEFAULT
+        if gap is not None:
+            zone.SetThermalReliefGap(nm(gap))
+        width = changes.get("spokeWidth")
+        if width is None and zone.GetThermalReliefSpokeWidth() <= 0:
+            width = THERMAL_DEFAULT
+        if width is not None:
+            zone.SetThermalReliefSpokeWidth(nm(width))
+    if "fillType" in changes:
+        zone.SetFillMode(
+            pcbnew.ZONE_FILL_MODE_HATCH_PATTERN if changes["fillType"] == "hatched"
+            else pcbnew.ZONE_FILL_MODE_POLYGONS
+        )
+    if "newName" in changes:
+        zone.SetZoneName(changes["newName"])
+    if "locked" in changes:
+        zone.SetLocked(changes["locked"])
+    if "outline" in changes:
+        outline = zone.Outline()
+        outline.RemoveAllContours()
+        outline.NewOutline()
+        for x, y in changes["outline"]:
+            outline.Append(pcbnew.VECTOR2I(nm(x), nm(y)))
+        zone.HatchBorder()  # the border hatching and the cached box follow the new outline
+        zone.CacheBoundingBox()
+    unfilled = any(k not in ("newName", "locked") for k in changes)
+    if unfilled:
+        zone.UnFill()  # the old fill no longer matches; refill_zones makes the new one
+    board.SetModified()
+    # `refill` is for live mode; offline the fill runs in refill_zones' own process
+    hint = "; run refill_zones to fill it again" if unfilled and params.get("refill") is not False else ""
+    return {
+        "success": True,
+        "message": f"Edited the zone{hint}",
+        "changed": sorted(changes),
+        "zone": _brief(_swig_summary(board, zone)),
+    }
+
+
+# --- live: kipy, in KiCad's board ---------------------------------------------------
+
+def _ipc_layer_name(layer: int) -> str:
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    name = BoardLayer.Name(layer)
+    return name[3:].replace("_", ".") if name.startswith("BL_") else name
+
+
+def _ipc_layer(name: str) -> Optional[int]:
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    try:
+        return BoardLayer.Value("BL_" + _layer_name(name).replace(".", "_"))
+    except ValueError:
+        return None
+
+
+def _ipc_summary(zone: Any, locked_uuids: Any = ()) -> Dict[str, Any]:
+    from kipy.proto.board.board_types_pb2 import ZoneConnectionStyle
+
+    points = [
+        node.point
+        for poly in zone._proto.outline.polygons
+        for node in poly.outline.nodes
+        if node.HasField("point")
+    ]
+    rule = zone.is_rule_area()
+    out: Dict[str, Any] = {
+        "uuid": zone.id.value,
+        "net": "" if rule or zone.net is None else zone.net.name,
+        "layers": [_ipc_layer_name(l) for l in zone.layers],
+        "priority": zone.priority,
+        "name": zone.name,
+        "isRuleArea": rule,
+        "locked": bool(zone.locked or zone.id.value.lower() in locked_uuids),
+        "isFilled": bool(zone.filled),
+        "_zone": zone,
+    }
+    if points:
+        xs, ys = [p.x_nm for p in points], [p.y_nm for p in points]
+        out["boundingBox"] = {
+            "x1": min(xs) / 1e6, "y1": min(ys) / 1e6, "x2": max(xs) / 1e6, "y2": max(ys) / 1e6,
+            "unit": "mm",
+        }
+    if not rule:
+        out["minThickness"] = zone.min_thickness / 1e6
+        out["clearance"] = zone.clearance / 1e6
+        style = zone._proto.copper_settings.connection.zone_connection
+        out["padConnection"] = {
+            ZoneConnectionStyle.ZCS_FULL: "solid",
+            ZoneConnectionStyle.ZCS_THERMAL: "thermal",
+        }.get(style, ZoneConnectionStyle.Name(style))
+    return out
+
+
+def ipc_query_zones(kboard: Any, params: Dict[str, Any], locked_uuids: Any = ()) -> Dict[str, Any]:
+    """query_zones on KiCad's board, so live uuids are the ones delete_zone / edit_zone
+    find there (zones added live aren't in the saved file yet)."""
+    net, layer, bbox = params.get("net"), params.get("layer"), params.get("boundingBox")
+    zones = [_ipc_summary(z, locked_uuids) for z in kboard.get_zones()]
+    out = []
+    for z in zones:
+        if net and z["net"] != net:
+            continue
+        if layer and _layer_name(layer) not in z["layers"]:
+            continue
+        if bbox and "boundingBox" in z:
+            scale = _TO_MM.get(bbox.get("unit", "mm"), 1.0)
+            x1, y1 = bbox.get("x1", 0) * scale, bbox.get("y1", 0) * scale
+            x2, y2 = bbox.get("x2", 0) * scale, bbox.get("y2", 0) * scale
+            b = z["boundingBox"]
+            if b["x2"] < min(x1, x2) or b["x1"] > max(x1, x2) or b["y2"] < min(y1, y2) or b["y1"] > max(y1, y2):
+                continue
+        out.append(_public(z))
+    return {"success": True, "zoneCount": len(out), "zones": out}
+
+
+def _commit(kboard: Any, message: str, fn: Callable[[], Any]) -> None:
+    commit = kboard.begin_commit()
+    try:
+        fn()
+        kboard.push_commit(commit, message)
+    except Exception:
+        kboard.drop_commit(commit)
+        raise
+
+
+def _refill(kboard: Any, params: Dict[str, Any], out: Dict[str, Any]) -> None:
+    if params.get("refill", True) is False:
+        out["message"] += "; zones not refilled (refill: false)"
+        return
+    try:
+        kboard.refill_zones(block=True, max_poll_seconds=60.0)
+        out["message"] += ", zones refilled"
+    except Exception as e:  # the edit stands; say the fill is old
+        out["message"] += f"; refilling the zones failed ({e}), run refill_zones"
+
+
+def ipc_delete_zone(kboard: Any, params: Dict[str, Any], locked_uuids: Any = ()) -> Dict[str, Any]:
+    zones = [_ipc_summary(z, locked_uuids) for z in kboard.get_zones()]
+    found, err = select_zones(zones, params, many=bool(params.get("all")))
+    if err:
+        return err
+    keep = [] if params.get("includeLocked") else [z for z in found if z.get("locked")]
+    found = [z for z in found if not any(z is k for k in keep)]
+    if not found:
+        return {"success": False,
+                "message": "Only locked zones match; unlock them in KiCad first, or pass includeLocked: true"}
+    _commit(kboard, "Delete zone", lambda: kboard.remove_items([z["_zone"] for z in found]))
+    out = {
+        "success": True,
+        "message": f"Deleted {len(found)} zone(s) in KiCad's board",
+        "deletedCount": len(found),
+        "deleted": [_brief(z) for z in found],
+    }
+    if keep:
+        out["lockedKept"] = [_brief(z) for z in keep]
+    _refill(kboard, params, out)
+    return out
+
+
+def ipc_edit_needs_file(kboard: Any, params: Dict[str, Any], locked_uuids: Any = ()) -> bool:
+    """Whether edit_zone must run on the saved file in live mode: KiCad 10.0.5's API
+    ignores a zone's lock on update, and an update through it unlocks a locked zone."""
+    if params.get("locked") is not None:
+        return True
+    zones = [_ipc_summary(z, locked_uuids) for z in kboard.get_zones()]
+    found, err = select_zones(zones, params)
+    return not err and bool(found[0].get("locked"))
+
+
+def ipc_edit_zone(kboard: Any, params: Dict[str, Any], locked_uuids: Any = ()) -> Dict[str, Any]:
+    from kipy.board_types import ZoneFillMode
+    from kipy.geometry import PolyLine, PolyLineNode
+    from kipy.proto.board.board_types_pb2 import ZoneConnectionStyle
+
+    changes, err_text = parse_zone_changes(params)
+    if err_text:
+        return {"success": False, "message": err_text}
+    zones = [_ipc_summary(z, locked_uuids) for z in kboard.get_zones()]
+    found, err = select_zones(zones, params)
+    if err:
+        return err
+    target = found[0]
+    err_text = _locked_outline_error(target, changes)
+    if err_text:
+        return {"success": False, "message": err_text}
+    zone = target["_zone"]
+    nm = lambda mm: int(round(mm * 1_000_000))
+
+    if "newNet" in changes:
+        if changes["newNet"] == "":
+            zone._proto.copper_settings.net.Clear()
+        else:
+            net = next((n for n in kboard.get_nets() if n.name == changes["newNet"]), None)
+            if net is None:
+                return {"success": False, "message": f"KiCad's board has no net {changes['newNet']!r}"}
+            zone.net = net
+    if "layers" in changes:
+        ids = []
+        for name in changes["layers"]:
+            lid = _ipc_layer(name)
+            if lid is None:
+                return {"success": False, "message": f"Unknown layer {name!r}"}
+            if not target.get("isRuleArea") and not _layer_name(name).endswith(".Cu"):
+                return {"success": False, "message": f"{name} isn't a copper layer"}
+            ids.append(lid)
+        zone.layers = ids
+    if "priority" in changes:
+        zone.priority = changes["priority"]
+    if "clearance" in changes:
+        zone.clearance = nm(changes["clearance"])
+    if "minThickness" in changes:
+        zone.min_thickness = nm(changes["minThickness"])
+    if "padConnection" in changes:
+        zone._proto.copper_settings.connection.zone_connection = (
+            ZoneConnectionStyle.ZCS_FULL if changes["padConnection"] == "solid"
+            else ZoneConnectionStyle.ZCS_THERMAL
+        )
+    if changes.get("padConnection") == "thermal" or "thermalGap" in changes or "spokeWidth" in changes:
+        spokes = zone._proto.copper_settings.connection.thermal_spokes
+        gap = changes.get("thermalGap")
+        if gap is None and spokes.gap.value_nm <= 0:
+            gap = THERMAL_DEFAULT
+        if gap is not None:
+            spokes.gap.value_nm = nm(gap)
+        width = changes.get("spokeWidth")
+        if width is None and spokes.width.value_nm <= 0:
+            width = THERMAL_DEFAULT
+        if width is not None:
+            spokes.width.value_nm = nm(width)
+    if "fillType" in changes:
+        zone._proto.copper_settings.fill_mode = (
+            ZoneFillMode.ZFM_HATCHED if changes["fillType"] == "hatched" else ZoneFillMode.ZFM_SOLID
+        )
+    if "newName" in changes:
+        zone.name = changes["newName"]
+    if "locked" in changes:
+        zone.locked = changes["locked"]
+    if "outline" in changes:
+        line = PolyLine()
+        line.closed = True
+        for x, y in changes["outline"]:
+            line.append(PolyLineNode.from_xy(nm(x), nm(y)))
+        del zone._proto.outline.polygons[:]
+        zone._proto.outline.polygons.add().outline.CopyFrom(line._proto)
+        del zone._proto.filled_polygons[:]
+
+    _commit(kboard, "Edit zone", lambda: kboard.update_items([zone]))
+    after = next((z for z in kboard.get_zones() if z.id.value == zone.id.value), zone)
+    out = {
+        "success": True,
+        "message": "Edited the zone in KiCad's board",
+        "changed": sorted(changes),
+        "zone": _brief(_ipc_summary(after, locked_uuids)),
+    }
+    if any(k not in ("newName", "locked") for k in changes):
+        _refill(kboard, params, out)
+    return out
