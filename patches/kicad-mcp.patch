+            if "clearance" not in params:
+                # The planner's fixed 0.2 mm default undercuts stricter net classes
+                # (e.g. 0.3 mm Power/GND); use the board's largest class clearance.
+                try:
+                    ns = board.GetDesignSettings().m_NetSettings
+                    classes = list(ns.GetNetclasses().values()) + [ns.GetDefaultNetclass()]
+                    plan_params["clearance"] = max(
