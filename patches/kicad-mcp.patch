new file mode 100644
index 0000000..ba5f282
--- /dev/null
+++ b/python/commands/powerlab_router/router.py
@@ -0,0 +1,220 @@
+"""The PowerLab router's main loop (plan §4.2-4.3).
+
+Connections are the edges of a minimum spanning tree over each net's pads. Groups are
+routed in the lab order; inside a group the most constrained connection goes next: the
+one whose worse end has the fewest free entry lanes left, then fine-pitch ends, then
+the shortest. Lane counts are kept up to date only near new copper.
+
+Pins still waiting keep their free entry lanes: while a connection is routed, those
+lanes are blocked (§3.4, escape room), so a pin isn't boxed in before its turn. If a
+connection finds no way with them blocked, it is tried again without.
+
+Each connection: search, exact check, and on a clearance error a retry with 0.05 mm and
+then 0.1 mm extra margin. Accepted copper is stamped into the grids.
+"""
+
+import math
+import time
+from collections import Counter
+
+import numpy as np
+import pcbnew
+
+from commands.powerlab_router.groups import GROUPS, classify
+from commands.powerlab_router.model import FINE_PITCH, RouterBoard
+from commands.powerlab_router.search import Costs
+
+T = pcbnew.ToMM
+RETRY_MARGINS = (0.05, 0.1)
+NEAR = 3.0  # mm: lane counts are refreshed for pads this close to new copper
+
+
+def _xy(item):
+    p = item.GetPosition()
+    return (T(p.x), T(p.y))
+
+
+def _name(pad):
+    return f"{pad.GetParentFootprint().GetReference()}.{pad.GetNumber()}"
+
+
+class Connection:
+    def __init__(self, net, a, b, group):
+        self.net, self.a, self.b, self.group = net, a, b, group
+        self.length = math.dist(_xy(a), _xy(b))
+        self.fine = any(_fine(p) for p in (a, b))
+        self.lanes = None  # fewest free lanes at either end, from the grid
+
+    def name(self):
+        return f"{_name(self.a)}-{_name(self.b)}"
+
+
+def _fine(pad):
+    c = _xy(pad)
+    me = pad.m_Uuid.AsString()
+    return any(p.m_Uuid.AsString() != me and 1e-3 < math.dist(c, _xy(p)) < FINE_PITCH
+               for p in pad.GetParentFootprint().Pads())
+
+
+def _mst(pads):
+    pts = [_xy(p) for p in pads]
+    inside, edges = {0}, []
+    while len(inside) < len(pads):
+        d, i, j = min((math.dist(pts[i], pts[j]), i, j) for i in inside for j in range(len(pads)) if j not in inside)
+        edges.append((i, j))
+        inside.add(j)
+    return edges
+
+
+class Router:
+    def __init__(self, board, pitch=0.1, pour_nets=("GND",), costs=None, rules=None, groups=None,
+                 order="length", reserve=False):
+        self.order, self.reserve = order, reserve
+        self.rb = RouterBoard(board, pitch=pitch, pour_nets=pour_nets, rules=rules)
+        self.costs = costs or Costs(layer_factor={1: 1.2} if len(self.rb.layers) == 2 else None)
+        self.group_overrides = groups or {}
+
+    def connections(self, nets):
+        rb = self.rb
+        group = classify(nets, lambda n: rb.netclass(n).GetName(), self.group_overrides)
+        out = []
+        for net in nets:
+            pads = [p for p in rb.pads if p.GetNetname() == net]
+            if len(pads) >= 2:
+                out += [Connection(net, pads[i], pads[j], group[net]) for i, j in _mst(pads)]
+        return out
+
+    def _lanes(self, conn, cache):
+        if conn.net not in cache:
+            cache[conn.net] = self.rb.obstacles(conn.net)[0]
+        blocked = cache[conn.net]
+        return min(len(self.rb.lanes(p, blocked, conn.net, exact=False)) for p in (conn.a, conn.b))
+
+    # --- reserved escape lanes -----------------------------------------------------------
+    def _reserve(self, pad, cache):
+        rb, net = self.rb, pad.GetNetname()
+        if net not in cache:
+            cache[net] = rb.obstacles(net)[0]
+        shapes = {i: [] for i in range(len(rb.layers))}
+        for lane in rb.lanes(pad, cache[net], net, exact=False):
+            shapes[lane.layer].append(rb.lane_shape(lane, net))
+        masks = [rb.grid.raster(shapes[i]).astype(np.uint16) for i in range(len(rb.layers))]
+        self._res[pad.m_Uuid.AsString()] = (net, masks)
+        mine = self._res_net.setdefault(net, [np.zeros_like(m) for m in masks])
+        for i, m in enumerate(masks):
+            self._res_count[i] += m
+            mine[i] += m
+
+    def _release(self, pad):
+        net, masks = self._res.pop(pad.m_Uuid.AsString(), (None, None))
+        if masks is not None:
+            for i, m in enumerate(masks):
+                self._res_count[i] -= m
+                self._res_net[net][i] -= m
+
+    def _reserved_for(self, net):
+        mine = self._res_net.get(net)
+        return [(self._res_count[i] - (mine[i] if mine is not None else 0)) > 0
+                for i in range(len(self._res_count))]
+
+    def run(self, nets, log=None):
+        rb = self.rb
+        t_start = time.time()
+        pending = self.connections(nets)
+        rows, totals = [], {"nodes": 0, "search_s": 0.0, "retries": 0, "exact_left": 0, "unreserved": 0}
+        cache = {}
+        for c in pending:
+            c.lanes = self._lanes(c, cache)
+        g = rb.grid
+        self._res, self._res_net = {}, {}
+        self._res_count = [np.zeros((g.ny, g.nx), np.uint16) for _ in rb.layers]
+        waiting = Counter()
+        for c in pending:
+            for p in (c.a, c.b):
+                if waiting[p.m_Uuid.AsString()] == 0 and self.reserve:
+                    self._reserve(p, cache)
+                waiting[p.m_Uuid.AsString()] += 1
+        while pending:
+            group = min(c.group for c in pending)
+            here = [c for c in pending if c.group == group]
+            if self.order == "constrained":
+                conn = min(here, key=lambda c: (c.lanes, not c.fine, c.length))
+            else:
+                conn = min(here, key=lambda c: c.length)
+            pending.remove(conn)
+            for p in (conn.a, conn.b):  # its own pins are free for it
+                waiting[p.m_Uuid.AsString()] -= 1
+                if waiting[p.m_Uuid.AsString()] == 0:
+                    self._release(p)
+            row = self._route(conn, totals)
+            rows.append(row)
+            if log:
+                log(row)
+            if row["ok"]:
+                # refresh lane counts near the new copper
+                box = row["box"]
+                cache = {}
+                for c in pending:
+                    if any(box[0] - NEAR <= x <= box[2] + NEAR and box[1] - NEAR <= y <= box[3] + NEAR
+                           for x, y in (_xy(c.a), _xy(c.b))):
+                        c.lanes = self._lanes(c, cache)
+        by_group = {}
+        for r in rows:
+            g = by_group.setdefault(GROUPS[r["group"]], {"routed": 0, "left": 0})
+            g["routed" if r["ok"] else "left"] += 1
+        return {
+            "connections": len(rows),
+            "routed": sum(r["ok"] for r in rows),
+            "left": [{k: r[k] for k in ("net", "connection", "reason")} for r in rows if not r["ok"]],
+            "groups": by_group,
+            "seconds": round(time.time() - t_start, 1),
+            "search_seconds": round(totals["search_s"], 1),
+            "nodes": totals["nodes"],
+            "retries": totals["retries"],
+            "routed_through_reserved_lanes": totals["unreserved"],
+            "exact_violations_left": totals["exact_left"],
+            "rules_not_understood": rb.rules.unsupported,
+            "rows": rows,
+        }
+
+    def _route(self, conn, totals):
+        rb = self.rb
+        row = {"net": conn.net, "connection": conn.name(), "group": conn.group, "lanes": conn.lanes,
+               "length": round(conn.length, 1), "ok": False}
+        items, geo, info = [], None, {}
+        reserved = self._reserved_for(conn.net)
+        for extra in (0.0,) + RETRY_MARGINS:
+            if extra:
+                totals["retries"] += 1
+                rb.remove(items)
+                items = []
+            blocked, via_ok = rb.obstacles(conn.net, extra)
+            held = [np.frombuffer(b, np.uint8).reshape(r.shape).astype(bool) | r for b, r in zip(blocked, reserved)]
+            geo, info = rb.route(conn.net, conn.a, conn.b, [h.astype(np.uint8).tobytes() for h in held], via_ok,
+                                 self.costs)
+            if geo is None and any(r.any() for r in reserved):
+                totals["unreserved"] += 1  # no way around the waiting pins' lanes: try through them
+                nodes = info["nodes"]
+                geo, info = rb.route(conn.net, conn.a, conn.b, blocked, via_ok, self.costs)
+                info["nodes"] += nodes
+            totals["nodes"] += info["nodes"]
+            totals["search_s"] += info["seconds"]
+            if geo is None:
+                break
+            items = rb.add(conn.net, *geo)
+            if not rb.violations(conn.net, items):
+                break
+        else:
+            totals["exact_left"] += 1  # still too close after the last retry: take it out
+            rb.remove(items)
+            items, geo = [], None
+            info["fail"] = "clearance after retries"
+        row.update(nodes=info.get("nodes"), seconds=info.get("seconds"))
+        if geo is None:
+            row["reason"] = info.get("fail", "no path")
+            return row
+        rb.commit(conn.net, items)
+        xs = [T(p.x) for it in items for p in (it.GetStart(), it.GetEnd())]
+        ys = [T(p.y) for it in items for p in (it.GetStart(), it.GetEnd())]
+        row.update(ok=True, vias=len(geo[1]), box=(min(xs), min(ys), max(xs), max(ys)))
+        return row
