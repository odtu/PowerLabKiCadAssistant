@@ -0,0 +1,192 @@
+"""PowerLab patch: board edits with KiCad open on the board (issues #63-#68).
+
+KiCad 10.0.5's API can't load a footprint from a library (ParseAndCreateItemsFromString
+is an empty stub, FlipItems came in 10.0.6), so these tools changed only the tool's
+offline copy and KiCad never showed it. Checked live against KiCad 10.0.5 too; these
+tests pin the dispatch and the pieces that don't need a KiCad window.
+"""
+
+import sys
+from pathlib import Path
+from typing import Any
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent.parent / "python"))
+
+
+def _iface() -> Any:
+    with patch("kicad_interface.USE_IPC_BACKEND", True):
+        from kicad_interface import KiCADInterface
+
+        iface = KiCADInterface.__new__(KiCADInterface)
+    iface.use_ipc = True
+    iface.board = MagicMock()
+    iface.ipc_board_api = MagicMock()
+    iface.session_backend = "ipc"
+    iface.session_board_path = None
+    return iface
+
+
+def test_library_footprint_commands_edit_the_saved_board():
+    from kicad_interface import KiCADInterface
+
+    for command in (
+        "place_component",
+        "add_mounting_hole",
+        "sync_schematic_to_board",
+        "edit_component",
+        "replace_component",
+    ):
+        assert command in KiCADInterface.LIVE_VIA_FILE_COMMANDS
+
+
+def test_live_place_goes_through_the_saved_board():
+    iface = _iface()
+    handler = MagicMock(return_value={"success": True})
+    iface.command_routes = {"place_component": handler}
+    live = ("C:/b/board.kicad_pcb", MagicMock())
+    with patch.object(iface, "_try_enable_ipc_backend"), patch.object(
+        iface, "_ipc_session_alive", return_value=True
+    ), patch.object(iface, "_live_board_for_file_edit", return_value=live), patch.object(
+        iface, "_edit_saved_board_then_revert", return_value={"success": True, "x": 1}
+    ) as edit:
+        result = iface.handle_command("place_component", {"componentId": "A:B"})
+    assert result == {"success": True, "x": 1}
+    edit.assert_called_once_with("place_component", handler, {"componentId": "A:B"}, live)
+
+
+def test_round_trip_saves_edits_saves_and_reverts_in_order():
+    iface = _iface()
+    order = []
+    kicad_board = MagicMock()
+    kicad_board.save.side_effect = lambda: order.append("kicad save")
+    kicad_board.revert.side_effect = lambda: order.append("kicad revert")
+    iface.board.GetFileName.return_value = "C:/b/board.kicad_pcb"
+
+    def reload(path):
+        order.append("load file")
+
+    def handler(params):
+        order.append("handler")
+        return {"success": True}
+
+    with patch.object(iface, "_reload_board_file", side_effect=reload), patch.object(
+        iface, "_record_board_signature"
+    ), patch("kicad_interface.pcbnew") as pcbnew, patch(
+        "kicad_interface.preserve_project_settings"
+    ):
+        pcbnew.SaveBoard.side_effect = lambda *a: order.append("save file")
+        result = iface._edit_saved_board_then_revert(
+            "place_component", handler, {}, ("C:/b/board.kicad_pcb", kicad_board)
+        )
+    assert result["success"] and result["_realtime"]
+    assert order == ["kicad save", "load file", "handler", "save file", "kicad revert"]
+
+
+def test_round_trip_failure_leaves_kicad_alone():
+    iface = _iface()
+    kicad_board = MagicMock()
+    with patch.object(iface, "_reload_board_file"), patch("kicad_interface.pcbnew") as pcbnew:
+        result = iface._edit_saved_board_then_revert(
+            "place_component",
+            lambda p: {"success": False, "message": "Footprint not found"},
+            {},
+            ("C:/b/board.kicad_pcb", kicad_board),
+        )
+    assert result["success"] is False
+    pcbnew.SaveBoard.assert_not_called()
+    kicad_board.revert.assert_not_called()
+
+
+def test_replace_component_is_a_command():
+    """#67: the tool existed, the Python command didn't ("Unknown command")."""
+    iface = _iface()
+    iface.component_commands = MagicMock()
+    iface.component_commands.edit_component.return_value = {"success": True}
+    result = iface._handle_replace_component(
+        {"reference": "R5", "newComponentId": "Lib:R_0603", "newValue": "10k"}
+    )
+    assert result["success"]
+    iface.component_commands.edit_component.assert_called_once_with(
+        {"reference": "R5", "footprint": "Lib:R_0603", "value": "10k"}
+    )
+
+
+def test_live_move_flips_before_placing():
+    """#64/#66: `layer` was ignored live. The flip comes first (it mirrors the angle)."""
+    iface = _iface()
+    calls = []
+    iface.ipc_board_api.flip_component.side_effect = lambda r, l: calls.append("flip") or (True, -90.0)
+    iface.ipc_board_api.move_component.side_effect = lambda **k: calls.append(("move", k["rotation"])) or True
+    result = iface._ipc_move_component(
+        {"reference": "R1", "position": {"x": 1, "y": 2, "unit": "mm"}, "layer": "B.Cu"}
+    )
+    assert result["success"]
+    assert calls == ["flip", ("move", -90.0)]  # keeps the angle it had
+
+
+def test_flip_falls_back_to_kicads_flip_action():
+    """KiCad 10.0.5 answers FlipItems with "no handler available"."""
+    from kicad_api.ipc_backend import IPCBoardAPI
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    api = IPCBoardAPI.__new__(IPCBoardAPI)
+    api._kicad = MagicMock()
+    fp = MagicMock()
+    fp.reference_field.text.value = "R1"
+    fp.layer = BoardLayer.BL_F_Cu
+    fp.orientation.degrees = 30.0
+    flipped = MagicMock()
+    flipped.id.value = fp.id.value
+    flipped.layer = BoardLayer.BL_B_Cu
+    board = MagicMock()
+    board.get_footprints.side_effect = [[fp], [flipped]]
+    board.flip_items.side_effect = RuntimeError("no handler available for FlipItems")
+    api._get_board = lambda: board
+
+    assert api.flip_component("R1", "B.Cu") == (True, 30.0)
+    board.add_to_selection.assert_called_once_with([fp])
+    api._kicad.run_action.assert_called_once_with("pcbnew.InteractiveEdit.flip")
+
+
+def test_live_circle_outline():
+    """#68: the live handler wanted a points list, so circles failed."""
+    iface = _iface()
+    board = iface.ipc_board_api._get_board.return_value
+    result = iface._ipc_add_board_outline(
+        {"shape": "circle", "params": {"x": 50, "y": 40, "radius": 5, "unit": "mm"}}
+    )
+    assert result["success"], result
+    circle = board.create_items.call_args[0][0]
+    assert circle.center.x == 50_000_000 and circle.center.y == 40_000_000
+    assert circle.radius() == pytest.approx(5_000_000)
+
+
+def test_kicad_cli_netlist_gives_pad_nets(tmp_path):
+    """#65: pad nets come from KiCad's own netlist, as F8 gives them."""
+    from commands.schematic_handlers import SchematicHandlersMixin  # noqa: F401
+    from kicad_interface import KiCADInterface
+
+    xml = """<export><design>
+      <sheet number="1" name="/"><title_block><source>top.kicad_sch</source></title_block></sheet>
+      <sheet number="2" name="/MCU/"><title_block><source>mcu.kicad_sch</source></title_block></sheet>
+    </design><nets>
+      <net code="1" name="/MCU/IO12"><node ref="U1" pin="14"/><node ref="R3" pin="2"/></net>
+      <net code="2" name="GND"><node ref="U1" pin="1"/></net>
+    </nets></export>"""
+
+    def fake_run(cmd, **kwargs):
+        Path(cmd[cmd.index("--output") + 1]).write_text(xml, encoding="utf-8")
+        return MagicMock(returncode=0, stderr="")
+
+    iface = KiCADInterface.__new__(KiCADInterface)
+    sch = tmp_path / "top.kicad_sch"
+    with patch.object(KiCADInterface, "_find_kicad_cli_static", return_value="kicad-cli"), patch(
+        "subprocess.run", side_effect=fake_run
+    ):
+        pad_nets, names, sheets = iface._kicad_cli_pad_net_map(str(sch))
+    assert pad_nets == {("U1", "14"): "/MCU/IO12", ("R3", "2"): "/MCU/IO12", ("U1", "1"): "GND"}
+    assert names == {"/MCU/IO12", "GND"}
+    assert [Path(s).name for s in sheets] == ["top.kicad_sch", "mcu.kicad_sch"]
