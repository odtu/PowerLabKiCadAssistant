+++ b/python/commands/powerlab_router2/plan.py
@@ -0,0 +1,320 @@
+"""The routing plan (PowerLab router 2): what each net is to the board, from the schematic.
+
+The router has to decide who gets the room when not everything fits, which nets run together
+as a bus and which may go down to a plane layer. Net names are a poor guide (Net-(U3-Pad7),
+BOOT in a GPIO's name, a test point on a rail). KiCad's own netlist (kicad-cli, as F8 makes
+it) says what every pin is: its name (G, GHA, INHA, X1, TMS), its electrical type and its
+part (a MOSFET, a crystal, an LED, a test point). The roles below come from that.
+
+    priority 3: switch nodes, gate drive, bootstrap and charge pump, clocks, PWM inputs
+    priority 2: power rails, analog (ADC inputs, current and voltage sense, references, feedback)
+    priority 1: other signals
+    priority 0: test points, debug (JTAG/SWD), LEDs
+
+`build()` makes the plan; Claude reviews it against the schematic, the board's requirements
+and the lab rules, shows it to the user (who may change it), and the router reads the
+result (`Router(plan=...)`). Without a schematic the router falls back to the names.
+No pcbnew here: the netlist is read as XML.
+"""
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+import xml.etree.ElementTree as ET
+
+PLAN_FILE = os.path.join("routing", "routing-plan.json")
+
+# --- what a part is ------------------------------------------------------------------------------
+KINDS = (
+    # (kind, words in its library/symbol/description, reference prefixes)
+    ("mosfet", ("MOSFET", "_FET", "Q_NMOS", "Q_PMOS", "N-CH", "P-CH", "GAN"), ()),
+    ("opamp", ("OPAMP", "OP-AMP", "OP AMP", "OPERATIONAL AMPLIFIER", "AMPLIFIER", "COMPARATOR"), ()),
+    ("crystal", ("CRYSTAL", "OSCILLATOR", "RESONATOR"), ("Y", "X")),
+    ("led", ("LED",), ()),
+    ("testpoint", ("TESTPOINT", "TEST_POINT", "TEST POINT", "TEST PAD"), ("TP",)),
+    ("inductor", ("INDUCTOR",), ("L",)),
+    ("ferrite", ("FERRITE",), ("FB",)),
+    ("connector", ("CONNECTOR", "CONN_"), ("J", "P")),
+)
+
+# --- what a pin is, by its name (KiCad's pin name, the "_<number>" taken off) ---------------------
+PIN_ROLES = (
+    # (role, regex on the pin name)
+    ("switch", r"^(SW|LX|PH|PHASE|SH[A-Z]?|HS|VS[A-Z]?|OUT[A-Z]?_?SW)$"),
+    ("gate", r"^(G|GATE|G[HL][A-Z]?|HO|LO|HG|LG|DH|DL|UG|LG[A-Z]?)$"),
+    ("boot", r"^(BST|BOOT|VB|VBST|CB|CPH|CPL|VCP|VCPH|VCPL)$"),
+    ("clock", r"^(X1|X2|XIN|XOUT|XI|XO|XTAL\w*|OSC\w*|CLKIN|CLKOUT|MCLK|SCLK|SCK|CLK\w*)$"),
+    ("pwm", r"^(IN[HL][A-Z]?|PWM\w*|HI|LI|EN[HL][A-Z]?|INA|INB)$"),
+    ("debug", r"^(TCK|TMS|TDI|TDO|TRST\w*|SWDIO|SWCLK|SWO|JTAG\w*)$"),
+    ("analog", r"^(\+|-|IN\+|IN-|\+IN|-IN|INP|INN|ADC\w*|AIN\w*|A\d+|SO[A-Z]?|SP[A-Z]?|SN[A-Z]?|CSA\w*|ISEN\w*|VSEN\w*|IS[PN]\w*|SENSE\w*|"
+               r"VREF\w*|REF\w*|FB|VFB|COMP|PGA\w*|CMP\w*|OPA\w*|DAC\w*)$"),
+)
+# a pin name may carry several functions (GPIO0/EPWM1A): each part is tried
+SPLIT = re.compile(r"[/,|]")
+
+# 4: the power stage's tight loops (a gate and its return, the switch node, bootstrap and
+# charge pump), drawn first by hand; 3: logic that switches (PWM inputs, clocks), which may step
+# aside or go inner. With one level for both, the router had nothing to choose by round a gate
+# driver: every net there was 3 (sf-motion, docs §13)
+LOOP = 4
+ROLE_PRIORITY = {"switch": LOOP, "gate": LOOP, "boot": LOOP, "clock": 3, "pwm": 3, "power": 2, "analog": 2,
+                 "signal": 1, "debug": 0, "testpoint": 0, "led": 0}
+OUTSIDE = ("switch", "gate", "boot", "power")  # roles that stay on the outer layers
+POWER_CLASSES = ("POWER", "PWR", "HV", "GND")
+
+
+def pin_name(function, number):
+    """KiCad writes a node's pinfunction as '<name>_<number>' ('G_4', 'INHA_37')."""
+    f = function or ""
+    if number and f.endswith("_" + number):
+        f = f[: -len(number) - 1]
+    return "" if f in ("~", "") else f.upper()
+
+
+def part_kind(comp):
+    text = " ".join([comp.get("lib", ""), comp.get("part", ""), comp.get("description", ""),
+                     comp.get("value", "")]).upper()
+    ref = comp.get("ref", "")
+    prefix = re.match(r"[A-Za-z]+", ref)
+    prefix = prefix.group(0).upper() if prefix else ""
+    for kind, words, refs in KINDS:
+        if any(w in text for w in words) or (prefix in refs and kind not in ("connector",)):
+            return kind
+    if prefix in ("J", "P", "CN") and "CONN" in text:
+        return "connector"
+    return {"R": "resistor", "C": "capacitor", "D": "diode", "Q": "transistor", "U": "ic", "IC": "ic"}.get(prefix, "part")
+
+
+def read_netlist(schematic, kicad_cli=None):
+    """{"components": {ref: {...}}, "nets": {name: {"class", "nodes": [(ref, pin, name, type)]}}}
+    from kicad-cli's XML netlist, or None when there is no schematic or no kicad-cli."""
+    if not schematic or not os.path.isfile(schematic):
+        return None
+    cli = kicad_cli or _kicad_cli()
+    if not cli:
+        return None
+    fd, tmp = tempfile.mkstemp(suffix=".xml")
+    os.close(fd)
+    try:
+        r = subprocess.run([cli, "sch", "export", "netlist", "--format", "kicadxml", "--output", tmp, schematic],
+                           capture_output=True, text=True, timeout=120)
+        if r.returncode != 0:
+            return None
+        return parse_netlist(ET.parse(tmp).getroot())
+    finally:
+        try:
+            os.unlink(tmp)
+        except OSError:
+            pass
+
+
+def parse_netlist(root):
+    comps = {}
+    for c in root.findall("./components/comp"):
+        ls = c.find("libsource")
+        comps[c.get("ref")] = {"ref": c.get("ref"), "value": c.findtext("value") or "",
+                               "description": c.findtext("description") or "",
+                               "lib": ls.get("lib", "") if ls is not None else "",
+                               "part": ls.get("part", "") if ls is not None else ""}
+    nets = {}
+    for n in root.findall("./nets/net"):
+        name = n.get("name", "")
+        if not name:
+            continue
+        nets[name] = {"class": n.get("class") or "",
+                      "nodes": [(x.get("ref"), x.get("pin"), pin_name(x.get("pinfunction"), x.get("pin")),
+                                 x.get("pintype") or "") for x in n.findall("node")]}
+    return {"components": comps, "nets": nets}
+
+
+def _kicad_cli():
+    for c in (shutil.which("kicad-cli"),
+              os.path.join(os.path.dirname(os.path.abspath(os.sys.executable)), "kicad-cli.exe"),
+              r"C:\Program Files\KiCad\10.0\bin\kicad-cli.exe"):
+        if c and os.path.isfile(c):
+            return c
+    return None
+
+
+# --- roles ---------------------------------------------------------------------------------------
+def net_roles(net, info, comps, nets_of=None, nets=None):
+    """[(role, why)] for one net: from its pins' names and types, its parts and its class.
+    nets_of/nets (ref -> its nets, net -> info) let a resistor be looked through: a GPIO that
+    drives an LED through its resistor is an indicator."""
+    out = []
+    if nets_of and nets:
+        for ref, pin, _name, _t in info["nodes"]:
+            if part_kind(comps.get(ref, {"ref": ref})) != "resistor":
+                continue
+            for other in nets_of.get(ref, ()):
+                # the resistor's other side is just the LED's (not GND or a rail, which reach
+                # every LED's cathode or anode)
+                if other == net or len(nets[other]["nodes"]) > 4:
+                    continue
+                kinds_there = {part_kind(comps.get(r, {"ref": r})) for r, *_ in nets[other]["nodes"]}
+                if "led" in kinds_there and len(nets[other]["nodes"]) <= 3:
+                    out.append(("led", f"{ref} to an LED"))
+                elif "opamp" in kinds_there:
+                    out.append(("analog", f"{ref} from an amplifier"))  # a filtered sense line
+    kinds = {}
+    for ref, pin, name, ptype in info["nodes"]:
+        kind = part_kind(comps.get(ref, {"ref": ref}))
+        kinds.setdefault(kind, []).append((ref, pin, name))
+        where = f"{ref}.{name or pin}"
+        if kind == "mosfet":
+            if name in ("G", "GATE") or name.startswith("G"):
+                out.append(("gate", f"{where}: MOSFET gate"))
+            elif name in ("D", "S", "DRAIN", "SOURCE") or name[:1] in ("D", "S"):
+                out.append(("mosfet_ds", f"{where}: MOSFET {name or pin}"))
+        elif kind == "crystal":
+            out.append(("clock", f"{ref}: crystal"))
+        elif kind == "led":
+            out.append(("led", f"{ref}: LED"))
+        elif kind == "testpoint":
+            out.append(("testpoint", f"{ref}: test point"))
+        elif kind in ("inductor", "ferrite"):
+            out.append(("power", f"{ref}: {kind} (a power path)"))
+        elif kind == "opamp" and name not in ("V+", "V-", "VCC", "VDD", "VEE", "VSS", "GND"):
+            out.append(("analog", f"{where}: amplifier"))
+        if ptype == "power_out" or (ptype == "power_in" and name not in ("GND", "VSS", "AGND", "DGND", "PGND")):
+            out.append(("power", f"{where}: {ptype}"))
+        for part in SPLIT.split(name):
+            for role, rx in PIN_ROLES:
+                if part and re.match(rx, part):
+                    if role == "gate" and kind not in ("ic", "mosfet"):
+                        continue
+                    out.append((role, f"{where}: {role} pin"))
+                    break
+    # a node between switching devices: a MOSFET's drain/source on an inductor or a second MOSFET
+    ds = [w for r, w in out if r == "mosfet_ds"]
+    if ds and ("inductor" in kinds or len({w.split('.')[0] for w in ds}) > 1 or any(r == "switch" for r, _ in out)):
+        out.append(("switch", ds[0] + " on " + ("an inductor" if "inductor" in kinds else "the bridge")))
+    out = [(r, w) for r, w in out if r != "mosfet_ds"]
+    if info["class"].upper() in POWER_CLASSES:
+        out.append(("power", f"net class {info['class']}"))
+    return out
+
+
+def classify(netlist, fallback=None, split=True):
+    """{net: {"priority", "inner", "roles", "why"}} for every net of the netlist. fallback(net,
+    class) -> (priority, role) or None: the net's name, asked only when its pins say nothing
+    (a GPIO named PA13, a test point) - never over what the pins say."""
+    comps = netlist["components"]
+    nets_of = {}
+    for net, info in netlist["nets"].items():
+        for ref, *_ in info["nodes"]:
+            nets_of.setdefault(ref, set()).add(net)
+    plan = {}
+    for net, info in netlist["nets"].items():
+        roles = net_roles(net, info, comps, nets_of, netlist["nets"])
+        names = {r for r, _ in roles}
+        hi = [r for r in names if ROLE_PRIORITY.get(r, 1) >= 1]
+        if hi:
+            p = max(ROLE_PRIORITY[r] for r in hi)
+            if not split:
+                p = min(p, 3)  # the bench's baseline: loops and logic at one level
+        elif names & {"debug", "testpoint", "led"}:
+            p = 0
+        else:
+            p = 1
+        if "power" in names and p < 2:
+            p = 2
+        if fallback and not (names - {"testpoint", "led"}):
+            fb = fallback(net, info["class"])
+            if fb is not None:
+                fp, frole = fb
+                p = fp if not names else max(p, fp)
+                names.add(frole)
+                roles.append((frole, f"name: {frole}"))
+        # (a rail with a test point or an LED on it is still a rail: power lifts it to 2 above)
+        inner = not (names & set(OUTSIDE))
+        if any(part_kind(comps.get(ref, {"ref": ref})) == "crystal" for ref, *_ in info["nodes"]):
+            inner = False  # a crystal's traces stay short and on top
+        seen, why = set(), []
+        for r, w in sorted(roles, key=lambda rw: -ROLE_PRIORITY.get(rw[0], 1)):
+            if w not in seen:
+                seen.add(w)
+                why.append(w)
+        why = "; ".join(why[:3]) or "no pin says more: a signal"
+        plan[net] = {"priority": p, "inner": bool(inner), "roles": sorted(names), "why": why}
+    return plan
+
+
+def gate_loops(netlist):
+    """[[nets]]: per MOSFET (each gate of a dual one), its gate path, then its return (last).
+    The gate path is the net on its G pin and, through a two-pin part (the gate resistor), the
+    net on the driver's pin: two nets in series, not side by side. The return is the net on its S
+    pin (the switch node for a high side). By hand a gate runs beside its return, a small loop;
+    the router pairs the longer leg of the gate path with the return (Router: loop pairs)."""
+    comps = netlist["components"]
+    pins = {}  # ref -> [(pin name, pin number, net)]
+    parts = {}  # ref -> [nets]
+    for net, info in netlist["nets"].items():
+        for ref, pin, name, _t in info["nodes"]:
+            pins.setdefault(ref, []).append((name or pin, pin, net))
+            parts.setdefault(ref, []).append(net)
+
+    def num(p):
+        m = re.match(r"\d+", p or "")
+        return int(m.group(0)) if m else 0
+    out = []
+    for ref, ps in pins.items():
+        if part_kind(comps.get(ref, {"ref": ref})) != "mosfet":
+            continue
+        gates = [(n, p, net) for n, p, net in ps if n == "G" or n == "GATE" or re.match(r"^G\d+$", n)]
+        sources = [(n, p, net) for n, p, net in ps if n == "S" or n == "SOURCE" or re.match(r"^S\d+$", n)]
+        for gname, gpin, gnet in gates:
+            # its own source: the same suffix (G1/S1), else - a dual part names both pins G and
+            # S - the source pin numbered just before the gate (S1=1, G1=2, S2=3, G2=4)
+            same = [s for s in sources if gname[1:] and s[0][1:] == gname[1:]]
+            if same:
+                snet = same[0][2]
+            elif sources:
+                snet = min(sources, key=lambda s: (abs(num(gpin) - 1 - num(s[1])), num(s[1])))[2]
+            else:
+                snet = None
+            group = [gnet]
+            for r, *_ in netlist["nets"][gnet]["nodes"]:
+                if r != ref and len(set(parts.get(r, []))) == 2 and part_kind(comps.get(r, {"ref": r})) in ("resistor", "part"):
+                    other = [n for n in set(parts[r]) if n != gnet]
+                    if other:
+                        group.append(other[0])  # the driver's side of the gate resistor
+            if snet and snet not in group:
+                group.append(snet)
+            if len(group) >= 2 and group not in out:
+                out.append(group)
+    return out
+
+
+def build(board_path, schematic=None, kicad_cli=None, fallback=None, split=True, loops=True):
+    """The plan for a board: from the schematic next to it (same name) when there is one."""
+    sch = schematic or os.path.splitext(board_path)[0] + ".kicad_sch"
+    nl = read_netlist(sch, kicad_cli)
+    if nl is None:
+        return {"version": 1, "source": "names", "nets": {}, "buses": None, "loops": [],
+                "note": "no schematic: net names"}
+    return {"version": 1, "source": "netlist", "schematic": os.path.basename(sch),
+            "nets": classify(nl, fallback, split), "buses": None, "loops": gate_loops(nl) if loops else []}
+
+
+def path_for(board_path):
+    return os.path.join(os.path.dirname(board_path), PLAN_FILE)
+
+
+def load(board_path):
+    p = path_for(board_path)
+    if os.path.isfile(p):
+        with open(p, encoding="utf-8") as fh:
+            return json.load(fh)
+    return None
+
+
+def save(board_path, plan):
+    p = path_for(board_path)
+    os.makedirs(os.path.dirname(p), exist_ok=True)
+    with open(p, "w", encoding="utf-8") as fh:
+        json.dump(plan, fh, indent=1, ensure_ascii=False)
+    return p
diff --git a/python/commands/powerlab_router2/router.py b/python/commands/powerlab_router2/router.py
new file mode 100644
index 0000000..827906b
--- /dev/null
+++ b/python/commands/powerlab_router2/router.py
@@ -0,0 +1,2437 @@
+"""PowerLab router 2: route like a person plans, then negotiate.
+
+The first router (commands/powerlab_router/) routes one connection after another and rips
+up when it gets stuck. On a crowded board (TestPCB2: 4 layers, 0.5 mm-pitch ICs, 146
+connections) the early tracks box in the pins of later ones, and most of the time goes into
+searches that can't succeed. This one is built round four other choices:
+
+1. Check first, in seconds. Every pin's ways out are measured against the fixed copper
+   (placement, hand-routed power, pours, keep-outs) before anything is routed. A pin with
+   none is placement's problem, and the report says so with its place, instead of a router
+   searching for minutes.
+2. Negotiate instead of queueing (congestion.py). All nets are routed at once with the
+   other nets' new copper passable at a price; nets that overlap are routed again with the
+   price raised, until every net has a way of its own. Order no longer decides who gets
+   boxed in.
+3. Nets as trees. A net's islands (pads KiCad's connectivity already joins: pours, hand
+   tracks) are joined one by one to the nearest part of the tree, and a track may end on
+   the net's own track at an angle (a T-junction), as by hand.
+4. The search finds the corridor; shaping draws the track (shape.py): straight runs,
+   45 degree corners with real chamfers, exact pad entries. Then the exact check, and DRC
+   (kicad-cli) has the last word in the caller.
+
+Block by block: `region` limits a run to connections inside a box, so a caller (Claude in
+the panel) can route one block, look, and go on, each call in seconds.
+"""
+
+import math
+import random
+import re
+import time
+
+import numpy as np
+import pcbnew
+
+from commands.powerlab_router2 import search as S
+from commands.powerlab_router2 import shape
+from commands.powerlab_router2.board import RouterBoard, grown, plane_layers, polys, uuid, xy
+from commands.powerlab_router2.congestion import Occupancy
+from commands.powerlab_router2.geom import cells_on, union_patch
+
+MM, T = pcbnew.FromMM, pcbnew.ToMM
+TEE_PAD = 1.0  # mm: a track joins its net's track no closer than this to a pad centre
+DIRECT = 3.0  # mm: pads closer than this may be joined by one straight track or dogleg
+DETOUR = 2.5  # a join's way may cost at most this many times its direct length (plus vias)
+SPOKE_REACH = 0.8  # mm beyond a pour pad's edge a thermal spoke needs (gap 0.5 + reach)
+SPOKE_HALF = 0.45  # mm: no track centre this close to a spoke's line (half spoke + clearance + half track)
+STALL = 5 # negotiation rounds without fewer overlaps before it stops
+PAIR = 5.0  # mm: a decap or pull-up this close to an IC pin of its net is joined to it first
+NUDGE_MAX = 0.05  # mm: a track this little too close to fixed copper is moved, not routed again
+ESCAPE_VIA = 1.0  # mm beyond a fine-pitch pad's copper, straight out, where other nets place no via
+DOORSTEP = 0.5  # mm beyond a pad's copper that is its net's way in (_doorsteps)
+NB_SCALE = 8  # node budgets times this with the compiled search
+DETOUR_LIMIT = (1.5, 1.0)  # check_routing's detour: longer than 1.5 times the span plus 1 mm
+GROUP_ORDER = ("power", "switching", "analog", "signal")
+
+
+class Costs:
+    def __init__(self, turn=1.0, via=4.0, diagonal=1.1, layers=(1.0, 1.15), inner=1.6,
+                 present=0.6, present_growth=1.7, history=0.5, rounds=40, nodes=200_000,
+                 margins=(3.0, 10.0, None), magnetics=2.0, escape=1.0, weight=1.3, fast=True, spokes=1.0,
+                 force=False, door=0.0, spoke_corridor=0.0, escalated=3.0, bus_pull=0.6, levels=True,
+                 loop_pairs=False, escape_vias=False, escape_via_cost=0.0, against=1.0, top_axis="v",
+                 pour_layer=2.0, fan_all=True, fan_straight=0.3):
+        self.turn, self.via, self.diagonal, self.weight, self.fast = turn, via, diagonal, weight, fast
+        # preferred directions, as by hand on two layers: the top runs one way (top_axis, "v" or
+        # "h"), the bottom the other, inner layers alternate. A step across a layer's direction
+        # costs `against` times its length, a diagonal half that much more (1.0: off). Without
+        # them both layers fill with tracks every way, so crossings find walls on both
+        # (detours) and the bottom pour is cut into pieces (sf-motion's GND: 12 against 3)
+        self.against, self.top_axis = against, top_axis
+        self.fan_straight = fan_straight  # mm on going straight on instead of the fan's 45 degrees
+        # Router.lanes: every fine-pitch pin fans toward its other pads (sf-motion, 3 seeds: 111.7
+        # -> 113.3 joins, important ones open 8.3 -> 6.7). Its jogs at the turn were the shaping's:
+        # _lane_turn and the magnetics mask in _clear_fn (check_routing 26 -> 17.7, as without)
+        self.fan_all = fan_all
+        self.pour_layer = pour_layer  # factor on an outer layer mostly covered by a pour net (pour_layers)
+        # force: a late round's failed search tries again at the first round's price (strict
+        # PathFinder). On TestPCB2 the overlaps then didn't settle within the time (41 nets
+        # after 8 rounds against 2 after 11) and the same 120 joins were made: off until the
+        # rounds are faster
+        self.force = force
+        self.levels = levels  # prices by whose copper it is (OVER); settle by priority either way
+        # off: on sf-motion it left 5 more joins open (docs §14), the strips of a pin row merge
+        self.escape_vias = escape_vias  # _escape_strips
+        # per via in another pad's escape strip, on top of `via` (mm): a softer rule than the
+        # ban, so a via goes there only when nothing cheaper is free
+        self.escape_via_cost = escape_via_cost
+        self.loop_pairs = loop_pairs  # a gate leg and its return drawn side by side, as a bus (the loop join either way)
+        self.bus_pull = bus_pull  # a bus member's price beside the members already routed (1: off)
+        self.escalated = escalated  # per mm on a plane layer a join went down to: short runs only
+        self.spoke_corridor = spoke_corridor  # per mm, across a pour pad's thermal spoke
+        self.door = door  # per mm, for other nets' tracks on a pad's doorstep (_doorsteps)
+        self.layers, self.inner = list(layers), inner
+        self.present, self.present_growth, self.history = present, present_growth, history
+        self.rounds, self.nodes, self.margins = rounds, nodes, margins
+        self.magnetics, self.escape, self.spokes = magnetics, escape, spokes
+
+
+class Branch:
+    """One join of a net's tree: a path from a pad's lane to the tree, ending at another
+    pad's lane or on an earlier branch's track (`host`, a T-junction)."""
+
+    def __init__(self, island, path, start, end, host, a, b):
+        self.island, self.path, self.start, self.end, self.host = island, path, start, end, host
+        self.a, self.b = a, b  # the island indices it joins
+        self.geo = None  # final copper: {"pieces", "vias", "stubs"}
+        self.grid_geo = None  # the search's copper, for the negotiation
+
+
+def _name(pad):
+    return f"{pad.GetParentFootprint().GetReference()}.{pad.GetNumber()}"
+
+
+def leaf(net):
+    """A net's own name: without its sheet path ("/Gate Driver/IDRIVE" is IDRIVE, not a gate)."""
+    return net.rstrip("/").split("/")[-1].upper()
+
+
+def group_of(net, cls):
+    n = leaf(net)
+    if cls in ("Power", "GND", "HV") or n.startswith(("+", "-", "VBUS")):
+        return "power"
+    t = [x for x in re.split(r"[^A-Z0-9]+", n) if x]
+    if (t[:1] == ["GATE"] or any(x.startswith(("PWM", "INH", "INL", "XTAL", "SCLK", "SCK", "CLK")) for x in t)
+            or any(x in ("HO", "LO") for x in t) or ("BOOT" in t and not any(x.startswith("GPIO") for x in t))):
+        return "switching"  # whole words: not EN_GATE, BOOT0 or BOOT_GPIO24
+    if any(s in n for s in ("SENSE", "SNS", "ISEN", "VSEN", "CSA", "ADC", "REF", "AIN")):
+        return "analog"
+    return "signal"
+
+
+# priorities: who gets the room when not everything fits (the lab's order, not whoever wins
+# the negotiation). 3: switch nodes, gate drive, PWM, clocks; 2: power, analog; 1: signals;
+# 0: test points, JTAG/debug, LEDs, boot straps. Claude can set them per net (`priorities`).
+LOOP_REACH = 5.0  # mm round a FET's gate pad: the return's copper a loop join may end on
+LOW = ("TCK", "TMS", "TDI", "TDO", "JTAG", "SWDIO", "SWCLK", "LED", "BOOT_GPIO", "SCI_", "UART", "DEBUG", "TEST")
+# the price of crossing another net's new copper, by whose it is: a lower level's copper is
+# cheap (settle moves that net out of the way), the same level's at the price, a higher
+# level's dear. So an important net takes its way through a test point's track, not around it
+OVER = {-4: 0.1, -3: 0.1, -2: 0.15, -1: 0.25, 0: 1.0, 1: 3.0, 2: 4.0, 3: 5.0, 4: 5.0}  # by (owner level - own level)
+
+
+def switch_node(net):
+    """Nets that carry the power stage's edges: switch nodes, phases, bootstrap and charge pump."""
+    t = [x for x in re.split(r"[^A-Z0-9]+", leaf(net)) if x]
+    # whole words only: SW_A, Net-(U1-SW), PHASE_A, GATE_AH, Net-(U1-BOOT); not SWDIO, BOOT0,
+    # EN_GATE (an enable) or BOOT_GPIO24 (a boot strap pin)
+    return (any(x in ("SW", "PHASE", "VBST", "BST", "CPH", "CPL", "VCP") for x in t)
+            or (t[:1] == ["GATE"]) or ("BOOT" in t and not any(x.startswith("GPIO") for x in t)))
+
+
+def priority_of(net, group, refs):
+    n = leaf(net)
+    if switch_node(net):
+        return 4  # the power stage's loops (plan.LOOP)
+    if group != "power" and (any(r.startswith("TP") for r in refs) or any(s in n for s in LOW)):
+        return 0  # a test point on a rail doesn't make the rail unimportant
+    if group == "switching":
+        return 3
+    if group in ("power", "analog"):
+        return 2
+    return 1
+
+
+def may_go_inner(net, group):
+    """Signals, analog and logic-level switching may go down to a plane layer when the outer
+    layers have no room; power rails, gate drive and switch nodes stay outside."""
+    return group != "power" and not switch_node(net)
+
+
+BUS_MIN = 3  # nets between the same two ICs that make a bus
+BUS_AIR = 0.05  # mm more than the clearance between a bus's tracks (a tidy bundle, not a squeeze)
+
+
+def buses(board, nets, groups, outside=None):
+    """{(ic, ic): [nets]}: three or more nets that each join the same two ICs (parts with more
+    than four pads), passing at most two-pad parts on the way (a series resistor), and that
+    aren't power or the power stage's own nets. By hand they run side by side as a bundle
+    (PWM and the driver's SPI between U4 and U3 on TestPCB2)."""
+    fps = {}
+    for fp in board.GetFootprints():
+        for pad in fp.Pads():
+            fps.setdefault(pad.GetNetname(), []).append(fp)
+    out = {}
+    for n in nets:
+        if outside is not None:
+            if n in outside:  # the plan keeps it outside: power, power stage, crystal
+                continue
+        elif groups.get(n) == "power" or switch_node(n):
+            continue
+        parts = fps.get(n, [])
+        ics = sorted({fp.GetReference() for fp in parts if fp.GetPadCount() > 4})
+        if len(ics) == 2 and all(fp.GetPadCount() > 4 or fp.GetPadCount() <= 2 for fp in parts):
+            out.setdefault(tuple(ics), []).append(n)
+    return {k: v for k, v in out.items() if len(v) >= BUS_MIN}
+
+
+def pour_layers(board, pour_nets, layers, share=0.5):
+    """Copper layers whose pour-net zones cover more than `share` of the board's outline."""
+    ol = pcbnew.SHAPE_POLY_SET()
+    try:
+        board.GetBoardPolygonOutlines(ol, False)
+    except TypeError:
+        board.GetBoardPolygonOutlines(ol)
+    total = ol.Area()
+    if total <= 0:
+        return set()
+    out = set()
+    for L in layers:
+        area = sum(z.Outline().Area() for z in board.Zones()
+                   if not z.GetIsRuleArea() and z.GetNetname() in pour_nets and z.IsOnLayer(L))
+        if area > share * total:
+            out.add(L)
+    return out
+
+
+def inner_layers(board, pour_nets):
+    """The plane layers a join may go down to: inner layers mostly covered by zones whose
+    copper isn't mostly a pour net's (the GND plane stays whole; a power plane takes a short
+    run, as by hand: In2 on TestPCB2)."""
+    out = []
+    for L in plane_layers(board):
+        total = pour = 0.0
+        for z in board.Zones():
+            if z.GetIsRuleArea() or not z.IsOnLayer(L):
+                continue
+            a = z.Outline().Area()
+            total += a
+            if z.GetNetname() in pour_nets:
+                pour += a
+        if total and pour < 0.5 * total:
+            out.append(board.GetLayerName(L))
+    return out
+
+
+def make_plan(board, board_path, schematic=None, pour_nets=("GND",), nets=None, split=False, loops=False):
+    """The routing plan to review and show: plan.build() from the schematic (names when there
+    is none), plus the buses found on the board and the plane layers joins may go down to.
+    `nets`: the nets to be routed (only those are listed)."""
+    from commands.powerlab_router2 import plan as P
+    ns = board.GetDesignSettings().m_NetSettings
+
+    def by_name(net, cls):
+        """The name as a fallback: only where the pins say nothing (plan.classify)."""
+        n = leaf(net)
+        if switch_node(net):
+            return 4, "switch"
+        if any(s in n for s in LOW):
+            return 0, "debug"
+        g = group_of(net, cls or ns.GetEffectiveNetClass(net).GetName())
+        return {"switching": (3, "pwm"), "analog": (2, "analog"), "power": (2, "power")}.get(g)
+    pl = P.build(board_path, schematic, fallback=by_name, split=split, loops=loops)
+    if pl["source"] != "netlist":
+        refs = {}
+        for fp in board.GetFootprints():
+            for pad in fp.Pads():
+                refs.setdefault(pad.GetNetname(), set()).add(fp.GetReference())
+        for n in nets or refs:
+            g = group_of(n, ns.GetEffectiveNetClass(n).GetName())
+            pl["nets"][n] = {"priority": priority_of(n, g, refs.get(n, ())), "inner": may_go_inner(n, g),
+                             "roles": [g], "why": f"name: {g}"}
+    if nets is not None:
+        pl["nets"] = {n: e for n, e in pl["nets"].items() if n in set(nets)}
+    # gate loops whose return is still to be routed (a poured return is already there), with
+    # at least one leg of the gate path
+    pl["loops"] = [[n for n in g[:-1] if n in pl["nets"]] + [g[-1]] for g in pl.get("loops") or []
+                   if g[-1] in pl["nets"] and any(n in pl["nets"] for n in g[:-1])]
+    # a net with a pour of its own (not the ground pour) carries current: a power path
+    poured = {z.GetNetname() for z in board.Zones() if not z.GetIsRuleArea() and z.GetNetname()
+              and z.GetNetname() not in set(pour_nets)}
+    for n in poured & set(pl["nets"]):
+        e = pl["nets"][n]
+        if e["priority"] < 2 or e["inner"]:
+            e["priority"], e["inner"] = max(e["priority"], 2), False
+            e["roles"] = sorted(set(e.get("roles", [])) | {"power"})
+            e["why"] = "has its own pour; " + e["why"]
+    groups = {n: group_of(n, ns.GetEffectiveNetClass(n).GetName()) for n in pl["nets"]}
+    outside = {n for n, e in pl["nets"].items() if not e.get("inner", True)}
+    pl["buses"] = [sorted(v) for v in buses(board, list(pl["nets"]), groups, outside).values()]
+    # a bus goes in before the loose signals: its members at least 2, said in the plan
+    for bus in pl["buses"]:
+        top = max(pl["nets"][n]["priority"] for n in bus)
+        for n in bus:
+            e = pl["nets"][n]
+            if e["priority"] < max(top, 2):
+                e["priority"] = max(top, 2)
+                e["why"] = f"bus of {len(bus)} with {bus[0] if bus[0] != n else bus[1]}; " + e["why"]
+    pl["inner_layers"] = inner_layers(board, set(pour_nets))
+    return pl
+
+
+class Router:
+    def __init__(self, board, pitch=0.1, pour_nets=("GND",), layers=None, regions=None, costs=None,
+                 time_budget=300.0, region=None, priorities=None, escalate="auto", plan=None, seed=None):
+        """priorities: {net: 0-3} over priority_of(). escalate: plane layer names joins may go
+        down to when the outer layers have no room ("auto": inner_layers(), None: none)."""
+        self.board = board
+        self.costs = costs or Costs()
+        # the routing plan (plan.py; from the schematic, reviewed by Claude and the user):
+        # priority and inner layer per net, and the buses. Names (priority_of) only fill in
+        self.plan = plan or {}
+        self.plan_nets = self.plan.get("nets") or {}
+        self.priorities = {n: e["priority"] for n, e in self.plan_nets.items() if "priority" in e}
+        self.priorities.update(priorities or {})
+        self.seed = seed
+        esc = inner_layers(board, set(pour_nets)) if escalate == "auto" else list(escalate or [])
+        regions = dict(regions or {})
+        if esc:
+            bb = board.GetEdgeBoundingBox() if hasattr(board, "GetEdgeBoundingBox") else board.GetBoardEdgesBoundingBox()
+            x0, y0, x1, y1 = T(bb.GetLeft()), T(bb.GetTop()), T(bb.GetRight()), T(bb.GetBottom())
+            for name in esc:
+                regions.setdefault(name, [(x0, y0), (x1, y0), (x1, y1), (x0, y1)])
+        self.rb = RouterBoard(board, pitch, pour_nets, layers, regions)
+        self.esc = {Li for Li, L in enumerate(self.rb.layers) if self.rb.layer_names[L] in set(esc)}
+        self.dirf = self._direction_factors()
+        self.time_budget = time_budget
+        self.region = region  # (x0, y0, x1, y1) mm: only connections inside
+        g = self.rb.grid
+        NL = len(self.rb.layers)
+        self.hist = [g.zeros(np.float32) for _ in range(NL)]
+        self.lf = []
+        for L in self.rb.layers:
+            outer = L in (self.rb.all_layers[0], self.rb.all_layers[-1])
+            if not outer:
+                self.lf.append(self.costs.inner)
+            elif L == self.rb.all_layers[0]:
+                self.lf.append(self.costs.layers[0])
+            else:
+                self.lf.append(self.costs.layers[-1])
+        # an outer layer that is mostly a pour net's copper (a 2-layer board's GND side) is the
+        # return plane: its tracks cost more, so long runs go on the other side and the plane
+        # isn't cut into pieces (sf-motion's bottom GND: 9.7 pieces -> 6 at 2.0; by hand 3)
+        self.pour_layers = pour_layers(board, set(pour_nets), self.rb.layers)
+        for Li, L in enumerate(self.rb.layers):
+            if L in self.pour_layers and L in (self.rb.all_layers[0], self.rb.all_layers[-1]):
+                self.lf[Li] *= self.costs.pour_layer
+        for Li in self.esc:
+            self.lf[Li] = self.costs.escalated
+        self.occ = {}
+        self._lanes = {}
+        self.fixed_idx = None
+        ds = board.GetDesignSettings()
+        self.neck = max(T(ds.m_TrackMinWidth), 0.15)  # neck-downs at fine-pitch pins
+        self.debug = None  # a list: the exact check records its findings there
+        self.nudge = True  # _nudge before a repair reroutes
+        self.nudged = 0
+        self.cut = False  # the last route_net ran out of time in a search
+        self.use_hist = True  # the negotiation's history cost in the searches' prices
+        self.diag = None  # a list: where joins with no way are blocked (_diagnose), for the bench
+        self._ring = None  # the bus pull of the net being routed (_bus_ring)
+        self.bus_groups = []
+        self.loop_pairs = []  # [gate leg, return] (_loop_pairs)
+        self._direct_ok = {}  # (net, layer, points) -> clear of the fixed copper
+        self.trials = {}  # take_out(trial=...) -> the joins it took out, for untake()
+
+    # --- setup -------------------------------------------------------------------------------
+    def _direction_factors(self):
+        """Per routed layer, the 8 step factors of Costs.against (None when off)."""
+        a = self.costs.against
+        if a <= 1.0:
+            return None
+        diag = 1.0 + (a - 1.0) / 2
+        axes = []
+        for k, L in enumerate(self.rb.all_layers):
+            first = self.costs.top_axis
+            axes.append(first if k % 2 == 0 else ("h" if first == "v" else "v"))
+        if len(self.rb.all_layers) > 1:  # the bottom always crosses the top
+            axes[-1] = "h" if axes[0] == "v" else "v"
+        out = []
+        for Li, L in enumerate(self.rb.layers):
+            if Li in self.esc:
+                out.append([1.0] * 8)  # short escalated runs: any way
+                continue
+            ax = axes[self.rb.all_layers.index(L)]
+            along = (0, 4) if ax == "h" else (2, 6)
+            out.append([1.0 if k in along else (diag if k % 2 else a) for k in range(8)])
+        return out
+
+
+    def occupancy(self, key):
+        if key not in self.occ:
+            o = Occupancy(self.rb, key)
+            for nr in self.routed.values():  # a key seen late learns what is already routed
+                if nr.grid_geo is not None:
+                    o.stamp(nr.net, nr.key, nr.grid_geo, nr.priority)
+            self.occ[key] = o
+        return self.occ[key]
+
+    def _esc_blocks(self):
+        """Per plane layer a join may go down to: closed under the power stage's switch-node
+        copper on any layer (its edges couple into a track there), grown by 0.5 mm."""
+        rb, g = self.rb, self.rb.grid
+        self.esc_block = {}
+        if not self.esc:
+            return
+        sw = []
+        for z in self.board.Zones():
+            if z.GetIsRuleArea() or not switch_node(z.GetNetname()):
+                continue
+            o = z.Outline().CloneDropTriangulation()
+            o.Inflate(MM(0.5), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, MM(0.01))
+            sw += polys(o)
+        m = g.polygons(sw) if sw else g.zeros()
+        for Li in self.esc:
+            self.esc_block[Li] = m
+
+    def lab(self):
+        """The lab's soft rules as a cost per mm per cell, one array per routing layer:
+        - no tracks under inductors and transformers (§3.4), on every layer;
+        - room in front of fine-pitch pins for their own escapes (§3.4)."""
+        rb, g = self.rb, self.rb.grid
+        out = [g.zeros(np.float32) for _ in rb.layers]
+        mag = []
+        for fp in self.board.GetFootprints():
+            ref = fp.GetReference()
+            lib = fp.GetFPIDAsString().lower()
+            if ref[:1] in ("L", "T") and ref[1:2].isdigit() or "inductor" in lib or "transformer" in lib:
+                bb = fp.GetBoundingBox(False)
+                x0, y0, x1, y1 = T(bb.GetLeft()), T(bb.GetTop()), T(bb.GetRight()), T(bb.GetBottom())
+                mag.append(([(x0, y0), (x1, y0), (x1, y1), (x0, y1)], []))
+        # the shaping keeps out from under magnetics by this mask, not by the summed costs: the
+        # escape-room costs of two neighbouring fine-pitch pins also add up to `magnetics`, and
+        # the shaping then refused the very cells the search had taken in front of a pin row
+        self.under_magnetics = g.polygons(mag) if mag else None
+        if mag:
+            m = self.under_magnetics
+            for a in out:
+                a[m] += self.costs.magnetics
+        spokes = [[] for _ in rb.layers]
+        corridors = [[] for _ in rb.layers]
+        for p in rb.pads:
+            if p.GetNetname() in rb.pour_nets:
+                c = xy(p.GetPosition())
+                for Li, L in enumerate(rb.layers):
+                    if not p.IsOnLayer(L):
+                        continue
+                    spokes[Li] += polys(grown(p, L, 0.6))
+                    # the thermal spokes leave along the pad's axes (45 degrees for a round
+                    # pad): a track across one starves the pad (DRC: fewer spokes than the
+                    # zone asks for; U4's GND pins and U6's tab on TestPCB2)
+                    ax = rb.axis(p, L)
+                    pts = [q for o, _h in polys(grown(p, L, 0.0)) for q in o]
+                    for a in ([45.0 + 90.0 * k for k in range(4)] if ax is None else [ax + 90.0 * k for k in range(4)]):
+                        u = (math.cos(math.radians(a)), math.sin(math.radians(a)))
+                        ext = max((q[0] - c[0]) * u[0] + (q[1] - c[1]) * u[1] for q in pts)
+                        corridors[Li].append(([c, (c[0] + u[0] * (ext + SPOKE_REACH), c[1] + u[1] * (ext + SPOKE_REACH))],
+                                              SPOKE_HALF))
+        for Li, pl in enumerate(spokes):
+            if pl:
+                out[Li][g.polygons(pl)] += self.costs.spokes
+        for Li, st in enumerate(corridors):
+            pt = g.patch(st, []) if st else None
+            if pt is not None:
+                pt.view(out[Li])[...] += pt.a * self.costs.spoke_corridor
+        esc = []
+        for p in rb.pads:
+            if not rb.is_fine(p):
+                continue
+            fp = p.GetParentFootprint()
+            c = xy(p.GetPosition())
+            bb = fp.GetBoundingBox(False)
+            o = (c[0] - T(bb.GetCenter().x), c[1] - T(bb.GetCenter().y))
+            n = math.hypot(*o)
+            if n < 0.05:
+                continue
+            u = (o[0] / n, o[1] / n)
+            e = (c[0] + u[0] * 1.2, c[1] + u[1] * 1.2)
+            esc.append(([c, e], 0.15))
+        if esc:
+            pt = g.patch(esc, [])
+            if pt is not None:
+                full = g.zeros()
+                pt.view(full)[...] |= pt.a
+                for a in out:
+                    a[full] += self.costs.escape
+        return out
+
+    def _doorsteps(self, nrs):
+        """The room just round each pad to be joined (DOORSTEP beyond its copper) is its own
+        net's way in: other nets pay `costs.door` per mm there, the pad's own net nothing. So a
+        rail routed early doesn't run along a decap's pads and leave its net no way in (+3V3
+        past the +1V2_MCU decaps on TestPCB2). Counts per layer, and each net's own patches to
+        take back out in its window."""
+        rb, g = self.rb, self.rb.grid
+        self.door = [g.zeros(np.uint16) for _ in rb.layers]
+        self.door_own = {}
+        if not self.costs.door:
+            return
+        for nr in nrs:
+            own = [None] * len(rb.layers)
+            for isl in nr.islands:
+                for p in isl:
+                    c = xy(p.GetPosition())
+                    for Li, L in enumerate(rb.layers):
+                        if not p.IsOnLayer(L):
+                            continue
+                        pts = [q for o, _h in polys(grown(p, L, 0.0)) for q in o]
+                        r = max((math.dist(c, q) for q in pts), default=0.3) + DOORSTEP
+                        pt = g.patch([], [(c, r)])
+                        if pt is not None:
+                            own[Li] = pt if own[Li] is None else union_patch(own[Li], pt)
+            for Li, pt in enumerate(own):
+                if pt is not None:
+                    pt.add_to(self.door[Li])  # once per net, so its own count comes out exactly
+            self.door_own[nr.net] = own
+
+    def _escape_strips(self, nrs):
+        """At fine pitch a via, wider than the pitch, in front of a pin closes the pin's only
+        way out; a track there only pushes the pin's track aside. So other nets place no via
+        in the strip straight out of a fine-pitch pad, ESCAPE_VIA beyond its copper, as wide
+        as a via, its clearance and the pin's track (SHA's via under U2.8 left GHA no way out
+        on sf-motion, round after round). Counts over every such pad, and each net's own patch
+        to take back out in its window, like _doorsteps."""
+        rb, g = self.rb, self.rb.grid
+        self.esc_via = g.zeros(np.uint16)
+        self.esc_via_own = {}
+        if not (self.costs.escape_vias or self.costs.escape_via_cost):
+            return
+        L0 = rb.layers[0]
+        for nr in nrs:
+            strokes = []
+            d = nr.key.vd / 2 + nr.key.w / 2 + rb.new_clearance(nr.key, "Track", nr.key, "Track", L0)
+            for isl in nr.islands:
+                for p in isl:
+                    if not rb.is_fine(p):
+                        continue
+                    L = next((L for L in rb.layers if p.IsOnLayer(L)), None)
+                    ax = rb.axis(p, L) if L is not None else None
+                    if ax is None:
+                        continue
+                    c = xy(p.GetPosition())
+                    bc = p.GetParentFootprint().GetBoundingBox(False).GetCenter()
+                    v = (c[0] - T(bc.x), c[1] - T(bc.y))
+                    pts = [q for o, _h in polys(grown(p, L, 0.0)) for q in o]
+                    best = None
+                    for a in (ax, ax + 90.0, ax + 180.0, ax + 270.0):
+                        u = (math.cos(math.radians(a)), math.sin(math.radians(a)))
+                        if best is None or u[0] * v[0] + u[1] * v[1] > best[0][0] * v[0] + best[0][1] * v[1]:
+                            best = (u, a)
+                    u = best[0]
+                    half = max(((q[0] - c[0]) * u[0] + (q[1] - c[1]) * u[1] for q in pts), default=0.3)
+                    strokes.append(([c, (c[0] + u[0] * (half + ESCAPE_VIA), c[1] + u[1] * (half + ESCAPE_VIA))], d))
+            pt = g.patch(strokes, []) if strokes else None
+            if pt is not None:
+                pt.add_to(self.esc_via)
+            self.esc_via_own[nr.net] = pt
+
+    def _door_cost(self, nr, Li, sl):
+        if not self.costs.door:
+            return 0.0
+        j0, j1, i0, i1 = sl[0].start, sl[0].stop, sl[1].start, sl[1].stop
+        a = self.door[Li][sl].astype(np.float32)
+        own = self.door_own.get(nr.net, [None] * len(self.door))[Li]
+        if own is not None:
+            pj0, pi0 = own.j0, own.i0
+            ph, pw = own.a.shape
+            a0, b0 = max(j0, pj0), max(i0, pi0)
+            a1, b1 = min(j1, pj0 + ph), min(i1, pi0 + pw)
+            if a1 > a0 and b1 > b0:
+                a[a0 - j0:a1 - j0, b0 - i0:b1 - i0] -= own.a[a0 - pj0:a1 - pj0, b0 - pi0:b1 - pi0]
+        return self.costs.door * np.minimum(np.maximum(a, 0.0), 1.0)
+
+    # --- one net's view of the board ---------------------------------------------------------------
+    def _blocked_fn(self, nr):
+        base_t, _bv, cnt_t, _cv, fixed_t, _fv, _op = self.rb.static(nr.key)
+        own = fixed_t.get(nr.net)
+
+        def blocked(Li, i, j):
+            if base_t[Li][j, i]:
+                return True
+            c = int(cnt_t[Li][j, i])
+            if own is not None and own[Li] is not None and own[Li].covers(i, j):
+                c -= 1
+            return c > 0
+        return blocked
+
+    def _window(self, nr, cells, margin):
+        g = self.rb.grid
+        if margin is None:
+            return 0, 0, g.nx, g.ny
+        m = int(math.ceil(margin / g.pitch))
+        i0 = max(0, min(c[0] for c in cells) - m)
+        j0 = max(0, min(c[1] for c in cells) - m)
+        i1 = min(g.nx, max(c[0] for c in cells) + m + 1)
+        j1 = min(g.ny, max(c[1] for c in cells) + m + 1)
+        return i0, j0, i1, j1
+
+    def _win(self, nr, box, pf):
+        """The search's window for `nr` with the present-cost factor pf."""
+        rb = self.rb
+        i0, j0, i1, j1 = box
+        base_t, base_v, cnt_t, cnt_v, fixed_t, fixed_v, own_pad = rb.static(nr.key)
+        occ = self.occupancy(nr.key)
+        NL = len(rb.layers)
+        win = S.Window(i0, j0, i1, j1, NL)
+        sl = (slice(j0, j1), slice(i0, i1))
+
+        def minus(cnt, patch):
+            a = cnt[sl].astype(np.int32)
+            if patch is not None:
+                pj0, pi0 = patch.j0, patch.i0
+                ph, pw = patch.a.shape
+                a0, b0 = max(j0, pj0), max(i0, pi0)
+                a1, b1 = min(j1, pj0 + ph), min(i1, pi0 + pw)
+                if a1 > a0 and b1 > b0:
+                    a[a0 - j0:a1 - j0, b0 - i0:b1 - i0] -= patch.a[a0 - pj0:a1 - pj0, b0 - pi0:b1 - pi0]
+            return a
+
+        own_t = fixed_t.get(nr.net) or [None] * NL
+        for Li in range(NL):
+            blk = base_t[Li][sl] | (minus(cnt_t[Li], own_t[Li]) > 0)
+            if Li in self.esc:
+                blk = blk | self.esc_block[Li][sl] if nr.inner else np.ones_like(blk)
+            win.block_a[Li] = blk
+            c = self.lf[Li] + self.labc[Li][sl] + self._door_cost(nr, Li, sl)
+            if nr.bus and self._ring is not None and self._ring[Li] is not None:
+                c = np.where(self._ring[Li][sl], c * self.costs.bus_pull, c)
+            if self.use_hist:
+                c = c + self.hist[Li][sl]
+            c = c * (1.0 + self._price(occ.tl, nr.priority, Li, sl, pf))
+            if nr.avoid is not None:
+                c = c + nr.avoid[Li][sl]
+            win.cost_a[Li] = c
+        vok = ~(base_v[sl] | (minus(cnt_v, fixed_v.get(nr.net)) > 0))
+        op = own_pad.get(nr.net)
+        if op is not None:
+            # a via keeps VIA_TO_PAD from its own net's pads too (§3.5)
+            vok &= ~(minus(np.zeros_like(cnt_v), op) < 0)
+        if self.costs.escape_vias:
+            vok &= ~(minus(self.esc_via, self.esc_via_own.get(nr.net)) > 0)
+        win.via_ok_a[...] = vok
+        vc = self.costs.via * (1.0 + self._price(occ.vl, nr.priority, None, sl, pf))
+        if self.use_hist:
+            vc = vc + 0.5 * sum(h[sl] for h in self.hist)
+        if self.costs.escape_via_cost and not self.costs.escape_vias:
+            vc = vc + self.costs.escape_via_cost * (minus(self.esc_via, self.esc_via_own.get(nr.net)) > 0)
+        win.via_cost_a[...] = vc
+        return win
+
+    def _price(self, counts, level, Li, sl, pf):
+        """pf times the others' copper here: weighted by whose it is (OVER) with `costs.levels`,
+        else every net's alike. A fixed price for lower levels' copper (LOW_PRICE, not grown per
+        round) was tried: on TestPCB2 the overlaps then didn't settle (115 joins against 127)."""
+        if not self.costs.levels:
+            return pf * sum((arr[Li][sl] if Li is not None else arr[sl]) for arr in counts)
+        return pf * (self._over(counts, level, Li, sl, True) + self._over(counts, level, Li, sl, False))
+
+    @staticmethod
+    def _over(counts, level, Li, sl, upper):
+        """The others' copper in the window, weighted by whose it is (OVER): with `upper` the
+        copper of nets at this net's level or above (its price grows each round), else of the
+        nets below it (a fixed LOW_PRICE: an important net goes through a test point's track as
+        if it were nearly free, and settle moves the test point)."""
+        out = None
+        for lev, arr in enumerate(counts):
+            if (lev >= level) != upper:
+                continue
+            a = arr[Li][sl] if Li is not None else arr[sl]
+            if not a.any():
+                continue
+            term = OVER[lev - level] * a
+            out = term if out is None else out + term
+        return out if out is not None else 0.0
+
+    def lanes(self, nr, pad):
+        k = (uuid(pad), nr.key.id)
+        if k not in self._lanes:
+            rb = self.rb
+            blocked = self._blocked_fn(nr)
+
+            def check(Li, a, b, width):
+                if math.dist(a, b) < 1e-6:
+                    return True
+                t = rb.track(nr.net, rb.layers[Li], a, b, width)
+                key = nr.key if width >= nr.key.w - 1e-6 else rb.neck_key(nr.key, width)
+                return not [h for h in rb.hits(nr.net, key, t, "Track", self.fixed_idx) if h is not None]
+            self._lanes[k] = rb.lanes(pad, nr.key, blocked, check, neck=self.neck)
+        out = self._lanes[k]
+        if self.esc and not nr.inner:
+            out = [l for l in out if l.layer not in self.esc]
+        if nr.bus and self.costs.bus_pull < 1.0 and self.rb.is_fine(pad):
+            out = self._fan(nr, pad, out)
+        elif self.costs.fan_all and self.rb.is_fine(pad):
+            # any net at a fine-pitch row fans the same way, toward its other pads: neighbours
+            # heading one way leave in order and run on parallel. Each choosing its own turn,
+            # the middle one of three (SHA between GHA and GLA at sf-motion's driver) was shut in
+            others = [xy(q.GetPosition()) for isl in nr.islands for q in isl if uuid(q) != uuid(pad)
+                      and q.GetParentFootprint().GetReference() != pad.GetParentFootprint().GetReference()]
+            if others:
+                tx = sum(q[0] for q in others) / len(others)
+                ty = sum(q[1] for q in others) / len(others)
+                out = self._fan(nr, pad, out, target=(tx, ty), straight=self.costs.fan_straight)
+        return out
+
+    def _fan(self, nr, pad, lanes, target=None, straight=1.0):
+        """A bus member's lanes at a fine-pitch pin row: straight out of the row to the lane's
+        exit, then 45 degrees towards the bus's other IC (straight on costs a little more).
+        Every pin of the row leaves the same way and turns at the same distance, so the tracks
+        run on parallel at the pin pitch over root 2, as a hand-drawn fan; turning anywhere,
+        each where it pleased, they left no gap for the next pin (PWM_BH at U3 on TestPCB2)."""
+        from commands.powerlab_router2.board import Lane
+        from commands.powerlab_router2.geom import DIRS
+        if target is not None:
+            tx, ty = target
+        else:
+            ref = pad.GetParentFootprint().GetReference()
+            other = [r for r in nr.bus_ics if r != ref]
+            if ref not in nr.bus_ics or not other:
+                return lanes
+            fp = self.board.FindFootprintByReference(other[0])
+            tx, ty = xy(fp.GetPosition())
+        out = []
+        for l in lanes:
+            if len(l.dirs) != 1:
+                out.append(l)
+                continue
+            d = next(iter(l.dirs))
+            vx, vy = tx - l.exit[0], ty - l.exit[1]
+
+            def toward(k):
+                dx, dy = DIRS[k]
+                return (dx * vx + dy * vy) / math.hypot(dx, dy)
+            diag = max(((d + 1) % 8, (d - 1) % 8), key=toward)
+            nl = Lane(l.pad, l.layer, l.centre, l.exit, l.cell, {diag: 0.0, d: straight}, l.cost, l.stub, l.width)
+            nl.anchor = l.anchor
+            out.append(nl)
+        return out
+
+    # --- one net -----------------------------------------------------------------------------------
+    def route_net(self, nr, pf, deadline, keep=None, weight=None):
+        """Join the net's islands into one tree. `keep`: branches that stay (a later round
+        routes again only the joins that overlapped); the islands they join count as one.
+        The parts are joined nearest first, each to the part that holds the most islands."""
+        rb, g, c = self.rb, self.rb.grid, self.costs
+        self.cut = False
+        self._ring = self._bus_ring(nr) if nr.bus and c.bus_pull < 1.0 else None
+        islands = nr.islands
+        isl_of = {uuid(p): k for k, isl in enumerate(islands) for p in isl}
+        parent = list(range(len(islands)))
+
+        def find(a):
+            while parent[a] != a:
+                parent[a] = parent[parent[a]]
+                a = parent[a]
+            return a
+        keep = list(keep or [])
+        for b in keep:
+            parent[find(b.a)] = find(b.b)
+        parts = {}
+        for k in range(len(islands)):
+            parts.setdefault(find(k), []).append(k)
+        groups = sorted(parts.values(), key=lambda ks: (-sum(len(islands[k]) for k in ks), min(ks)))
+        root = groups[0]
+        tree = [p for k in root for p in islands[k]]
+        rest = groups[1:]
+        branches = list(keep)
+        tees = {}  # (i, j, L) -> (host branch, directions it may be joined from)
+        pad_pts = [xy(p.GetPosition()) for p in rb.pads_of.get(nr.net, [])]
+
+        def add_tees(b):
+            for s in b.path[1:-1]:
+                if s[3] == S.FREE:
+                    continue
+                p = g.at(s[0], s[1])
+                if any(math.dist(p, q) < TEE_PAD for q in pad_pts):
+                    continue
+                dirs = frozenset(k for k in range(8) if k % 4 != s[3] % 4)
+                tees.setdefault((s[0], s[1], s[2]), (b, dirs))
+        joined = {find(root[0])}
+        for b in keep:
+            if find(b.a) in joined:
+                add_tees(b)
+        failed = []
+
+        def attempt(isl, targets, use_tees, jk):
+            """One join: from `isl`'s lanes to the lanes of `targets` (and the tree's tracks if
+            use_tees). Returns (branch or None, why)."""
+            direct = self._direct(nr, isl, targets, isl_of)
+            if direct is not None:
+                return direct, None
+            la = [l for p in isl for l in self.lanes(nr, p)]
+            # goals: lanes of every target pad and the tree's tracks; the window round the
+            # part and the targets' nearest pads that have a way in
+            near = sorted(targets, key=lambda q: min(math.dist(xy(a.GetPosition()), xy(q.GetPosition())) for a in isl))
+            lb = [l for p in near for l in self.lanes(nr, p)]
+            lb_near = [l for p in near[:6] for l in self.lanes(nr, p)] or lb[:12]
+            ts = tees if use_tees else {}
+            if not la or not (lb or ts):
+                return None, "no free entry lane" if not la else "no free entry lane at the other end"
+            starts = [(l.cell[0], l.cell[1], l.layer, d, l.cost + extra) for l in la for d, extra in l.dirs.items()]
+            goals = {}
+            for l in lb:
+                key = (l.cell[0], l.cell[1], l.layer)
+                dirs = frozenset((d + 4) % 8 for d in l.dirs)
+                old = goals.get(key)
+                goals[key] = (dirs | old[0], min(old[1], l.cost)) if old else (dirs, l.cost)
+            for key, (_b, dirs) in ts.items():
+                if key not in goals:
+                    goals[key] = (dirs, 0.0)
+            cells = [l.cell for l in la + lb_near]
+            if not lb_near:
+                cells += [(k[0], k[1]) for k in list(ts)[:: max(1, len(ts) // 20)]]
+            ends = [l.exit for l in lb_near] or [g.at(k[0], k[1]) for k in ts]
+            lower = min(math.dist(a.exit, b) for a in la for b in ends)
+            # compiled (search_nb), a node costs about a 20th: long joins (35-55 mm round the
+            # power stage) got a search too small for them and were called placement's fault
+            k = NB_SCALE if S.search_nb.AVAILABLE else 1
+            budget = int(min(c.nodes * k, (20_000 + 6_000 * lower) * k))
+            if jk in nr.nodes_used:
+                # it found a way before: a few times that is enough, the rest is wandering
+                budget = min(budget, 4 * nr.nodes_used[jk] + 20_000)
+            path, best_cost, why = None, None, "no path"
+            if jk in nr.hopeless:
+                return None, nr.hopeless[jk]
+            # the first time a join is searched, a detour limit: what would cost more than
+            # DETOUR times the direct way (plus a few vias) isn't a way, and is not tried again
+            first_time = jk not in nr.searched
+            nr.searched.add(jk)
+            if first_time:
+                # the limit is the placement's: it is checked against the fixed copper only (the
+                # other nets' new copper free, no history). Checked under a late round's prices,
+                # a join first searched then (its part's islands grouped differently) failed it
+                # for the others' copper and was given up for good
+                limit = DETOUR * lower + 3 * c.via + 3.0
+                if nr.inner:
+                    # a mm on the plane layer costs `escalated`: the limit is on length, not price
+                    limit = DETOUR * lower * c.escalated + 4 * c.via + 3.0
+                ok, use_hist = False, self.use_hist
+                self.use_hist = False
+                try:
+                    for margin in c.margins:
+                        win0 = self._win(nr, self._window(nr, cells, margin), 0.0)
+                        f0, _c0, n0 = S.search(win0, starts, goals, g.pitch, c.turn, c.diagonal, dirf=self.dirf,
+                                               max_nodes=max(budget, c.nodes * k), weight=c.weight, max_cost=limit)
+                        self.nodes += n0
+                        self.searches += 1
+                        if f0:
+                            ok = True
+                            break
+                        if n0 == 0 and margin is None:
+                            why = "closed in by fixed copper"
+                finally:
+                    self.use_hist = use_hist
+                if not ok:
+                    if why == "no path":
+                        why = f"no way within {DETOUR:g}x its direct length ({lower:.1f} mm): placement, or another layer"
+                    nr.hopeless[jk] = why
+                    return None, why
+            limit = None
+            widened = False
+            used = 0
+            for margin in c.margins:
+                box = self._window(nr, cells, margin)
+                win = self._win(nr, box, pf)
+                found, cost, nodes = S.search(win, starts, goals, g.pitch, c.turn, c.diagonal, dirf=self.dirf, max_nodes=budget,
+                                              deadline=deadline, weight=weight or c.weight, max_cost=limit)
+                self.nodes += nodes
+                self.searches += 1
+                if not found and deadline is not None and time.time() > deadline:
+                    self.cut = True  # out of time, not out of ways: the caller keeps the old tree
+                    break
+                if not found and nodes == 0:
+                    # the coarse map says no way at all in this window
+                    why = "closed in by fixed copper" if margin is None else why
+                    continue
+                if found and (path is None or cost < best_cost):
+                    path, best_cost, used = found, cost, nodes
+                if path and (best_cost <= 2.0 * lower + 2 * c.via or widened):
+                    break
+                if path:
+                    widened = True  # a dear way: one wider window may have one round it
+                budget = int(budget * 1.5)
+            if not path and c.force and not first_time and not self.cut and self.costs.present < pf < 1e3:
+                # PathFinder needs every net to have a way, if only through others: at a late
+                # round's price the search runs out of nodes before it pays it, the join drops
+                # out and the nets in its way never feel it. So once more at the first round's
+                # price: the overlap it leaves raises the history there and the others move
+                box = self._window(nr, cells, c.margins[1])
+                win = self._win(nr, box, self.costs.present)
+                found, cost, nodes = S.search(win, starts, goals, g.pitch, c.turn, c.diagonal, dirf=self.dirf, max_nodes=c.nodes,
+                                              deadline=deadline, weight=weight or c.weight)
+                self.nodes += nodes
+                self.searches += 1
+                if found:
+                    path, best_cost, used = found, cost, nodes
+                    self.forced += 1
+                elif deadline is not None and time.time() > deadline:
+                    self.cut = True
+            if not path and self.diag is not None and not first_time and why == "no path":
+                self._diagnose(nr, isl, cells, starts, goals, weight)
+            if not path:
+                return None, why  # the placement allows a way: the others are in it (crowded)
+            i, j, L, d = path[0]
+            start = next((l for l in la if l.cell == (i, j) and l.layer == L and d in l.dirs), la[0])
+            ei, ej, eL, ed = path[-1]
+            end = next((l for l in lb if l.cell == (ei, ej) and l.layer == eL and (ed + 4) % 8 in l.dirs), None)
+            host = None
+            if end is None:
+                hit = ts.get((ei, ej, eL))
+                host = hit[0] if hit else None
+            a = isl_of[uuid(start.pad)]
+            bidx = isl_of[uuid(end.pad)] if end is not None else (host.a if host is not None else root[0])
+            nr.nodes_used[jk] = max(used, 1000)
+            b = Branch(isl, path, start, end, host, a, bidx)
+            b.grid_geo = self._branch_geo(b)
+            return b, None
+
+        # pin and part first: a decap or a pull-up beside an IC pin of the net is joined to
+        # that pin on its own, as by hand, before the tree; else it hangs on whatever track of
+        # the net passes, and pin and decap end up joined round the board (+3V3 at U4)
+        # (a gate loop's return first: driver pin to its FET's source, _loop_joins)
+        paired = []
+        for ka, kbs in self._loop_joins(nr):
+            kbs = [k for k in kbs if find(k) != find(ka)]
+            if self.cut or not kbs:
+                continue
+            jk = frozenset([uuid(p) for p in islands[ka]] + ["loop"])
+            br, _why = attempt(islands[ka], [p for k in kbs for p in islands[k]], False, jk)
+            if br is None:
+                continue
+            branches.append(br)
+            paired.append(br)
+            parent[find(br.b)] = find(ka)
+        for ka, kb, tag in [(a, b, "pair") for a, b in self._pin_pairs(nr, rest + [root])]:
+            if self.cut or find(ka) == find(kb):
+                continue
+            jk = frozenset([uuid(p) for p in islands[kb]] + [tag])
+            br, _why = attempt(islands[kb], islands[ka], False, jk)
+            if br is None:
+                continue
+            branches.append(br)
+            paired.append(br)
+            parent[find(kb)] = find(ka)
+        if paired:
+            parts = {}
+            for k in range(len(islands)):
+                parts.setdefault(find(k), []).append(k)
+            root_k = find(root[0])
+            root = parts.pop(root_k)
+            tree = [p for k in root for p in islands[k]]
+            rest = sorted(parts.values(), key=lambda ks: (-sum(len(islands[k]) for k in ks), min(ks)))
+            for b2 in paired:
+                if find(b2.a) == root_k:
+                    add_tees(b2)
+        joined_extra = keep + paired
+        while rest:
+            if self.cut:
+                for ks in rest:
+                    failed.append(([p for k in ks for p in islands[k]], "no path"))
+                break
+
+            def gap(ks):
+                return min(math.dist(xy(a.GetPosition()), xy(q.GetPosition()))
+                           for k in ks for a in islands[k] for q in tree)
+            ks = min(rest, key=gap)
+            rest.remove(ks)
+            isl = [p for k in ks for p in islands[k]]
+            br, why = attempt(isl, tree, True, frozenset(uuid(p) for p in isl))
+            if br is None:
+                failed.append((isl, why))
+                continue
+            branches.append(br)
+            tree += isl
+            add_tees(br)
+            kr = find(ks[0])
+            for b2 in joined_extra:
+                if find(b2.a) == kr:
+                    add_tees(b2)
+        nr.branches = branches
+        nr.failed = failed
+        nr.grid_geo = self._grid_geo(nr)
+
+    def _loop_pairs(self, by_net):
+        """Each gate loop of the plan as a pair: the gate path's longest leg (its pads' spread)
+        and the return. Not raised like a bus: a return such as a current-sense net keeps its
+        own priority for its other legs."""
+        self.loop_pairs = []
+        for g in self.plan.get("loops") or []:
+            legs = [by_net[n] for n in g[:-1] if n in by_net]
+            if legs and g[-1] in by_net:
+                if self.costs.loop_pairs:
+                    self.loop_pairs.append([max(legs, key=lambda nr: nr.hpwl()).net, g[-1]])
+                # the return's own join: driver pin to this FET's source. The FET has pads on
+                # the G-pin net and the return; the driver too when there is no gate resistor,
+                # so the FET is the smaller of the two, the driver the larger
+                refs = {}
+                for n in g:
+                    for p in self.rb.pads_of.get(n, []):
+                        refs.setdefault(n, {})[p.GetParentFootprint().GetReference()] = p.GetParentFootprint().GetPadCount()
+                both = {r: c for r, c in refs.get(g[0], {}).items() if r in refs.get(g[-1], {})}
+                if not both:
+                    continue
+                fet = min(both, key=both.get)
+                drv = [r for n in g[:-1] for r, c in refs.get(n, {}).items()
+                       if r != fet and r in refs.get(g[-1], {}) and c > 4]
+                if drv:
+                    by_net[g[-1]].loop_joins.append((drv[0], fet))
+        return self.loop_pairs
+
+    def _loop_joins(self, nr):
+        """(driver pin island, [islands at the FET]) of each gate loop the net is the return
+        of: joined first, from the driver's pin, beside the gate track (the pair's bus ring),
+        as by hand. Else the net's shortest tree may reach the driver's pin from anywhere on
+        the net, and the loop round the gate is as wide as the board allows. It may end on any
+        of the return's islands within LOOP_REACH of the FET's gate pad (by hand SHA ends on
+        the low side's drain, beside the high side's source, and the pour joins them)."""
+        out = []
+        for drv, fet in nr.loop_joins:
+            fp = self.board.FindFootprintByReference(fet)
+            gate = [xy(p.GetPosition()) for p in fp.Pads() if p.GetNetname() != nr.net] if fp else []
+            ka = [k for k, isl in enumerate(nr.islands) if any(p.GetParentFootprint().GetReference() == drv for p in isl)]
+            kb = [k for k, isl in enumerate(nr.islands)
+                  if any(p.GetParentFootprint().GetReference() == fet
+                         or (gate and min(math.dist(xy(p.GetPosition()), q) for q in gate) <= LOOP_REACH) for p in isl)]
+            kb = [k for k in kb if not ka or k != ka[0]]
+            if ka and kb:
+                out.append((ka[0], kb))
+        return out
+
+    def _bus_ring(self, nr):
+        """Per layer, the cells where a track centre of `nr` runs beside a bus member's track at
+        the bundle's pitch (their half widths + clearance + BUS_AIR, give or take a cell)."""
+        rb, g = self.rb, self.rb.grid
+        out = [None] * len(rb.layers)
+        for Li, L in enumerate(rb.layers):
+            near, far = [], []
+            for m in nr.bus:
+                if m.grid_geo is None:
+                    continue
+                d = rb.new_clearance(nr.key, "Track", m.key, "Track", L) + nr.key.w / 2 + m.key.w / 2 + BUS_AIR
+                for Lm, pts in m.grid_geo["pieces"]:
+                    if Lm == Li and len(pts) >= 2:
+                        far.append((pts, d + g.pitch))
+                        near.append((pts, max(d - g.pitch, g.pitch)))
+            if not far:
+                continue
+            a, b = g.patch(far, []), g.patch(near, [])
+            ring = g.zeros()
+            if a is not None:
+                a.view(ring)[...] |= a.a
+            if b is not None:
+                b.view(ring)[...] &= ~b.a
+            out[Li] = ring
+        return out
+
+    def _pin_pairs(self, nr, groups):
+        """(IC pin island, part island) pairs of the net to join first: a two-pad C/R/FB part
+        whose pad is within PAIR mm of an IC pin (a part with more than four pads), nearest
+        first, each island in one pair at most; single-island groups only."""
+        if nr.net in self.rb.pour_nets:
+            return []
+        single = [ks[0] for ks in groups if len(ks) == 1 and len(nr.islands[ks[0]]) == 1]
+
+        def kind(k):
+            fp = nr.islands[k][0].GetParentFootprint()
+            n = fp.GetPadCount()
+            ref = fp.GetReference()
+            if n > 4:
+                return "ic"
+            if n == 2 and (ref[:1] in ("C", "R") or ref[:2] == "FB"):
+                return "part"
+            return None
+        kinds = {k: kind(k) for k in single}
+        cand = []
+        for ka in single:
+            if kinds[ka] != "ic":
+                continue
+            pa = xy(nr.islands[ka][0].GetPosition())
+            for kb in single:
+                if kinds[kb] != "part":
+                    continue
+                d = math.dist(pa, xy(nr.islands[kb][0].GetPosition()))
+                if d <= PAIR:
+                    cand.append((d, ka, kb))
+        used, out = set(), []
+        for _d, ka, kb in sorted(cand):
+            if ka in used or kb in used:
+                continue
+            used.update((ka, kb))
+            out.append((ka, kb))
+        return out
+
+    def _diagnose(self, nr, isl, cells, starts, goals, weight):
+        """For the bench: where a join that found no way is blocked. A search at the first
+        round's price finds the way through the others; record whose copper it crosses and how
+        far from the net's own pads (an entry taken, or a channel full)."""
+        g, c = self.rb.grid, self.costs
+        box = self._window(nr, cells, c.margins[1])
+        win = self._win(nr, box, self.costs.present)
+        found, _cost, _n = S.search(win, starts, goals, g.pitch, c.turn, c.diagonal, dirf=self.dirf, max_nodes=c.nodes,
+                                    weight=weight or c.weight)
+        rec = {"net": nr.net, "pin": _name(isl[0]), "round_price": None}
+        if not found:
+            rec["blocked"] = "no way even through others"
+            self.diag.append(rec)
+            return
+        occ = self.occ[nr.key]
+        pads = [xy(p.GetPosition()) for p in self.rb.pads_of.get(nr.net, [])]
+        hits = {}
+        for i, j, L, _d in found:
+            if occ.t[L][j, i] <= 0:
+                continue
+            p = g.at(i, j)
+            near = min(math.dist(p, q) for q in pads)
+            for other, (tl, _vp) in occ.stamps.items():
+                if other != nr.net and tl[L] is not None and tl[L].covers(i, j):
+                    h = hits.setdefault(other, [99.0, 0])
+                    h[0] = min(h[0], near)
+                    h[1] += 1
+        rec["crosses"] = {k: {"cells": v[1], "nearest_own_pad_mm": round(v[0], 2)} for k, v in hits.items()}
+        self.diag.append(rec)
+
+    def _direct(self, nr, isl, tree, isl_of):
+        """Two pads of the net close together (a decap beside its IC pin): one straight track
+        from centre to centre, or one dogleg, when it is clear of everything, as by hand.
+        Their lanes would cross each other, so the search can't find this."""
+        from commands.powerlab_router2.board import Lane
+        from commands.powerlab_router2.geom import doglegs, direction
+        rb, g = self.rb, self.rb.grid
+        occ = self.occ[nr.key]
+        blocked = self._blocked_fn(nr)
+        best = None
+        for a in isl:
+            ca = xy(a.GetPosition())
+            for q in tree:
+                cq = xy(q.GetPosition())
+                d = math.dist(ca, cq)
+                if d > DIRECT or d < 1e-3 or (best is not None and d >= best[0]):
+                    continue
+                layers = [Li for Li, L in enumerate(rb.layers) if a.IsOnLayer(L) and q.IsOnLayer(L)
+                          and (Li not in self.esc or nr.inner)]
+                for Li in layers:
+                    for pts in doglegs(ca, cq):
+                        if not self._direct_clear(nr, Li, pts, a, q, occ, blocked):
+                            continue
+                        best = (d, Li, pts, a, q)
+                        break
+                    if best is not None and best[3] is a and best[4] is q:
+                        break
+        if best is None:
+            return None
+        _d, Li, pts, a, q = best
+        cells = cells_on(g, pts)
+        path = []
+        for (i, j) in cells:
+            path.append((i, j, Li, None))
+        for k in range(len(path)):
+            nxt = path[k + 1] if k + 1 < len(path) else None
+            prv = path[k - 1] if k else None
+            ref = (path[k], nxt) if nxt else (prv, path[k])
+            dd = direction(g.at(ref[0][0], ref[0][1]), g.at(ref[1][0], ref[1][1]))
+            path[k] = (path[k][0], path[k][1], Li, dd if dd is not None else 0)
+        la = Lane(a, Li, xy(a.GetPosition()), xy(a.GetPosition()), cells[0], {path[0][3]: 0.0}, 0.0, True)
+        lb = Lane(q, Li, xy(q.GetPosition()), xy(q.GetPosition()), cells[-1], {(path[-1][3] + 4) % 8: 0.0}, 0.0, True)
+        b = Branch(isl, path, la, lb, None, isl_of[uuid(a)], isl_of[uuid(q)])
+        b.direct = pts
+        b.grid_geo = self._branch_geo(b)
+        return b
+
+    def _direct_clear(self, nr, Li, pts, a, q, occ, blocked):
+        rb, g = self.rb, self.rb.grid
+        # the grid: the others' new copper, and fixed copper away from the two pads
+        for i, j in cells_on(g, pts):
+            if not g.inside(i, j) or occ.t[Li][j, i] > 0:
+                return False
+        # the exact check against the fixed copper doesn't change between rounds: cached
+        ck = (nr.net, Li, tuple(pts))
+        if ck not in self._direct_ok:
+            ok = True
+            for m in range(len(pts) - 1):
+                t = rb.track(nr.net, rb.layers[Li], pts[m], pts[m + 1], nr.key.w)
+                if rb.hits(nr.net, nr.key, t, "Track", self.fixed_idx):
+                    ok = False
+                    break
+            self._direct_ok[ck] = ok
+        if not self._direct_ok[ck]:
+            return False
+        if len(pts) == 3:
+            # a dogleg's bend may not sit inside a pad of either end (it would just be a kink)
+            if a.HitTest(pcbnew.VECTOR2I(MM(pts[1][0]), MM(pts[1][1]))) or                     q.HitTest(pcbnew.VECTOR2I(MM(pts[1][0]), MM(pts[1][1]))):
+                return False
+        return True
+
+    def _branch_geo(self, b):
+        g = self.rb.grid
+        pcs, vs, _dirs = shape.pieces(b.path, g)
+        stubs = [(lane.layer, lane.centre, g.at(*lane.cell)) for lane in (b.start, b.end) if lane is not None]
+        return {"pieces": pcs, "vias": vs, "stubs": stubs}
+
+    def _grid_geo(self, nr):
+        pieces, vias, stubs = [], [], []
+        for b in nr.branches:
+            if b.grid_geo is None:
+                b.grid_geo = self._branch_geo(b)
+            pieces += b.grid_geo["pieces"]
+            vias += b.grid_geo["vias"]
+            stubs += b.grid_geo["stubs"]
+        return {"pieces": pieces, "vias": vias, "stubs": stubs}
+
+    @staticmethod
+    def _with_dependents(nr, gone):
+        """`gone` plus every branch that ends on one of them (a T-junction onto it)."""
+        gone = set(gone)
+        changed = True
+        while changed:
+            changed = False
+            for b in nr.branches:
+                if b not in gone and b.host is not None and b.host in gone:
+                    gone.add(b)
+                    changed = True
+        return gone
+
+    def _bad_branches(self, nr):
+        """The net's branches whose copper sits in another net's, and those cells."""
+        occ = self.occ[nr.key]
+        bad, cells = [], []
+        for b in nr.branches:
+            cs = occ.conflicts(nr.net, b.grid_geo)
+            if cs:
+                bad.append(b)
+                cells += cs
+        return bad, cells
+
+    def stamp(self, nr, geo):
+        for key in list(self.occ):
+            self.occ[key].stamp(nr.net, nr.key, geo, nr.priority)
+
+    def unstamp(self, nr):
+        for o in self.occ.values():
+            o.unstamp(nr.net)
+
+    # --- the run ---------------------------------------------------------------------------------
+    def run(self, nets, log=None):
+        t_start = time.perf_counter()
+        rb = self.rb
+        self.nodes = self.searches = self.plain = self.forced = 0
+        self.routed = {}
+        timings = {}
+        # 1. check: what is to be joined, and whether every pin has a way out at all
+        self.fixed_idx = rb.index([(it, it.GetNetname()) for it in rb.fixed])
+        self.labc = self.lab()
+        self._esc_blocks()
+        nrs = []
+        for net in nets:
+            isl = rb.islands(net)
+            if len(isl) < 2:
+                continue
+            if self.region:
+                x0, y0, x1, y1 = self.region
+                inside = lambda p: x0 <= xy(p.GetPosition())[0] <= x1 and y0 <= xy(p.GetPosition())[1] <= y1
+                if not all(inside(p) for g_ in isl for p in g_):
+                    continue
+            nr = _Net(net, rb.key(net), isl, group_of(net, rb.netclass(net).GetName()))
+            refs = {p.GetParentFootprint().GetReference() for g_ in isl for p in g_}
+            nr.priority = self.priorities.get(net, priority_of(net, nr.group, refs))
+            e = self.plan_nets.get(net)
+            nr.may_inner = e["inner"] if e and "inner" in e else may_go_inner(net, nr.group)
+            nrs.append(nr)
+        by_net = {nr.net: nr for nr in nrs}
+        self.bus_groups = []
+        if isinstance(self.plan.get("buses"), list):
+            # as the plan lists them (two buses may join the same two ICs: a list, not a dict);
+            # a gate loop (plan.gate_loops) runs side by side like a bus
+            groups = []
+            for members in self.plan["buses"] + self._loop_pairs(by_net):
+                mem = [n for n in members if n in by_net]
+                ics = sorted({p.GetParentFootprint().GetReference() for n in mem for isl in by_net[n].islands
+                              for p in isl if p.GetParentFootprint().GetPadCount() > 4})
+                if len(mem) >= 2 and ics:
+                    groups.append(((ics[0], ics[1] if len(ics) > 1 else ics[0]), mem))
+        else:
+            outside = {n for n, e in self.plan_nets.items() if not e.get("inner", True)} if self.plan_nets else None
+            groups = list(buses(self.board, list(by_net), {n: by_net[n].group for n in by_net}, outside).items())
+        for (ic, _ic2), members in groups:
+            mem = [by_net[n] for n in members]
+            # in the order of their pins along the first IC's row, so neighbours stay neighbours
+            def pin_at(nr, ic=ic):
+                ps = [xy(p.GetPosition()) for isl in nr.islands for p in isl
+                      if p.GetParentFootprint().GetReference() == ic]
+                return ps[0] if ps else (0.0, 0.0)
+            # round the IC (a bus may leave it on two sides), starting after the widest gap
+            fp = self.board.FindFootprintByReference(ic)
+            cx, cy = xy(fp.GetPosition())
+            ang = {nr.net: math.atan2(pin_at(nr)[1] - cy, pin_at(nr)[0] - cx) for nr in mem}
+            mem.sort(key=lambda nr: ang[nr.net])
+            gaps = [(ang[mem[(k + 1) % len(mem)].net] - ang[mem[k].net]) % (2 * math.pi) for k in range(len(mem))]
+            cut = max(range(len(mem)), key=lambda k: gaps[k])
+            mem = mem[cut + 1:] + mem[:cut + 1]
+            top = max(nr.priority for nr in mem)
+            for k, nr in enumerate(mem):
+                nr.bus = [m for m in mem if m is not nr]
+                nr.bus_ics = {ic, _ic2}
+                nr.bus_rank = k
+                if nr.net not in self.priorities and members not in self.loop_pairs:
+                    nr.priority = max(top, 2)  # a bus goes in before the loose signals
+            self.bus_groups.append([nr.net for nr in mem])
+            for nr in mem:
+                nr.bus_groups_key = len(self.bus_groups)
+        for nr in nrs:
+            self.occupancy(nr.key)
+        blocked_pins = []
+        for nr in nrs:
+            for isl in nr.islands:
+                for p in isl:
+                    if not self.lanes(nr, p):
+                        blocked_pins.append({"net": nr.net, "pin": _name(p), "at": _at(xy(p.GetPosition()))})
+        self._doorsteps(nrs)
+        self._escape_strips(nrs)
+        self.nrs = nrs  # for take_out() after the caller's DRC
+        timings["check"] = round(time.perf_counter() - t_start, 1)
+        if log:
+            log({"phase": "check", "nets": len(nrs), "pins_without_a_way_out": len(blocked_pins)})
+        # 2. negotiate: every net routed, the overlapping joins routed again at a rising price
+        t1 = time.perf_counter()
+        deadline_all = time.time() + self.time_budget * 0.7
+        # seed (the bench's noise runs): loose nets of a priority come in a shuffled order (their
+        # length jittered by up to 15 %), to see how much a result owes to the order alone
+        rng = random.Random(self.seed) if self.seed is not None else None
+        jit = {nr.net: (1.0 + 0.3 * (rng.random() - 0.5)) if rng else 1.0 for nr in sorted(nrs, key=lambda n: n.net)}
+        order = sorted(nrs, key=lambda n: (-n.priority, GROUP_ORDER.index(n.group),
+                                           (0, n.bus_groups_key, n.bus_rank) if n.bus else (1, n.hpwl() * jit[n.net], 0)))
+        pf = self.costs.present
+        todo = {nr: None for nr in order}  # net -> branches that stay (None: route it whole)
+        rounds = 0
+        history = []
+        best_overlap, best_round = 1 << 30, 0
+        for rnd in range(self.costs.rounds):
+            rounds = rnd + 1
+            t_round = time.perf_counter()
+            for nr in order:
+                if nr not in todo or time.time() > deadline_all:
+                    continue
+                self.unstamp(nr)
+                t_net = time.perf_counter()
+                old = (nr.branches, nr.failed, nr.grid_geo)
+                self.route_net(nr, pf, deadline_all, keep=todo[nr],
+                               weight=min(2.5, self.costs.weight * 1.2 ** rnd))
+                if self.cut and old[2] is not None:
+                    # the time ran out in this net: what it had last round stays (settle sorts
+                    # out its overlaps), rather than losing joins it had a way for
+                    nr.branches, nr.failed, nr.grid_geo = old
+                nr.seconds = round(time.perf_counter() - t_net, 2)
+                self.stamp(nr, nr.grid_geo)
+                self.routed[nr.net] = nr
+            todo = {}
+            overlapping = hot = 0
+            for nr in order:
+                if nr.grid_geo is None:
+                    continue
+                bad, cells = self._bad_branches(nr)
+                if bad:
+                    overlapping += 1
+                    hot += len(cells)
+                    for Li, i, j in cells:
+                        self.hist[Li][j, i] += self.costs.history
+                    gone = self._with_dependents(nr, bad)
+                    todo[nr] = [b for b in nr.branches if b not in gone]
+                elif any(why == "no path" for _i, why in nr.failed):
+                    todo[nr] = list(nr.branches)  # its missing joins try again while others move
+            history.append((overlapping, hot))
+            if log:
+                slow = sorted(order, key=lambda n: -getattr(n, "seconds", 0))[:5]
+                log({"phase": "negotiating", "round": rounds, "nets_overlapping": overlapping, "cells": hot,
+                     "routed_now": sum(len(n.branches) for n in order),
+                     "round_seconds": round(time.perf_counter() - t_round, 1),
+                     "slowest": [(n.net, getattr(n, "seconds", 0)) for n in slow]})
+                for n in order:
+                    n.seconds = 0
+            if not overlapping or time.time() > deadline_all:
+                break
+            # stalled: no fewer overlaps for STALL rounds (on TestPCB2 nothing changed after
+            # round 10 of 40); settle sorts out the rest
+            if overlapping < best_overlap:
+                best_overlap, best_round = overlapping, rnd
+            elif rnd - best_round >= STALL:
+                break
+            pf *= self.costs.present_growth
+        timings["negotiate"] = round(time.perf_counter() - t1, 1)
+        # 3. what still overlaps: one net at a time, its overlapping joins are routed again
+        # with the others' copper as walls; what still finds no way of its own goes
+        t2 = time.perf_counter()
+        if log:
+            log({"phase": "settling the overlaps"})
+        dropped = self._settle(order)
+        timings["settle"] = round(time.perf_counter() - t2, 1)
+        # 3b. a second look at the long ways: the negotiation pushed nets round each other, and
+        # once everyone has a place, a shorter way of its own is often free
+        t2 = time.perf_counter()
+        if log:
+            log({"phase": "a second look at long joins"})
+        self.shortened = self._second_look(order, time.time() + max(20.0, self.time_budget * 0.1))
+        timings["second_look"] = round(time.perf_counter() - t2, 1)
+        # 3c. what still has no way outside goes down to a plane layer, most important first
+        t2 = time.perf_counter()
+        if log and self.esc:
+            log({"phase": "inner layer for the joins left"})
+        self.went_down = self._escalate(order, time.time() + max(30.0, self.time_budget * 0.15))
+        timings["inner"] = round(time.perf_counter() - t2, 1)
+        # 4. shape and check exactly; a join too close to something is routed again with that
+        # spot made dear, twice at most, then it goes
+        t3 = time.perf_counter()
+        if log:
+            log({"phase": "shaping and checking the tracks"})
+        for nr in order:
+            self._shape_net(nr)
+        timings["shape"] = round(time.perf_counter() - t3, 1)
+        t4 = time.perf_counter()
+        repaired = 0
+        bad = self._exact(order)
+        for _round in range(2):
+            if not bad:
+                break
+            changed = set()
+            for nr in order:
+                mine = [b for b in nr.branches if b in bad]
+                if not mine:
+                    continue
+                if self.nudge:
+                    nudged = [b for b in mine if self._nudge(nr, b, bad[b])]
+                    if nudged:
+                        self._regeo(nr)
+                        changed.add(nr.net)
+                        self.nudged += len(nudged)
+                        mine = [b for b in mine if b not in nudged]
+                        if not mine:
+                            continue
+                self._avoid(nr, [it for b in mine for it, _o in bad[b]])
+                gone = self._with_dependents(nr, mine)
+                old = (list(nr.branches), list(nr.failed))
+                self.unstamp(nr)
+                self.route_net(nr, 1e4, None, keep=[b for b in nr.branches if b not in gone])
+                self.stamp(nr, nr.grid_geo)
+                self._drop_overlapping(nr, "too close to other copper; no other way")
+                if len(nr.branches) < len(old[0]) - len(gone):
+                    # the repair lost more than the joins it was for (+3V3 on TestPCB2: one join
+                    # too close, seven gone): keep the rest as they were, drop only those
+                    self.unstamp(nr)
+                    nr.branches = [b for b in old[0] if b not in gone]
+                    nr.failed = old[1] + [(b.island, "too close to other copper; no other way") for b in gone]
+                    nr.grid_geo = self._grid_geo(nr)
+                    self.stamp(nr, nr.grid_geo)
+                self._shape_net(nr)
+                changed.add(nr.net)
+                repaired += 1
+            # only the rerouted nets' copper is new: check it against everything
+            bad = self._exact(order, only=changed)
+        removed = self._drop(order, bad)
+        timings["exact"] = round(time.perf_counter() - t4, 1)
+        items = self._commit(order)
+        timings["total"] = round(time.perf_counter() - t_start, 1)
+        return self._report(nrs, blocked_pins, rounds, history, dropped, {"rerouted": repaired, "removed": removed, "nudged": self.nudged},
+                            timings, items)
+
+    def _settle(self, order):
+        """After the rounds, the least important overlapping net first (then the one with the
+        most overlap): its overlapping joins are routed again with every other net's copper as a
+        wall (a price no way pays if it has a choice); joins that still overlap go. Each step
+        leaves one more net clear, and the ones that keep their way are the important ones."""
+        dropped = 0
+        for _ in range(2 * len(order)):
+            worst, worst_k = None, None
+            for nr in order:
+                if nr.grid_geo is None:
+                    continue
+                bad, cells = self._bad_branches(nr)
+                if cells and (worst_k is None or (nr.priority, -len(cells)) < worst_k):
+                    worst, worst_k, worst_bad = nr, (nr.priority, -len(cells)), bad
+            if worst is None:
+                break
+            gone = self._with_dependents(worst, worst_bad)
+            self.unstamp(worst)
+            self.route_net(worst, 1e4, None, keep=[b for b in worst.branches if b not in gone])
+            self.stamp(worst, worst.grid_geo)
+            dropped += self._drop_overlapping(worst, "crowded: no way of its own after negotiating")
+        return dropped
+
+    def _escalate(self, order, deadline):
+        """Nets with joins left open that may go inner (may_go_inner): routed once more with the
+        plane layers open to them, at `costs.escalated` per mm there and with the others' copper
+        as walls. The plane is closed under switch-node copper. A net that gains no join stays
+        as it was; the plane layers then stay closed to it. Returns the joins gained."""
+        if not self.esc:
+            return 0
+        gained = 0
+        for nr in sorted(order, key=lambda n: -n.priority):
+            if time.time() > deadline:
+                break
+            if not nr.failed or not nr.may_inner:
+                continue
+            old = (list(nr.branches), list(nr.failed), nr.grid_geo, dict(nr.hopeless), set(nr.searched))
+            nr.inner = True
+            nr.hopeless.clear()  # the detour limit was the outer layers'
+            nr.searched.clear()
+            nr.nodes_used.clear()
+            self.unstamp(nr)
+            self.route_net(nr, 1e4, deadline, keep=list(nr.branches))
+            self.stamp(nr, nr.grid_geo)
+            self._drop_overlapping(nr, "crowded: no way of its own after negotiating")
+            if self.cut or len(nr.branches) <= len(old[0]):
+                self.unstamp(nr)
+                nr.branches, nr.failed, nr.grid_geo, nr.hopeless, nr.searched = old
+                nr.inner = False
+                self.stamp(nr, nr.grid_geo)
+            else:
+                gained += len(nr.branches) - len(old[0])
+        return gained
+
+    def _length(self, b):
+        geo = b.grid_geo
+        return (sum(math.dist(p, q) for _L, pts in geo["pieces"] for p, q in zip(pts, pts[1:]))
+                + sum(math.dist(s[1], s[2]) for s in geo["stubs"]))
+
+    def _long(self, b):
+        """A join much longer than the way it spans (check_routing's detour limit)."""
+        if getattr(b, "direct", None) or b.grid_geo is None:
+            return False
+        a = b.start.centre
+        e = b.end.centre if b.end is not None else self.rb.grid.at(b.path[-1][0], b.path[-1][1])
+        return self._length(b) > DETOUR_LIMIT[0] * math.dist(a, e) + DETOUR_LIMIT[1]
+
+    def _second_look(self, order, deadline):
+        """Each long join (with the joins made onto it) is routed again with the others'
+        copper as walls, without the history of cells fought over and a less greedy search.
+        The new way stays only if it is shorter, joins no fewer islands and overlaps nothing."""
+        shortened = 0
+        self.use_hist = False
+        try:
+            for nr in order:
+                for b in list(nr.branches):
+                    if time.time() > deadline:
+                        return shortened
+                    if b not in nr.branches or not self._long(b):
+                        continue
+                    gone = self._with_dependents(nr, [b])
+                    old = (nr.branches, nr.failed, nr.grid_geo)
+                    old_len = sum(self._length(x) for x in gone)
+                    old_open = len(nr.failed)
+                    nr.nodes_used.clear()
+                    self.unstamp(nr)
+                    self.route_net(nr, 1e4, deadline, keep=[x for x in nr.branches if x not in gone],
+                                   weight=1.0)
+                    new = [x for x in nr.branches if x not in old[0]]
+                    ok = (not self.cut and len(nr.failed) <= old_open
+                          and sum(self._length(x) for x in new) < old_len - 0.5)
+                    if ok:
+                        self.stamp(nr, nr.grid_geo)
+                        if self._bad_branches(nr)[0]:
+                            self.unstamp(nr)
+                            ok = False
+                    if ok:
+                        shortened += 1
+                    else:
+                        nr.branches, nr.failed, nr.grid_geo = old
+                        self.stamp(nr, nr.grid_geo)
+            return shortened
+        finally:
+            self.use_hist = True
+
+    def _drop_overlapping(self, nr, why):
+        """Take out the net's branches that still sit in another net's copper."""
+        bad, cells = self._bad_branches(nr)
+        if not bad:
+            return 0
+        gone = self._with_dependents(nr, bad)
+        if self.diag is not None:
+            # for the bench: whose copper the dropped joins sat in, at what priority
+            occ = self.occ[nr.key]
+            owners = {}
+            for Li, i, j in cells:
+                for other, (tl, _vp) in occ.stamps.items():
+                    if other != nr.net and tl[Li] is not None and tl[Li].covers(i, j):
+                        owners[other] = owners.get(other, 0) + 1
+            prio = {n.net: n.priority for n in self.routed.values()}
+            self.diag.append({"dropped": nr.net, "priority": nr.priority, "joins": len(gone), "why": why,
+                              "pin": _name(next(iter(gone)).island[0]),
+                              "in": sorted(((o, prio.get(o), c) for o, c in owners.items()), key=lambda x: -x[2])[:5]})
+        for b in gone:
+            nr.failed.append((b.island, why))
+        nr.branches = [b for b in nr.branches if b not in gone]
+        self.unstamp(nr)
+        nr.grid_geo = self._grid_geo(nr)
+        self.stamp(nr, nr.grid_geo)
+        return len(gone)
+
+    # --- shaping ---------------------------------------------------------------------------------
+    def _clear_fn(self, nr):
+        """clear(layer, points): whether a centre line there is free for `nr`. Each sample
+        point's four surrounding cells must all be free: a cell is free when its centre keeps
+        the clearance, and a point between centres is only safe when every corner is."""
+        rb, g = self.rb, self.rb.grid
+        blocked = self._blocked_fn(nr)
+        occ = self.occ[nr.key]
+        own_t = occ.stamps.get(nr.net, ([None] * len(rb.layers), None))[0]
+        mag = getattr(self, "under_magnetics", None)
+        p = g.pitch
+
+        def free(Li, i, j):
+            if not g.inside(i, j) or blocked(Li, i, j):
+                return False
+            own = 1 if own_t[Li] is not None and own_t[Li].covers(i, j) else 0
+            if occ.t[Li][j, i] > own:
+                return False
+            if Li in self.esc and (not nr.inner or self.esc_block[Li][j, i]):
+                return False
+            return mag is None or not mag[j, i]
+
+        def clear(Li, pts):
+            seen = set()
+            for a, b in zip(pts, pts[1:]):
+                n = max(1, int(math.dist(a, b) / (p * 0.5)))
+                for s in range(n + 1):
+                    x = (a[0] + (b[0] - a[0]) * s / n - g.x0) / p
+                    y = (a[1] + (b[1] - a[1]) * s / n - g.y0) / p
+                    i0, j0 = int(math.floor(x + 1e-9)), int(math.floor(y + 1e-9))
+                    on_i, on_j = abs(x - round(x)) < 1e-6, abs(y - round(y)) < 1e-6
+                    for i in ((round(x),) if on_i else (i0, i0 + 1)):
+                        for j in ((round(y),) if on_j else (j0, j0 + 1)):
+                            if (i, j) in seen:
+                                continue
+                            seen.add((i, j))
+                            if not free(Li, int(i), int(j)):
+                                return False
+            return True
+        return clear
+
+    def _shape_branch(self, nr, b, keeps, clear, plain=False):
+        g = self.rb.grid
+        if getattr(b, "direct", None):
+            return {"pieces": [(b.start.layer, shape.tidy(b.direct))], "vias": [], "stubs": []}
+        pcs, vias, dirs = shape.pieces(b.path, g)
+        out = []
+        for k, (L, pts) in enumerate(pcs):
+            kp = [p for (KL, p) in keeps.get(b, []) if KL == L]
+            pts = _insert(pts, kp)
+            if not plain:
+                keep_idx = [m for m, p in enumerate(pts) if p in kp]
+                first = dirs[k][0] if k == 0 else None
+                last = dirs[k][1] if k == len(pcs) - 1 and b.end is not None else None
+                before = b.start.centre if k == 0 else None
+                after = b.end.centre if (k == len(pcs) - 1 and b.end is not None) else None
+                cl = lambda poly, L=L: clear(L, poly)  # noqa: E731
+                pts = shape.straighten(pts, cl, first, last, keep_idx, before, after)
+                pts = shape.chamfers(pts, cl)
+            out.append((L, pts))
+        start = b.start.anchor
+        if b.end is not None:
+            end = b.end.anchor
+        else:
+            host = b.host.geo if b.host is not None else None
+            end = _nearest_on(host, out[-1][0], out[-1][1][-1]) if host else out[-1][1][-1]
+        out, vias = shape.fit_runs(out, list(vias), start, end)
+        # the lane: pad centre -> exit along the pad's axis (a stub lane is drawn on its own)
+        if not b.start.stub:
+            L0, p0 = out[0]
+            out[0] = (L0, shape.corners([b.start.centre] + p0))
+        if b.end is not None and not b.end.stub:
+            L1, p1 = out[-1]
+            out[-1] = (L1, shape.corners(p1 + [b.end.centre]))
+        if not plain:
+            # the turn after a lane slides back along the pad's axis where the run after it can
+            # start from there: no hook past the turn or V under it at the lane's exit
+            L0, p0 = out[0]
+            if not b.start.stub:
+                out[0] = (L0, _lane_turn(p0, b.start.pad, self.rb.layers[L0], lambda poly, L=L0: clear(L, poly)))
+            L1, p1 = out[-1]
+            if b.end is not None and not b.end.stub:
+                out[-1] = (L1, _lane_turn(p1[::-1], b.end.pad, self.rb.layers[L1],
+                                          lambda poly, L=L1: clear(L, poly))[::-1])
+        out = [(L, shape.despike(pts, None if plain else (lambda poly, L=L: clear(L, poly)))) for L, pts in out]
+        if not plain:
+            # a spike taken out can leave a square corner: chamfer it
+            out = [(L, shape.chamfers(pts, lambda poly, L=L: clear(L, poly))) for L, pts in out]
+        out = [(L, shape.tidy(pts)) for L, pts in out]
+        stubs = []
+        for lane in (b.start, b.end):
+            if lane is not None and lane.stub:
+                stubs.append([lane.layer, lane.centre, lane.exit, lane.width or nr.key.w])
+        if (len(stubs) == 2 and not vias and len(out) == 1 and stubs[0][0] == stubs[1][0]
+                and shape.length(out[0][1]) < 0.05 and not keeps.get(b)):
+            # two pads facing each other: their lanes meet, and the track between the exits is
+            # a sliver whose direction is noise (a 170 degree "corner"). The stubs meet halfway
+            a, e = stubs[0][2], stubs[1][2]
+            m = ((a[0] + e[0]) / 2, (a[1] + e[1]) / 2)
+            stubs[0][2] = stubs[1][2] = m
+            out = []
+        return {"pieces": out, "vias": vias, "stubs": [tuple(s) for s in stubs]}
+
+    def _shape_net(self, nr):
+        """Shape every join of the net; a shaped join that the exact check finds too close to
+        the fixed copper falls back to the search's own corners (anchored only)."""
+        g = self.rb.grid
+        if not nr.branches:
+            self.unstamp(nr)
+            nr.final_geo = {"pieces": [], "vias": [], "stubs": []}
+            self.stamp(nr, nr.final_geo)
+            return
+        clear = self._clear_fn(nr)
+        keeps = {}
+        for b in nr.branches:
+            if b.host is not None:
+                e = b.path[-1]
+                keeps.setdefault(b.host, []).append((e[2], g.at(e[0], e[1])))
+        for b in nr.branches:
+            b.geo = None
+        for b in nr.branches:
+            b.geo = self._shape_branch(nr, b, keeps, clear)
+            if self._fixed_hits(nr, b):
+                b.geo = self._shape_branch(nr, b, keeps, clear, plain=True)
+                self.plain += 1
+        self.unstamp(nr)
+        nr.final_geo = {"pieces": [p for b in nr.branches for p in b.geo["pieces"]],
+                        "vias": [v for b in nr.branches for v in b.geo["vias"]],
+                        "stubs": [s for b in nr.branches for s in b.geo["stubs"]]}
+        self.stamp(nr, nr.final_geo)
+
+    def _nudge(self, nr, b, hits):
+        """A track a few microns too close to fixed copper (the grid's rounding, a run anchored
+        on a pad's axis) is moved straight away by the shortfall, both its ends with it, before
+        any reroute. On TestPCB2 a +3V3 trunk under U4 came 0.011 mm too close to a pin; the
+        repair found no other way and the eight joins hanging on it went. A piece's end moves
+        with everything of the branch at that point (a stub's end, a via and the other layer's
+        piece); one that ends on another branch's track (a T) stays inside its copper, the move
+        being under half a track's width. Never a pad's centre. The branch must then be clear
+        of the fixed copper."""
+        if b.geo is None or not hits:
+            return False
+        rb = self.rb
+        fixed = getattr(self, "_fixed_ids", None)
+        if fixed is None:
+            fixed = self._fixed_ids = {id(x) for x in rb.fixed}
+        old = [(Li, list(pts)) for Li, pts in b.geo["pieces"]]
+        old_stubs = list(b.geo["stubs"])
+        old_vias = list(b.geo["vias"])
+        pieces = [(Li, list(pts)) for Li, pts in old]
+        stubs = list(old_stubs)
+        vias = list(old_vias)
+        pad_pts = [xy(q.GetPosition()) for q in rb.pads_of.get(nr.net, [])]
+
+        def no(why):
+            if self.debug is not None:
+                self.debug.append({"nudge": "declined", "why": why, "net": nr.net})
+            return False
+
+        def near(u, v):
+            return math.dist(u, v) < 1e-4
+        for it, h in hits:
+            if h is None or id(h) not in fixed or it.Type() == pcbnew.PCB_VIA_T:
+                return no("not a track against fixed copper")
+            key = self._item_key(nr, it)
+            d = self._deficit(nr, it, h, {id(it): key}, "Track")
+            short = d["need"] - d["gap"] if "need" in d else None
+            if short is None or short <= 0 or short > NUDGE_MAX:
+                return no(f"shortfall {short}")
+            a, c = (T(it.GetStart().x), T(it.GetStart().y)), (T(it.GetEnd().x), T(it.GetEnd().y))
+            where = None
+            for pi, (Li, pts) in enumerate(pieces):
+                for k in range(len(pts) - 1):
+                    if (near(pts[k], a) and near(pts[k + 1], c)) or (near(pts[k], c) and near(pts[k + 1], a)):
+                        where = (pi, k)
+            if where is None:
+                return no("segment not in the branch's pieces (a stub?)")
+            pi, k = where
+            Li, pts = pieces[pi]
+            p, q = pts[k], pts[k + 1]
+            ends = []
+            for idx, pt in ((k, p), (k + 1, q)):
+                if 0 < idx < len(pts) - 1:
+                    continue
+                if any(near(pt, c0) for c0 in pad_pts):
+                    return no("piece end on a pad's centre")
+                ends.append(pt)
+            if ends and short + 0.005 >= nr.key.w / 2:
+                return no("too far for a joint")
+            n = math.dist(p, q)
+            nx, ny = -(q[1] - p[1]) / n, (q[0] - p[0]) / n
+            step = short + 0.005
+            done = False
+            for sgn in (1.0, -1.0):
+                p2 = (p[0] + sgn * step * nx, p[1] + sgn * step * ny)
+                q2 = (q[0] + sgn * step * nx, q[1] + sgn * step * ny)
+                t = rb.track(nr.net, rb.layers[Li], p2, q2, nr.key.w)
+                if not rb.hits(nr.net, key, t, "Track", self.fixed_idx):
+                    for pt in ends:
+                        moved = p2 if pt is p else q2
+                        for pj, (Lj, ptsj) in enumerate(pieces):
+                            pieces[pj] = (Lj, [moved if near(v, pt) else v for v in ptsj])
+                        for i, (sL, sa, sc, sw) in enumerate(stubs):
+                            stubs[i] = (sL, moved if near(sa, pt) else sa, moved if near(sc, pt) else sc, sw)
+                        vias = [moved if near(v, pt) else v for v in vias]
+                    pieces[pi][1][k], pieces[pi][1][k + 1] = p2, q2
+                    done = True
+                    break
+            if not done:
+                return no("both ways still too close")
+        b.geo["pieces"], b.geo["stubs"], b.geo["vias"] = pieces, stubs, vias
+        if self._fixed_hits(nr, b):
+            b.geo["pieces"], b.geo["stubs"], b.geo["vias"] = old, old_stubs, old_vias
+            return no("the branch hits fixed copper after the move")
+        return True
+
+    def _regeo(self, nr):
+        self.unstamp(nr)
+        nr.final_geo = {"pieces": [p for b in nr.branches for p in b.geo["pieces"]],
+                        "vias": [v for b in nr.branches for v in b.geo["vias"]],
+                        "stubs": [s for b in nr.branches for s in b.geo["stubs"]]}
+        self.stamp(nr, nr.final_geo)
+
+    def _fixed_hits(self, nr, b):
+        for it in self._items(nr, b):
+            kind = "Via" if it.Type() == pcbnew.PCB_VIA_T else "Track"
+            if self.rb.hits(nr.net, self._item_key(nr, it), it, kind, self.fixed_idx):
+                return True
+        return False
+
+    def _avoid(self, nr, items):
+        """Make the cells round the copper that came too close dear for `nr` (a repair)."""
+        rb, g = self.rb, self.rb.grid
+        if nr.avoid is None:
+            nr.avoid = [g.zeros(np.float32) for _ in rb.layers]
+        for it in items:
+            if it.Type() == pcbnew.PCB_VIA_T:
+                c = xy(it.GetPosition())
+                p = g.patch([], [(c, 0.4)])
+                layers = range(len(rb.layers))
+            else:
+                p = g.patch([([xy(it.GetStart()), xy(it.GetEnd())], 0.3)], [])
+                layers = [rb.layers.index(it.GetLayer())] if it.GetLayer() in rb.layers else []
+            if p is None:
+                continue
+            for Li in layers:
+                p.view(nr.avoid[Li])[...] += p.a * 8.0
+
+    # --- exact check and the board ----------------------------------------------------------------
+    def _item_key(self, nr, it):
+        if it.Type() != pcbnew.PCB_VIA_T and T(it.GetWidth()) < nr.key.w - 1e-6:
+            return self.rb.neck_key(nr.key, T(it.GetWidth()))
+        return nr.key
+
+    def _items(self, nr, b):
+        rb = self.rb
+        out = []
+        # a piece shorter than half the track's width lies inside its neighbours' copper: left
+        # out, it can't be a dangling end (KiCad flagged 0.03-0.14 mm +3V3 pieces on TestPCB2),
+        # and the tracks on either side still touch
+        for Li, pts in b.geo["pieces"]:
+            for a, c in zip(pts, pts[1:]):
+                if math.dist(a, c) >= max(1e-4, nr.key.w / 2):
+                    out.append(rb.track(nr.net, rb.layers[Li], a, c, nr.key.w))
+        for Li, a, c, w in b.geo["stubs"]:
+            if math.dist(a, c) >= max(1e-4, w / 2):
+                out.append(rb.track(nr.net, rb.layers[Li], a, c, w))
+        for v in b.geo["vias"]:
+            out.append(rb.via(nr.net, v, nr.key.vd, nr.key.drill))
+        return out
+
+    def _exact(self, order, only=None):
+        """Every new track and via (of the nets in `only`, if given) against the fixed copper
+        and the other nets' new copper: {branch: [(item, what it hits)]}."""
+        rb = self.rb
+        new = []
+        owner = {}
+        for nr in order:
+            for b in nr.branches:
+                b.items = self._items(nr, b)
+                for it in b.items:
+                    new.append((it, nr.net))
+                    owner[id(it)] = (nr, b)
+        idx = rb.index([(it, n) for it, n in new] + [(it, it.GetNetname()) for it in rb.fixed])
+        keys = {id(it): self._item_key(owner[id(it)][0], it) for it, _n in new}
+        key_of = lambda o: keys.get(id(o))  # noqa: E731
+        bad = {}
+        for it, net in new:
+            if only is not None and net not in only:
+                continue
+            nr, b = owner[id(it)]
+            kind = "Via" if it.Type() == pcbnew.PCB_VIA_T else "Track"
+            for h in rb.hits(net, keys[id(it)], it, kind, idx, key_of):
+                bad.setdefault(b, []).append((it, h))
+                if self.debug is not None:
+                    self.debug.append(self._deficit(nr, it, h, keys, kind))
+        return bad
+
+    def _deficit(self, nr, it, h, keys, kind):
+        """For diagnosis: how much closer than allowed `it` comes to `h` (mm)."""
+        from commands.powerlab_router2.board import grown
+        rb = self.rb
+        if h is None:
+            return {"what": "edge", "net": nr.net}
+        L = next((L for L in rb.layers if it.IsOnLayer(L) and h.IsOnLayer(L)), None)
+        if L is None:
+            return {"what": "other layer?", "net": nr.net}
+        okind = "Via" if h.Type() == pcbnew.PCB_VIA_T else ("Pad" if h.Type() == pcbnew.PCB_PAD_T else (
+            "Zone" if h.Type() == pcbnew.PCB_ZONE_T else "Track"))
+        if id(h) in keys:
+            need = rb.new_clearance(keys[id(it)], kind, keys[id(h)], "Via" if okind == "Via" else "Track", L)
+            src = "new"
+        else:
+            need = rb.clearance(h, keys[id(it)], kind, L)
+            src = "fixed"
+        mine = grown(it, L, 0.0)
+        if okind == "Zone":
+            return {"what": f"{src} Zone", "need": round(need, 3), "net": nr.net}
+        lo, hi = 0.0, need
+        for _ in range(12):
+            mid = (lo + hi) / 2
+            if mine.Collide(grown(h, L, mid)):
+                hi = mid
+            else:
+                lo = mid
+        return {"what": f"{src} {okind}", "need": round(need, 3), "gap": round(lo, 3), "net": nr.net,
+                "other": h.GetNetname(), "kind": kind,
+                "at": [round(T(it.GetPosition().x), 2), round(T(it.GetPosition().y), 2)] if kind == "Via" else
+                [round(T(it.GetStart().x), 2), round(T(it.GetStart().y), 2), round(T(it.GetEnd().x), 2),
+                 round(T(it.GetEnd().y), 2)]}
+
+    def _drop(self, order, bad):
+        """Joins still too close go, with the joins made through them."""
+        removed = 0
+        for nr in order:
+            mine = [b for b in nr.branches if b in bad]
+            if not mine:
+                continue
+            gone = self._with_dependents(nr, mine)
+            keep = []
+            for b in nr.branches:
+                if b in gone:
+                    first = bad[b][0][1] if b in bad else None
+                    what = "the board edge" if b in bad and first is None else (
+                        _what(first) if b in bad else "a join it hangs on")
+                    nr.failed.append((b.island, f"too close to {what}"))
+                    removed += 1
+                else:
+                    keep.append(b)
+            nr.branches = keep
+        return removed
+
+    def _commit(self, order):
+        n = 0
+        for nr in order:
+            for b in nr.branches:
+                for it in b.items:
+                    self.board.Add(it)
+                    n += 1
+        return n
+
+    # --- after DRC -------------------------------------------------------------------------------
+    def take_out(self, uuids=(), starved=(), why="a new DRC error", reach=None, trial=None):
+        """kicad-cli DRC has the last word: joins whose copper is in a new DRC error go, with
+        the joins hanging on them, from the board too.
+
+        uuids: items named in new violations (only the router's own count). starved: pads
+        (pcbnew) whose thermal spokes found no room; the other nets' new copper across a spoke's
+        line goes (the exact check can't see spokes: KiCad draws them when it fills), or, when
+        nothing new crosses one, the new copper within a spoke's reach of the pad. `reach` (mm):
+        the new copper within that much of the pad goes, for a pad still starved after a round
+        (a track a few mm off can cut the pour round the pad into an island KiCad drops, and
+        the spoke then has nothing to reach). `trial`: a key under which the joins taken out are
+        kept, so untake() can put them back when the pad stays starved anyway. Returns the
+        report's `left` entries for the joins taken out."""
+        uuids = set(uuids)
+        rb = self.rb
+        lines, boxes = [], []  # (net, layer, a, b): a spoke's line; (net, box): its reach
+        for pad in starved:
+            c = xy(pad.GetPosition())
+            for L in rb.all_layers:
+                if not pad.IsOnLayer(L):
+                    continue
+                try:
+                    ax = rb.axis(pad, L)
+                    pts = [q for o, _h in polys(grown(pad, L, 0.0)) for q in o]
+                except Exception:
+                    continue
+                for a in ([45.0 + 90.0 * k for k in range(4)] if ax is None else [ax + 90.0 * k for k in range(4)]):
+                    u = (math.cos(math.radians(a)), math.sin(math.radians(a)))
+                    ext = max((q[0] - c[0]) * u[0] + (q[1] - c[1]) * u[1] for q in pts)
+                    lines.append((pad.GetNetname(), L, c, (c[0] + u[0] * (ext + SPOKE_REACH),
+                                                           c[1] + u[1] * (ext + SPOKE_REACH))))
+            bb = pad.GetBoundingBox()
+            r = reach if reach is not None else SPOKE_REACH + 0.5
+            boxes.append((pad.GetNetname(), (T(bb.GetLeft()) - r, T(bb.GetTop()) - r,
+                                             T(bb.GetRight()) + r, T(bb.GetBottom()) + r)))
+
+        def across(net, it):
+            """`it` crosses a spoke line of a starved pad of another net."""
+            if it.Type() == pcbnew.PCB_VIA_T:
+                p, rad = xy(it.GetPosition()), _via_radius(it)
+                return any(n != net and _seg_dist(p, p, a, b) < SPOKE_HALF + rad - 0.075 for n, _L, a, b in lines)
+            s, e, w = xy(it.GetStart()), xy(it.GetEnd()), T(it.GetWidth())
+            return any(n != net and L == it.GetLayer() and _seg_dist(s, e, a, b) < SPOKE_HALF + (w - 0.15) / 2
+                       for n, L, a, b in lines)
+
+        def near(net, it):
+            ib = it.GetBoundingBox()
+            return any(n != net and T(ib.GetRight()) >= x0 and T(ib.GetLeft()) <= x1 and T(ib.GetBottom()) >= y0
+                       and T(ib.GetTop()) <= y1 for n, (x0, y0, x1, y1) in boxes)
+
+        nrs = getattr(self, "nrs", [])
+        test = across
+        if reach is not None or starved and not any(across(nr.net, it) for nr in nrs for b in nr.branches for it in getattr(b, "items", [])):
+            test = near
+
+        def hits(nr, it):
+            return uuid(it) in uuids or (bool(starved) and test(nr.net, it))
+
+        only = None
+        if reach is not None and starved:
+            # still starved: only the join nearest the pad within `reach` goes (with what hangs
+            # on it; at the same distance the one with fewer joins on it): the whole box cost
+            # +1V2_MCU's tree of five on TestPCB2
+            centres = [(pad.GetNetname(), xy(pad.GetPosition())) for pad in starved]
+            best = None
+            for nr in nrs:
+                for b in nr.branches:
+                    its = [it for it in getattr(b, "items", None) or [] if near(nr.net, it)]
+                    if not its:
+                        continue
+                    d = min(_seg_dist(xy(it.GetStart()), xy(it.GetEnd()), c, c) if it.Type() != pcbnew.PCB_VIA_T
+                            else math.dist(xy(it.GetPosition()), c) for it in its for n, c in centres if n != nr.net)
+                    rank = (round(d * 2) / 2, len(self._with_dependents(nr, [b])))
+                    if best is None or rank < best[0]:
+                        best = (rank, b)
+            only = {best[1]} if best else set()
+
+        left = []
+        for nr in nrs:
+            if only is not None:
+                mine = [b for b in nr.branches if b in only]
+            else:
+                mine = [b for b in nr.branches if any(hits(nr, it) for it in getattr(b, "items", None) or [])]
+            if not mine:
+                continue
+            gone = self._with_dependents(nr, mine)
+            for b in gone:
+                for it in b.items:
+                    self.board.Remove(it)
+                reason = why if b in mine else "a join it hangs on was taken out"
+                failed = (b.island, reason)
+                nr.failed.append(failed)
+                p = b.island[0]
+                entry = {"net": nr.net, "pin": _name(p), "reason": reason, "at": _at(xy(p.GetPosition()))}
+                left.append(entry)
+                if trial is not None:
+                    self.trials.setdefault(trial, []).append((nr, b, failed, entry))
+            nr.branches = [b for b in nr.branches if b not in gone]
+        return left
+
+    # --- pours after routing ---------------------------------------------------------------------
+    def _pour_pieces(self, min_area=1.0):
+        """Fill the zones; the pour nets' filled pieces on the routed layers beyond the largest
+        of each zone, at least `min_area` mm2 (slivers between parallel tracks don't count):
+        [(layer, area mm2, outline)]. A track that closes a ring with others or the edge cuts
+        the plane into pieces; the search's costs only see length, not the cut."""
+        pcbnew.ZONE_FILLER(self.board).Fill(self.board.Zones())
+        out = []
+        for z in self.board.Zones():
+            if z.GetIsRuleArea() or z.GetNetname() not in self.rb.pour_nets:
+                continue
+            for L in self.rb.layers:
+                if not z.IsOnLayer(L):
+                    continue
+                f = z.GetFilledPolysList(L)
+                pieces = sorted(((abs(f.Outline(i).Area()) / 1e12, f.Outline(i).Clone())
+                                 for i in range(f.OutlineCount())), key=lambda p: -p[0])
+                out += [(L, a, o) for a, o in pieces[1:] if a >= min_area]
+        return out
+
+    def _bounding(self, L, outline, reach=0.4):
+        """The router's joins with a track on L within `reach` mm of a piece's outline."""
+        r = int(pcbnew.FromMM(reach))
+        found = []
+        for nr in getattr(self, "nrs", []):
+            for b in nr.branches:
+                for it in getattr(b, "items", None) or []:
+                    if it.Type() == pcbnew.PCB_VIA_T or it.GetLayer() != L:
+                        continue
+                    if outline.Collide(pcbnew.SEG(it.GetStart(), it.GetEnd()), r):
+                        found.append((nr, b))
+                        break
+        return found
+
+    def repair_pours(self, deadline, factor=6.0):
+        """Joins whose tracks bound a cut-off piece of a pour are routed again, all of that
+        piece's at once (a piece is mostly closed by several nets: moving one of them never
+        joined it back), with that layer `factor` times dearer per mm and the other nets as
+        walls. Kept only if every new way is clear (exact check), no join is lost and less of
+        the pour is cut off; else the old copper goes back. Returns how many joins moved."""
+        moved = 0
+        why = self.repair_why = {}
+
+        def note(k):
+            why[k] = why.get(k, 0) + 1
+        def per_layer(ps):
+            d = {}
+            for L, x, _o in ps:
+                d[L] = d.get(L, 0.0) + x
+            return d
+        pieces = self._pour_pieces()
+        cut = sum(a for _L, a, _o in pieces)
+        layers_cut = per_layer(pieces)
+        why["cut_off_mm2_before"] = {self.rb.layer_names[L]: round(x, 1) for L, x in layers_cut.items()}
+        tried = set()
+        while time.time() < deadline:
+            todo = [(L, a, o) for L, a, o in sorted(pieces, key=lambda p: -p[1])
+                    if (L, round(a, 1)) not in tried]
+            if not todo:
+                break
+            L, a, o = todo[0]
+            tried.add((L, round(a, 1)))
+            group = self._bounding(L, o)
+            if not group:
+                note("no join of the router's bounds it")
+                continue
+            ok, undo = self._reroute_group(group, L, factor, deadline)
+            if ok is False and undo == "overlaps" and len({id(nr) for nr, _b in group}) > 1:
+                # the first net routed again took the room the next one needed: the other order
+                note("overlaps, tried the other order")
+                ok, undo = self._reroute_group(group[::-1], L, factor, deadline)
+            if not ok:
+                note(ok is None and "out of time" or undo)
+                continue
+            after = self._pour_pieces()
+            cut_after = sum(x for _L, x, _o in after)
+            layers_after = per_layer(after)
+            # no pour is traded for another: on TestPCB2 the moved tracks went to the top,
+            # also a GND pour, and cut it there (7 -> 10 pieces) while the total fell
+            worse = [M for M in set(layers_after) | set(layers_cut)
+                     if layers_after.get(M, 0.0) > layers_cut.get(M, 0.0) + 0.5]
+            if cut_after < cut - 0.5 and not worse:
+                pieces, cut, layers_cut = after, cut_after, layers_after
+                moved += len(group)
+                tried = set()  # the pieces moved: look again
+                continue
+            note("cuts another pour" if worse else "no less cut off")
+            undo()
+            pieces = self._pour_pieces()
+        why["cut_off_mm2_after"] = {self.rb.layer_names[L]: round(x, 1) for L, x in layers_cut.items()}
+        return moved
+
+    def _reroute_group(self, group, L, factor, deadline):
+        """Route the joins of `group` again with layer L `factor` times dearer, the rest as
+        walls, and put them on the board. Returns (True, undo) or (False, why)."""
+        Li = self.rb.layers.index(L)
+        nets = {}
+        for nr, b in group:
+            nets.setdefault(id(nr), (nr, []))[1].append(b)
+        saved = []
+        for nr, bs in nets.values():
+            saved.append((nr, list(nr.branches), list(nr.failed), nr.grid_geo, nr.final_geo,
+                          {id(x): x.items for x in nr.branches}, self._with_dependents(nr, bs)))
+
+        added = []  # the new copper put on the board (only once everything is clear)
+
+        def undo():
+            for it in added:
+                self.board.Remove(it)
+            added.clear()
+            for nr, br, fl, gg, fg, items, gone in saved:
+                self.unstamp(nr)
+                nr.branches, nr.failed, nr.grid_geo, nr.final_geo = br, fl, gg, fg
+                for x in nr.branches:
+                    x.items = items[id(x)]
+                for x in gone:
+                    for it in x.items:
+                        self.board.Add(it)
+                self.stamp(nr, nr.final_geo or nr.grid_geo)
+
+        # take the old copper off first, so the joins of the group can use each other's room
+        for nr, br, fl, gg, fg, items, gone in saved:
+            for x in gone:
+                for it in x.items:
+                    self.board.Remove(it)
+            self.unstamp(nr)
+            nr.branches = [x for x in nr.branches if x not in gone]
+            nr.grid_geo = self._grid_geo(nr)
+            self.stamp(nr, nr.grid_geo)
+        lf = self.lf[Li]
+        self.lf[Li] = lf * factor
+        why = ""
+        try:
+            for nr, br, fl, gg, fg, items, gone in saved:
+                open_before = len(fl)
+                self.unstamp(nr)
+                nr.nodes_used.clear()
+                self.route_net(nr, 1e4, deadline, keep=list(nr.branches), weight=1.0)
+                self.stamp(nr, nr.grid_geo)
+                if self.cut:
+                    why = None
+                    break
+                if len(nr.failed) > open_before:
+                    why = "a join found no other way"
+                    break
+                if self._bad_branches(nr)[0]:
+                    why = "overlaps"
+                    break
+        finally:
+            self.lf[Li] = lf
+        if why != "":
+            undo()
+            return (None if why is None else False), why
+        nrs = getattr(self, "nrs", [])
+        new = {}
+        for nr, br, fl, gg, fg, items, gone in saved:
+            self._shape_net(nr)
+            new[id(nr)] = [x for x in nr.branches if id(x) not in items]
+            for x in new[id(nr)]:
+                x.items = self._items(nr, x)
+        moving = {id(nr) for nr, *_ in saved}
+        others = [(it, n.net) for n in nrs if id(n) not in moving for x in n.branches for it in x.items]
+        mine = [(it, nr.net) for nr, *_ in saved for x in nr.branches if id(x) in {id(y) for y in new[id(nr)]}
+                for it in x.items]
+        kept = [(it, nr.net) for nr, br, fl, gg, fg, items, gone in saved for x in nr.branches
+                if id(x) in items for it in x.items]
+        idx = self.rb.index(others + kept + mine + [(it, it.GetNetname()) for it in self.rb.fixed])
+        for nr, *_ in saved:
+            for x in new[id(nr)]:
+                for it in x.items:
+                    kind = "Via" if it.Type() == pcbnew.PCB_VIA_T else "Track"
+                    if [h for h in self.rb.hits(nr.net, self._item_key(nr, it), it, kind, idx) if h is not None]:
+                        undo()
+                        return False, "too close (exact check)"
+        for nr, *_ in saved:
+            for x in new[id(nr)]:
+                for it in x.items:
+                    self.board.Add(it)
+                    added.append(it)
+        return True, undo
+
+    def untake(self, trial):
+        """Put back the joins take_out(trial=...) took out; returns their `left` entries."""
+        back = []
+        for nr, b, failed, entry in self.trials.pop(trial, []):
+            for it in b.items:
+                self.board.Add(it)
+            nr.branches.append(b)
+            if failed in nr.failed:
+                nr.failed.remove(failed)
+            back.append(entry)
+        return back
+
+    # --- report ----------------------------------------------------------------------------------
+    def _report(self, nrs, blocked_pins, rounds, history, dropped, bad, timings, items):
+        joins = sum(len(nr.islands) - 1 for nr in nrs)
+        routed = sum(len(nr.branches) for nr in nrs)
+        left = []
+        for nr in nrs:
+            for isl, why in nr.failed:
+                p = isl[0]
+                left.append({"net": nr.net, "pin": _name(p), "reason": why, "at": _at(xy(p.GetPosition()))})
+        groups = {}
+        for nr in nrs:
+            gr = groups.setdefault(nr.group, {"joins": 0, "routed": 0})
+            gr["joins"] += len(nr.islands) - 1
+            gr["routed"] += len(nr.branches)
+        vias = sum(len(b.geo["vias"]) for nr in nrs for b in nr.branches if b.geo)
+        length = sum(math.dist(a, c) for nr in nrs for b in nr.branches if b.geo
+                     for _L, pts in b.geo["pieces"] for a, c in zip(pts, pts[1:]))
+        tees = sum(1 for nr in nrs for b in nr.branches if b.host is not None)
+        inner_mm = {}
+        for nr in nrs:
+            for b in nr.branches:
+                for Li, pts in (b.geo or {"pieces": []})["pieces"]:
+                    if Li in self.esc:
+                        inner_mm[nr.net] = inner_mm.get(nr.net, 0.0) + sum(math.dist(a, c) for a, c in zip(pts, pts[1:]))
+        by_priority = {}
+        for nr in nrs:
+            e = by_priority.setdefault(nr.priority, {"joins": 0, "routed": 0})
+            e["joins"] += len(nr.islands) - 1
+            e["routed"] += len(nr.branches)
+        return {
+            "connections": joins,
+            "routed": routed,
+            "left": left,
+            "pins_without_a_way_out": blocked_pins,
+            "groups": groups,
+            "by_priority": by_priority,
+            "buses": self.bus_groups,
+            "loop_joins": {nr.net: nr.loop_joins for nr in nrs if nr.loop_joins},
+            "inner": {"layers": [self.rb.layer_names[self.rb.layers[Li]] for Li in sorted(self.esc)],
+                      "joins_gained": self.went_down,
+                      "track_mm": {k: round(v, 1) for k, v in sorted(inner_mm.items())}},
+            "negotiation": {"rounds": rounds, "overlaps_per_round": [h[0] for h in history],
+                            "dropped_after": dropped,
+                            "shortened_on_second_look": self.shortened,
+                            "ways_through_others_at_first_price": self.forced},
+            "exact_check": bad,
+            "shaped_plain": self.plain,
+            "t_junctions": tees,
+            "vias": vias,
+            "track_mm": round(length, 1),
+            "searches": self.searches,
+            "nodes": self.nodes,
+            "items_added": items,
+            "layers": [self.rb.layer_names[L] for L in self.rb.layers],
+            "seconds": timings,
+            "rules_not_understood": self.rb.rules.unsupported,
+        }
+
+
+class _Net:
+    def __init__(self, net, key, islands, group):
+        self.net, self.key, self.islands, self.group = net, key, islands, group
+        self.branches, self.failed = [], []
+        self.grid_geo = None
+        self.final_geo = None
+        self.avoid = None
+        self.priority = 1  # priority_of(): who gets the room
+        self.bus = None  # the other nets of its bus (buses()), routed beside them
+        self.bus_rank = self.bus_groups_key = 0
+        self.bus_ics = set()  # the bus's two ICs
+        self.loop_joins = []  # (driver ref, FET ref): gate loops it is the return of (Router._loop_pairs)
+        self.may_inner = False  # may go down to a plane layer (the plan, else may_go_inner)
+        self.inner = False  # may use the plane layers (it went down: _escalate)
+        self.hopeless = {}  # join (pad uuids) -> why: no way within the detour limit
+        self.nodes_used = {}  # join -> search nodes its last way took
+        self.searched = set()
+
+    def hpwl(self):
+        pts = [xy(p.GetPosition()) for isl in self.islands for p in isl]
+        return (max(p[0] for p in pts) - min(p[0] for p in pts)) + (max(p[1] for p in pts) - min(p[1] for p in pts))
+
+
+def _at(p):
+    return f"kicad:at={p[0]:.2f},{p[1]:.2f}"
+
+
+LANE_TURN_REACH = 2.0  # mm of track after a lane's exit that _lane_turn may cut out
+
+
+def _lane_turn(pts, pad, layer, clear):
+    """pts starts at the pad's centre and runs along its axis to the lane's exit, then on. The
+    exit sits on the grid's nearest cell, so the run that really leaves often starts a cell
+    off it: a V down and up again, or a hook past the turn and back (sf-motion, with every
+    fine-pitch pin fanned). Here the turn moves onto the axis where a later run's line meets
+    it, cutting what lies between, if that point is outside the pad, the turn is at most 90
+    degrees and the new pieces are clear. The latest such run wins (it cuts the most)."""
+    if len(pts) < 4 or math.dist(pts[0], pts[1]) < 1e-6:
+        return pts
+    c = pts[0]
+    u = ((pts[1][0] - c[0]) / math.dist(c, pts[1]), (pts[1][1] - c[1]) / math.dist(c, pts[1]))
+    try:
+        edge = max((q[0] - c[0]) * u[0] + (q[1] - c[1]) * u[1] for o, _h in polys(grown(pad, layer, 0.0)) for q in o)
+    except Exception:
+        return pts
+    walked = 0.0
+    best = None
+    for m in range(2, len(pts) - 1):
+        walked += math.dist(pts[m - 1], pts[m])
+        if walked > LANE_TURN_REACH:
+            break
+        a, e = pts[m], pts[m + 1]
+        d = math.dist(a, e)
+        if d < 1e-6:
+            continue
+        v = ((e[0] - a[0]) / d, (e[1] - a[1]) / d)
+        if u[0] * v[0] + u[1] * v[1] < -1e-6:
+            continue  # more than a 90 degree turn
+        cr = u[0] * v[1] - u[1] * v[0]
+        if abs(cr) < 1e-9:
+            continue  # parallel to the axis: nothing to meet
+        # c + t u = a + s v
+        t = ((a[0] - c[0]) * v[1] - (a[1] - c[1]) * v[0]) / cr
+        s = ((a[0] - c[0]) * u[1] - (a[1] - c[1]) * u[0]) / cr
+        if t <= edge + 1e-3 or s >= d - 1e-6:
+            continue  # the turn would sit on the pad, or past the run's own end
+        turn = (c[0] + t * u[0], c[1] + t * u[1])
+        cand = [c, turn] + pts[m + 1:]
+        if shape.length(cand) >= shape.length(pts) - 1e-6:
+            continue
+        if clear([c, turn, pts[m + 1]]):
+            best = cand
+    return shape.corners(best) if best else pts
+
+
+def _via_radius(v):
+    for args in ((pcbnew.F_Cu,), ()):
+        try:
+            return T(v.GetWidth(*args)) / 2
+        except Exception:
+            pass
+    return 0.3
+
+
+def _seg_dist(p, q, a, b):
+    """Shortest distance between segments p-q and a-b (mm)."""
+    def to_seg(x, s, e):
+        dx, dy = e[0] - s[0], e[1] - s[1]
+        L2 = dx * dx + dy * dy
+        t = 0.0 if L2 == 0 else max(0.0, min(1.0, ((x[0] - s[0]) * dx + (x[1] - s[1]) * dy) / L2))
+        return math.dist(x, (s[0] + t * dx, s[1] + t * dy))
+
+    def cross(o, s, e):
+        return (s[0] - o[0]) * (e[1] - o[1]) - (s[1] - o[1]) * (e[0] - o[0])
+    d1, d2, d3, d4 = cross(a, b, p), cross(a, b, q), cross(p, q, a), cross(p, q, b)
+    if ((d1 > 0) != (d2 > 0)) and ((d3 > 0) != (d4 > 0)) and d1 and d2 and d3 and d4:
+        return 0.0
+    return min(to_seg(p, a, b), to_seg(q, a, b), to_seg(a, p, q), to_seg(b, p, q))
+
+
+def _what(o):
+    if o is None:
+        return "something"
+    if o.Type() == pcbnew.PCB_PAD_T:
+        return f"pad {_name(o)} ({o.GetNetname()})"
+    if o.Type() == pcbnew.PCB_ZONE_T:
+        return f"a {o.GetNetname()} zone"
+    return f"a {o.GetNetname()} {'via' if o.Type() == pcbnew.PCB_VIA_T else 'track'}"
+
+
+def _insert(pts, extra):
+    """Put the points `extra` (on the polyline's runs) into it as vertices."""
+    out = list(pts)
+    for p in extra:
+        if p in out:
+            continue
+        for k in range(len(out) - 1):
+            a, b = out[k], out[k + 1]
+            ab = math.dist(a, b)
+            if ab > 1e-9 and abs(math.dist(a, p) + math.dist(p, b) - ab) < 1e-6:
+                out.insert(k + 1, p)
+                break
+    return out
+
+
+def _nearest_on(geo, L, p):
+    best, bp = 1e18, p
+    for Li, pts in geo["pieces"]:
+        if Li != L:
+            continue
+        for a, b in zip(pts, pts[1:]):
+            ab = (b[0] - a[0], b[1] - a[1])
+            n2 = ab[0] ** 2 + ab[1] ** 2
+            t = 0.0 if n2 < 1e-12 else max(0.0, min(1.0, ((p[0] - a[0]) * ab[0] + (p[1] - a[1]) * ab[1]) / n2))
+            q = (a[0] + t * ab[0], a[1] + t * ab[1])
+            d = math.dist(p, q)
+            if d < best:
+                best, bp = d, q
+    return bp
