@@ -0,0 +1,318 @@
+"""Custom design rules (.kicad_dru) for the PowerLab router: the clearance rules, and
+the zone_connection rules (how pads join a pour: solid, thermal reliefs or none).
+
+KiCad's rule engine isn't available from Python, so this reads the forms the lab's boards
+use: Type, NetName, NetClass, Width, Reference and Layer comparisons, memberOfFootprint(),
+hasNetclass(), isPlated() and existsOnLayer(), with &&, ||, ! and parentheses, and the
+(layer ...) clause. Strings compare with KiCad's * and ? wildcards.
+
+Like KiCad, the last matching rule wins. A term this doesn't understand (e.g.
+intersectsArea) makes a condition "maybe": such a rule is applied only where it makes the
+clearance larger, so the router errs on the safe side. Rules with one are listed in
+`unsupported`, for the report.
+"""
+
+import fnmatch
+import re
+
+UNITS = {"mm": 1.0, "mil": 0.0254, "in": 25.4, "um": 0.001}
+MAYBE = None
+
+
+# --- s-expressions -------------------------------------------------------------------
+def _sexpr(text):
+    tokens = re.findall(r'\(|\)|"(?:[^"\\]|\\.)*"|[^\s()]+', text)
+    stack = [[]]
+    for tok in tokens:
+        if tok == "(":
+            stack.append([])
+        elif tok == ")":
+            done = stack.pop()
+            stack[-1].append(done)
+        elif tok.startswith('"'):
+            stack[-1].append(tok[1:-1].replace('\\"', '"'))
+        else:
+            stack[-1].append(tok)
+    return stack[0]
+
+
+def _length(text):
+    m = re.fullmatch(r"\s*(-?[0-9.]+)\s*(mm|mil|in|um)?\s*", str(text))
+    if not m:
+        raise ValueError(text)
+    return float(m.group(1)) * UNITS[m.group(2) or "mm"]
+
+
+# --- conditions ----------------------------------------------------------------------
+_TOKEN = re.compile(r"\s*(\|\||&&|==|!=|<=|>=|<|>|!|\(|\)|,|'[^']*'|[AB]\.[A-Za-z_]+|-?[0-9.]+(?:mm|mil|in|um)?|[A-Za-z_][A-Za-z_0-9]*)")
+
+
+def _tokens(text):
+    out, pos = [], 0
+    text = text.strip()
+    while pos < len(text):
+        m = _TOKEN.match(text, pos)
+        if not m or m.end() == pos:
+            raise ValueError(f"can't read {text[pos:pos + 20]!r}")
+        out.append(m.group(1))
+        pos = m.end()
+    return out
+
+
+def _and(a, b):
+    if a is False or b is False:
+        return False
+    if a is MAYBE or b is MAYBE:
+        return MAYBE
+    return True
+
+
+def _or(a, b):
+    if a is True or b is True:
+        return True
+    if a is MAYBE or b is MAYBE:
+        return MAYBE
+    return False
+
+
+def _not(a):
+    return MAYBE if a is MAYBE else not a
+
+
+def _wild(value, pattern):
+    return fnmatch.fnmatchcase(str(value), str(pattern))
+
+
+class _Parser:
+    """Compiles a condition to f(A, B, layer) -> True / False / MAYBE.
+    A and B are dicts of item properties (see `props` in model.py)."""
+
+    def __init__(self, text):
+        self.toks = _tokens(text)
+        self.i = 0
+        self.unknown = set()
+
+    def peek(self):
+        return self.toks[self.i] if self.i < len(self.toks) else None
+
+    def take(self, expect=None):
+        tok = self.peek()
+        if tok is None or (expect is not None and tok != expect):
+            raise ValueError(f"expected {expect!r}, got {tok!r}")
+        self.i += 1
+        return tok
+
+    def parse(self):
+        f = self.expr()
+        if self.peek() is not None:
+            raise ValueError(f"unexpected {self.peek()!r}")
+        return f
+
+    def expr(self):
+        f = self.conj()
+        while self.peek() == "||":
+            self.take()
+            g, h = f, self.conj()
+            f = lambda A, B, L, g=g, h=h: _or(g(A, B, L), h(A, B, L))
+        return f
+
+    def conj(self):
+        f = self.unary()
+        while self.peek() == "&&":
+            self.take()
+            g, h = f, self.unary()
+            f = lambda A, B, L, g=g, h=h: _and(g(A, B, L), h(A, B, L))
+        return f
+
+    def unary(self):
+        if self.peek() == "!":
+            self.take()
+            g = self.unary()
+            return lambda A, B, L: _not(g(A, B, L))
+        if self.peek() == "(":
+            self.take()
+            f = self.expr()
+            self.take(")")
+            return f
+        return self.term()
+
+    def operand(self):
+        tok = self.take()
+        if tok.startswith("'"):
+            v = tok[1:-1]
+            return lambda A, B, L: v
+        if re.fullmatch(r"-?[0-9.]+(?:mm|mil|in|um)?", tok):
+            v = _length(tok)
+            return lambda A, B, L: v
+        if re.fullmatch(r"[AB]\.[A-Za-z_]+", tok):
+            side, prop = tok.split(".")
+            if self.peek() == "(":
+                return self.call(side, prop)
+            return lambda A, B, L, side=side, prop=prop: (A if side == "A" else B).get(prop, MAYBE)
+        raise ValueError(f"can't read {tok!r}")
+
+    def call(self, side, name):
+        self.take("(")
+        args = []
+        while self.peek() != ")":
+            tok = self.take()
+            if tok != ",":
+                args.append(tok[1:-1] if tok.startswith("'") else tok)
+        self.take(")")
+        pick = (lambda A, B: A) if side == "A" else (lambda A, B: B)
+        if name == "memberOfFootprint":
+            pat = args[0] if args else "*"
+            return lambda A, B, L: (False if pick(A, B).get("Footprint") is None
+                                    else _wild(pick(A, B)["Footprint"], pat))
+        if name == "hasNetclass":
+            pat = args[0] if args else "*"
+            return lambda A, B, L: _wild(pick(A, B).get("NetClass", ""), pat)
+        if name == "isPlated":
+            return lambda A, B, L: bool(pick(A, B).get("Plated", False))
+        if name == "existsOnLayer":
+            pat = args[0] if args else "*"
+            return lambda A, B, L: any(_wild(x, pat) for x in pick(A, B).get("Layers", ()))
+        self.unknown.add(name)
+        return lambda A, B, L: MAYBE
+
+    def term(self):
+        left = self.operand()
+        op = self.peek()
+        if op not in ("==", "!=", "<=", ">=", "<", ">"):
+            return lambda A, B, L: MAYBE if left(A, B, L) is MAYBE else bool(left(A, B, L))
+        self.take()
+        right = self.operand()
+
+        def cmp(A, B, L):
+            a, b = left(A, B, L), right(A, B, L)
+            if a is MAYBE or b is MAYBE:
+                return MAYBE
+            if op in ("==", "!="):
+                eq = _wild(a, b) if isinstance(a, str) else a == b
+                return eq if op == "==" else not eq
+            if isinstance(a, str) or isinstance(b, str):
+                return False
+            return {"<=": a <= b, ">=": a >= b, "<": a < b, ">": a > b}[op]
+
+        return cmp
+
+
+# --- rules ---------------------------------------------------------------------------
+class Rule:
+    def __init__(self, name, condition, clearance, layer, zone_connection=None):
+        self.zone_connection = zone_connection  # "solid", "thermal_reliefs", "none" or None
+        self.name, self.clearance, self.layer, self.text = name, clearance, layer, condition or ""
+        self.condition, self.unknown, self.error = None, set(), None
+        if condition:
+            try:
+                p = _Parser(condition)
+                self.condition = p.parse()
+                self.unknown = p.unknown
+            except ValueError as e:
+                self.error = str(e)
+
+    def layer_matches(self, layer):
+        if self.layer is None:
+            return True
+        if self.layer == "outer":
+            return layer in ("F.Cu", "B.Cu")
+        if self.layer == "inner":
+            return layer not in ("F.Cu", "B.Cu")
+        return _wild(layer, self.layer)
+
+    def matches(self, a, b, layer):
+        if self.error:
+            return MAYBE
+        if self.condition is None:
+            return True
+        return _or(self.condition(a, b, layer), self.condition(b, a, layer))
+
+
+class Rules:
+    def __init__(self, rules=()):
+        self.rules = list(rules)
+
+    @classmethod
+    def load(cls, path):
+        with open(path, encoding="utf-8") as fh:
+            return cls.parse(fh.read())
+
+    @classmethod
+    def parse(cls, text):
+        rules = []
+        for node in _sexpr(text):
+            if not isinstance(node, list) or not node or node[0] != "rule":
+                continue
+            name = node[1] if len(node) > 1 else ""
+            condition, layer, clearance, severity, connection = None, None, None, None, None
+            for part in node[2:]:
+                if not isinstance(part, list) or not part:
+                    continue
+                if part[0] == "condition":
+                    condition = part[1]
+                elif part[0] == "layer":
+                    layer = part[1]
+                elif part[0] == "severity":
+                    severity = part[1]
+                elif part[0] == "constraint" and len(part) > 1 and part[1] == "clearance":
+                    for sub in part[2:]:
+                        if isinstance(sub, list) and sub and sub[0] == "min":
+                            clearance = _length(sub[1])
+                elif part[0] == "constraint" and len(part) > 2 and part[1] == "zone_connection":
+                    connection = part[2]
+            if (clearance is not None or connection is not None) and severity != "ignore":
+                rules.append(Rule(name, condition, clearance, layer, connection))
+        return cls(rules)
+
+    @property
+    def unsupported(self):
+        return [r.name for r in self.rules if (r.error or r.unknown) and r.clearance is not None]
+
+    @property
+    def uses_net_names(self):
+        return any("NetName" in r.text for r in self.rules)
+
+    def zone_connection(self, pad, zone, layer):
+        """How the pad joins the zone by the custom rules: "solid", "thermal_reliefs",
+        "none", or None when no rule says. The last matching rule wins; a rule that only
+        may match (a term this can't read) doesn't count here."""
+        for rule in reversed(self.rules):
+            if rule.zone_connection is None or not rule.layer_matches(layer):
+                continue
+            if rule.matches(pad, zone, layer) is True:
+                return rule.zone_connection
+        return None
+
+    def clearance(self, a, b, layer, default):
+        """Clearance between items a and b (property dicts) on `layer`: the last rule that
+        matches wins; rules that may match only count where they ask for more."""
+        maybe = 0.0
+        for rule in reversed(self.rules):
+            if rule.clearance is None or not rule.layer_matches(layer):
+                continue
+            m = rule.matches(a, b, layer)
+            if m is True:
+                return max(rule.clearance, maybe) if maybe else rule.clearance
+            if m is MAYBE:
+                maybe = max(maybe, rule.clearance)
+        return max(default, maybe)
+
+
+_NAME_CMP = r"[AB]\.NetName\s*(?:==|!=)\s*"
+
+
+def net_name_patterns(rules):
+    """The patterns the rules compare NetName with ('+48V_DC', 'SW_*'...): two nets that
+    match the same ones look alike to every condition. None when a rule uses NetName any
+    other way (A.NetName == B.NetName), where only the net itself will do."""
+    pats = []
+    for r in rules.rules:
+        text = r.text
+        if re.search(_NAME_CMP + r"[AB]\.NetName", text):
+            return None
+        found = re.findall(_NAME_CMP + r"'([^']*)'", text) + \
+            re.findall(r"'([^']*)'\s*(?:==|!=)\s*[AB]\.NetName", text)
+        if len(found) != text.count("NetName"):
+            return None
+        pats += found
+    return sorted(set(pats))
