+                "success": True,
+                "message": f"Deleted {len(found) - vias} track(s) and {vias} via(s) in KiCad's board",
+                "deletedCount": len(found),
+            }
+            if locked:
+                out["lockedKept"] = len(locked)
+            return out
+        except Exception as e:
+            logger.error(f"IPC delete_trace error: {e}")
+            return {"success": False, "message": "Failed to delete trace", "errorDetails": str(e)}
+
+    def _ipc_shape_payload(self, shape: Any) -> Dict[str, Any]:
+        """A board shape from KiCad's board, like the SWIG list_graphics entries."""
+        from kipy.proto.board.board_types_pb2 import BoardLayer
+
+        mm = lambda v: {"x": v.x / 1_000_000, "y": v.y / 1_000_000, "unit": "mm"}
+        out: Dict[str, Any] = {
+            "uuid": shape.id.value,
+            "type": type(shape).__name__,
+            "layer": self._normalize_ipc_layer_name(BoardLayer.Name(shape.layer)),
+        }
+        for key, attr in (("start", "start"), ("end", "end"), ("mid", "mid"), ("center", "center"),
+                          ("topLeft", "top_left"), ("bottomRight", "bottom_right")):
+            try:
+                value = getattr(shape, attr)
+            except Exception:
+                continue
+            if value is not None and hasattr(value, "x"):
+                out[key] = mm(value)
+        return out
+
+    def _ipc_text_payload(self, text: Any) -> Dict[str, Any]:
+        """A board text or text box from KiCad's board (PowerLab patch, #70), with what
+        edit_board_text can change."""
+        from kipy.board_types import BoardTextBox
+        from kipy.proto.board.board_types_pb2 import BoardLayer
+
+        mm = lambda v: {"x": v.x / 1_000_000, "y": v.y / 1_000_000, "unit": "mm"}
+        attrs = text.attributes
+        out: Dict[str, Any] = {
+            "uuid": text.id.value,
+            "type": type(text).__name__,
+            "layer": self._normalize_ipc_layer_name(BoardLayer.Name(text.layer)),
+            "text": text.value,
+            "size": attrs.size.y / 1_000_000,
+            "thickness": attrs.stroke_width / 1_000_000,
+            "angle": float(attrs.angle),
+            "mirrored": bool(attrs.mirrored),
+        }
+        if isinstance(text, BoardTextBox):
+            out["position"] = mm(text.top_left)
+            out["topLeft"] = mm(text.top_left)
+            out["bottomRight"] = mm(text.bottom_right)
+        else:
+            out["position"] = mm(text.position)
+        return out
+
+    # KiCad 10's own names for the layers the API calls F.SilkS, F.CrtYd, ...
+    _KICAD_LAYER_NAMES = {
+        "F.Silkscreen": "F.SilkS",
+        "B.Silkscreen": "B.SilkS",
+        "F.Adhesive": "F.Adhes",
+        "B.Adhesive": "B.Adhes",
+        "F.Courtyard": "F.CrtYd",
+        "B.Courtyard": "B.CrtYd",
+        "User.Drawings": "Dwgs.User",
+        "User.Comments": "Cmts.User",
+        "User.Eco1": "Eco1.User",
+        "User.Eco2": "Eco2.User",
+    }
+
+    def _ipc_board_layer(self, name: str) -> Optional[int]:
+        """BoardLayer value for a layer name in either spelling (PowerLab patch, #70)."""
+        from kipy.proto.board.board_types_pb2 import BoardLayer
+
+        name = self._KICAD_LAYER_NAMES.get(str(name), str(name))
+        try:
+            return BoardLayer.Value("BL_" + name.replace(".", "_"))
+        except ValueError:
+            return None
+
+    def _ipc_list_graphics(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """IPC handler for list_graphics (PowerLab patch, #56): KiCad's board shapes, with
+        the UUIDs delete_graphic needs in live mode. Board text and text boxes too (#70)."""
+        try:
+            board = self.ipc_board_api._get_board()
+            layer = params.get("layer")
+            graphics = [self._ipc_shape_payload(s) for s in board.get_shapes()]
+            graphics += [self._ipc_text_payload(t) for t in board.get_text()]
+            if layer:
+                wanted = self._ipc_board_layer(layer)
+                graphics = [
+                    g for g in graphics
+                    if g["layer"] == layer
+                    or (wanted is not None and self._ipc_board_layer(g["layer"]) == wanted)
+                ]
+            return {"success": True, "count": len(graphics), "graphics": graphics}
+        except Exception as e:
+            logger.error(f"IPC list_graphics error: {e}")
+            return {"success": False, "message": "Failed to list graphics", "errorDetails": str(e)}
+
+    def _ipc_delete_graphic(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """IPC handler for delete_graphic (PowerLab patch, #56): deletes the shape in KiCad's
+        board (the SWIG handler only changed the tool's own copy)."""
+        try:
+            uuid = params.get("uuid")
+            if not uuid:
+                return {"success": False, "message": "uuid is required"}
+            board = self.ipc_board_api._get_board()
+            found = [s for s in board.get_shapes() if s.id.value == uuid]
+            if not found:  # PowerLab patch (#70): board text and text boxes too
+                found = [t for t in board.get_text() if t.id.value == uuid]
+            if not found:
+                return {
+                    "success": False,
+                    "message": "Graphic not found",
+                    "errorDetails": f"KiCad's board has no graphic with uuid {uuid}; list_graphics gives "
+                                    "the current UUIDs",
+                }
+            commit = board.begin_commit()
+            try:
+                board.remove_items(found)
+                board.push_commit(commit, "Delete graphic")
+            except Exception:
+                board.drop_commit(commit)
+                raise
+            return {"success": True, "message": f"Deleted graphic {uuid} in KiCad's board", "uuid": uuid}
+        except Exception as e:
+            logger.error(f"IPC delete_graphic error: {e}")
+            return {"success": False, "message": "Failed to delete graphic", "errorDetails": str(e)}
+
+    def _ipc_edit_board_text(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """IPC handler for edit_board_text (PowerLab patch, #70): changes a board text or
+        text box in KiCad's board, in one commit."""
+        try:
+            from kipy.board_types import BoardTextBox
+            from kipy.geometry import Vector2
+
+            uuid = params.get("uuid")
+            if not uuid:
+                return {"success": False, "message": "uuid is required"}
+            board = self.ipc_board_api._get_board()
+            text = next((t for t in board.get_text() if t.id.value == uuid), None)
+            if text is None:
+                return {
+                    "success": False,
+                    "message": "Board text not found",
+                    "errorDetails": f"KiCad's board has no text with uuid {uuid}; list_graphics "
+                                    "gives the current UUIDs",
+                }
+
+            unit = params.get("unit") or (params.get("position") or {}).get("unit") or "mm"
+            scale = {"mm": 1_000_000, "inch": 25_400_000, "mil": 25_400}.get(unit, 1_000_000)
+            layer = None
+            if params.get("layer"):
+                layer = self._ipc_board_layer(params["layer"])
+                if layer is None:
+                    return {"success": False, "message": f"Unknown layer: {params['layer']}"}
+
+            if params.get("text") is not None:
+                text.value = str(params["text"])
+            if params.get("position"):
+                pos = params["position"]
+                new = Vector2.from_xy(int(float(pos["x"]) * scale), int(float(pos["y"]) * scale))
+                if isinstance(text, BoardTextBox):  # the position is its top-left corner
+                    delta = new - text.top_left
+                    text.top_left, text.bottom_right = new, text.bottom_right + delta
+                else:
+                    text.position = new
+            if layer is not None:
+                text.layer = layer
+            if params.get("size") is not None:
+                size = int(float(params["size"]) * scale)
+                text.attributes.size = Vector2.from_xy(size, size)
+            if params.get("thickness") is not None:
+                text.attributes.stroke_width = int(float(params["thickness"]) * scale)
+            if params.get("rotation") is not None:
+                text.attributes.angle = float(params["rotation"])
+            if params.get("mirrored") is not None:
+                text.attributes.mirrored = bool(params["mirrored"])
+
+            commit = board.begin_commit()
+            try:
+                board.update_items([text])
+                board.push_commit(commit, "Edit board text")
+            except Exception:
+                board.drop_commit(commit)
+                raise
+            return {
+                "success": True,
+                "message": f"Edited board text {uuid} in KiCad's board",
+                "graphic": self._ipc_text_payload(text),
+            }
+        except Exception as e:
+            logger.error(f"IPC edit_board_text error: {e}")
+            return {"success": False, "message": "Failed to edit board text", "errorDetails": str(e)}
+
+    def _ipc_clear_board_outline(self, params: Dict[str, Any]) -> Dict[str, Any]:
