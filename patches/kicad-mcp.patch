+"""route_trace and route_pad_to_pad, drawn the way a careful designer does (PowerLab patch).
+
+Tracks run at 0, 45 and 90 degrees only, corners that turn more than 45 degrees are
+chamfered, and a track leaves and enters a pad straight at its centre (utils/track45.py
+does the geometry). Both tools work offline (pcbnew, the tool's board) and live (kipy,
+KiCad's open board, in one commit), with the same geometry:
+
+- route_trace: start, end, optional waypoints. A start or end inside a pad moves to the
+  pad's centre and the track uses the pad's axes; one on the end of a track of the same
+  net and layer goes on in its direction, and a corner there that would turn more than 45
+  degrees is chamfered on both tracks. snap45: false keeps the exact geometry.
+- route_pad_to_pad: straight out of each pad along its axis, 45 degrees between. Pads on
+  different sides get a via a short way out of the start pad along its axis.
+"""
+
+import logging
+import math
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+from utils import track45
+
+logger = logging.getLogger("kicad_interface")
+
+NM = 1_000_000
+JOINT_TOL = 0.005  # mm: a point this close to a track end is on it
+VIA_GAP = 0.25  # mm between a via's ring and the pad it leaves
+
+
+def _mm(v: Any) -> float:
+    return v / NM
+
+
+def _unit_scale(spec: Dict[str, Any]) -> float:
+    return {"mm": 1.0, "mil": 0.0254, "inch": 25.4}.get(str(spec.get("unit") or "mm"), 1.0)
+
+
+def as_point(spec: Any) -> Optional[Tuple[float, float]]:
+    """(x, y) in mm from {x, y, unit} or [x, y]; None for anything else."""
+    if isinstance(spec, dict) and "x" in spec and "y" in spec:
+        k = _unit_scale(spec)
+        return (float(spec["x"]) * k, float(spec["y"]) * k)
+    if isinstance(spec, (list, tuple)) and len(spec) == 2:
+        return (float(spec[0]), float(spec[1]))
+    return None
+
+
+def waypoints_of(params: Dict[str, Any]) -> List[Any]:
+    return list(params.get("waypoints") or params.get("via_points") or [])
+
+
+def path_specs(params: Dict[str, Any]) -> Tuple[Any, List[Any], Any]:
+    """(start, waypoints, end) as given. `points` is the waypoints between start and end,
+    or, without start and end, the whole polyline (the JSON-RPC schema's form)."""
+    start, end = params.get("start"), params.get("end")
+    pts = list(params.get("points") or [])
+    if (start is None or end is None) and len(pts) >= 2:
+        return pts[0], pts[1:-1], pts[-1]
+    return start, waypoints_of(params) or pts, end
+
+
+def _snap45(params: Dict[str, Any]) -> bool:
+    v = params.get("snap45", True)
+    if isinstance(v, str):
+        return v.strip().lower() not in ("false", "0", "no", "off")
+    return v is not False
+
+
+def _pick_pad(pads: Sequence[Dict[str, Any]], pt, layer: str, net: Optional[str]):
+    """The pad on `layer` under pt (same net first, then the nearest centre)."""
+    hits = [p for p in pads if layer in p["layers"] and track45.pad_contains(p, pt[0], pt[1])
+            and (not net or p.get("net") in (net, ""))]  # never snap onto another net's pad
+    if not hits:
+        return None
+    hits.sort(key=lambda p: (bool(net) and p.get("net") != net, math.dist(pt, (p["x"], p["y"]))))
+    return hits[0]
+
+
+def _pick_joint(tracks: Sequence[Dict[str, Any]], vias: Sequence[Tuple[float, float]], pt,
+                layer: str, net: Optional[str]):
+    """A track of the net on `layer` that ends at pt, when it's the only copper there."""
+    ends = []
+    for t in tracks:
+        if t["layer"] != layer or (net and t["net"] != net):
+            continue
+        for which in ("start", "end"):
+            if math.dist(t[which], pt) <= JOINT_TOL:
+                ends.append((t, which))
+    if len(ends) != 1 or any(math.dist(v, pt) <= JOINT_TOL for v in vias):
+        return None
+    t, which = ends[0]
+    far = t["end" if which == "start" else "start"]
+    if math.dist(far, pt) < track45.EPS:
+        return None
+    return {"track": t, "which": which, "far": far, "joint": t[which]}
+
+
+def plan(points, width: float, start_pad=None, end_pad=None, start_joint=None,
+         end_joint=None, snap45: bool = True, max_chamfer: float = track45.MAX_CHAMFER):
+    """The new track's polyline, and the existing track ends to move for joint chamfers:
+    {"points": [...], "moves": [(joint, new (x, y)), ...]}."""
+    pts = [tuple(p) for p in points]
+    if not snap45:
+        return {"points": track45.cleanup(pts), "moves": []}
+    if start_joint is not None:
+        pts[0] = start_joint["joint"]
+    if end_joint is not None:
+        pts[-1] = end_joint["joint"]
+    sd = ed = None
+    if start_joint is not None:
+        sd = (pts[0][0] - start_joint["far"][0], pts[0][1] - start_joint["far"][1])
+    if end_joint is not None:
+        ed = (end_joint["far"][0] - pts[-1][0], end_joint["far"][1] - pts[-1][1])
+    poly = track45.route(pts, width, start_pad, end_pad, sd, ed, max_chamfer)
+    moves = []
+    if len(poly) >= 2 and start_joint is not None and not start_joint["track"].get("locked"):
+        keep = 0.0
+        if len(poly) == 2 and end_pad is not None:
+            keep = track45.escape_length(end_pad, track45._unit(track45._sub(poly[0], poly[1])), width)
+        jc = track45.joint_chamfer(start_joint["far"], poly[0], poly[1], max_chamfer, keep)
+        if jc:
+            moves.append((start_joint, jc["existing_end"]))
+            poly = jc["points"] + poly[1:]
+    if len(poly) >= 2 and end_joint is not None and not end_joint["track"].get("locked"):
+        keep = 0.0
+        if len(poly) == 2 and start_pad is not None:
+            keep = track45.escape_length(start_pad, track45._unit(track45._sub(poly[1], poly[0])), width)
+        jc = track45.joint_chamfer(end_joint["far"], poly[-1], poly[-2], max_chamfer, keep)
+        if jc:
+            moves.append((end_joint, jc["existing_end"]))
+            poly = poly[:-1] + list(reversed(jc["points"]))
+    poly = [(round(x, 6) + 0.0, round(y, 6) + 0.0) for x, y in track45.cleanup(poly)]
+    return {"points": poly, "moves": moves}
+
+
+def via_spot(start_pad: Dict[str, Any], toward, via_size: float):
+    """Where a via goes when the track changes side right at the start pad: straight out
+    along the pad axis that faces `toward` best, its ring VIA_GAP clear of the pad."""
+    best = None
+    d = track45._unit(track45._sub(toward, (start_pad["x"], start_pad["y"])))
+    for u, cost in track45.entry_directions(start_pad):
+        if cost >= 1.0:
+            continue
+        score = cost + 2.0 * (1.0 - (u[0] * d[0] + u[1] * d[1]))
+        if best is None or score < best[0]:
+            best = (score, u)
+    u = best[1] if best else d
+    r = track45.pad_extent(start_pad, u) + VIA_GAP + via_size / 2
+    return (round(start_pad["x"] + u[0] * r, 6) + 0.0, round(start_pad["y"] + u[1] * r, 6) + 0.0)
+
+
+def via_pad(pos, via_size: float, layers: Sequence[str]) -> Dict[str, Any]:
+    """A via as a round pad, for track45."""
+    return {"x": pos[0], "y": pos[1], "w": via_size, "h": via_size, "angle": 0.0,
+            "shape": "circle", "fine": False, "layers": list(layers)}
+
+
+def _layer_choice(a: Dict[str, Any], b: Dict[str, Any], wanted: Optional[str]):
+    """(layer for both pads, None) when they share a copper layer, else (a's, b's)."""
+    common = [l for l in a["layers"] if l in b["layers"]]
+    if wanted and wanted in common:
+        return wanted, None
+    if common:
+        for l in (a.get("side"), b.get("side"), "F.Cu", "B.Cu"):
+            if l in common:
+                return l, None
+        return common[0], None
+    la = wanted if wanted in a["layers"] else a.get("side") or a["layers"][0]
+    lb = b.get("side") if b.get("side") in b["layers"] else b["layers"][0]
+    return la, lb
+
+
+def pad_to_pad_plan(a: Dict[str, Any], b: Dict[str, Any], width: float, waypoints,
+                    layer: Optional[str], via_size: float, snap45: bool = True):
+    """Legs ([(layer, points)]) and the via position (or None) for route_pad_to_pad."""
+    la, lb = _layer_choice(a, b, layer)
+    wps = [as_point(w) for w in waypoints]
+    wps = [w for w in wps if w is not None]
+    if lb is None:
+        poly = plan([(a["x"], a["y"])] + wps + [(b["x"], b["y"])], width, a, b, snap45=snap45)["points"]
+        return [(la, poly)], None, la, None
+    toward = wps[0] if wps else (b["x"], b["y"])
+    via = via_spot(a, toward, via_size)
+    v = via_pad(via, via_size, [la, lb])
+    leg1 = plan([(a["x"], a["y"]), via], width, a, v, snap45=snap45)["points"]
+    leg2 = plan([via] + wps + [(b["x"], b["y"])], width, v, b, snap45=snap45)["points"]
+    return [(la, leg1), (lb, leg2)], via, la, lb
+
+
+# --- offline (pcbnew) -------------------------------------------------------------------
+def _fine(pad, cx, cy, pads) -> bool:
+    me = pad.m_Uuid.AsString() if hasattr(pad, "m_Uuid") else None
+    for p in pads:
+        if p is pad or (me and p.m_Uuid.AsString() == me):
+            continue
+        q = p.GetPosition()
+        if 1e-3 < math.hypot(_mm(q.x) - cx, _mm(q.y) - cy) < track45.FINE_PITCH:
+            return True
+    return False
+
+
+def swig_pad(board, pad) -> Dict[str, Any]:
+    """A pcbnew pad as a track45 pad dict."""
+    import pcbnew
+
+    pos = pad.GetPosition()
+    cx, cy = _mm(pos.x), _mm(pos.y)
+    layers = [board.GetLayerName(l) for l in pad.GetLayerSet().CuStack() if board.IsLayerEnabled(l)]
+    probe = pcbnew.F_Cu if pad.IsOnLayer(pcbnew.F_Cu) else pcbnew.B_Cu
+    try:
+        size = pad.GetSize(probe)
+        shape = pad.GetShape(probe)
+    except TypeError:
+        size, shape = pad.GetSize(), pad.GetShape()
+    shapes = {
+        getattr(pcbnew, "PAD_SHAPE_CIRCLE", -1): "circle",
+        getattr(pcbnew, "PAD_SHAPE_OVAL", -2): "oval",
+        getattr(pcbnew, "PAD_SHAPE_RECTANGLE", getattr(pcbnew, "PAD_SHAPE_RECT", -3)): "rect",
+        getattr(pcbnew, "PAD_SHAPE_ROUNDRECT", -4): "roundrect",
+    }
+    fp = pad.GetParentFootprint()
+    body = None
+    fine = False
+    side = layers[0] if layers else "F.Cu"
+    ref = ""
+    if fp is not None:
+        c = fp.GetBoundingBox(False).GetCenter()
+        body = (_mm(c.x), _mm(c.y))
+        fine = _fine(pad, cx, cy, list(fp.Pads()))
+        side = board.GetLayerName(fp.GetLayer())
+        ref = fp.GetReference()
+    return {
+        "x": cx, "y": cy, "w": _mm(size.x), "h": _mm(size.y),
+        "angle": pad.GetOrientation().AsDegrees(), "shape": shapes.get(shape, "rect"),
+        "fine": fine, "body": body, "layers": layers, "net": pad.GetNetname(),
+        "ref": ref, "number": pad.GetNumber(), "side": side if side in layers else (layers or [side])[0],
+    }
+
+
+def _swig_net_width(board, net: Optional[str]) -> int:
+    ds = board.GetDesignSettings()
+    if net:
+        try:
+            return int(ds.m_NetSettings.GetEffectiveNetClass(net).GetTrackWidth())
+        except Exception:
+            pass
+    return int(ds.GetCurrentTrackWidth())
+
+
+def _swig_tracks(board) -> Tuple[List[Dict[str, Any]], List[Tuple[float, float]]]:
+    import pcbnew
+
+    tracks, vias = [], []
+    for t in board.GetTracks():
+        if t.Type() == pcbnew.PCB_VIA_T:
+            p = t.GetPosition()
+            vias.append((_mm(p.x), _mm(p.y)))
+        elif t.Type() == pcbnew.PCB_TRACE_T:
+            s, e = t.GetStart(), t.GetEnd()
+            tracks.append({
+                "obj": t, "layer": board.GetLayerName(t.GetLayer()), "net": t.GetNetname(),
+                "start": (_mm(s.x), _mm(s.y)), "end": (_mm(e.x), _mm(e.y)),
+                "locked": bool(t.IsLocked()),
+            })
+    return tracks, vias
+
+
+def _swig_add(board, poly, layer_id, width_nm, net_obj) -> List[Any]:
+    import pcbnew
+
+    made = []
+    for a, b in zip(poly, poly[1:]):
+        t = pcbnew.PCB_TRACK(board)
+        t.SetStart(pcbnew.VECTOR2I(int(round(a[0] * NM)), int(round(a[1] * NM))))
+        t.SetEnd(pcbnew.VECTOR2I(int(round(b[0] * NM)), int(round(b[1] * NM))))
+        t.SetLayer(layer_id)
+        t.SetWidth(width_nm)
+        if net_obj is not None:
+            t.SetNet(net_obj)
+        board.Add(t)
+        made.append(t)
+    return made
+
+
+def _net_obj(board, net: Optional[str]):
+    if not net:
+        return None
+    nets = board.GetNetInfo().NetsByName()
+    return nets[net] if nets.has_key(net) else None
+
+
+def _swig_pad_by_spec(board, spec) -> Optional[Any]:
+    if isinstance(spec, dict) and "pad" in spec and "componentRef" in spec:
+        fp = board.FindFootprintByReference(spec["componentRef"])
+        if fp:
+            for pad in fp.Pads():  # KiCad 10's FOOTPRINT has no FindPadByName
+                if pad.GetNumber() == str(spec["pad"]):
+                    return pad
+            raise ValueError(f"Pad not found: {spec['componentRef']} pad {spec['pad']}")
+        raise ValueError(f"Component not found: {spec['componentRef']}")
+    return None
+
+
+def _ends_and_pads(pads_of, specs, layer, net, tracks, vias, snap45):
+    """Resolve start/end: (points, start_pad, end_pad, start_joint, end_joint, net)."""
+    start, wps, end = specs
+    out_pts, found = [], []
+    for spec in (start, end):
+        pad = pads_of["by_spec"](spec)
+        pt = (pad["x"], pad["y"]) if pad else as_point(spec)
+        if pt is None:
+            raise ValueError("Invalid point specification")
+        if pad is None and snap45:
+            pad = _pick_pad(pads_of["all"](), pt, layer, net)
+        found.append(pad)
+        out_pts.append(pt)
+    start_pad, end_pad = found
+    if not net:
+        net = (start_pad or {}).get("net") or (end_pad or {}).get("net") or None
+    sj = ej = None
+    if snap45:
+        if start_pad is None:
+            sj = _pick_joint(tracks, vias, out_pts[0], layer, net)
+        if end_pad is None:
+            ej = _pick_joint(tracks, vias, out_pts[1], layer, net)
+        if not net:
+            net = ((sj or ej or {}).get("track") or {}).get("net") or None
+    mids = [as_point(w) for w in wps]
+    if any(m is None for m in mids):
+        raise ValueError("Invalid waypoint: use {x, y, unit} or [x, y] in mm")
+    return [out_pts[0]] + mids + [out_pts[1]], start_pad, end_pad, sj, ej, net
+
+
+def _result(poly, layer, width_mm, net, start_pad, end_pad, moves, snap45, live):
+    segs = track45.segments(poly)
+    out = {
+        "success": True,
+        "message": (f"Added {len(segs)} track segment(s)"
+                    + (" (visible in KiCAD UI)" if live else "")
+                    + (", 0/45/90 degrees, corners chamfered" if snap45 else ", exact geometry")),
+        "trace": {
+            "start": {"x": poly[0][0], "y": poly[0][1], "unit": "mm"},
+            "end": {"x": poly[-1][0], "y": poly[-1][1], "unit": "mm"},
+            "layer": layer, "width": width_mm, "net": net,
+        },
+        "segments": segs,
+        "snap45": snap45,
+    }
+    for key, pad in (("startPad", start_pad), ("endPad", end_pad)):
+        if pad is not None and pad.get("ref"):
+            out[key] = {"ref": pad["ref"], "pad": pad.get("number"), "x": pad["x"], "y": pad["y"]}
+    if moves:
+        out["chamferedExisting"] = [
+            {"from": {"x": j["joint"][0], "y": j["joint"][1]}, "to": {"x": round(p[0], 6), "y": round(p[1], 6)}}
+            for j, p in moves
+        ]
+    return out
+
+
+def swig_route_trace(cmds, params: Dict[str, Any]) -> Dict[str, Any]:
+    """route_trace on the tool's board (pcbnew)."""
+    board = cmds.board
+    layer = params.get("layer") or "F.Cu"
+    layer_id = board.GetLayerID(layer)
+    if layer_id < 0:
+        return {"success": False, "message": "Invalid layer", "errorDetails": f"Layer '{layer}' does not exist"}
+    specs = path_specs(params)
+    if specs[0] is None or specs[2] is None:
+        return {"success": False, "message": "Missing parameters", "errorDetails": "start and end points are required"}
+    snap45 = _snap45(params)
+    net = params.get("net") or params.get("netName")
+    tracks, vias = _swig_tracks(board) if snap45 else ([], [])
+    cache: Dict[str, Any] = {}
+
+    def all_pads():
+        if "all" not in cache:
+            cache["all"] = [swig_pad(board, p) for p in board.GetPads()]
+        return cache["all"]
+
+    def by_spec(spec):
+        pad = _swig_pad_by_spec(board, spec)
+        return swig_pad(board, pad) if pad is not None else None
+
+    pts, sp, ep, sj, ej, net = _ends_and_pads(
+        {"all": all_pads, "by_spec": by_spec}, specs, layer, net, tracks, vias, snap45)
+    width = params.get("width")
+    width_nm = int(round(float(width) * NM)) if width else _swig_net_width(board, net)
+    p = plan(pts, width_nm / NM, sp, ep, sj, ej, snap45, float(params.get("maxChamfer") or track45.MAX_CHAMFER))
+    import pcbnew
+
+    for joint, new in p["moves"]:
+        t = joint["track"]["obj"]
+        v = pcbnew.VECTOR2I(int(round(new[0] * NM)), int(round(new[1] * NM)))
+        (t.SetStart if joint["which"] == "start" else t.SetEnd)(v)
+    poly = p["points"]
+    if len(poly) < 2:
+        return {"success": False, "message": "Start and end are the same point"}
+    _swig_add(board, poly, layer_id, width_nm, _net_obj(board, net))
+    if params.get("via") and net:
+        cmds.add_via({"position": {"x": poly[-1][0], "y": poly[-1][1], "unit": "mm"}, "net": net})
+    return _result(poly, layer, width_nm / NM, net, sp, ep, p["moves"], snap45, False)
+
+
+def _swig_find_pad(board, ref: str, number: str):
+    fp = board.FindFootprintByReference(ref)
+    if not fp:
+        return None, f"Component not found: {ref}"
+    for pad in fp.Pads():
+        if pad.GetNumber() == number:
+            return pad, None
+    return None, f"Pad not found: {ref} pad {number}"
+
+
+def swig_route_pad_to_pad(cmds, params: Dict[str, Any]) -> Dict[str, Any]:
+    """route_pad_to_pad on the tool's board (pcbnew)."""
+    import pcbnew
+
+    board = cmds.board
+    refs = (params.get("fromRef"), str(params.get("fromPad", "")), params.get("toRef"), str(params.get("toPad", "")))
+    if not all(refs):
+        return {"success": False, "message": "Missing parameters",
+                "errorDetails": "fromRef, fromPad, toRef, toPad are all required"}
+    pa, err = _swig_find_pad(board, refs[0], refs[1])
+    if err:
+        return {"success": False, "message": err, "errorDetails": "Check the reference and pad number"}
+    pb, err = _swig_find_pad(board, refs[2], refs[3])
+    if err:
+        return {"success": False, "message": err, "errorDetails": "Check the reference and pad number"}
+    a, b = swig_pad(board, pa), swig_pad(board, pb)
+    net = params.get("net") or a["net"] or b["net"] or ""
+    width = params.get("width")
+    width_nm = int(round(float(width) * NM)) if width else _swig_net_width(board, net)
+    ds = board.GetDesignSettings()
+    via_size = float(params.get("viaSize") or _mm(ds.GetCurrentViaSize()))
+    via_drill = float(params.get("viaDrill") or _mm(ds.GetCurrentViaDrill()))
+    snap45 = _snap45(params)
+    legs, via, la, lb = pad_to_pad_plan(a, b, width_nm / NM, waypoints_of(params),
+                                        params.get("layer"), via_size, snap45)
+    net_obj = _net_obj(board, net)
+    segs = []
+    for layer, poly in legs:
+        _swig_add(board, poly, board.GetLayerID(layer), width_nm, net_obj)
+        segs += [dict(s, layer=layer) for s in track45.segments(poly)]
+    out = {
+        "success": True,
+        "message": f"Routed {refs[0]}.{refs[1]} -> {refs[2]}.{refs[3]} (net: {net}, {len(segs)} segment(s)"
+                   + (f", via at {via[0]:.2f},{via[1]:.2f})" if via else ")"),
+        "segments": segs, "layer": la, "width": width_nm / NM, "net": net, "snap45": snap45,
+        "fromPad": {"ref": refs[0], "pad": refs[1], "x": a["x"], "y": a["y"]},
+        "toPad": {"ref": refs[2], "pad": refs[3], "x": b["x"], "y": b["y"]},
+    }
+    if via:
+        r = cmds.add_via({"position": {"x": via[0], "y": via[1], "unit": "mm"}, "net": net,
+                          "size": via_size, "drill": via_drill, "from_layer": "F.Cu", "to_layer": "B.Cu"})
+        out.update(via_added=bool(r.get("success")), via_position={"x": via[0], "y": via[1]},
+                   via_size=via_size, via_drill=via_drill, toLayer=lb)
+    return out
+
+
+# --- live (kipy, KiCad's open board) ----------------------------------------------------
+def _ipc_layer_name(value) -> str:
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    return BoardLayer.Name(value)[3:].replace("_", ".")
+
+
+def _ipc_layer(name: str):
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    name = {"F.Silkscreen": "F.SilkS", "B.Silkscreen": "B.SilkS"}.get(name, name)
+    return BoardLayer.Value("BL_" + name.replace(".", "_"))
+
+
+class IpcPads:
+    """KiCad's pads as track45 pad dicts, read once per call."""
+
+    def __init__(self, kboard):
+        self.kboard = kboard
+        self._fps = None
+        self._copper = None
+
+    def footprints(self):
+        if self._fps is None:
+            self._fps = list(self.kboard.get_footprints())
+        return self._fps
+
+    def pad_dict(self, fp, pad, body=None) -> Dict[str, Any]:
+        from kipy.proto.board.board_types_pb2 import BoardLayer, PadStackShape, PadType
+
+        ps = pad.padstack
+        cls = ps.copper_layers
+        cl = cls[0] if cls else None
+        layers = [_ipc_layer_name(l) for l in ps.layers if BoardLayer.Name(l).endswith("_Cu")]
+        if pad.pad_type == PadType.Value("PT_PTH"):  # a plated hole is on every copper layer
+            if self._copper is None:
+                self._copper = [_ipc_layer_name(l) for l in self.kboard.get_enabled_layers()
+                                if BoardLayer.Name(l).endswith("_Cu")]
+            layers = list(self._copper) or layers
+        shape = {PadStackShape.Value("PSS_CIRCLE"): "circle", PadStackShape.Value("PSS_OVAL"): "oval",
+                 PadStackShape.Value("PSS_RECTANGLE"): "rect",
+                 PadStackShape.Value("PSS_ROUNDRECT"): "roundrect"}.get(cl.shape if cl else -1, "rect")
+        cx, cy = _mm(pad.position.x), _mm(pad.position.y)
+        fine = False
+        side = None
+        ref = ""
+        if fp is not None:
+            for q in fp.definition.pads:
+                if q.id.value == pad.id.value:
+                    continue
+                if 1e-3 < math.hypot(_mm(q.position.x) - cx, _mm(q.position.y) - cy) < track45.FINE_PITCH:
+                    fine = True
+                    break
+            side = _ipc_layer_name(fp.layer)
+            ref = fp.reference_field.text.value
+        return {
+            "x": cx, "y": cy, "w": _mm(cl.size.x) if cl else 0.0, "h": _mm(cl.size.y) if cl else 0.0,
+            "angle": float(ps.angle.degrees), "shape": shape, "fine": fine, "body": body,
+            "layers": layers, "net": pad.net.name if pad.net else "", "ref": ref,
+            "number": pad.number, "side": side if side in layers else (layers or ["F.Cu"])[0],
+            "_fp": fp,
+        }
+
+    def _body(self, fp):
+        try:
+            box = self.kboard.get_item_bounding_box(fp)
+            if box is not None:
+                c = box.center()
+                return (_mm(c.x), _mm(c.y))
+        except Exception as e:
+            logger.debug(f"footprint bounding box: {e}")
+        return (_mm(fp.position.x), _mm(fp.position.y))
+
+    def with_body(self, d: Optional[Dict[str, Any]]):
+        if d is not None and d.get("_fp") is not None and d.get("body") is None:
+            d["body"] = self._body(d["_fp"])
+        return d
+
+    def find(self, ref: str, number: str):
+        for fp in self.footprints():
+            if fp.reference_field.text.value != ref:
+                continue
+            for pad in fp.definition.pads:
+                if pad.number == number:
+                    return self.with_body(self.pad_dict(fp, pad)), None
+            return None, f"Pad not found: {ref} pad {number}"
+        return None, f"Component not found: {ref}"
+
+    def all(self) -> List[Dict[str, Any]]:
+        out = []
+        for fp in self.footprints():
+            for pad in fp.definition.pads:
+                out.append(self.pad_dict(fp, pad))
+        return out
+
+
+def _ipc_tracks(kboard):
+    from kipy.board_types import Track
+
+    tracks = []
+    for t in kboard.get_tracks():
+        if not isinstance(t, Track):
+            continue
+        tracks.append({
+            "obj": t, "layer": _ipc_layer_name(t.layer), "net": t.net.name if t.net else "",
+            "start": (_mm(t.start.x), _mm(t.start.y)), "end": (_mm(t.end.x), _mm(t.end.y)),
+            "locked": bool(getattr(t, "locked", False)),
+        })
+    vias = [(_mm(v.position.x), _mm(v.position.y)) for v in kboard.get_vias()]
+    return tracks, vias
+
+
+def _ipc_net(kboard, net: Optional[str]):
+    if not net:
+        return None
+    for n in kboard.get_nets():
+        if n.name == net:
+            return n
+    return None
+
+
+def _ipc_class(kboard, net_obj):
+    if net_obj is None:
+        return None
+    try:
+        classes = kboard.get_netclass_for_nets(net_obj)
+        return next(iter(classes.values()), None)
+    except Exception as e:
+        logger.debug(f"net class: {e}")
+        return None
+
+
+def _ipc_new_tracks(poly, layer: str, width_mm: float, net_obj):
+    from kipy.board_types import Track
+    from kipy.geometry import Vector2
+
+    items = []
+    for a, b in zip(poly, poly[1:]):
+        t = Track()
+        t.start = Vector2.from_xy(int(round(a[0] * NM)), int(round(a[1] * NM)))
+        t.end = Vector2.from_xy(int(round(b[0] * NM)), int(round(b[1] * NM)))
+        t.width = int(round(width_mm * NM))
+        t.layer = _ipc_layer(layer)
+        if net_obj is not None:
+            t.net = net_obj
+        items.append(t)
+    return items
+
+
+def _ipc_new_via(pos, size: float, drill: float, net_obj):
+    from kipy.board_types import Via
+    from kipy.geometry import Vector2
+    from kipy.proto.board.board_types_pb2 import ViaType
+
+    v = Via()
+    v.position = Vector2.from_xy(int(round(pos[0] * NM)), int(round(pos[1] * NM)))
+    v.diameter = int(round(size * NM))
+    v.drill_diameter = int(round(drill * NM))
+    v.type = ViaType.VT_THROUGH
+    if net_obj is not None:
+        v.net = net_obj
+    return v
+
+
+def _ipc_commit(kboard, updated, created, message: str):
+    commit = kboard.begin_commit()
+    try:
+        if updated:
+            kboard.update_items(updated)
+        made = kboard.create_items(created) if created else []
+        kboard.push_commit(commit, message)
+        return made
+    except Exception:
+        kboard.drop_commit(commit)
+        raise
+
+
+def ipc_route_trace(kboard, params: Dict[str, Any]) -> Dict[str, Any]:
+    """route_trace on KiCad's open board, in one commit."""
+    from kipy.geometry import Vector2
+
+    layer = params.get("layer") or "F.Cu"
+    try:
+        _ipc_layer(layer)
+    except ValueError:
+        return {"success": False, "message": "Invalid layer", "errorDetails": f"Layer '{layer}' does not exist"}
+    specs = path_specs(params)
+    if specs[0] is None or specs[2] is None:
+        return {"success": False, "message": "Missing parameters", "errorDetails": "start and end points are required"}
+    snap45 = _snap45(params)
+    net = params.get("net") or params.get("netName")
+    pads = IpcPads(kboard)
+    tracks, vias = _ipc_tracks(kboard) if snap45 else ([], [])
+    cache: Dict[str, Any] = {}
+
+    def all_pads():
+        if "all" not in cache:
+            cache["all"] = pads.all()
+        return cache["all"]
+
+    def by_spec(spec):
+        if isinstance(spec, dict) and "pad" in spec and "componentRef" in spec:
+            d, _err = pads.find(spec["componentRef"], str(spec["pad"]))
+            return d
+        return None
+
+    pts, sp, ep, sj, ej, net = _ends_and_pads(
+        {"all": all_pads, "by_spec": by_spec}, specs, layer, net, tracks, vias, snap45)
+    sp, ep = pads.with_body(sp), pads.with_body(ep)
+    net_obj = _ipc_net(kboard, net)
+    width = params.get("width")
+    if not width:
+        nc = _ipc_class(kboard, net_obj)
+        width = _mm(nc.track_width) if nc is not None and nc.track_width else 0.25
+    width = float(width)
+    p = plan(pts, width, sp, ep, sj, ej, snap45, float(params.get("maxChamfer") or track45.MAX_CHAMFER))
+    poly = p["points"]
+    if len(poly) < 2:
+        return {"success": False, "message": "Start and end are the same point"}
+    updated = []
+    for joint, new in p["moves"]:
+        t = joint["track"]["obj"]
+        v = Vector2.from_xy(int(round(new[0] * NM)), int(round(new[1] * NM)))
+        if joint["which"] == "start":
+            t.start = v
+        else:
+            t.end = v
+        updated.append(t)
+    created = _ipc_new_tracks(poly, layer, width, net_obj)
+    if params.get("via") and net:
+        nc = _ipc_class(kboard, net_obj)
+        size = float(params.get("viaSize") or (_mm(nc.via_diameter) if nc is not None and nc.via_diameter else 0.8))
+        drill = float(params.get("viaDrill") or (_mm(nc.via_drill) if nc is not None and nc.via_drill else 0.4))
+        created.append(_ipc_new_via(poly[-1], size, drill, net_obj))
+    _ipc_commit(kboard, updated, created, "Route track")
+    return _result(poly, layer, width, net, sp, ep, p["moves"], snap45, True)
+
+
+def ipc_route_pad_to_pad(kboard, params: Dict[str, Any]) -> Dict[str, Any]:
+    """route_pad_to_pad on KiCad's open board, in one commit."""
+    refs = (params.get("fromRef"), str(params.get("fromPad", "")), params.get("toRef"), str(params.get("toPad", "")))
+    if not all(refs):
+        return {"success": False, "message": "Missing parameters",
+                "errorDetails": "fromRef, fromPad, toRef, toPad are all required"}
+    pads = IpcPads(kboard)
+    a, err = pads.find(refs[0], refs[1])
+    if err:
+        return {"success": False, "message": err, "errorDetails": "Check the reference and pad number"}
+    b, err = pads.find(refs[2], refs[3])
+    if err:
+        return {"success": False, "message": err, "errorDetails": "Check the reference and pad number"}
+    net = params.get("net") or a["net"] or b["net"] or ""
+    net_obj = _ipc_net(kboard, net)
+    nc = _ipc_class(kboard, net_obj)
+    width = params.get("width")
+    if not width:
+        width = _mm(nc.track_width) if nc is not None and nc.track_width else 0.25
+    width = float(width)
+    via_size = float(params.get("viaSize") or (_mm(nc.via_diameter) if nc is not None and nc.via_diameter else 0.8))
+    via_drill = float(params.get("viaDrill") or (_mm(nc.via_drill) if nc is not None and nc.via_drill else 0.4))
+    snap45 = _snap45(params)
+    legs, via, la, lb = pad_to_pad_plan(a, b, width, waypoints_of(params), params.get("layer"), via_size, snap45)
+    created, segs = [], []
+    for layer, poly in legs:
+        created += _ipc_new_tracks(poly, layer, width, net_obj)
+        segs += [dict(s, layer=layer) for s in track45.segments(poly)]
+    if via:
+        created.append(_ipc_new_via(via, via_size, via_drill, net_obj))
+    _ipc_commit(kboard, [], created, f"Route {refs[0]}.{refs[1]} to {refs[2]}.{refs[3]}")
+    out = {
+        "success": True,
+        "message": f"Routed {refs[0]}.{refs[1]} -> {refs[2]}.{refs[3]} (net: {net}, {len(segs)} segment(s)"
+                   + (f", via at {via[0]:.2f},{via[1]:.2f})" if via else ")") + " (visible in KiCAD UI)",
+        "segments": segs, "layer": la, "width": width, "net": net, "snap45": snap45,
+        "fromPad": {"ref": refs[0], "pad": refs[1], "x": a["x"], "y": a["y"]},
+        "toPad": {"ref": refs[2], "pad": refs[3], "x": b["x"], "y": b["y"]},
+    }
+    if via:
+        out.update(via_added=True, via_position={"x": via[0], "y": via[1]},
+                   via_size=via_size, via_drill=via_drill, toLayer=lb)
+    return out
