diff --git a/python/commands/autoroute_backup.py b/python/commands/autoroute_backup.py
new file mode 100644
index 0000000..ef01ec3
--- /dev/null
+++ b/python/commands/autoroute_backup.py
@@ -0,0 +1,56 @@
+"""
+The board as it was before the last autoroute run, so the run can be undone (PowerLab patch).
+
+autoroute writes the routed board over the saved .kicad_pcb, so File > Revert in KiCad
+loads the routed board, not the one before. Each run that changes the board keeps a copy
+of the saved file from before it in autoroute-backup/ next to the board; undo_autoroute
+copies it back (into KiCad's open board when KiCad has it open) and removes it.
+powerlab_route keeps one the same way.
+"""
+
+import os
+import shutil
+from datetime import datetime
+from typing import Any, Dict
+
+BACKUP_FOLDER = "autoroute-backup"
+
+
+def backup_path(board_path: str) -> str:
+    """Where the pre-autoroute copy of this board is kept."""
+    folder = os.path.join(os.path.dirname(os.path.abspath(board_path)), BACKUP_FOLDER)
+    return os.path.join(folder, os.path.basename(board_path))
+
+
+def keep(before: str, board_path: str) -> str:
+    """Keep ``before`` (the saved board from before the run) as the board's backup."""
+    target = backup_path(board_path)
+    os.makedirs(os.path.dirname(target), exist_ok=True)
+    shutil.copy2(before, target)
+    return target
+
+
+def restore(board_path: str) -> Dict[str, Any]:
+    """Copy the backup back over the board file and remove it."""
+    source = backup_path(board_path)
+    if not os.path.isfile(source):
+        return {
+            "success": False,
+            "message": "No autoroute backup for this board",
+            "errorDetails": f"Expected {source}. Only a successful autoroute or powerlab_route run leaves one, and undo_autoroute uses it up.",
+        }
+    # copyfile, not copy2: a fresh modification time, so KiCad sees the file changed
+    shutil.copyfile(source, board_path)
+    return discard(board_path)
+
+
+def discard(board_path: str) -> Dict[str, Any]:
+    """Remove the backup once it has been put back (in the file, or in KiCad's open board)."""
+    source = backup_path(board_path)
+    taken = datetime.fromtimestamp(os.path.getmtime(source)).strftime("%Y-%m-%d %H:%M")
+    os.remove(source)
+    try:
+        os.rmdir(os.path.dirname(source))
+    except OSError:
+        pass
+    return {"success": True, "restored_from": source, "saved_before_run": taken}
