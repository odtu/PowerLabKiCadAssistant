@@ -0,0 +1,302 @@
+"""
+Placed symbols carry every library field and the library's Value.
+
+A part-per-symbol library (one symbol per orderable part, as in the METU Power
+Lab library) names a symbol "22 uF 100V" while its Value is "22 uF" and the
+rating sits in a visible "Voltage Rating" field next to MPN, manufacturer and
+distributor fields. Placement used to write only Reference/Value/Footprint/
+Datasheet/Description and the symbol's *name* as Value, so the part lost its
+data and showed the rating glued to the value.
+"""
+
+import json
+import re
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent.parent / "python"))
+
+LIB_SYMBOL = """    (symbol "Lab:22 uF 100V" (pin_numbers (hide yes)) (pin_names (offset 0.254)) (in_bom yes) (on_board yes)
+      (property "Reference" "C" (at 0.635 2.54 0)
+        (effects (font (size 1.27 1.27)) (justify left))
+      )
+      (property "Value" "22 uF" (at 0.635 -2.54 0)
+        (effects (font (size 1.27 1.27)) (justify left))
+      )
+      (property "Footprint" "Lab:2220" (at 0 0 0)
+        (effects (font (size 1.27 1.27)) (hide yes))
+      )
+      (property "Datasheet" "https://example.com/c.pdf" (at 0 0 0)
+        (effects (font (size 1.27 1.27)) (hide yes))
+      )
+      (property "Description" "Ceramic SMD Cap 2220" (at 0 0 0)
+        (effects (font (size 1.27 1.27)) (hide yes))
+      )
+      (property "Manufacturer Number" "C5750X7S2A226M" (at 0 0 0)
+        (effects (font (size 1.27 1.27)) (hide yes))
+      )
+      (property "Voltage Rating" "100V" (at 0.635 -4.318 0)
+        (show_name no)
+        (effects (font (size 1 1)) (justify left))
+      )
+      (property "Saturation Current" "3A" (at 0.635 -5.842 0)
+        (show_name yes)
+        (effects (font (size 1 1)) (justify left))
+      )
+      (property "ki_keywords" "cap capacitor" (at 0 0 0)
+        (effects (font (size 1.27 1.27)) (hide yes))
+      )
+      (symbol "22 uF 100V_1_1"
+        (pin passive line (at 0 5.08 270) (length 4.064)
+          (name "~" (effects (font (size 1.27 1.27))))
+          (number "1" (effects (font (size 1.27 1.27))))
+        )
+        (pin passive line (at 0 -5.08 90) (length 4.064)
+          (name "~" (effects (font (size 1.27 1.27))))
+          (number "2" (effects (font (size 1.27 1.27))))
+        )
+      )
+    )
+"""
+
+SCHEMATIC = (
+    '(kicad_sch (version 20250114) (generator "test")\n'
+    "  (uuid b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e)\n"
+    '  (paper "A4")\n'
+    "  (lib_symbols\n" + LIB_SYMBOL + "  )\n"
+    "  (sheet_instances (path \"/\" (page \"1\")))\n"
+    ")\n"
+)
+
+# An instance as the old placement code wrote it: five fields, name as Value.
+OLD_INSTANCE = """  (symbol (lib_id "Lab:22 uF 100V") (at 100 50 0) (unit 1)
+    (uuid "11111111-1111-1111-1111-111111111111")
+    (property "Reference" "C1" (at 103 49 0)
+      (effects (font (size 1.27 1.27)) (justify left))
+    )
+    (property "Value" "22 uF 100V" (at 103 60 0)
+      (effects (font (size 1.27 1.27)) (justify right))
+    )
+    (property "Footprint" "Lab:2220" (at 100 50 0) (hide yes)
+      (effects (font (size 1.27 1.27)))
+    )
+    (pin "1" (uuid "22222222-2222-2222-2222-222222222222"))
+    (pin "2" (uuid "33333333-3333-3333-3333-333333333333"))
+  )
+"""
+
+
+def _props(block: str) -> dict:
+    return {
+        m.group(1): m.group(2)
+        for m in re.finditer(r'\(property "([^"]*)" "([^"]*)"', block)
+    }
+
+
+def _instance_block(content: str) -> str:
+    start = content.index("(symbol (lib_id")
+    depth = 0
+    for i in range(start, len(content)):
+        if content[i] == "(":
+            depth += 1
+        elif content[i] == ")":
+            depth -= 1
+            if depth == 0:
+                return content[start : i + 1]
+    raise AssertionError("unterminated instance")
+
+
+@pytest.fixture
+def loader():
+    from commands.dynamic_symbol_loader import DynamicSymbolLoader
+
+    return DynamicSymbolLoader()
+
+
+@pytest.fixture
+def sch(tmp_path):
+    path = tmp_path / "lab.kicad_sch"
+    path.write_text(SCHEMATIC, encoding="utf-8")
+    return path
+
+
+@pytest.mark.unit
+class TestPlacementCopiesLibraryFields:
+    def _place(self, loader, sch, **kw):
+        loader.create_component_instance(
+            sch, "Lab", "22 uF 100V", reference="C1", x=100.33, y=50.8, **kw
+        )
+        return _instance_block(sch.read_text(encoding="utf-8"))
+
+    def test_value_comes_from_library_when_omitted(self, loader, sch):
+        assert _props(self._place(loader, sch))["Value"] == "22 uF"
+
+    def test_symbol_name_as_value_becomes_library_value(self, loader, sch):
+        block = self._place(loader, sch, value="22 uF 100V")
+        assert _props(block)["Value"] == "22 uF"
+
+    def test_explicit_value_still_wins(self, loader, sch):
+        assert _props(self._place(loader, sch, value="47 uF"))["Value"] == "47 uF"
+
+    def test_every_library_field_is_copied(self, loader, sch):
+        props = _props(self._place(loader, sch))
+        assert props["Manufacturer Number"] == "C5750X7S2A226M"
+        assert props["Voltage Rating"] == "100V"
+        assert props["Saturation Current"] == "3A"
+        assert props["Footprint"] == "Lab:2220"
+        assert "ki_keywords" not in props
+
+    def test_visibility_and_show_name_follow_the_library(self, loader, sch):
+        block = self._place(loader, sch)
+
+        def field(name):
+            start = block.index(f'(property "{name}"')
+            return block[start : block.index("(effects", start)]
+
+        assert "(hide yes)" in field("Manufacturer Number")
+        assert "(hide yes)" not in field("Voltage Rating")
+        assert "(show_name no)" in field("Voltage Rating")
+        assert "(show_name yes)" in field("Saturation Current")
+
+    def test_library_y_up_offsets_are_drawn_y_down(self, loader, sch):
+        block = self._place(loader, sch)
+
+        def y(name):
+            m = re.search(rf'\(property "{name}" "[^"]*"\s+\(at [-\d.]+ ([-\d.]+)', block)
+            return float(m.group(1))
+
+        # Library: Reference above the body (+2.54), Value and rating below.
+        assert y("Reference") < 50.8 < y("Value") < y("Voltage Rating")
+
+
+@pytest.mark.unit
+class TestSyncInstanceFields:
+    def _old_schematic(self, sch):
+        content = sch.read_text(encoding="utf-8")
+        content = content.replace("  (sheet_instances", OLD_INSTANCE + "  (sheet_instances")
+        sch.write_text(content, encoding="utf-8")
+
+    def test_missing_fields_added_and_value_reset(self, loader, sch):
+        self._old_schematic(sch)
+        assert loader.sync_instance_fields(sch, "Lab", "22 uF 100V") == 1
+        props = _props(_instance_block(sch.read_text(encoding="utf-8")))
+        assert props["Value"] == "22 uF"
+        assert props["Voltage Rating"] == "100V"
+        assert props["Manufacturer Number"] == "C5750X7S2A226M"
+        assert props["Datasheet"] == "https://example.com/c.pdf"
+        assert props["Reference"] == "C1"
+        assert "ki_keywords" not in props
+
+    def test_rating_stacks_under_the_moved_value(self, loader, sch):
+        self._old_schematic(sch)
+        loader.sync_instance_fields(sch, "Lab", "22 uF 100V")
+        block = _instance_block(sch.read_text(encoding="utf-8"))
+        start = block.index('(property "Voltage Rating"')
+        rating = block[start : block.index("\n    )", start)]
+        # Value sits at (103, 60), justified right; the library puts the rating
+        # 1.778 mm under the Value.
+        assert "(at 103 61.778 0)" in rating
+        assert "(justify right)" in rating
+        assert "(hide yes)" not in rating
+
+    def _rating(self, sch):
+        block = _instance_block(sch.read_text(encoding="utf-8"))
+        start = block.index('(property "Voltage Rating"')
+        return block[start : block.index("\n    )", start)]
+
+    def test_rating_follows_the_value_angle_on_a_rotated_part(self, loader, sch):
+        self._old_schematic(sch)
+        content = sch.read_text(encoding="utf-8")
+        content = content.replace("(at 100 50 0) (unit 1)", "(at 100 50 90) (unit 1)")
+        content = content.replace("(at 103 60 0)", "(at 103 60 90)")
+        sch.write_text(content, encoding="utf-8")
+        loader.sync_instance_fields(sch, "Lab", "22 uF 100V")
+        assert "(at 103 61.778 90)" in self._rating(sch)
+
+    def test_rating_stacks_upward_when_the_value_is_above(self, loader, sch):
+        self._old_schematic(sch)
+        content = sch.read_text(encoding="utf-8").replace(
+            '(property "Reference" "C1" (at 103 49 0)', '(property "Reference" "C1" (at 103 70 0)'
+        )
+        sch.write_text(content, encoding="utf-8")
+        loader.sync_instance_fields(sch, "Lab", "22 uF 100V")
+        assert "(at 103 58.222 0)" in self._rating(sch)
+
+    def test_second_run_changes_nothing(self, loader, sch):
+        self._old_schematic(sch)
+        loader.sync_instance_fields(sch, "Lab", "22 uF 100V")
+        before = sch.read_text(encoding="utf-8")
+        assert loader.sync_instance_fields(sch, "Lab", "22 uF 100V") == 0
+        assert sch.read_text(encoding="utf-8") == before
+
+    def test_edited_value_is_kept(self, loader, sch):
+        self._old_schematic(sch)
+        content = sch.read_text(encoding="utf-8").replace(
+            '(property "Value" "22 uF 100V" (at 103', '(property "Value" "DNP" (at 103'
+        )
+        sch.write_text(content, encoding="utf-8")
+        loader.sync_instance_fields(sch, "Lab", "22 uF 100V")
+        assert _props(_instance_block(sch.read_text(encoding="utf-8")))["Value"] == "DNP"
+
+
