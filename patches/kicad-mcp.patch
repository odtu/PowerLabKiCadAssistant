+    def _live_kicad_board(self, board_path: str) -> Any:
+        """KiCad's open board (kipy) when KiCad has board_path open, else None (PowerLab patch)."""
+        self._try_enable_ipc_backend()
+        backend = getattr(self, "ipc_backend", None)
+        if backend and backend.is_connected() and self._ipc_board_path_matches(board_path):
+            try:
+                return backend._kicad.get_board()
+            except Exception as e:
+                logger.warning(f"No board from KiCad: {e}")
+        return None
+
+    def _live_board_for_file_edit(self) -> Optional[Tuple[str, Any]]:
+        """(board path, KiCad's kipy board) when KiCad has this session's board open, else
+        None (PowerLab patch, see LIVE_VIA_FILE_COMMANDS)."""
+        if not self._session_allows_ipc():
+            return None
+        self._try_enable_ipc_backend()
+        backend = getattr(self, "ipc_backend", None)
+        if not (self.use_ipc and backend and backend.is_connected()):
+            return None
+        try:
+            path = backend.get_open_board_path()
+        except Exception:
+            return None
+        if not path or not os.path.isfile(str(path)):
+            return None
+        session_path = getattr(self, "session_board_path", None)
+        if session_path and self._normalize_board_path(path) != session_path:
+            return None
+        try:
+            return str(path), backend._kicad.get_board()
+        except Exception as e:
+            logger.warning(f"No board from KiCad: {e}")
+            return None
+
+    def _edit_saved_board_then_revert(
+        self, command: str, handler: Any, params: Dict[str, Any], live: Tuple[str, Any]
+    ) -> Dict[str, Any]:
+        """Run a SWIG handler on KiCad's saved board and load the result into KiCad
+        (PowerLab patch, see LIVE_VIA_FILE_COMMANDS)."""
+        board_path, kicad_board = live
+        try:
+            kicad_board.save()
+        except Exception as e:
+            return {"success": False, "message": f"{command}: KiCad could not save the board: {e}"}
+        self._reload_board_file(board_path)
+        if getattr(self, "board", None) is None:
+            return {"success": False, "message": f"{command}: could not load {board_path}"}
+        if self.session_board_path is None:
+            self.session_board_path = self._normalize_board_path(board_path)
+            self.session_backend = "ipc"
+
+        result = handler(params)
+        if not (isinstance(result, dict) and result.get("success")):
+            self._reload_board_file(board_path)  # drop anything half done
+            return result
+
+        current = self.board.GetFileName() or board_path
+        if self._normalize_board_path(current) == self._normalize_board_path(board_path):
+            with preserve_project_settings(board_path):
+                pcbnew.SaveBoard(board_path, self.board)
+        self._record_board_signature()
+        try:
+            kicad_board.revert()
+        except Exception as e:
+            result["warnings"] = list(result.get("warnings") or []) + [
+                f"Saved to the board file, but KiCad did not reload it ({e}): "
+                "use File > Revert in KiCad before editing or saving there."
+            ]
+            return result
+        result["_backend"] = "ipc"
+        result["_realtime"] = True
+        result["liveNote"] = (
+            "KiCad's API can't do this on the open board, so KiCad saved the board, the "
+            "change was made on the saved file and KiCad reloaded it. KiCad's undo "
+            "history starts again from here."
+        )
+        return result
+
