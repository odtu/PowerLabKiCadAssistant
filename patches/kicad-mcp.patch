+++ b/python/commands/powerlab_router/bus.py
@@ -0,0 +1,144 @@
+"""River routing of a bus between two parallel pin rows, as drawn by hand (no pcbnew).
+
+A module's pin row and a header's pin row side by side, with one connection per pin
+pair and the pins in the same order on both rows: each track leaves its pin straight,
+bends 45 degrees into the channel between the rows, runs along it, bends 45 degrees and
+enters the other pin straight. The tracks share the channel in slots one track pitch
+apart, so they run side by side at exactly the pitch:
+- Tracks going down the channel are placed in order from the top pin: the first takes
+  the slot nearest the far row, the next the slot beside it, and so on. Then no track's
+  stub crosses another's run. Tracks going up are the mirror image.
+- A track whose pins are level runs straight across.
+
+Works in a local frame where the rows run along y, the near row ("a") is at larger x and
+the far row ("b") at smaller x; plan() maps in and out of it.
+"""
+
+def plan(pairs, pitch, edge_a, edge_b, clear=None, chamfers=(0.6, 0.4, 0.25), tolerance=0.05, step=0.1,
+         round_b=False, step_in=True):
+    """Shapes for a bus. `pairs`: [(a centre, b centre)] in world mm; `edge_a`, `edge_b`:
+    how far from its row's centre line a track's centre must stay in the channel (pad
+    half-width + clearance + half a track). `clear(index, points)` says whether the shape
+    for pair `index` (world mm) keeps its clearance to other copper: a track that doesn't fit in its slot moves
+    `step` mm further along the channel until it does (trying the 45 degree bends at
+    each size in `chamfers`), and the next one starts a pitch beyond it. With round_b
+    (round pads on the far row, which have no axis), a track may also end with a 45
+    degree run straight into the pad's centre instead of a level one: from the channel,
+    or after a level run just above or below the pin's row (to pass under copper that
+    sits on that row, as the hand-routed TestPCB does at J2.9). Returns {index: [points,
+    a centre first]} for the pairs it could place, or {} when the rows aren't two
+    parallel lines in the same pin order."""
+    if len(pairs) < 2:
+        return {}
+    xs, ys = [a[0] for a, _b in pairs], [a[1] for a, _b in pairs]
+    swap = (max(xs) - min(xs)) > (max(ys) - min(ys))  # rows along x: work with x and y swapped
+
+    def sw(p):
+        return (p[1], p[0]) if swap else p
+
+    pts = [(sw(a), sw(b)) for a, b in pairs]
+    # the pins on the two rows: those on the commonest line of each side (a module's pin
+    # on another side, say, is left to the search)
+    def line(vals):
+        return max(vals, key=lambda v: sum(1 for w in vals if abs(w - v) <= tolerance))
+    xa0, xb0 = line([a[0] for a, _b in pts]), line([b[0] for _a, b in pts])
+    keep = [i for i, (a, b) in enumerate(pts) if abs(a[0] - xa0) <= tolerance and abs(b[0] - xb0) <= tolerance]
+    if len(keep) < 2:
+        return {}
+    flip = xb0 > xa0  # the far row at smaller x
+
+    def fl(p):
+        return (-p[0], p[1]) if flip else p
+
+    local = {i: (fl(pts[i][0]), fl(pts[i][1])) for i in keep}  # world = sw(fl(local)): both are their own inverse
+    xa, xb = fl((xa0, 0))[0], fl((xb0, 0))[0]
+    lo, hi = xb + edge_b, xa - edge_a  # where a track centre may run in the channel
+    if hi <= lo:
+        return {}
+    order_a = sorted(keep, key=lambda i: local[i][0][1])
+    order_b = sorted(keep, key=lambda i: local[i][1][1])
+    if order_a != order_b:
+        return {}  # pins not in the same order on both rows: the tracks would cross
+    def world(p):
+        return [sw(fl(q)) for q in p]
+
+    out = {}
+    for i in order_a:
+        a, b = local[i]
+        if abs(b[1] - a[1]) <= tolerance and (clear is None or clear(i, world([a, b]))):
+            out[i] = [a, b]  # level: straight across
+    down = [i for i in order_a if local[i][1][1] - local[i][0][1] > tolerance]
+    up = [i for i in reversed(order_a) if local[i][0][1] - local[i][1][1] > tolerance]
+    for members, sign in ((down, 1.0), (up, -1.0)):
+        nxt = lo + min(chamfers)
+        placed_here = []
+        for i in members:
+            a, b = local[i]
+            dy = abs(b[1] - a[1])
+            x = nxt
+            placed = False
+            while x + min(chamfers) <= hi and not placed:
+                for size in chamfers:
+                    e = min(size, dy / 2.0)
+                    if x - e < lo or x + e > hi:
+                        continue
+                    p = [a, (x + e, a[1]), (x, a[1] + sign * e)]
+                    if dy - 2 * e > 1e-6:
+                        p.append((x, b[1] - sign * e))
+                    p += [(x - e, b[1]), b]
+                    tries = [p]
+                    run = x - b[0]  # a 45 degree end: as long across as along
+                    if round_b and dy - e - run > 1e-6:
+                        tries.append(p[:3] + [(x, b[1] - sign * run), b])
+                    if round_b:
+                        for dd in (0.5, 0.7, 1.0):
+                            for side in (1.0, -1.0):
+                                yh = b[1] + side * sign * dd  # the level run, beside the pin's row
+                                fall = sign * (yh - sign * e - (a[1] + sign * e))
+                                if fall < -1e-6 or x - e <= b[0] + dd + 1e-6:
+                                    continue
+                                tries.append(p[:3] + [(x, yh - sign * e), (x - e, yh), (b[0] + dd, yh), b])
+                    for q in tries:
+                        if clear is None or clear(i, world(q)):
+                            out[i] = q
+                            nxt = x + pitch
+                            placed = True
+                            placed_here.append(i)
+                            break
+                    if placed:
+                        break
+                x += step
+            # one that found no slot goes to the search; the next ones may still fit
+        if step_in:
+            _step_in(out, placed_here, local, sign, pitch, clear, world, lo)
+    return {i: world(p) for i, p in out.items()}
+
+
+def _step_in(out, order, local, sign, pitch, clear, world, lo):
+    """Once the track before has turned off into its pin, a track moves over into the slot
+    it freed, as the hand-routed TestPCB does: a 45 degree step from its own slot to the
+    one before, a pitch and a half below where that track left the channel. Only for the
+    plain shape (run, bend, level into the pin); kept only if it is clear."""
+    for prev, k in zip(order, order[1:]):
+        p, q = out[prev], out[k]
+        if len(q) != 6:
+            continue  # not the plain shape
+        a, b = local[k]
+        xk = q[2][0]
+        runs = [u[0] for u, v in zip(p[2:-1], p[3:-1]) if abs(u[0] - v[0]) < 1e-9]
+        if not runs:
+            continue
+        xp = runs[-1]  # where the track before ran last along the channel
+        if xk - xp < pitch - 1e-6:
+            continue
+        left = max(sign * pt[1] for pt in p) * sign  # the furthest row the track before reaches
+        ys = left + sign * 1.5 * pitch  # below that, its slot is free
+        top = ys - sign * (xk - xp)
+        e = xk - q[4][0]  # the end bend's size
+        if xp - e < lo - 1e-6:
+            continue  # the end bend would land on the far pin's pad
+        if sign * (top - q[2][1]) < 1e-6 or sign * (b[1] - sign * e - ys) < 1e-6:
+            continue  # no room for the step above or below
+        new = [q[0], q[1], q[2], (xk, top), (xp, ys), (xp, b[1] - sign * e), (xp - e, b[1]), q[-1]]
+        if clear is None or clear(k, world(new)):
+            out[k] = new
diff --git a/python/commands/powerlab_router/costs.py b/python/commands/powerlab_router/costs.py
new file mode 100644
index 0000000..427728c
--- /dev/null
+++ b/python/commands/powerlab_router/costs.py
@@ -0,0 +1,341 @@
+"""The lab rules as search costs (plan §4.4, milestone 3).
+
+Per-cell penalties, in units of Costs.unit (0.1 mm of track), composed per connection:
+- Pours stay whole, without slivers (§3.3): on layers with a pour, a track either hugs
+  other copper or the board edge at the clearance (one track pitch, as the hand-routed
+  TestPCB does: 31 of its 64 parallel runs sit exactly 0.4 mm apart), or stands far
+  enough off that the pour fills the gap (two zone clearances plus its minimum width).
+  In between, where the gap is too narrow to pour, cells cost the most; in the open pour,
+  less; hugging, nothing. So tracks run in tight bundles instead of cutting through the
+  pour or leaving voids beside each other.
+- Thermal spokes of pour-net pads stay clear, so the pad keeps its connection.
+- No tracks under inductors, transformers or chokes, on any layer (§3.4), except the
+  part's own nets.
+- Escape room: 1.5 mm in front of every fine-pitch pin stays free of other nets' tracks
+  (§3.4).
+- Switching nets and clocks keep off a layer where that area has a power pour (§3.4).
+- Clocks: 3W from other tracks (§3.4), and not along the board edge.
+Via costs: a via near the connection's own pins (an escape via, as in the hand routing)
+costs less; on clocks and switching nets a via costs more (§3.4, §3.5).
+"""
+
+import math
+
+import numpy as np
+import pcbnew
+from PIL import Image, ImageDraw
+
+from commands.powerlab_router.model import _grown, _polys
+
+T = pcbnew.ToMM
+
+HUG = 3  # units per cell in the open pour (0.3 mm per 0.1 mm cell)
+SLIVER = 8  # units per cell too close to copper for the pour to fill between (§3.3 slivers)
+SPOKES = 20
+MAGNETICS = 120
+MAGNETICS_MARGIN = 0.3  # mm around the courtyard: half a track and some
+ESCAPE = 20
+ESCAPE_MM = 1.5
+POWER_LAYER = 60  # switching net on a layer with a power pour there
+CLOCK_3W = 30
+CLOCK_EDGE = 30
+CLOCK_EDGE_MM = 1.0
+ESCAPE_VIA_MM = 1.2  # a via this close to the connection's own pin is an escape via
+ESCAPE_VIA_FACTOR = 0.5
+FAST_VIA_FACTOR = 3.0
+MAGNETIC_REFS = ("L", "T", "FL")
+MAGNETIC_WORDS = ("inductor", "transformer", "choke", "coil")
+
+
+def _xy(item):
+    p = item.GetPosition()
+    return (T(p.x), T(p.y))
+
+
+def _rect(c, u, a, b, half):
+    """Polygon of a band from a to b (distances along unit u from c), half-width `half`."""
+    nx, ny = -u[1] * half, u[0] * half
+    x0, y0 = c[0] + u[0] * a, c[1] + u[1] * a
+    x1, y1 = c[0] + u[0] * b, c[1] + u[1] * b
+    return ([(x0 + nx, y0 + ny), (x1 + nx, y1 + ny), (x1 - nx, y1 - ny), (x0 - nx, y0 - ny)], [])
+
+
+def _dilate(mask, steps):
+    """Distance in cells (capped at `steps`) from the True cells, 8-connected."""
+    dist = np.full(mask.shape, steps, np.uint8)
+    frontier = mask.copy()
+    dist[frontier] = 0
+    seen = frontier.copy()
+    for k in range(1, steps):
+        grown = frontier.copy()
+        grown[1:, :] |= frontier[:-1, :]
+        grown[:-1, :] |= frontier[1:, :]
+        grown[:, 1:] |= frontier[:, :-1]
+        grown[:, :-1] |= frontier[:, 1:]
+        grown[1:, 1:] |= frontier[:-1, :-1]
+        grown[:-1, :-1] |= frontier[1:, 1:]
+        grown[1:, :-1] |= frontier[:-1, 1:]
+        grown[:-1, 1:] |= frontier[1:, :-1]
+        new = grown & ~seen
+        if not new.any():
+            break
+        dist[new] = k
+        seen |= new
+        frontier = new
+    return dist
+
+
+def labels(free, min_cells, block=3):
+    """(label per block, {label: size}) for the pieces of at least `min_cells`; blocks
+    of other pieces and blocked ones are 0. See pieces()."""
+    ny, nx = (free.shape[0] // block) * block, (free.shape[1] // block) * block
+    coarse = free[:ny, :nx].reshape(ny // block, block, nx // block, block).all(axis=(1, 3))
+    need = max(1, min_cells // (block * block))
+    arr = coarse.astype(np.uint8) * 255
+    out = np.zeros(coarse.shape, np.int32)
+    sizes = {}
+    for _ in range(5000):
+        ys, xs = np.nonzero(arr == 255)
+        if not len(ys):
+            break
+        im = Image.frombytes("L", (arr.shape[1], arr.shape[0]), arr.tobytes())
+        ImageDraw.floodfill(im, (int(xs[0]), int(ys[0])), 100)
+        piece = np.asarray(im) == 100
+        n = int(piece.sum())
+        if n >= need:
+            label = len(sizes) + 1
+            out[piece] = label
+            sizes[label] = n
+        arr[piece] = 0
+    return out, sizes
+
+
+def pieces(free, min_cells, block=3, sizes=False):
+    """How many pieces of at least `min_cells` the True cells of `free` make (with
+    sizes=True: their sizes, largest first). Counted on blocks of `block` x `block` cells
+    that are free throughout: a neck narrower than a block (0.3 mm on the 0.1 mm grid)
+    doesn't join a pour (minimum pour width, §3.3)."""
+    ny, nx = (free.shape[0] // block) * block, (free.shape[1] // block) * block
+    coarse = free[:ny, :nx].reshape(ny // block, block, nx // block, block).all(axis=(1, 3))
+    need = max(1, min_cells // (block * block))
+    arr = coarse.astype(np.uint8) * 255
+    count, found = 0, []
+    for _ in range(5000):
+        ys, xs = np.nonzero(arr == 255)
+        if not len(ys):
+            break
+        im = Image.frombytes("L", (arr.shape[1], arr.shape[0]), arr.tobytes())
+        ImageDraw.floodfill(im, (int(xs[0]), int(ys[0])), 100)
+        piece = np.asarray(im) == 100
+        n = int(piece.sum())
+        if n >= need:
+            count += 1
+            found.append(n)
+        arr[piece] = 0
+    return sorted(found, reverse=True) if sizes else count
+
+
+def is_magnetic(fp):
+    ref = fp.GetReference().upper()
+    lib = fp.GetFPIDAsString().lower()
+    if any(w in lib for w in MAGNETIC_WORDS):
+        return True
+    return any(ref.startswith(p) and ref[len(p):len(p) + 1].isdigit() for p in MAGNETIC_REFS)
+
+
+class LabCosts:
+    def __init__(self, router):
+        self.router = router
+        rb = self.rb = router.rb
+        g = rb.grid
+        self.shape = (g.ny, g.nx)
+        self.n = len(rb.layers)
+        pour_zones = [z for z in rb.board.Zones() if not z.GetIsRuleArea() and z.GetNetname() in rb.pour_nets]
+        self.pour_layer = [any(z.IsOnLayer(L) for z in pour_zones) for L in rb.layers]
+        self.spokes = self._spokes(pour_zones)
+        self.magnetic = self._magnetics()  # [(nets of the part, [mask per layer])]
+        self.escape_total, self.escape_own = self._escape_room()
+        self.power_pour = self._power_pours()
+        self.edge_band = [~rb.inside(CLOCK_EDGE_MM)] * self.n
+        # cells (beyond the hugging one) where the gap to copper is too narrow to pour
+        gap, width = 0.2, 0.25
+        if pour_zones:
+            z = pour_zones[0]
+            gap = max(T(z.GetLocalClearance() or 0) if hasattr(z, "GetLocalClearance") else 0.0,
+                      T(rb.netclass(z.GetNetname()).GetClearance()))
+            width = T(z.GetMinThickness())
+        self.sliver_cells = int(math.ceil((2 * gap + width) / g.pitch))
+        self.pour_gap = gap
+
+    # --- static maps -----------------------------------------------------------------
+    def _zeros(self):
+        return [np.zeros(self.shape, np.int32) for _ in range(self.n)]
+
+    def _spokes(self, zones):
+        rb = self.rb
+        w = max(rb.widths(n)[0] for n in [""] + list(rb.pour_nets))
+        out = self._zeros()
+        for i, L in enumerate(rb.layers):
+            shapes = []
+            for z in zones:
+                if not z.IsOnLayer(L):
+                    continue
+                gap, spoke = T(z.GetThermalReliefGap()), T(z.GetThermalReliefSpokeWidth())
+                for p in rb.pads:
+                    if p.GetNetname() != z.GetNetname() or not p.IsOnLayer(L):
+                        continue
+                    c = _xy(p)
+                    pts = [pt for o, _h in _polys(_grown(p, L, 0.0)) for pt in o]
+                    for k in range(4):
+                        a = math.radians(p.GetOrientation().AsDegrees() + 90 * k)
+                        u = (math.cos(a), math.sin(a))
+                        ext = max((x - c[0]) * u[0] + (y - c[1]) * u[1] for x, y in pts)
+                        shapes.append(_rect(c, u, ext, ext + gap + rb.min_clearance + w / 2 + 0.2,
+                                            spoke / 2 + rb.min_clearance + w / 2))
+            out[i] += rb.grid.raster(shapes).astype(np.int32) * SPOKES
+        return out
+
+    def _magnetics(self):
+        rb = self.rb
+        out = []
+        for fp in rb.board.GetFootprints():
+            if not is_magnetic(fp):
+                continue
+            nets = {p.GetNetname() for p in fp.Pads() if p.GetNetname()}
+            polys = []
+            fp.BuildCourtyardCaches()
+            for side in (pcbnew.F_CrtYd, pcbnew.B_CrtYd):
+                # grown, so a track's own width stays off the body too
+                sp = fp.GetCourtyard(side).CloneDropTriangulation()
+                sp.Inflate(pcbnew.FromMM(MAGNETICS_MARGIN), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS,
+                           pcbnew.FromMM(0.01))
+                polys += _polys(sp)
+            if not polys:  # no courtyard: the body's box
+                bb = fp.GetBoundingBox(False)
+                polys = [([(T(bb.GetLeft()), T(bb.GetTop())), (T(bb.GetRight()), T(bb.GetTop())),
+                           (T(bb.GetRight()), T(bb.GetBottom())), (T(bb.GetLeft()), T(bb.GetBottom()))], [])]
+            mask = rb.grid.raster(polys)
+            out.append((nets, mask))
+        return out
+
+    def _escape_room(self):
+        """Lanes in front of fine-pitch pins: per layer the count, and per net its own."""
+        rb = self.rb
+        total = self._zeros()
+        own = {}
+        for fp in rb.board.GetFootprints():
+            body = fp.GetBoundingBox(False).GetCenter()
+            for p in fp.Pads():
+                c = _xy(p)
+                if not any(1e-3 < math.dist(c, _xy(q)) < 0.8 for q in fp.Pads()):
+                    continue
+                out = (c[0] - T(body.x), c[1] - T(body.y))
+                n = math.hypot(*out)
+                if n < 0.05:
+                    continue
+                # the pad axis closest to straight out of the part
+                best = None
+                for k in range(4):
+                    a = math.radians(p.GetOrientation().AsDegrees() + 90 * k)
+                    u = (math.cos(a), math.sin(a))
+                    dot = (u[0] * out[0] + u[1] * out[1]) / n
+                    if best is None or dot > best[0]:
+                        best = (dot, u)
+                u = best[1]
+                for i, L in enumerate(rb.layers):
+                    if not p.IsOnLayer(L) and p.GetAttribute() != pcbnew.PAD_ATTRIB_PTH:
+                        continue
+                    pts = [pt for o, _h in _polys(_grown(p, L if p.IsOnLayer(L) else rb.layers[0], 0.0)) for pt in o]
+                    ext = max((x - c[0]) * u[0] + (y - c[1]) * u[1] for x, y in pts)
+                    width = min(T(p.GetSizeX()), T(p.GetSizeY()))
+                    m = rb.grid.raster([_rect(c, u, ext, ext + ESCAPE_MM, width / 2)]).astype(np.int32)
+                    total[i] += m
+                    mine = own.setdefault(p.GetNetname(), self._zeros())
+                    mine[i] += m
+        return total, own
+
+    def _power_pours(self):
+        """Per layer, cells within 1 mm of a power net's pour (not the pour nets)."""
+        rb = self.rb
+        out = []
+        for L in rb.layers:
+            polys = []
+            for z in rb.board.Zones():
+                n = z.GetNetname()
+                if z.GetIsRuleArea() or not n or n in rb.pour_nets or not z.IsOnLayer(L):
+                    continue
+                if rb.netclass(n).GetName().lower() not in ("power", "hv"):
+                    continue
+                sp = z.GetFilledPolysList(L).CloneDropTriangulation()
+                sp.Inflate(pcbnew.FromMM(1.0), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, pcbnew.FromMM(0.01))
+                polys += _polys(sp)
+            out.append(rb.grid.raster(polys))
+        return out
+
+    # --- per connection ------------------------------------------------------------------
+    def penalty(self, conn, blocked, hist, soft=None, soft_cost=0, clock_nets=(), clock_items=(), pour=True):
+        """Per layer bytes for the search (pour=False: without the pour's hug and sliver costs)."""
+        rb = self.rb
+        g = rb.grid
+        fast = conn.group == 1  # switching and clocks
+        sliver = self.sliver_cells
+        out = []
+        for i in range(self.n):
+            p = hist[i].astype(np.int32) + self.spokes[i]
+            if self.pour_layer[i] and pour:
+                hard = np.frombuffer(blocked[i], np.uint8).reshape(self.shape).astype(bool)
+                dist = _dilate(hard, sliver + 2).astype(np.int32)
+                p += np.where(dist <= 1, 0, np.where(dist <= sliver, SLIVER, HUG))
+            for nets, mask in self.magnetic:
+                if conn.net not in nets:
+                    p += mask * MAGNETICS
+            esc = self.escape_total[i]
+            mine = self.escape_own.get(conn.net)
+            p += (esc - (mine[i] if mine is not None else 0) > 0) * ESCAPE
+            if fast:
+                p += self.power_pour[i] * POWER_LAYER
+            if conn.net in clock_nets:
+                p += self.edge_band[i] * CLOCK_EDGE
+            if soft is not None:
+                p += soft[i] * soft_cost
+            out.append(p)
+        if clock_items and conn.net not in clock_nets:
+            out = [p + m * CLOCK_3W for p, m in zip(out, self._near_clocks(clock_items, conn))]
+        return [np.clip(p, 0, 255).astype(np.uint8).tobytes() for p in out]
+
+    def _near_clocks(self, items, conn):
+        rb = self.rb
+        w = rb.widths(conn.net)[0]
+        masks = []
+        for L in rb.layers:
+            polys = []
+            for it in items:
+                if it.IsOnLayer(L):
+                    width = T(it.GetWidth()) if it.Type() == pcbnew.PCB_TRACE_T else 0.3
+                    polys += _polys(_grown(it, L, 3 * width + w / 2))
+            masks.append(rb.grid.raster(polys).astype(np.int32))
+        return masks
+
+    def via_costs(self, conn, lanes, base):
+        """{cell index: via cost} near the connection's own pins (escape vias), and the
+        cost elsewhere."""
+        g = self.rb.grid
+        elsewhere = base * (FAST_VIA_FACTOR if conn.group == 1 else 1.0)
+        near = {}
+        r = int(round(ESCAPE_VIA_MM / g.pitch))
+        for lane in lanes:
+            ci, cj = lane.cell
+            for dj in range(-r, r + 1):
+                for di in range(-r, r + 1):
+                    if di * di + dj * dj <= r * r:
+                        near[(cj + dj) * g.nx + ci + di] = elsewhere * ESCAPE_VIA_FACTOR
+        return near, elsewhere, self.via_pour(conn.net)
+
+    def via_pour(self, net):
+        """A via cuts a disc out of the pour on every layer (its pad and the pour's gap
+        round it): the length of this net's track that cuts as much, in cells. The search
+        charges a via the pour costs of that many cells on each layer, so going down and
+        back up costs what the holes cost the pours, not only the via."""
+        _cls, w, vd, _n = self.rb.key(net)
+        d = vd + 2 * self.pour_gap
+        return math.pi * d * d / 4 / (w + 2 * self.pour_gap) / self.rb.grid.pitch
diff --git a/python/commands/powerlab_router/finish.py b/python/commands/powerlab_router/finish.py
new file mode 100644
index 0000000..e2151ce
--- /dev/null
+++ b/python/commands/powerlab_router/finish.py
@@ -0,0 +1,257 @@
+"""Shortcut pass after routing (plan §4.7; the method of track_opt.py in the lab's
+InductiveEncoder project).
+
+For each run of a connection's track on one layer, from each point jump to the farthest
+later point that a clear straight segment, or a straight + 45 degree dogleg, reaches, if
+that is cheaper, or as cheap with fewer corners. Cheaper by the search's costs plus `bend`
+per corner, so corners that serve nothing go (design rules §3.4, "fewest corners"): a
+little wiggle round a pad, a stair-step, a bend just before a pad. The lab costs that
+matter for the route still count (no cutting under an inductor or across a pin's escape
+room); the pour's hug and sliver costs don't, because they made tracks follow pad outlines
+in little zigzags. Instead the router checks the pour on KiCad's fill after each
+connection (Router._pour_quality) and puts the old track back if the pour got worse.
+- Pads: a fine-pitch pad keeps its straight lane (§3.4, "leave pads straight out"); other
+  pads may be entered at 45 degrees to their centre, as by hand, instead of bending just
+  before the pad to come in square.
+- A track that ends on another track of its net (a T-junction) keeps that end, and never
+  turns to run along the track it joins.
+- Every corner still turns by 45 degrees at most (§3.4). Vias stay where they are.
+- Every new segment is checked exactly against the other nets' copper.
+No pcbnew here: the board is reached through the router's RouterBoard.
+"""
+
+import math
+
+MIN_SEGMENT = 0.2  # mm, between two corners
+MAX_TURN = math.radians(45.5)
+EPS = 1e-4
+BEND = 1.5  # mm: what a corner costs here (as in the search and the drawn shapes)
+
+
+def _unit(a, b):
+    dx, dy = b[0] - a[0], b[1] - a[1]
+    n = math.hypot(dx, dy)
+    return (dx / n, dy / n) if n > EPS else None
+
+
+def _turn_ok(u, v):
+    if u is None or v is None:
+        return True
+    return math.acos(max(-1.0, min(1.0, u[0] * v[0] + u[1] * v[1]))) <= MAX_TURN
+
+
+def _octilinear(dx, dy):
+    return abs(dx) < EPS or abs(dy) < EPS or abs(abs(dx) - abs(dy)) < EPS
+
+
+def _turns(pts):
+    """Changes of direction along a point list."""
+    n = 0
+    for a, b, c in zip(pts, pts[1:], pts[2:]):
+        u, v = _unit(a, b), _unit(b, c)
+        if u is not None and v is not None and abs(u[0] * v[1] - u[1] * v[0]) > 1e-3:
+            n += 1
+    return n
+
+
+def _candidates(p, q):
+    """Ways from p to q made of 45 degree multiples: straight, or a dogleg two ways."""
+    dx, dy = q[0] - p[0], q[1] - p[1]
+    if _octilinear(dx, dy):
+        return [[q]]
+    sx, sy = math.copysign(1, dx), math.copysign(1, dy)
+    a, b = abs(dx), abs(dy)
+    if a > b:
+        straight_first = (p[0] + sx * (a - b), p[1])
+        diagonal_first = (p[0] + sx * b, p[1] + sy * b)
+    else:
+        straight_first = (p[0], p[1] + sy * (b - a))
+        diagonal_first = (p[0] + sx * a, p[1] + sy * a)
+    return [[straight_first, q], [diagonal_first, q]]
+
+
+def _corners(pts):
+    """Drop the points between two collinear segments."""
+    out = pts[:1]
+    for b, c in zip(pts[1:], pts[2:]):
+        a = out[-1]
+        u, v = _unit(a, b), _unit(b, c)
+        if u is None or (v is not None and abs(u[0] * v[1] - u[1] * v[0]) < 1e-6 and u[0] * v[0] + u[1] * v[1] > 0):
+            continue
+        out.append(b)
+    return out + pts[-1:] if len(pts) > 1 else pts
+
+
+def _length(pts):
+    return sum(math.dist(a, b) for a, b in zip(pts, pts[1:]))
+
+
+def _shorten(clear, pts, lo, hi, cost=None, bend=0.0, forbid_end=None):
+    """Shortcut pts[lo..hi]; segments before lo and after hi stay. `clear(a, b)` says
+    whether a segment keeps its clearance; `cost(a, b)` what it costs (default: length);
+    `bend` what a corner costs; `forbid_end`: a unit direction the last segment may not
+    run along (the track a T-junction joins)."""
+    cost = cost or math.dist
+
+    def score(ps, before, after):
+        chain = ([before] if before is not None else []) + ps + ([after] if after is not None else [])
+        return sum(cost(a, b) for a, b in zip(ps, ps[1:])) + bend * _turns(chain)
+
+    out = pts[:lo + 1]
+    i = lo
+    while i < hi:
+        done = False
+        for j in range(hi, i + 1, -1):
+            before = out[-2] if len(out) >= 2 else None
+            after = pts[j + 1] if j + 1 < len(pts) else None
+            old = score(pts[i:j + 1], before, after)
+            for mids in _candidates(pts[i], pts[j]):
+                new = [pts[i]] + mids
+                # cheaper, or as cheap with fewer corners (a staircase of 45 and 90 degree
+                # steps is as long as one dogleg)
+                c = score(new, before, after)
+                if c > old + 0.01 or (c > old - 0.01 and len(new) >= j - i + 1):
+                    continue
+                if any(math.dist(a, b) < MIN_SEGMENT for a, b in zip(new, new[1:])):
+                    continue
+                dirs = [_unit(before, out[-1]) if before is not None else None]
+                dirs += [_unit(a, b) for a, b in zip(new, new[1:])]
+                dirs.append(_unit(pts[j], after) if after is not None else None)
+                if not all(_turn_ok(u, v) for u, v in zip(dirs, dirs[1:])):
+                    continue
+                if forbid_end is not None and j == len(pts) - 1:
+                    u = _unit(new[-2], new[-1])
+                    if u is not None and abs(u[0] * forbid_end[1] - u[1] * forbid_end[0]) < 1e-3:
+                        continue
+                if all(clear(a, b) for a, b in zip(new, new[1:])):
+                    out += mids
+                    i = j
+                    done = True
+                    break
+            if done:
+                break
+        if not done:
+            out.append(pts[i + 1])
+            i += 1
+    return out + pts[hi + 1:]
+
+
+def _on(point, pieces, layer):
+    """Whether point lies on one of the pieces' segments on `layer`."""
+    for L, pts in pieces:
+        if L != layer:
+            continue
+        for a, b in zip(pts, pts[1:]):
+            dx, dy = b[0] - a[0], b[1] - a[1]
+            n2 = dx * dx + dy * dy
+            t = 0.0 if n2 < 1e-12 else max(0.0, min(1.0, ((point[0] - a[0]) * dx + (point[1] - a[1]) * dy) / n2))
+            if math.dist(point, (a[0] + t * dx, a[1] + t * dy)) < 0.005:
+                return True
+    return False
+
+
+def _joined_along(c):
+    """The unit direction of the track c's T-junction end lies on, or None."""
+    if c.tee is None or not c.tee.geo:
+        return None
+    L, pts = c.geo[0][-1]
+    end = pts[-1]
+    for M, qs in c.tee.geo[0]:
+        if M != L:
+            continue
+        for a, b in zip(qs, qs[1:]):
+            if _on(end, [(L, [a, b])], L):
+                return _unit(a, b)
+    return None
+
+
+def shortcut(router, conns):
+    """Shorten the routed connections in place; returns a summary."""
+    rb = router.rb
+    g = rb.grid
+    stats = {"connections_shortened": 0, "mm_saved": 0.0, "corners_removed": 0, "undone": 0, "pour_kept": 0}
+    for c in conns:
+        if not c.items:
+            continue
+        pieces, vias = c.geo
+        w = rb.widths(c.net)[0]
+        vd = rb.key(c.net)[2]
+        blocked = rb.obstacles(c.net)[0]
+        penalty = router._penalty(c, blocked, pour=False)
+        unit = router.costs.unit
+        factor = router.costs.layer_factor
+
+        def cost_on(L):
+            pen = penalty[L] if penalty is not None else None
+
+            def cost(a, b):
+                d = math.dist(a, b)
+                diag = abs(abs(b[0] - a[0]) - abs(b[1] - a[1])) < 1e-6 and abs(b[0] - a[0]) > 1e-6
+                total = d * factor.get(L, 1.0) * (router.costs.diagonal if diag else 1.0)
+                if pen is None or d < EPS:
+                    return total
+                n = max(1, int(d / (g.pitch / 2)))
+                for k in range(n):
+                    x = a[0] + (b[0] - a[0]) * (k + 0.5) / n
+                    y = a[1] + (b[1] - a[1]) * (k + 0.5) / n
+                    i, j = g.cell(x, y)
+                    if 0 <= i < g.nx and 0 <= j < g.ny:
+                        total += pen[j * g.nx + i] * unit * (d / n) / g.pitch
+                return total
+            return cost
+        along = _joined_along(c)
+        new_pieces, saved, corners = [], 0.0, 0
+        for k, (L, pts) in enumerate(pieces):
+            first, last = k == 0, k == len(pieces) - 1
+            # a pad end may move off its lane unless the pad is fine pitch; a T-junction
+            # end stays put, but the way into it may change
+            lo = (0 if router._free_end(c, pts[0]) else 1) if first else 0
+            if last and c.tee is None:
+                hi = len(pts) - 1 if router._free_end(c, pts[-1]) else len(pts) - 2
+            else:
+                hi = len(pts) - 1
+            if hi - lo < 2:
+                new_pieces.append((L, pts))
+                continue
+            layer = rb.layers[L]
+
+            # the exact check sees copper and the board edge; the rule areas come from the grid
+            def ok(a, b, layer=layer, L=L):
+                return router._outside_keepouts([a, b], L, w, vd) and rb.clear(c.net, layer, a, b, w)
+            new = _corners(_shorten(ok, pts, lo, hi, cost_on(L), bend=BEND, forbid_end=along if last else None))
+            saved += _length(pts) - _length(new)
+            corners += _turns(pts) - _turns(new)
+            new_pieces.append((L, new))
+        if saved < 0.01 and corners <= 0:
+            continue
+        before_q = router._pour_quality() if router.pour_net else None
+        old_geo, old_items = c.geo, c.items
+        for it in old_items:
+            router.owner.pop(it.m_Uuid.AsString(), None)
+        rb.remove(old_items)
+        items = rb.add(c.net, new_pieces, vias)
+        router._q = None
+        # the tracks that end on this one must still find it
+        kids = [d for d in set(router.owner.values()) if d.tee is c and d.items]
+        bad = rb.violations(c.net, items) or any(not _on(d.geo[0][-1][1][-1], new_pieces, d.geo[0][-1][0]) for d in kids)
+        if not bad and before_q is not None and router._pour_quality() > before_q:
+            bad = True
+            stats["pour_kept"] += 1
+        else:
+            stats["undone"] += 1 if bad else 0
+        if bad:
+            rb.remove(items)
+            items = rb.add(c.net, *old_geo)
+            router._q = None
+        else:
+            c.geo = (new_pieces, vias)
+            stats["connections_shortened"] += 1
+            stats["mm_saved"] += saved
+            stats["corners_removed"] += corners
+        rb.uncommit(c.net, [it for d in set(router.owner.values()) if d.net == c.net and d is not c for it in d.items])
+        rb.commit(c.net, items)
+        c.items = items
+        for it in items:
+            router.owner[it.m_Uuid.AsString()] = c
+    stats["mm_saved"] = round(stats["mm_saved"], 1)
+    return stats
diff --git a/python/commands/powerlab_router/grid.py b/python/commands/powerlab_router/grid.py
new file mode 100644
index 0000000..766ed64
--- /dev/null
+++ b/python/commands/powerlab_router/grid.py
@@ -0,0 +1,48 @@
+"""The router's grid: copper shapes rasterised per layer (numpy and Pillow, no pcbnew).
+
+A cell is blocked when a track centre line there would be too close to something. Shapes
+come in already grown by the clearance and half the track width, so the search only moves
+a point. Pillow also fills the cells under a polygon's outline, which errs on the safe side.
+"""
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+
+class Grid:
+    def __init__(self, x0, y0, x1, y1, pitch):
+        self.x0, self.y0, self.pitch = x0, y0, pitch
+        self.nx = int((x1 - x0) / pitch) + 2
+        self.ny = int((y1 - y0) / pitch) + 2
+
+    def px(self, x, y):
+        return ((x - self.x0) / self.pitch, (y - self.y0) / self.pitch)
+
+    def cell(self, x, y):
+        return (int(round((x - self.x0) / self.pitch)), int(round((y - self.y0) / self.pitch)))
+
+    def at(self, i, j):
+        return (self.x0 + i * self.pitch, self.y0 + j * self.pitch)
+
+    def raster(self, polygons):
+        """polygons: [(outline, holes)] in mm -> bool array [ny, nx], True inside."""
+        im = Image.new("1", (self.nx, self.ny), 0)
+        draw = ImageDraw.Draw(im)
+        holed = []
+        for outline, holes in polygons:
+            if len(outline) < 3:
+                continue
+            if holes:
+                holed.append((outline, holes))
+                continue
+            draw.polygon([self.px(*p) for p in outline], fill=1, outline=1)
+        out = np.array(im, dtype=bool)
+        for outline, holes in holed:  # each on its own image, so a hole can't clear a neighbour
+            one = Image.new("1", (self.nx, self.ny), 0)
+            d = ImageDraw.Draw(one)
+            d.polygon([self.px(*p) for p in outline], fill=1, outline=1)
+            for hole in holes:
+                if len(hole) >= 3:
+                    d.polygon([self.px(*p) for p in hole], fill=0, outline=1)
+            out |= np.array(one, dtype=bool)
+        return out
diff --git a/python/commands/powerlab_router/groups.py b/python/commands/powerlab_router/groups.py
new file mode 100644
index 0000000..4d59b97
--- /dev/null
+++ b/python/commands/powerlab_router/groups.py
@@ -0,0 +1,75 @@
+"""Routing groups in the lab order (design rules §3.4; plan §5). No pcbnew.
+
+Power first, then switching and clocks, differential pairs, sensitive analog, and the
+rest. Names are matched on the net's last path segment, ignoring case; KiCad's automatic
+names (Net-(R1-Pad2)) only go by net class. The user can move nets between groups.
+"""
+
+import fnmatch
+import re
+
+GROUPS = ("power", "switching and clocks", "differential pairs", "sensitive analog", "other")
+
+POWER_CLASSES = ("power", "gnd", "hv")
+POWER = ("+*", "-*", "vbus*", "vcc*", "vdd*", "vin*", "vbat*")
+SWITCHING = ("*gate*", "*pwm*", "*boot*", "*_ho*", "*_lo*", "gh?", "gl?", "*_sw", "sw_*", "*sw_node*",
+             "*clk*", "*sck*", "*xtal*", "*osc*")
+ANALOG = ("*sense*", "*sens_*", "*sns*", "*isen*", "*ref*", "*adc*", "*ain*", "*sensor*", "*kelvin*")
+PAIR_SUFFIXES = (("_p", "_n"), ("+", "-"), ("_h", "_l"), ("_dp", "_dn"), ("usb_dp", "usb_dn"))
+
+
+CLOCKS = ("*clk*", "*sck*", "*xtal*", "*osc*")
+
+
+def is_clock(net):
+    return _match(_short(net), CLOCKS)
+
+
+def _short(net):
+    return net.rsplit("/", 1)[-1].lower()
+
+
+def _match(name, patterns):
+    return any(fnmatch.fnmatchcase(name, p) for p in patterns)
+
+
+def pairs(nets):
+    """{net: partner} for differential pairs found by suffix (USB_DP/USB_DN, CAN_H/CAN_L...)."""
+    by_short = {_short(n): n for n in nets}
+    out = {}
+    for n in nets:
+        s = _short(n)
+        for a, b in PAIR_SUFFIXES:
+            if s.endswith(a) and len(s) > len(a):
+                partner = by_short.get(s[: -len(a)] + b)
+                if partner and partner != n:
+                    out[n] = partner
+                    out[partner] = n
+    return out
+
+
+def classify(nets, netclass_of, overrides=None):
+    """{net: group index}. `netclass_of(net)` gives the net class name; `overrides` maps
+    a net to a group index or name."""
+    overrides = overrides or {}
+    paired = pairs(nets)
+    out = {}
+    for n in nets:
+        if n in overrides:
+            g = overrides[n]
+            out[n] = GROUPS.index(g) if isinstance(g, str) else int(g)
+            continue
+        s = _short(n)
+        auto = s.startswith("net-(") or re.match(r"unconnected-", s)
+        cls = (netclass_of(n) or "").lower()
+        if cls in POWER_CLASSES or (not auto and _match(s, POWER)):
+            out[n] = 0
+        elif not auto and _match(s, SWITCHING):
+            out[n] = 1
+        elif n in paired or cls in ("usb", "diff", "differential"):
+            out[n] = 2
+        elif not auto and _match(s, ANALOG):
+            out[n] = 3
+        else:
+            out[n] = 4
+    return out
diff --git a/python/commands/powerlab_router/model.py b/python/commands/powerlab_router/model.py
new file mode 100644
index 0000000..f2906cd
--- /dev/null
+++ b/python/commands/powerlab_router/model.py
@@ -0,0 +1,800 @@
+"""Board side of the PowerLab router (pcbnew): obstacles, pad entry lanes, results as tracks.
+
+Clearances are KiCad's: the larger of the two net classes' clearances and the board
+minimum, overridden by the board's custom rules (.kicad_dru, see rules.py). Edge and hole
+clearances come from the board constraints. Pour nets aren't obstacles (the pour refills
+around new copper). Copper of the net being routed isn't an obstacle either.
+
+The grids are kept per "key" (net class, track width, via size; plus the net when rules
+compare net names): one raster per net and layer, and a count of nets per cell. A net's
+obstacles are then the cells some other net covers, and new copper is stamped in
+without rebuilding anything. The board's own copper and the router's are kept apart, so
+the router's copper of some nets can be "soft" for a rip-up search: passable at a cost.
+"""
+
+import copy
+import math
+import os
+import time
+
+import numpy as np
+import pcbnew
+
+from commands.powerlab_router import search
+from commands.powerlab_router.grid import Grid
+from commands.powerlab_router.rules import Rules
+
+MM, T = pcbnew.FromMM, pcbnew.ToMM
+VIA_TO_PAD = 0.25  # via ring to a pad edge (§3.5)
+FINE_PITCH = 0.8  # pads closer than this are fine pitch: leave straight out (§3.4)
+UNDER_BODY = 1.5  # extra cost (mm) for a lane that leaves a pad under its part
+DIAGONAL_ENTRY = 0.3  # extra cost (mm) for entering a pad that has axes at 45 degrees
+TEE_PAD_MM = 1.0  # a track joins its net's track no closer than this to a pad centre (§3.4)
+USED_LANE = 3.0  # extra cost (mm) for a lane another track of the net already leaves by
+LANE_TRIES = 6  # exit lengths tried per lane, one grid cell apart
+ERR = MM(0.005)
+TYPES = {pcbnew.PCB_PAD_T: "Pad", pcbnew.PCB_TRACE_T: "Track", pcbnew.PCB_ARC_T: "Track",
+         pcbnew.PCB_VIA_T: "Via", pcbnew.PCB_ZONE_T: "Zone"}
+
+
+def _polys(sps):
+    out = []
+    for i in range(sps.OutlineCount()):
+        o = sps.Outline(i)
+        outline = [(T(o.CPoint(k).x), T(o.CPoint(k).y)) for k in range(o.PointCount())]
+        holes = []
+        for h in range(sps.HoleCount(i)):
+            hc = sps.Hole(i, h)
+            holes.append([(T(hc.CPoint(k).x), T(hc.CPoint(k).y)) for k in range(hc.PointCount())])
+        out.append((outline, holes))
+    return out
+
+
+def _grown(item, layer, by_mm):
+    sp = pcbnew.SHAPE_POLY_SET()
+    item.TransformShapeToPolygon(sp, layer, MM(by_mm), ERR, pcbnew.ERROR_OUTSIDE)
+    return sp
+
+
+def is_round(pad, layer):
+    try:
+        shape = pad.GetShape(layer)
+    except TypeError:
+        shape = pad.GetShape()
+    return shape == pcbnew.PAD_SHAPE_CIRCLE
+
+
+def _uuid(item):
+    return item.m_Uuid.AsString()
+
+
+class Lane:
+    """A straight way into a pad: from its centre along `direction` to the exit point."""
+
+    def __init__(self, pad, layer, direction, centre, exit_mm, cell, cost):
+        self.pad, self.layer, self.direction = pad, layer, direction
+        self.centre, self.exit, self.cell, self.cost = centre, exit_mm, cell, cost
+
+
+class _Occupancy:
+    """The grids for one key: per net and layer, where that net's copper keeps a track
+    centre (and a via centre) of the key's nets away; and per cell, how many nets do."""
+
+    def __init__(self, rb, key):
+        self.rb, self.key = rb, key
+        g = rb.grid
+        n = len(rb.layers)
+        self.fixed_t, self.fixed_v = {}, {}  # net -> [bool array per layer]: the board's copper
+        self.new_t, self.new_v = {}, {}  # the router's copper
+        self.track, self.via = {}, {}  # both
+        self.t_count = [np.zeros((g.ny, g.nx), np.uint16) for _ in range(n)]
+        self.v_count = [np.zeros((g.ny, g.nx), np.uint16) for _ in range(n)]
+        self.own_via = {}
+        _cls, w, vd, _net = key
+        edge, hole = rb.edge_clearance, rb.hole_clearance
+        inside_t = rb.inside(edge + w / 2)
+        inside_v = rb.inside(edge + vd / 2)
+        keep = rb.keepouts(w, vd)
+        self.static_t = [~inside_t | k for k in keep[0]]
+        self.static_v = ~inside_v
+        for k in keep[1]:
+            self.static_v |= k
+        fixed, new = {}, {}
+        for item, net in rb.copper_items():
+            (new if _uuid(item) in rb.router_items else fixed).setdefault(net, []).append(item)
+        for net, items in fixed.items():
+            self.fixed_t[net], self.fixed_v[net] = self._raster(items)
+        for net, items in new.items():
+            self.new_t[net], self.new_v[net] = self._raster(items)
+        for net in set(fixed) | set(new):
+            self._update(net)
+
+    def _raster(self, items):
+        rb = self.rb
+        _cls, w, vd, _net = self.key
+        tp = {L: [] for L in rb.layers}
+        vp = {L: [] for L in rb.layers}
+        for it in items:
+            for L in rb.layers:
+                if not it.IsOnLayer(L) or (it.Type() == pcbnew.PCB_PAD_T and it.GetAttribute() == pcbnew.PAD_ATTRIB_NPTH):
+                    continue
+                c_t = rb.clearance_to(it, self.key, "Track", L)
+                c_v = rb.clearance_to(it, self.key, "Via", L)
+                if it.Type() == pcbnew.PCB_ZONE_T:
+                    for by, dst in ((c_t + w / 2, tp), (c_v + vd / 2, vp)):
+                        sp = it.GetFilledPolysList(L).CloneDropTriangulation()
+                        sp.Inflate(MM(by), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+                        dst[L] += _polys(sp)
+                    continue
+                tp[L] += _polys(_grown(it, L, c_t + w / 2))
+                if it.Type() == pcbnew.PCB_PAD_T:
+                    c_v = max(c_v, VIA_TO_PAD)
+                vp[L] += _polys(_grown(it, L, c_v + vd / 2))
+            if it.Type() == pcbnew.PCB_PAD_T and (it.HasHole() or it.GetAttribute() == pcbnew.PAD_ATTRIB_NPTH):
+                for by, dst in ((rb.hole_clearance + w / 2, tp), (rb.hole_clearance + vd / 2, vp)):
+                    hole = pcbnew.SHAPE_POLY_SET()
+                    it.TransformHoleToPolygon(hole, MM(by), ERR, pcbnew.ERROR_OUTSIDE)
+                    for L in rb.layers:
+                        dst[L] += _polys(hole)
+        g = rb.grid
+        return [g.raster(tp[L]) for L in rb.layers], [g.raster(vp[L]) for L in rb.layers]
+
+    def _update(self, net):
+        """Recount `net` after its fixed or new copper changed."""
+        n = len(self.t_count)
+        parts_t = [x for x in (self.fixed_t.get(net), self.new_t.get(net)) if x is not None]
+        parts_v = [x for x in (self.fixed_v.get(net), self.new_v.get(net)) if x is not None]
+        track = [np.logical_or.reduce([p[i] for p in parts_t]) for i in range(n)]
+        via = [np.logical_or.reduce([p[i] for p in parts_v]) for i in range(n)]
+        old_t, old_v = self.track.get(net), self.via.get(net)
+        for i in range(n):
+            if old_t is not None:
+                self.t_count[i] -= old_t[i]
+                self.v_count[i] -= old_v[i]
+            self.t_count[i] += track[i]
+            self.v_count[i] += via[i]
+        self.track[net], self.via[net] = track, via
+
+    def stamp(self, net, items):
+        """Add the router's new copper of `net`."""
+        t, v = self._raster(items)
+        if net in self.new_t:
+            t = [a | b for a, b in zip(self.new_t[net], t)]
+            v = [a | b for a, b in zip(self.new_v[net], v)]
+        self.new_t[net], self.new_v[net] = t, v
+        self._update(net)
+
+    def set_new(self, net, items):
+        """Replace the router's copper of `net` (after a rip-up)."""
+        if items:
+            self.new_t[net], self.new_v[net] = self._raster(items)
+        else:
+            self.new_t.pop(net, None)
+            self.new_v.pop(net, None)
+        self._update(net)
+
+    def blocked(self, net, soft=()):
+        """(track bytes, via_ok bytes, soft masks or None). `soft`: nets whose router copper
+        doesn't block, but is returned as masks so the search can price it."""
+        mine_t = self.track.get(net)
+        mine_v = self.via.get(net)
+        out_t, out_soft = [], []
+        via_block = self.static_v.copy()
+        for i in range(len(self.t_count)):
+            t = self.t_count[i].astype(np.int32)
+            if mine_t is not None:
+                t -= mine_t[i]
+            soft_any = np.zeros(t.shape, bool)
+            for s in soft:
+                if s == net or s not in self.new_t:
+                    continue
+                t -= self.track[s][i]
+                if s in self.fixed_t:
+                    t += self.fixed_t[s][i]
+                soft_any |= self.new_t[s][i]
+            hard = (t > 0) | self.static_t[i]
+            out_t.append(hard.astype(np.uint8).tobytes())
+            out_soft.append(soft_any & ~hard)
+            v = self.v_count[i] - (mine_v[i] if mine_v is not None else 0)
+            via_block |= v > 0
+        via_block |= self._own_via(net)
+        return out_t, (~via_block).astype(np.uint8).tobytes(), (out_soft if soft else None)
+
+    def _own_via(self, net):
+        """A via keeps VIA_TO_PAD from the net's own pads too (§3.5)."""
+        if net not in self.own_via:
+            rb = self.rb
+            vd = self.key[2]
+            polys = []
+            for p in rb.pads:
+                if p.GetNetname() != net:
+                    continue
+                for L in rb.layers:
+                    if p.IsOnLayer(L):
+                        polys += _polys(_grown(p, L, VIA_TO_PAD + vd / 2))
+            self.own_via[net] = rb.grid.raster(polys)
+        return self.own_via[net]
+
+
+class RouterBoard:
+    def __init__(self, board, pitch=0.1, pour_nets=("GND",), rules=None):
+        self.board = board
+        self.pour_nets = set(pour_nets)
+        self.layers = list(board.GetEnabledLayers().CuStack())
+        self.layer_names = {L: board.GetLayerName(L) for L in self.layers}
+        ds = board.GetDesignSettings()
+        self.ns = ds.m_NetSettings
+        self.min_clearance = T(ds.m_MinClearance)
+        self.edge_clearance = T(ds.m_CopperEdgeClearance)
+        self.hole_clearance = T(ds.m_HoleClearance)
+        if rules is None:
+            dru = os.path.splitext(board.GetFileName())[0] + ".kicad_dru"
+            rules = Rules.load(dru) if os.path.isfile(dru) else Rules()
+        self.rules = rules
+        self.outline = pcbnew.SHAPE_POLY_SET()
+        board.GetBoardPolygonOutlines(self.outline, False)
+        bb = board.GetBoardEdgesBoundingBox()
+        self.grid = Grid(T(bb.GetLeft()), T(bb.GetTop()), T(bb.GetRight()), T(bb.GetBottom()), pitch)
+        self.pads = [p for fp in board.GetFootprints() for p in fp.Pads()]
+        self._props = {}
+        self._occ = {}
+        self.router_items = set()  # uuids of the copper this router added
+        self._others = {}
+        self._inside = {}
+
+    # --- rules -------------------------------------------------------------------------
+    def netclass(self, net):
+        return self.ns.GetEffectiveNetClass(net)
+
+    def widths(self, net):
+        nc = self.netclass(net)
+        return T(nc.GetTrackWidth()), T(nc.GetViaDiameter()), T(nc.GetViaDrill())
+
+    def key(self, net, extra=0.0):
+        w, vd, _drill = self.widths(net)
+        name = net if self.rules.uses_net_names else None
+        return (self.netclass(net).GetName(), round(w + 2 * extra, 4), round(vd + 2 * extra, 4), name)
+
+    def props(self, item):
+        u = _uuid(item)
+        if u not in self._props:
+            net = item.GetNetname()
+            p = {"Type": TYPES.get(item.Type(), "Other"), "NetName": net,
+                 "NetClass": self.netclass(net).GetName() if net else "Default",
+                 "Layers": [self.layer_names[L] for L in self.layers if item.IsOnLayer(L)], "Footprint": None}
+            if item.Type() in (pcbnew.PCB_TRACE_T, pcbnew.PCB_ARC_T):
+                p["Width"] = T(item.GetWidth())
+            if item.Type() == pcbnew.PCB_PAD_T:
+                p["Footprint"] = item.GetParentFootprint().GetReference()
+                p["Plated"] = item.GetAttribute() != pcbnew.PAD_ATTRIB_NPTH
+            self._props[u] = p
+        return self._props[u]
+
+    def routed_props(self, key, kind):
+        cls, w, _vd, net = key
+        p = {"Type": kind, "NetName": net, "NetClass": cls, "Footprint": None,
+             "Layers": list(self.layer_names.values())}
+        if kind == "Track":
+            p["Width"] = w
+        return p
+
+    def clearance_to(self, item, key, kind, layer):
+        """Clearance between `item` and new copper (`kind` "Track"/"Via") of the key's nets."""
+        ip = self.props(item)
+        a = T(self.netclass(ip["NetName"]).GetClearance()) if ip["NetName"] else self.min_clearance
+        b = T(self.ns.GetNetClassByName(key[0]).GetClearance()) if key[0] else self.min_clearance
+        default = max(a, b, self.min_clearance)
+        return self.rules.clearance(ip, self.routed_props(key, kind), self.layer_names[layer], default)
+
+    # --- geometry ------------------------------------------------------------------------
+    def inside(self, by):
+        """Cells at least `by` mm inside the board outline. Pillow fills the cells under a
+        polygon's outline too, which errs outward here, so the outline shrinks a cell more."""
+        k = round(by, 4)
+        if k not in self._inside:
+            sp = self.outline.CloneDropTriangulation()
+            sp.Inflate(MM(-(by + self.grid.pitch)), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+            self._inside[k] = self.grid.raster(_polys(sp))
+        return self._inside[k]
+
+    def keepouts(self, w, vd):
+        """Rule areas that keep tracks out: per layer, for track centres and for vias. The
+        board's own and the footprints' (a module's antenna keepout comes with its footprint)."""
+        t = [np.zeros((self.grid.ny, self.grid.nx), bool) for _ in self.layers]
+        v = [np.zeros((self.grid.ny, self.grid.nx), bool) for _ in self.layers]
+        zones = list(self.board.Zones()) + [z for fp in self.board.GetFootprints() for z in fp.Zones()]
+        for z in zones:
+            if not z.GetIsRuleArea():
+                continue
+            for i, L in enumerate(self.layers):
+                if not z.IsOnLayer(L):
+                    continue
+                if z.GetDoNotAllowTracks():
+                    sp = z.Outline().CloneDropTriangulation()
+                    sp.Inflate(MM(w / 2), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+                    t[i] |= self.grid.raster(_polys(sp))
+                if z.GetDoNotAllowVias():
+                    sp = z.Outline().CloneDropTriangulation()
+                    sp.Inflate(MM(vd / 2), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+                    v[i] |= self.grid.raster(_polys(sp))
+        return t, v
+
+    def copper_items(self):
+        """(item, net) for everything that can be in a new track's way."""
+        out = [(p, p.GetNetname()) for p in self.pads]
+        out += [(t, t.GetNetname()) for t in self.board.GetTracks()]
+        out += [(z, z.GetNetname()) for z in self.board.Zones()
+                if not z.GetIsRuleArea() and z.GetNetname() not in self.pour_nets]
+        return out
+
+    # --- obstacles -------------------------------------------------------------------------
+    def occupancy(self, key):
+        if key not in self._occ:
+            self._occ[key] = _Occupancy(self, key)
+        return self._occ[key]
+
+    def obstacles(self, net, extra=0.0):
+        """Per layer: flat bytes, 1 where this net's track centre can't go; and where a via can.
+        `extra` (mm) keeps everything that much further away, for a retry after the exact check."""
+        return self.occupancy(self.key(net, extra)).blocked(net)[:2]
+
+    def obstacles_soft(self, net, soft, extra=0.0):
+        """Like obstacles(), with the router's copper of the `soft` nets left passable;
+        also returns where that copper is, per layer (bool arrays)."""
+        return self.occupancy(self.key(net, extra)).blocked(net, soft)
+
+    # --- pad entry lanes ---------------------------------------------------------------
+    def lanes(self, pad, blocked, net, exact=True, ignore=None):
+        """Straight ways out of a pad along its axes, on each of its copper layers.
+        Under the part only at a cost; at fine pitch only straight out of the pin row.
+        With exact=False, only the grid is asked (cheap, for ordering)."""
+        w = self.widths(net)[0]
+        g = self.grid
+        fp = pad.GetParentFootprint()
+        me = _uuid(pad)
+        cx, cy = T(pad.GetPosition().x), T(pad.GetPosition().y)
+        fine = any(_uuid(p) != me and 1e-3 < math.hypot(T(p.GetPosition().x) - cx, T(p.GetPosition().y) - cy) < FINE_PITCH
+                   for p in fp.Pads())
+        # the body's centre, not the pads' average: a USB-C receptacle's pins sit at its back
+        bbox = fp.GetBoundingBox(False)
+        out = (cx - T(bbox.GetCenter().x), cy - T(bbox.GetCenter().y))
+        out_len = math.hypot(*out)
+        theta = pad.GetOrientation().AsDegrees()
+        result = []
+        for L_idx, L in enumerate(self.layers):
+            if not pad.IsOnLayer(L):
+                continue
+            pts = [pt for outline, _h in _polys(_grown(pad, L, 0.0)) for pt in outline]
+            # a round pad has no axis: every 45 degree direction goes straight to its centre.
+            # Other pads are entered along an axis, or at 45 degrees to their centre where
+            # they aren't fine pitch (as by hand: no extra bend just to come in square)
+            for k in range(8):
+                a = theta + 45 * k
+                if k % 2 and not is_round(pad, L) and fine:
+                    continue
+                d8 = a / 45.0
+                if abs(d8 - round(d8)) > 1e-3:
+                    continue  # pad not at a multiple of 45 degrees
+                d = int(round(d8)) % 8
+                ux, uy = math.cos(math.radians(a)), math.sin(math.radians(a))
+                penalty = DIAGONAL_ENTRY if k % 2 and not is_round(pad, L) else 0.0
+                if out_len > 0.05:
+                    dot = (ux * out[0] + uy * out[1]) / out_len
+                    if fine and dot < 0.7:
+                        continue
+                    if dot < -0.3:
+                        penalty += UNDER_BODY  # under the part: fine for a module's edge pads
+                extent = max((px - cx) * ux + (py - cy) * uy for px, py in pts)
+                preferred = extent + max(w, 0.5 if fine else 0.3)
+                # the lane is checked exactly (the grid is too coarse between fine-pitch pads);
+                # only its exit cell, where the search starts, must be free on the grid, so a
+                # few lengths are tried: the preferred one and longer, then shorter ones down
+                # to a track width beyond the pad (the grid errs by about a cell at a pin row)
+                longer = [preferred + k * g.pitch for k in range(LANE_TRIES)]
+                shorter = []
+                s = preferred - g.pitch
+                while s >= extent + w - 1e-9:
+                    shorter.append(s)
+                    s -= g.pitch
+                for length in longer + shorter:
+                    ex, ey = cx + ux * length, cy + uy * length
+                    cell = g.cell(ex, ey)
+                    if not (0 <= cell[0] < g.nx and 0 <= cell[1] < g.ny):
+                        continue
+                    if blocked[L_idx][cell[1] * g.nx + cell[0]]:
+                        continue
+                    if not exact or self.clear(net, L, (cx, cy), (ex, ey), w, ignore):
+                        result.append(Lane(pad, L_idx, d, (cx, cy), (ex, ey), cell, length + penalty))
+                        break
+        return result
+
+    def lane_shape(self, lane, net):
+        """Where a track of `net` can't go without blocking `lane` (for reserving it): the
+        lane from the pad's edge to its exit, grown by the clearance and half a track."""
+        w = self.widths(net)[0]
+        c = self.clearance_to(lane.pad, self.key(net), "Track", self.layers[lane.layer])
+        (cx, cy), (ex, ey) = lane.centre, lane.exit
+        L = math.hypot(ex - cx, ey - cy) or 1.0
+        ux, uy = (ex - cx) / L, (ey - cy) / L
+        half = w + c  # the lane's own half width (w/2) plus clearance plus half the other track
+        nx_, ny_ = -uy * half, ux * half
+        return ([(cx + nx_, cy + ny_), (ex + ux * half + nx_, ey + uy * half + ny_),
+                 (ex + ux * half - nx_, ey + uy * half - ny_), (cx - nx_, cy - ny_)], [])
+
+    # --- one connection ----------------------------------------------------------------
+    def route(self, net, pad_a, pad_b, blocked, via_ok, costs, margins=(3.0, 10.0, None), penalty=None,
+              ignore=None, via_costs=None, tree=None, used=None):
+        """`penalty`: per layer bytes of extra cost per cell; `ignore`: uuids of other nets'
+        copper the exact lane checks may pass through (it's being ripped up); `via_costs`:
+        lanes -> ({cell index: via cost}, via cost elsewhere).
+        `tree`: [(layer index, p, q)], the net's own tracks already joined to pad_b. The way
+        may end on one of them instead of at pad_b, as a person joins a track to the net's
+        track that is already there instead of running a second one beside it (info["tee"]
+        is then the index of that track). It joins at an angle, never along the track, and
+        not within TEE_PAD_MM of a pad (the pad is the junction there, §3.4).
+        `used`: {(pad uuid, layer index, direction)} lanes the net's tracks already leave by;
+        a second track there would lie on the first, so those lanes cost USED_LANE more."""
+        g = self.grid
+        la, lb = self.lanes(pad_a, blocked, net, ignore=ignore), self.lanes(pad_b, blocked, net, ignore=ignore)
+        info = {"lanes": (len(la), len(lb)), "nodes": 0, "seconds": 0.0}
+        if not la or not lb:
+            info["fail"] = "no free entry lane"
+            return None, info
+        if used:
+            for l in la + lb:
+                if (_uuid(l.pad), l.layer, l.direction) in used:
+                    l.cost += USED_LANE
+        starts = [(l.cell[0], l.cell[1], l.layer, l.direction, l.cost) for l in la]
+        goals = {(l.cell[0], l.cell[1], l.layer): ((l.direction + 4) % 8, l.cost) for l in lb}
+        tree_at = self._tree_goals(net, tree, blocked, goals) if tree else {}
+        for key in tree_at:
+            goals[key] = (tree_at[key][2], 0.0)
+        back = [(l.cell[0], l.cell[1], l.layer, 0, 0) for l in lb]
+        if (search.enclosed(blocked, via_ok, g.nx, g.ny, starts, goals)
+                or search.enclosed(blocked, via_ok, g.nx, g.ny, back, {(l.cell[0], l.cell[1], l.layer): None for l in la})):
+            info["fail"] = "closed pocket"
+            return None, info
+        cells = [l.cell for l in la + lb]
+        # the cheapest a way could be: the octilinear distance between the lane exits
+        lower = min(math.dist(a.exit, b.exit) for a in la for b in lb)
+        if tree_at:
+            lower = min([lower] + [math.dist(a.exit, t[1]) for a in la for t in list(tree_at.values())[::8]])
+        t0 = time.time()
+        path = None
+        vc = via_costs(la + lb) if via_costs else None
+        budget = costs.node_limit(math.dist(la[0].centre, lb[0].centre))
+        for margin in margins:
+            if margin is None:
+                window = (0, 0, g.nx - 1, g.ny - 1)
+            else:
+                m = int(margin / g.pitch)
+                window = (max(0, min(c[0] for c in cells) - m), max(0, min(c[1] for c in cells) - m),
+                          min(g.nx - 1, max(c[0] for c in cells) + m), min(g.ny - 1, max(c[1] for c in cells) + m))
+            found, stats = search.search(blocked, via_ok, g.nx, g.ny, g.pitch, starts, goals, window, costs,
+                                         max_nodes=budget, penalty=penalty, via_cost=vc)
+            info["nodes"] += stats["nodes"]
+            # a path that comes back to a cell it has been on (a loop through two vias at one
+            # spot, to turn where the corner rules don't allow it): no via there, search again
+            for _retry in range(3):
+                spots = _loops(found)
+                if not spots:
+                    break
+                via_ok = bytearray(via_ok)
+                for i, j in spots:
+                    via_ok[j * g.nx + i] = 0
+                found, stats = search.search(blocked, bytes(via_ok), g.nx, g.ny, g.pitch, starts, goals, window,
+                                             costs, max_nodes=budget, penalty=penalty, via_cost=vc)
+                info["nodes"] += stats["nodes"]
+            if found and _loops(found):
+                found = None
+            if found and (path is None or stats["cost_mm"] < info["cost_mm"]):
+                path = found
+                info["window_mm"] = margin
+                info["cost_mm"] = stats["cost_mm"]
+            # a way much dearer than its length paid for something (an inductor, a pour, a
+            # rip-up): a bigger window may have one around it
+            if path and info["cost_mm"] <= 2.0 * lower + 3.0 * costs.via:
+                break
+            if path:
+                budget *= 3  # a dear way inside: the way round, if any, needs a wider search
+            if stats.get("limit"):
+                info["limit"] = not path  # gave up: a bigger window won't be cheaper
+                break
+        info["seconds"] = round(time.time() - t0, 3)
+        if not path and (costs.diagonal > 1.0 or costs.min_run_diag > costs.min_run):
+            # by hand, diagonals are short corners; where it's too tight for that (a fine-pitch
+            # connector), any 45 degree way is better than none
+            plain = copy.copy(costs)
+            plain.diagonal, plain.min_run_diag = 1.0, costs.min_run
+            again, more = self.route(net, pad_a, pad_b, blocked, via_ok, plain, margins, penalty, ignore, via_costs,
+                                     tree, used)
+            more["nodes"] += info["nodes"]
+            more["seconds"] = round(more["seconds"] + info["seconds"], 3)
+            more["plain_diagonals"] = True
+            return again, more
+        if not path:
+            info["fail"] = "node limit" if info.get("limit") else "no path"
+            return None, info
+        first = path[0]
+        start = next(l for l in la if (l.cell, l.layer, l.direction) == ((first[0], first[1]), first[2], first[3]))
+        last = path[-1]
+        key = (last[0], last[1], last[2])
+        if key in tree_at:  # joins the net's track
+            idx, _pt, _dirs = tree_at[key]
+            _L, p, q = tree[idx]
+            c = g.at(last[0], last[1])
+            e = _meet(c, search.DIRS[last[3]], p, q) or _pt
+            goal = Lane(None, last[2], (last[3] + 4) % 8, e, e, (last[0], last[1]), 0.0)
+            info["tee"] = idx
+        else:
+            goal = next(l for l in lb if (l.cell, l.layer) == ((last[0], last[1]), last[2]))
+        return self._geometry(path, start, goal), info
+
+    def _tree_goals(self, net, tree, blocked, goals):
+        """{(i, j, layer): (track index, point on it, directions it may be joined from)}."""
+        g = self.grid
+        pads = [(T(p.GetPosition().x), T(p.GetPosition().y)) for p in self.pads if p.GetNetname() == net]
+        out = {}
+        for idx, (L, p, q) in enumerate(tree):
+            length = math.dist(p, q)
+            if length < 1e-6:
+                continue
+            d8 = math.degrees(math.atan2(q[1] - p[1], q[0] - p[0])) / 45.0
+            d = int(round(d8)) % 8 if abs(d8 - round(d8)) < 1e-3 else None
+            dirs = frozenset(k for k in range(8) if d is None or k % 4 != d % 4)
+            n = max(1, int(length / (g.pitch / 2)))
+            for s in range(n + 1):
+                x, y = p[0] + (q[0] - p[0]) * s / n, p[1] + (q[1] - p[1]) * s / n
+                if any(math.dist((x, y), c) < TEE_PAD_MM for c in pads):
+                    continue
+                i, j = g.cell(x, y)
+                if not (0 <= i < g.nx and 0 <= j < g.ny) or blocked[L][j * g.nx + i] or (i, j, L) in goals:
+                    continue
+                out.setdefault((i, j, L), (idx, (x, y), dirs))
+        return out
+
+    def _geometry(self, path, start, goal):
+        """Grid path -> [(layer index, [points mm])], [via points], ending at both pad centres.
+        The first and last straight runs are moved onto the pads' axes, so the entry is exact
+        even when the pad centre isn't on the grid (see _align)."""
+        g = self.grid
+        pieces, vias = [], []
+        cur_layer, pts = path[0][2], [g.at(path[0][0], path[0][1])]
+        for a, b in zip(path, path[1:]):
+            if b[2] != a[2]:
+                pieces.append((cur_layer, pts))
+                vias.append(g.at(a[0], a[1]))
+                cur_layer, pts = b[2], [g.at(b[0], b[1])]
+            else:
+                pts.append(g.at(b[0], b[1]))
+        pieces.append((cur_layer, pts))
+        pieces = [[L, _corners(p)] for L, p in pieces]
+        _align(pieces, vias, start.exit)
+        rev = [[L, p[::-1]] for L, p in pieces[::-1]]
+        rvias = vias[::-1]
+        _align(rev, rvias, goal.exit)
+        pieces = [(L, p[::-1]) for L, p in rev[::-1]]
+        vias = rvias[::-1]
+        _square_middles(pieces, vias)
+        pieces[0] = (pieces[0][0], [start.centre] + pieces[0][1])
+        if goal.pad is not None:  # a pad; else the point where it joins the net's track
+            pieces[-1] = (pieces[-1][0], pieces[-1][1] + [goal.centre])
+        return pieces, vias
+
+    def add(self, net, pieces, vias):
+        """Put the copper on the board (not yet in the grids, see commit()); returns the items."""
+        w, vd, drill = self.widths(net)
+        n = self.board.FindNet(net)
+        items = []
+        for L_idx, pts in pieces:
+            for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
+                if math.hypot(x1 - x0, y1 - y0) < 1e-4:
+                    continue
+                t = pcbnew.PCB_TRACK(self.board)
+                t.SetStart(pcbnew.VECTOR2I(MM(x0), MM(y0)))
+                t.SetEnd(pcbnew.VECTOR2I(MM(x1), MM(y1)))
+                t.SetWidth(MM(w))
+                t.SetLayer(self.layers[L_idx])
+                t.SetNet(n)
+                self.board.Add(t)
+                items.append(t)
+        for x, y in vias:
+            v = pcbnew.PCB_VIA(self.board)
+            v.SetPosition(pcbnew.VECTOR2I(MM(x), MM(y)))
+            v.SetWidth(MM(vd))
+            v.SetDrill(MM(drill))
+            v.SetNet(n)
+            self.board.Add(v)
+            items.append(v)
+        self.router_items.update(_uuid(it) for it in items)
+        self._others = {}
+        return items
+
+    def commit(self, net, items):
+        """Stamp accepted copper into every key's grids."""
+        for occ in self._occ.values():
+            occ.stamp(net, items)
+
+    def uncommit(self, net, items_left):
+        """After a rip-up: `net`'s router copper is now only `items_left`."""
+        for occ in self._occ.values():
+            occ.set_new(net, items_left)
+
+    def remove(self, items):
+        for it in items:
+            self.router_items.discard(_uuid(it))
+            self.board.Delete(it)
+        self._others = {}
+
+    # --- exact checks ------------------------------------------------------------------
+    def _other_items(self, net):
+        """Other nets' copper with its bounding box, cached until the copper changes."""
+        if net not in self._others:
+            out = []
+            for o, n in self.copper_items():
+                if n != net and o.Type() != pcbnew.PCB_ZONE_T:
+                    out.append((o, o.GetBoundingBox()))
+            self._others[net] = out
+        return self._others[net]
+
+    def _hits(self, net, item, layer, ignore=None):
+        key = self.key(net)
+        kind = "Via" if item.Type() == pcbnew.PCB_VIA_T else "Track"
+        mine = _grown(item, layer, 0.0)
+        box = mine.BBox()
+        box.Inflate(MM(2.0))  # more than any clearance the lab uses
+        hits = []
+        for o, bb in self._other_items(net):
+            if not o.IsOnLayer(layer) or not box.Intersects(bb):
+                continue
+            if ignore and _uuid(o) in ignore:
+                continue
+            c = self.clearance_to(o, key, kind, layer)
+            if mine.Collide(_grown(o, layer, c - 0.001)):
+                hits.append(o)
+        return hits
+
+    def clear(self, net, layer, a, b, width, ignore=None):
+        """Whether a track from a to b keeps its clearance to every other net (exact)."""
+        t = pcbnew.PCB_TRACK(self.board)
+        t.SetStart(pcbnew.VECTOR2I(MM(a[0]), MM(a[1])))
+        t.SetEnd(pcbnew.VECTOR2I(MM(b[0]), MM(b[1])))
+        t.SetWidth(MM(width))
+        t.SetLayer(layer)
+        return not self._hits(net, t, layer, ignore) and not self._off_edge(t)
+
+    def violations(self, net, items):
+        """Exact check of new copper against other nets' copper and the board edge:
+        [(item, other)] too close; other is None for the edge."""
+        bad = []
+        for it in items:
+            for L in self.layers:
+                if it.IsOnLayer(L):
+                    bad += [(it, o) for o in self._hits(net, it, L)]
+            if self._off_edge(it):
+                bad.append((it, None))
+        return bad
+
+    def _off_edge(self, item):
+        """Whether `item` comes closer to the board edge than the edge clearance."""
+        L = next(L for L in self.layers if item.IsOnLayer(L))
+        grown = _grown(item, L, self.edge_clearance - 0.001)
+        grown.BooleanSubtract(self.outline)
+        return grown.OutlineCount() > 0 and grown.Area() > MM(0.001) ** 2
+
+
+def _square_middles(pieces, vias, most=0.3):
+    """A straight run between two vias that both ends' alignment (_align) left a little
+    off a 45 degree multiple (pad -> via -> other layer -> via -> pad, every piece one run,
+    both pads off the grid): slide the two vias along the runs that reach them, by the
+    least that squares the middle run, so no track is a few degrees skew."""
+    def unit(a, b):
+        n = math.dist(a, b)
+        return ((b[0] - a[0]) / n, (b[1] - a[1]) / n) if n > 1e-9 else None
+    cross = lambda u, v: u[0] * v[1] - u[1] * v[0]
+    for k in range(1, len(pieces) - 1):
+        L, pts = pieces[k]
+        if len(pts) != 2:
+            continue
+        a, b = pts
+        r = (b[0] - a[0], b[1] - a[1])
+        ang = math.degrees(math.atan2(r[1], r[0]))
+        if abs(ang / 45.0 - round(ang / 45.0)) * 45.0 < 0.05:
+            continue
+        dm = (math.cos(math.radians(round(ang / 45.0) * 45)), math.sin(math.radians(round(ang / 45.0) * 45)))
+        before, after = pieces[k - 1][1], pieces[k + 1][1]
+        ua, ub = unit(before[-2], before[-1]), unit(after[1], after[0])
+        if ua is None or ub is None:
+            continue
+        # cross(r + tb*ub - ta*ua, dm) = 0, the smallest (ta, tb)
+        g = (-cross(ua, dm), cross(ub, dm))
+        gg = g[0] * g[0] + g[1] * g[1]
+        if gg < 1e-12:
+            continue
+        c = cross(r, dm)
+        ta, tb = -c * g[0] / gg, -c * g[1] / gg
+        if abs(ta) > most or abs(tb) > most:
+            continue
+        na = (a[0] + ta * ua[0], a[1] + ta * ua[1])
+        nb = (b[0] + tb * ub[0], b[1] + tb * ub[1])
+        if math.dist(before[-2], na) < 0.05 or math.dist(after[1], nb) < 0.05:
+            continue
+        before[-1], after[0] = na, nb
+        pieces[k] = (L, [na, nb])
+        vias[k - 1], vias[k] = na, nb
+
+
+def _meet(c, u, p, q):
+    """Where the line from c along u meets the track from p to q, or None (parallel, or
+    past the track's ends)."""
+    vx, vy = q[0] - p[0], q[1] - p[1]
+    det = -u[0] * vy + u[1] * vx
+    if abs(det) < 1e-12:
+        return None
+    rx, ry = p[0] - c[0], p[1] - c[1]
+    t = (-rx * vy + vx * ry) / det
+    s = (u[0] * ry - u[1] * rx) / det
+    if not -0.01 <= s <= 1.01:
+        return None
+    return (c[0] + t * u[0], c[1] + t * u[1])
+
+
+def _loops(path):
+    """Cells where a grid path changes layer more than once, or that it visits twice on a layer."""
+    if not path:
+        return []
+    seen, vias, out = set(), {}, set()
+    for a, b in zip(path, path[1:]):
+        if a[2] != b[2]:
+            vias[(a[0], a[1])] = vias.get((a[0], a[1]), 0) + 1
+    out |= {c for c, n in vias.items() if n > 1}
+    for s in path:
+        key = (s[0], s[1], s[2])
+        if key in seen:
+            out.add((s[0], s[1]))
+        seen.add(key)
+    return sorted(out)
+
+
+def _corners(pts):
+    if len(pts) < 3:
+        return pts
+    out = [pts[0]]
+    for a, b, c in zip(pts, pts[1:], pts[2:]):
+        d1 = (round(b[0] - a[0], 6), round(b[1] - a[1], 6))
+        d2 = (round(c[0] - b[0], 6), round(c[1] - b[1], 6))
+        if d1[0] * d2[1] - d1[1] * d2[0] != 0 or d1[0] * d2[0] + d1[1] * d2[1] < 0:
+            out.append(b)
+    out.append(pts[-1])
+    return out
+
+
+def _align(pieces, vias, exact, k=0):
+    """Make piece k start at `exact` (off the grid) without bending any run: the first
+    corner slides along the second run. A run that ends at a via moves whole, via and
+    all, and the next piece is lined up from the moved via."""
+    L, pts = pieces[k]
+    if len(pts) >= 3 or k == len(pieces) - 1:
+        pieces[k][1] = _snap_end(pts, exact)
+        return
+    off = (exact[0] - pts[0][0], exact[1] - pts[0][1])
+    moved = [(x + off[0], y + off[1]) for x, y in pts]
+    pieces[k][1] = moved
+    vias[k] = moved[-1]
+    _align(pieces, vias, moved[-1], k + 1)
+
+
+def _snap_end(pts, exact):
+    """Replace pts[0] (a grid cell) by `exact` and move the first corner so the first run
+    keeps its direction and the second run still reaches its far end."""
+    if len(pts) < 3:
+        return [exact] + pts[1:]
+    (x0, y0), (x1, y1), (x2, y2) = pts[0], pts[1], pts[2]
+    v0, v1 = (x1 - x0, y1 - y0), (x2 - x1, y2 - y1)
+    det = v0[0] * (-v1[1]) - v0[1] * (-v1[0])
+    if abs(det) < 1e-12:
+        return [exact] + pts[1:]
+    rx, ry = x1 - exact[0], y1 - exact[1]
+    t = (rx * (-v1[1]) - ry * (-v1[0])) / det
+    corner = (exact[0] + t * v0[0], exact[1] + t * v0[1])
+    return [exact, corner] + pts[2:]
