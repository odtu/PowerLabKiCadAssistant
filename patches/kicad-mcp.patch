+def parse_schematic_color(color: str) -> str:
+    """'#RRGGBB', 'rgb(r, g, b)', 'rgba(r, g, b, a)' or a basic colour name ->
+    KiCad's ``rgba(r, g, b, 1.000)`` string. Raises ValueError otherwise."""
+    text = color.strip().lower()
+    if text in _NAMED_COLORS:
