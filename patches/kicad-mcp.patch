+    def _ipc_move_footprint_text(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """IPC handler for move_footprint_text (PowerLab patch).
+
+        Without it the SWIG handler moved the text on the tool's own copy of the
+        board, and the next save wrote KiCad's live board over it.
+        """
+        try:
+            from kipy.board_types import BoardText, Field
+            from kipy.geometry import Vector2
+            from kipy.proto.board.board_types_pb2 import BoardLayer
+
+            reference = params.get("reference") or params.get("ref")
+            field = params.get("field") or "reference"
+            if not reference:
+                return {"success": False, "message": "reference is required"}
+
+            board = self.ipc_board_api._get_board()
+            target_fp = None
+            for fp in board.get_footprints():
+                if fp.reference_field and fp.reference_field.text.value == reference:
+                    target_fp = fp
+                    break
+            if not target_fp:
+                return {
+                    "success": False,
+                    "message": "Component not found",
+                    "errorDetails": f"Could not find component: {reference}",
+                }
+
+            key = field.lower()
+            item = None
+            if key in ("reference", "ref"):
+                item = target_fp.reference_field
+            elif key in ("value", "val"):
+                item = target_fp.value_field
+            else:
+                texts = target_fp.texts_and_fields
+                item = next(
+                    (t for t in texts if isinstance(t, Field) and t.name.lower() == key), None
+                ) or next(
+                    (t for t in texts if isinstance(t, BoardText) and t.value == field), None
+                )
+            if item is None:
+                return {
+                    "success": False,
+                    "message": "Footprint text not found",
+                    "errorDetails": f"Could not find field '{field}' on {reference}",
+                }
+            text = item.text if isinstance(item, Field) else item
+
+            scale = {"mm": 1_000_000, "inch": 25_400_000, "mil": 25_400}.get(
+                params.get("unit", "mm"), 1_000_000
+            )
+            if params.get("x") is not None and params.get("y") is not None:
+                text.position = Vector2.from_xy(
+                    int(float(params["x"]) * scale), int(float(params["y"]) * scale)
+                )
+            if params.get("rotation") is not None:
+                text.attributes.angle = float(params["rotation"])
+            if params.get("layer"):
+                layer_name = "BL_" + str(params["layer"]).replace(".", "_")
+                try:
+                    layer = BoardLayer.Value(layer_name)
+                except ValueError:
+                    return {"success": False, "message": f"Unknown layer: {params['layer']}"}
+                if isinstance(item, Field):
+                    item.layer = layer
+                else:
+                    text.layer = layer
+            if params.get("visible") is not None:
+                if isinstance(item, Field):
+                    item.visible = bool(params["visible"])
+                else:
+                    text.attributes.visible = bool(params["visible"])
+
+            commit = board.begin_commit()
+            board.update_items([target_fp])
+            board.push_commit(commit, f"Moved {reference} {field} text")
+
+            pos = text.position
+            return {
+                "success": True,
+                "message": f"Moved {reference} {field} text (visible in KiCAD UI)",
+                "text": {
+                    "reference": reference,
+                    "field": field,
+                    "position": {"x": pos.x / 1_000_000, "y": pos.y / 1_000_000, "unit": "mm"},
+                    "layer": self._normalize_ipc_layer_name(BoardLayer.Name(text.layer)),
+                },
+            }
+        except Exception as e:
+            logger.error(f"IPC move_footprint_text error: {e}")
+            return {"success": False, "message": str(e)}
