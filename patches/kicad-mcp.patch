+"""Octilinear A* for PowerLab router 2. No pcbnew, so it can be tested anywhere.
+
+A state is (cell, layer, direction): the direction it was entered in, 0-7 (45 degrees apart)
+or FREE right after a via. A step turns by 45 degrees at most, so no 90 degree corner can
+be drawn; each turn costs `turn` mm. The old router also counted the cells run straight
+(min_run), which made the state space four times bigger; here the shaping pass after the
+search draws the corners (shape.py), so the search only has to find the corridor.
+
+Everything is local to a window: per layer, flat lists of the window's cells.
+- block[L]: truthy = no track centre here (fixed copper, edge, keepouts).
+- cost[L]: cost per mm of track in that cell (>= 1): the layer's factor, the congestion of
+  the other nets' copper (PathFinder's present cost), the history of cells fought over,
+  and the lab's soft rules (no tracks under magnetics, room in front of fine-pitch pins).
+- via_ok: truthy = a through via fits here; via_cost: what a via costs here (mm).
+"""
+
+import heapq
+import math
+import time
+
+import numpy as np
+
+from commands.powerlab_router2 import search_nb
+from commands.powerlab_router2.geom import DIRS, SQ2
+
+FREE = 8
+
+
+class Window:
+    def __init__(self, i0, j0, i1, j1, layers):
+        """Cells i0..i1-1, j0..j1-1 (global indices). The caller fills the numpy arrays
+        block_a / cost_a [layer, j, i] and via_ok_a / via_cost_a [j, i]; the Python loop reads
+        them as flat lists and bytes (block, cost, via_ok, via_cost), made when first asked."""
+        self.i0, self.j0, self.w, self.h = i0, j0, i1 - i0, j1 - j0
+        self.layers = layers
+        self.block_a = np.zeros((layers, self.h, self.w), np.uint8)
+        self.cost_a = np.ones((layers, self.h, self.w))
+        self.via_ok_a = np.zeros((self.h, self.w), np.uint8)
+        self.via_cost_a = np.zeros((self.h, self.w))
+        self._lists = None
+
+    def _make_lists(self):
+        if self._lists is None:
+            self._lists = ([self.block_a[L].tobytes() for L in range(self.layers)],
+                           [self.cost_a[L].ravel().tolist() for L in range(self.layers)],
+                           self.via_ok_a.tobytes(), self.via_cost_a.ravel().tolist())
+        return self._lists
+
+    @property
+    def block(self):
+        return self._make_lists()[0]
+
+    @property
+    def cost(self):
+        return self._make_lists()[1]
+
+    @property
+    def via_ok(self):
+        return self._make_lists()[2]
+
+    @property
+    def via_cost(self):
+        return self._make_lists()[3]
+
+    def contains(self, i, j):
+        return self.i0 <= i < self.i0 + self.w and self.j0 <= j < self.j0 + self.h
+
+
+def search(win, starts, goals, pitch, turn=1.0, diagonal=1.1, max_nodes=400_000, deadline=None, weight=1.0,
+           max_cost=None, dirf=None):
+    """Cheapest way from a start to a goal.
+
+    starts: [(i, j, L, d, cost)] global cells, d the direction the track leaves in;
+    goals: {(i, j, L): (directions it may arrive in, cost)}.
+    weight > 1: a greedier search (at most that much dearer than the best way), far fewer
+    nodes; the shaping pass redraws the corridor anyway.
+    max_cost: give up once every way left would cost more (a detour nobody would draw).
+    dirf: per window layer, 8 factors on a step's length by its direction (a layer's preferred
+    direction at 1, the others dearer), or None.
+    Returns (path [(i, j, L, d)], cost mm, nodes) or (None, None, nodes)."""
+    w, h, NL = win.w, win.h, win.layers
+    i0, j0 = win.i0, win.j0
+    step = [[pitch * (diagonal * SQ2 if k % 2 else 1.0) * (dirf[L][k] if dirf else 1.0) for k in range(8)]
+            for L in range(NL)]
+    lgoal = {}
+    for (gi, gj, gl), v in goals.items():
+        if win.contains(gi, gj):
+            lgoal[((gl * h) + gj - j0) * w + gi - i0] = v
+    if not lgoal:
+        return None, None, 0
+    hla = _heuristic(win, lgoal, pitch, weight)
+    if not any(hla[L, (i - i0) + (j - j0) * w] < 1e17 for i, j, L, _d, _c in starts if win.contains(i, j)):
+        return None, None, 0  # no start can reach a goal at all
+    if search_nb.AVAILABLE:
+        return _search_nb(win, starts, lgoal, step, hla, turn, max_nodes, max_cost, weight)
+    block, cost, via_ok, via_cost = win.block, win.cost, win.via_ok, win.via_cost
+    wh = w * h
+    hl = [hla[L].tolist() for L in range(NL)]
+    best = {}
+    parent = {}
+    openq = []
+    for i, j, L, d, c in starts:
+        if not win.contains(i, j):
+            continue
+        cell = ((L * h) + j - j0) * w + i - i0
+        if block[L][cell - L * wh]:
+            continue
+        s = cell * 9 + d
+        if c < best.get(s, 1e18):
+            best[s] = c
+            parent[s] = -1
+            heapq.heappush(openq, (c + hl[L][cell - L * wh], c, s))
+    nodes = 0
+    found = -1
+    push, pop = heapq.heappush, heapq.heappop
+    while openq:
+        f, g, s = pop(openq)
+        if g > best.get(s, 1e18):
+            continue
+        nodes += 1
+        if nodes > max_nodes or (deadline is not None and not nodes & 4095 and time.time() > deadline):
+            break
+        if max_cost is not None and f > max_cost * weight:
+            break
+        d = s % 9
+        cell = s // 9
+        L = cell // wh
+        xy = cell - L * wh
+        jj, ii = divmod(xy, w)
+        gl = lgoal.get(cell)
+        if gl is not None and d != FREE and (gl[0] is None or d in gl[0]):
+            found = s
+            break
+        blk, cst = block[L], cost[L]
+        if d == FREE:
+            options = range(8)
+        else:
+            options = (d, (d + 1) & 7, (d - 1) & 7)
+        for k in options:
+            dx, dy = DIRS[k]
+            ni, nj = ii + dx, jj + dy
+            if ni < 0 or nj < 0 or ni >= w or nj >= h:
+                continue
+            nxy = nj * w + ni
+            if blk[nxy]:
+                continue
+            if k & 1 and (blk[jj * w + ni] or blk[nj * w + ii]):
+                continue  # a diagonal past a blocked cell would cut its corner
+            ng = g + step[L][k] * cst[nxy]
+            if d != FREE and k != d:
+                ng += turn
+            ns = (L * wh + nxy) * 9 + k
+            gl = lgoal.get(ns // 9)
+            if gl is not None and (gl[0] is None or k in gl[0]):
+                ng += gl[1]  # the goal lane's own cost
+            if ng < best.get(ns, 1e18):
+                best[ns] = ng
+                parent[ns] = s
+                push(openq, (ng + hl[L][nxy], ng, ns))
+        if NL > 1 and d != FREE and via_ok[xy]:
+            vc = via_cost[xy]
+            for L2 in range(NL):
+                if L2 == L or block[L2][xy]:
+                    continue
+                ns = (L2 * wh + xy) * 9 + FREE
+                ng = g + vc
+                if ng < best.get(ns, 1e18):
+                    best[ns] = ng
+                    parent[ns] = s
+                    push(openq, (ng + hl[L2][xy], ng, ns))
+    if found < 0:
+        return None, None, nodes
+    path = []
+    s = found
+    while s >= 0:
+        d = s % 9
+        cell = s // 9
+        L = cell // wh
+        jj, ii = divmod(cell - L * wh, w)
+        path.append((ii + i0, jj + j0, L, d))
+        s = parent[s]
+    path.reverse()
+    return path, g, nodes
+
+
+def _heuristic(win, lgoal, pitch, weight):
+    """Per layer and cell (flat): the octilinear distance to the nearest goal at the cheapest
+    cost per mm, or the coarse map's distance round the fixed copper where that is longer
+    (coarse()), times `weight`; 1e18 where no goal can be reached."""
+    w, h, NL = win.w, win.h, win.layers
+    cmin = float(win.cost_a.min())
+    cols = np.arange(w)[None, :]
+    rows = np.arange(h)[:, None]
+    hmap = np.full((h, w), np.inf)
+    gcells = sorted({(k % (w * h)) for k in lgoal})
+    if len(gcells) > 60:
+        gcells = gcells[::max(1, len(gcells) // 60)]
+    for c in gcells:
+        gi, gj = c % w, c // w
+        dx, dy = np.abs(cols - gi), np.abs(rows - gj)
+        hmap = np.minimum(hmap, np.maximum(dx, dy) + (SQ2 - 1.0) * np.minimum(dx, dy))
+    hmap *= pitch
+    cd = coarse(win, lgoal, pitch)
+    out = np.empty((NL, w * h))
+    for L in range(NL):
+        m = np.maximum(hmap, cd[L]) * (cmin * weight)
+        out[L] = np.where(np.isfinite(m), m, 1e18).ravel()
+    return out
+
+
+def _search_nb(win, starts, lgoal, step, hla, turn, max_nodes, max_cost, weight):
+    """search() through the compiled loop (search_nb); same result."""
+    w, h, NL = win.w, win.h, win.layers
+    i0, j0 = win.i0, win.j0
+    n = NL * w * h
+    gmask = np.zeros(n, np.int32)
+    gcost = np.zeros(n)
+    for cell, (dirs, c) in lgoal.items():
+        gmask[cell] = 0xFF if dirs is None else sum(1 << k for k in dirs)
+        gcost[cell] = c
+    ss, sc = [], []
+    for i, j, L, d, c in starts:
+        if win.contains(i, j):
+            ss.append((((L * h) + j - j0) * w + i - i0) * 9 + d)
+            sc.append(float(c))
+    found, g, nodes, states = search_nb._astar(
+        w, h, NL, np.ascontiguousarray(win.block_a).ravel(), np.ascontiguousarray(win.cost_a, np.float64).ravel(),
+        np.ascontiguousarray(win.via_ok_a).ravel(), np.ascontiguousarray(win.via_cost_a, np.float64).ravel(),
+        hla.ravel(), gmask, gcost, np.array(ss, np.int64), np.array(sc, np.float64),
+        np.array(step, np.float64).ravel(), _DX, _DY, float(turn), int(max_nodes),
+        float(max_cost * weight) if max_cost is not None else 1e300)
+    if found < 0:
+        return None, None, int(nodes)
+    wh = w * h
+    path = []
+    for s in states.tolist():
+        d = s % 9
+        cell = s // 9
+        L = cell // wh
+        jj, ii = divmod(cell - L * wh, w)
+        path.append((ii + i0, jj + j0, L, d))
+    return path, float(g), int(nodes)
+
+
+_DX = np.array([d[0] for d in DIRS], np.int64)
+_DY = np.array([d[1] for d in DIRS], np.int64)
+
+
+def search_fast(win, starts, goals, pitch, turn=1.0, diagonal=1.1, max_nodes=400_000, deadline=None,
+                weight=1.0, max_cost=None, square=4.0):
+    """Like search(), with a state per (cell, layer) only: the direction a cell was reached in
+    is kept with its best way, not as part of the state. Nine times fewer states; the price
+    is that a turn is judged by the way the cell was first reached best (not exact). A 45
+    degree turn costs `turn`, a 90 degree one `square` more (the shaping pass chamfers it), a
+    sharper one isn't made. Same arguments and result as search()."""
+    w, h, NL = win.w, win.h, win.layers
+    i0, j0 = win.i0, win.j0
+    block, cost, via_ok, via_cost = win.block, win.cost, win.via_ok, win.via_cost
+    step = [pitch * (diagonal * SQ2 if k % 2 else 1.0) for k in range(8)]
+    tcost = [0.0, turn, turn + square, 1e9, 1e9, 1e9, turn + square, turn]  # by (k - d) % 8
+    lgoal = {}
+    for (gi, gj, gl), v in goals.items():
+        if win.contains(gi, gj):
+            lgoal[((gl * h) + gj - j0) * w + gi - i0] = v
+    if not lgoal:
+        return None, None, 0
+    cmin = min(min(c) for c in cost)
+    cols = np.arange(w)[None, :]
+    rows = np.arange(h)[:, None]
+    hmap = np.full((h, w), np.inf)
+    gcells = sorted({(k % (w * h)) for k in lgoal})
+    if len(gcells) > 60:
+        gcells = gcells[::max(1, len(gcells) // 60)]
+    for c in gcells:
+        gi, gj = c % w, c // w
+        dx, dy = np.abs(cols - gi), np.abs(rows - gj)
+        hmap = np.minimum(hmap, np.maximum(dx, dy) + (SQ2 - 1.0) * np.minimum(dx, dy))
+    hmap *= pitch
+    wh = w * h
+    cd = coarse(win, lgoal, pitch)
+    hl = []
+    for L in range(NL):
+        m = np.maximum(hmap, cd[L]) * (cmin * weight)
+        hl.append(np.where(np.isfinite(m), m, 1e18).ravel().tolist())
+    best = {}
+    came = {}  # cell -> direction it was reached in (FREE after a via)
+    parent = {}
+    openq = []
+    for i, j, L, d, c in starts:
+        if not win.contains(i, j):
+            continue
+        cell = ((L * h) + j - j0) * w + i - i0
+        xy = cell - L * wh
+        if block[L][xy] or hl[L][xy] > 1e17:
+            continue
+        if c < best.get(cell, 1e18):
+            best[cell] = c
+            came[cell] = d
+            parent[cell] = -1
+            heapq.heappush(openq, (c + hl[L][xy], c, cell))
+    nodes = 0
+    found = -1
+    push, pop = heapq.heappush, heapq.heappop
+    while openq:
+        f, g, cell = pop(openq)
+        if g > best.get(cell, 1e18):
+            continue
+        nodes += 1
+        if nodes > max_nodes or (deadline is not None and not nodes & 4095 and time.time() > deadline):
+            break
+        if max_cost is not None and f > max_cost * weight:
+            break
+        d = came[cell]
+        L = cell // wh
+        xy = cell - L * wh
+        jj, ii = divmod(xy, w)
+        gl = lgoal.get(cell)
+        if gl is not None and d != FREE and (gl[0] is None or d in gl[0]):
+            found = cell
+            break
+        blk, cst, hll = block[L], cost[L], hl[L]
+        base = L * wh
+        for k in range(8):
+            if d == FREE:
+                tc = 0.0
+            else:
+                tc = tcost[(k - d) & 7]
+                if tc > 1e8:
+                    continue
+            dx, dy = DIRS[k]
+            ni, nj = ii + dx, jj + dy
+            if ni < 0 or nj < 0 or ni >= w or nj >= h:
+                continue
+            nxy = nj * w + ni
+            if blk[nxy]:
+                continue
+            if k & 1 and (blk[jj * w + ni] or blk[nj * w + ii]):
+                continue
+            ng = g + step[k] * cst[nxy] + tc
+            ns = base + nxy
+            gl2 = lgoal.get(ns)
+            if gl2 is not None and (gl2[0] is None or k in gl2[0]):
+                ng += gl2[1]
+            if ng < best.get(ns, 1e18):
+                best[ns] = ng
+                came[ns] = k
+                parent[ns] = cell
+                push(openq, (ng + hll[nxy], ng, ns))
+        if NL > 1 and d != FREE and via_ok[xy]:
+            vc = via_cost[xy]
+            for L2 in range(NL):
+                if L2 == L or block[L2][xy]:
+                    continue
+                ns = L2 * wh + xy
+                ng = g + vc
+                if ng < best.get(ns, 1e18):
+                    best[ns] = ng
+                    came[ns] = FREE
+                    parent[ns] = cell
+                    push(openq, (ng + hl[L2][xy], ng, ns))
+    if found < 0:
+        return None, None, nodes
+    path = []
+    cell = found
+    while cell >= 0:
+        L = cell // wh
+        jj, ii = divmod(cell - L * wh, w)
+        path.append((ii + i0, jj + j0, L, came[cell]))
+        cell = parent[cell]
+    path.reverse()
+    return path, g, nodes
+
+
+COARSE = 5  # cells per coarse block (0.5 mm on the 0.1 mm grid)
+
+
+def coarse(win, lgoal, pitch, F=COARSE):
+    """Per layer, a lower bound of the distance (mm) from each cell to the nearest goal round
+    the fixed copper: a breadth-first spread over blocks of FxF cells (a block is open if any
+    of its cells is, layers joined where a via fits), numpy only. A cell whose block can't
+    reach a goal at all is inf. As a heuristic it sends the search round a wall instead of
+    filling the whole bay in front of it."""
+    w, h, NL = win.w, win.h, win.layers
+    H, W = -(-h // F), -(-w // F)
+    wh = w * h
+
+    def blocks(a, fill):
+        a = a.astype(bool)
+        p = np.full((H * F, W * F), fill, bool)
+        p[:h, :w] = a
+        return p.reshape(H, F, W, F)
+
+    free = np.stack([~blocks(win.block_a[L], True).all(axis=(1, 3)) for L in range(NL)])
+    vok = blocks(win.via_ok_a, False).any(axis=(1, 3))
+    front = np.zeros((NL, H, W), bool)
+    for c in lgoal:
+        L, xy = divmod(c, wh)
+        j, i = divmod(xy, w)
+        front[L, j // F, i // F] = True
+    front &= free
+    dist = np.full((NL, H, W), np.inf)
+    dist[front] = 0
+    seen = front.copy()
+    level = 0
+    while front.any():
+        level += 1
+        nb = np.zeros_like(front)
+        nb[:, 1:, :] |= front[:, :-1, :]
+        nb[:, :-1, :] |= front[:, 1:, :]
+        nb[:, :, 1:] |= front[:, :, :-1]
+        nb[:, :, :-1] |= front[:, :, 1:]
+        nb[:, 1:, 1:] |= front[:, :-1, :-1]
+        nb[:, 1:, :-1] |= front[:, :-1, 1:]
+        nb[:, :-1, 1:] |= front[:, 1:, :-1]
+        nb[:, :-1, :-1] |= front[:, 1:, 1:]
+        if NL > 1:
+            nb |= (front.any(axis=0) & vok)[None, :, :]
+        nb &= free & ~seen
+        dist[nb] = level
+        seen |= nb
+        front = nb
+    # a block k steps away is at least (k - 1) blocks of track away
+    lower = np.maximum(dist - 1, 0) * (F * pitch)
+    out = []
+    for L in range(NL):
+        full = np.repeat(np.repeat(lower[L], F, axis=0), F, axis=1)[:h, :w]
+        out.append(full)
+    return out
+
+
+def flood_reaches(win, starts, goals, limit=20000):
+    """Whether any goal can be reached at all through free cells (any direction, vias):
+    cheap, so a connection boxed in by fixed copper fails at once instead of after a search."""
+    w, h, NL = win.w, win.h, win.layers
+    i0, j0 = win.i0, win.j0
+    gcells = set()
+    for (gi, gj, gl) in goals:
+        if win.contains(gi, gj):
+            gcells.add(((gl * h) + gj - j0) * w + gi - i0)
+    wh = w * h
+    seen = set()
+    stack = []
+    for i, j, L, _d, _c in starts:
+        if win.contains(i, j):
+            stack.append(((L * h) + j - j0) * w + i - i0)
+    while stack:
+        c = stack.pop()
+        if c in seen:
+            continue
+        seen.add(c)
+        if c in gcells:
+            return True
+        if len(seen) > limit:
+            return True  # open enough: let the search decide
+        L = c // wh
+        xy = c - L * wh
+        jj, ii = divmod(xy, w)
+        blk = win.block[L]
+        for dx, dy in DIRS:
+            ni, nj = ii + dx, jj + dy
+            if 0 <= ni < w and 0 <= nj < h and not blk[nj * w + ni]:
+                n = L * wh + nj * w + ni
+                if n not in seen:
+                    stack.append(n)
+        if NL > 1 and win.via_ok[xy]:
+            for L2 in range(NL):
+                if L2 != L and not win.block[L2][xy]:
+                    n = L2 * wh + xy
+                    if n not in seen:
+                        stack.append(n)
+    return False
