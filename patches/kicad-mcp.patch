+            "update_seconds_max": round(max(timings), 3) if timings else None,
+            "kicad_push_seconds_max": max((p["seconds"] for p in pushes), default=None),
+            "items_pushed_max": max((p["added"] + p["removed"] for p in pushes), default=None),
+        }
+        if job["state"] == "TIMED_OUT":
+            return {
+                "success": False,
+                "message": f"Freerouting timed out after {timeout}s",
+                "errorDetails": "Increase timeout or reduce board complexity; the board is unchanged",
+                "live": stats,
+            }
+        if not job["ses"]:
+            return {
+                "success": False,
+                "message": f"Freerouting ended with state {job['state']}",
+                "errorDetails": job.get("log", ""),
+                "live": stats,
+            }
+        with open(ses_path, "w", encoding="utf-8") as fh:
+            fh.write(job["ses"])
+        return {"success": True, "copper": copper, "live": stats}
+
