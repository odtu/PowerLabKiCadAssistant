+def apply_netclass_patterns_to_project_settings(
+    data: Dict[str, Any], name: str, patterns: List[str]
+) -> Dict[str, Any]:
+    """Add net-name patterns (``*GND*``, ``+*``) for class ``name`` to
+    ``net_settings.netclass_patterns``, skipping ones already there. Pure."""
+    net_settings = data.setdefault("net_settings", {})
+    if not isinstance(net_settings.get("netclass_patterns"), list):
+        net_settings["netclass_patterns"] = []
+    existing = net_settings["netclass_patterns"]
+    for pattern in patterns:
+        entry = {"netclass": name, "pattern": pattern}
+        if entry not in existing:
+            existing.append(entry)
+    return data
+
+
+_NAMED_COLORS = {
+    "red": (255, 0, 0),
+    "blue": (0, 0, 255),
