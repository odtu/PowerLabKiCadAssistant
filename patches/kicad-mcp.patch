+                    placed.append(p)
+            plan["placed"] = placed
+            summary["placed_count"] = len(placed)
+            summary["dry_run"] = False
+            plan["message"] = f"Added {len(placed)} stitching vias (visible in KiCAD UI)"
+            plan["note"] = (
+                "Positions were checked against the saved board file; "
+                "save in KiCad first if it has unsaved edits, then run DRC."
+            )
+            return plan
+        except Exception as e:
+            logger.error(f"IPC add_gnd_stitching_vias error: {e}")
+            return {"success": False, "message": str(e)}
