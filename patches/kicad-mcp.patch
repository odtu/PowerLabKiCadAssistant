+        """IPC handler for delete_trace (PowerLab patch, #56).
+
+        It used to fall back to the SWIG handler, which deleted from the tool's own copy
+        of the board and reported success; KiCad's board kept the copper and the next
+        save wrote it back. Now the tracks and vias are deleted in KiCad's board, in one
+        commit, by UUID, position (the nearest within 1 mm) or net, like the SWIG
+        handler; nothing found is a failure.
+        """
+        try:
+            import math
+
+            from kipy.board_types import Via
+            from kipy.proto.board.board_types_pb2 import BoardLayer
+
+            trace_uuid = params.get("traceUuid")
+            position = params.get("position")
+            net_name = params.get("net")
+            layer = params.get("layer")
+            include_vias = params.get("includeVias", False)
+            if not trace_uuid and not position and not net_name:
+                return {
+                    "success": False,
+                    "message": "Missing parameters",
+                    "errorDetails": "One of traceUuid, position, or net must be provided",
+                }
+            board = self.ipc_board_api._get_board()
+            items = list(board.get_tracks()) + list(board.get_vias())
+            layer_of = lambda it: self._normalize_ipc_layer_name(BoardLayer.Name(it.layer))
+            if net_name:
+                found = [
+                    it for it in items
+                    if (net_name == "*" or (it.net.name if it.net else "") == net_name)
+                    and (include_vias or not isinstance(it, Via))
+                    and (not layer or isinstance(it, Via) or layer_of(it) == layer)
+                ]
+            elif trace_uuid:
+                # query_traces reports the live UUID as kipy's KIID text ('value: "..."')
+                import re
+
+                m = re.search(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}", trace_uuid)
+                wanted = m.group(0).lower() if m else trace_uuid
+                found = [it for it in items if it.id.value.lower() == wanted]
+            else:
+                scale = {"mm": 1_000_000, "mil": 25_400, "inch": 25_400_000}.get(position.get("unit", "mm"), 1_000_000)
+                px, py = float(position["x"]) * scale, float(position["y"]) * scale
+
+                def distance(it):
+                    if isinstance(it, Via):
+                        return math.hypot(it.position.x - px, it.position.y - py)
+                    ax, ay, bx, by = it.start.x, it.start.y, it.end.x, it.end.y
+                    dx, dy = bx - ax, by - ay
+                    n2 = dx * dx + dy * dy
+                    t = 0.0 if n2 == 0 else max(0.0, min(1.0, ((px - ax) * dx + (py - ay) * dy) / n2))
+                    return math.hypot(ax + t * dx - px, ay + t * dy - py)
+                near = [it for it in items if not layer or isinstance(it, Via) or layer_of(it) == layer]
+                # a point on a via means the via, not a track that ends there
+                on_via = [it for it in near if isinstance(it, Via) and distance(it) <= it.diameter / 2]
+                best = min(on_via or near, key=distance) if near else None
+                found = [best] if best is not None and distance(best) < 1_000_000 else []
+            if not found:
