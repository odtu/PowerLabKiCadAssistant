diff --git a/python/commands/board_region.py b/python/commands/board_region.py
new file mode 100644
index 0000000..cfdd6ad
--- /dev/null
+++ b/python/commands/board_region.py
@@ -0,0 +1,229 @@
+"""get_elements_in_region on the board (PowerLab patch, #80).
+
+The tool read only schematics and required schematicPath, so Claude, routing in the PCB
+editor and asking what lies in an area of the board, got "Input validation error ...
+expected string, received undefined". Now, without schematicPath, it lists the board's
+footprints, pads, tracks, vias and zones in the rectangle: live from KiCad's board when
+KiCad has it open, else from the board file (pcbPath, or the loaded board).
+
+An item counts when it touches the rectangle: a footprint or zone whose bounding box
+overlaps it, a track crossing it, a pad or via whose centre is in it. Each list is capped
+at `limit` (default 100); `counts` are the full numbers.
+"""
+
+from typing import Any, Dict, Tuple
+
+Box = Tuple[float, float, float, float]  # x0, y0, x1, y1 in mm
+
+
+def _inside(box: Box, x: float, y: float) -> bool:
+    return box[0] <= x <= box[2] and box[1] <= y <= box[3]
+
+
+def _overlaps(box: Box, other: Box) -> bool:
+    return not (other[2] < box[0] or other[0] > box[2] or other[3] < box[1] or other[1] > box[3])
+
+
+def segment_crosses(box: Box, ax: float, ay: float, bx: float, by: float, half_width: float = 0.0) -> bool:
+    """A track from (ax, ay) to (bx, by), `half_width` wide each side, touches the box
+    (Liang-Barsky clipping on the box grown by the half width)."""
+    x0, y0, x1, y1 = box[0] - half_width, box[1] - half_width, box[2] + half_width, box[3] + half_width
+    dx, dy = bx - ax, by - ay
+    t0, t1 = 0.0, 1.0
+    for p, q in ((-dx, ax - x0), (dx, x1 - ax), (-dy, ay - y0), (dy, y1 - ay)):
+        if p == 0:
+            if q < 0:
+                return False
+            continue
+        t = q / p
+        if p < 0:
+            t0 = max(t0, t)
+        else:
+            t1 = min(t1, t)
+        if t0 > t1:
+            return False
+    return True
+
+
+def collect(box: Box, footprints, pads, tracks, vias, zones, limit: int = 100) -> Dict[str, Any]:
+    """The response from item summaries (dicts) that touch `box`."""
+    found = {
+        "footprints": [f for f in footprints if _overlaps(box, f.pop("_bbox"))],
+        "pads": [p for p in pads if _inside(box, p["x"], p["y"])],
+        "tracks": [
+            t for t in tracks
+            if segment_crosses(box, t["start"]["x"], t["start"]["y"], t["end"]["x"], t["end"]["y"],
+                               t["width"] / 2)
+        ],
+        "vias": [v for v in vias if _inside(box, v["x"], v["y"])],
+        "zones": [z for z in zones if _overlaps(box, z.pop("_bbox"))],
+    }
+    counts = {k: len(v) for k, v in found.items()}
+    out: Dict[str, Any] = {
+        "success": True,
+        "mode": "board",
+        "region": {"x1": box[0], "y1": box[1], "x2": box[2], "y2": box[3], "unit": "mm"},
+        "counts": counts,
+    }
+    truncated = []
+    for key, items in found.items():
+        out[key] = items[:limit]
+        if len(items) > limit:
+            truncated.append(key)
+    if truncated:
+        out["truncated"] = truncated
+        out["note"] = (f"{', '.join(truncated)} cut to {limit} each (limit); narrow the region "
+                       "or raise limit for the rest")
+    out["message"] = (
+        f"Board region: {counts['footprints']} footprints, {counts['pads']} pads, "
+        f"{counts['tracks']} tracks, {counts['vias']} vias, {counts['zones']} zones"
+    )
+    return out
+
+
+def _r(v: float) -> float:
+    return round(v, 4)
+
+
+# --- offline: pcbnew -------------------------------------------------------------------
+
+def _via_width(via: Any) -> int:
+    import pcbnew
+
+    try:
+        return via.GetWidth(pcbnew.F_Cu)  # KiCad 9+: per layer (padstacks)
+    except TypeError:
+        return via.GetWidth()
+
+
+def swig_items(board: Any, box: Box, limit: int = 100) -> Dict[str, Any]:
+    import pcbnew
+
+    mm = lambda v: v / 1_000_000
+    footprints, pads = [], []
+    for fp in board.GetFootprints():
+        bb = fp.GetBoundingBox(False)  # without fields, like a courtyard-less body
+        pos = fp.GetPosition()
+        ref = fp.GetReference()
+        footprints.append({
+            "reference": ref,
+            "value": fp.GetValue(),
+            "x": _r(mm(pos.x)), "y": _r(mm(pos.y)),
+            "rotation": _r(fp.GetOrientationDegrees()),
+            "side": "bottom" if fp.IsFlipped() else "top",
+            "locked": bool(fp.IsLocked()),
+            "_bbox": (mm(bb.GetLeft()), mm(bb.GetTop()), mm(bb.GetRight()), mm(bb.GetBottom())),
+        })
+        for pad in fp.Pads():
+            p = pad.GetPosition()
+            pads.append({
+                "reference": ref, "pad": pad.GetNumber(), "net": pad.GetNetname(),
+                "x": _r(mm(p.x)), "y": _r(mm(p.y)),
+            })
+    tracks, vias = [], []
+    for t in board.GetTracks():
+        if t.Type() == pcbnew.PCB_VIA_T:
+            p = t.GetPosition()
+            vias.append({
+                "uuid": t.m_Uuid.AsString(), "net": t.GetNetname(),
+                "x": _r(mm(p.x)), "y": _r(mm(p.y)),
+                "size": _r(mm(_via_width(t))),
+                "drill": _r(mm(t.GetDrillValue())),
+            })
+        else:
+            s, e = t.GetStart(), t.GetEnd()
+            tracks.append({
+                "uuid": t.m_Uuid.AsString(), "net": t.GetNetname(),
+                "layer": board.GetLayerName(t.GetLayer()), "width": _r(mm(t.GetWidth())),
+                "start": {"x": _r(mm(s.x)), "y": _r(mm(s.y))},
+                "end": {"x": _r(mm(e.x)), "y": _r(mm(e.y))},
+                **({"arc": True} if t.Type() == pcbnew.PCB_ARC_T else {}),
+            })
+    zones = []
+    for z in board.Zones():
+        bb = z.GetBoundingBox()
+        try:
+            layers = [board.GetLayerName(l) for l in z.GetLayerSet().Seq()]
+        except Exception:
+            layers = [board.GetLayerName(z.GetLayer())]
+        zones.append({
+            "uuid": z.m_Uuid.AsString(), "net": z.GetNetname(), "layers": layers,
+            "priority": z.GetAssignedPriority(), "name": z.GetZoneName(),
+            "isRuleArea": bool(z.GetIsRuleArea()),
+            "_bbox": (mm(bb.GetLeft()), mm(bb.GetTop()), mm(bb.GetRight()), mm(bb.GetBottom())),
+        })
+    return collect(box, footprints, pads, tracks, vias, zones, limit)
+
+
+# --- live: kipy -------------------------------------------------------------------------
+
+def ipc_items(kboard: Any, box: Box, limit: int = 100) -> Dict[str, Any]:
+    from kipy.board_types import ArcTrack
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    mm = lambda v: v / 1_000_000
+    layer_name = lambda l: (lambda n: n[3:].replace("_", ".") if n.startswith("BL_") else n)(BoardLayer.Name(l))
+    footprints, pads = [], []
+    fps = list(kboard.get_footprints())
+    boxes: Dict[str, Box] = {}
+    try:  # one request for all the boxes
+        for fp, bb in zip(fps, kboard.get_item_bounding_box(fps)):
+            if bb is not None:
+                boxes[fp.id.value] = (mm(bb.pos.x), mm(bb.pos.y), mm(bb.pos.x + bb.size.x), mm(bb.pos.y + bb.size.y))
+    except Exception:
+        pass
+    for fp in fps:
+        ref = fp.reference_field.text.value if fp.reference_field else ""
+        fp_pads = list(fp.definition.pads)
+        if fp.id.value in boxes:
+            bbox = boxes[fp.id.value]
+        else:  # the pads' centres, or the anchor
+            pts = [(mm(p.position.x), mm(p.position.y)) for p in fp_pads] or [(mm(fp.position.x), mm(fp.position.y))]
+            bbox = (min(x for x, _ in pts), min(y for _, y in pts), max(x for x, _ in pts), max(y for _, y in pts))
+        footprints.append({
+            "reference": ref,
+            "value": fp.value_field.text.value if fp.value_field else "",
+            "x": _r(mm(fp.position.x)), "y": _r(mm(fp.position.y)),
+            "rotation": _r(fp.orientation.degrees if fp.orientation else 0.0),
+            "side": "bottom" if fp.layer == BoardLayer.BL_B_Cu else "top",
+            "locked": bool(fp.locked),
+            "_bbox": bbox,
+        })
+        for p in fp_pads:
+            pads.append({
+                "reference": ref, "pad": p.number, "net": p.net.name if p.net else "",
+                "x": _r(mm(p.position.x)), "y": _r(mm(p.position.y)),
+            })
+    tracks = []
+    for t in kboard.get_tracks():
+        tracks.append({
+            "uuid": t.id.value, "net": t.net.name if t.net else "", "layer": layer_name(t.layer),
+            "width": _r(mm(t.width)),
+            "start": {"x": _r(mm(t.start.x)), "y": _r(mm(t.start.y))},
+            "end": {"x": _r(mm(t.end.x)), "y": _r(mm(t.end.y))},
+            **({"arc": True} if isinstance(t, ArcTrack) else {}),
+        })
+    vias = [
+        {
+            "uuid": v.id.value, "net": v.net.name if v.net else "",
+            "x": _r(mm(v.position.x)), "y": _r(mm(v.position.y)),
+            "size": _r(mm(v.diameter)), "drill": _r(mm(v.drill_diameter)),
+        }
+        for v in kboard.get_vias()
+    ]
+    zones = []
+    for z in kboard.get_zones():
+        pts = [n.point for poly in z._proto.outline.polygons for n in poly.outline.nodes if n.HasField("point")]
+        if not pts:
+            continue
+        rule = z.is_rule_area()
+        zones.append({
+            "uuid": z.id.value, "net": "" if rule or z.net is None else z.net.name,
+            "layers": [layer_name(l) for l in z.layers], "priority": z.priority, "name": z.name,
+            "isRuleArea": rule,
+            "_bbox": (mm(min(p.x_nm for p in pts)), mm(min(p.y_nm for p in pts)),
+                      mm(max(p.x_nm for p in pts)), mm(max(p.y_nm for p in pts))),
+        })
+    out = collect(box, footprints, pads, tracks, vias, zones, limit)
+    out["source"] = "KiCad's open board"
+    return out
