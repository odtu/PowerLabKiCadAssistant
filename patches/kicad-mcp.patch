+    def _handle_clean_up_routing(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """Clean up tracks after autorouting, on the saved board file (PowerLab patch).
+
+        Like autoroute it reads and writes the .kicad_pcb file: with the board open in
