+            plan = RoutingCommands(board).add_gnd_stitching_vias(plan_params)
+            if not plan.get("success") or params.get("dryRun"):
+                return plan
+
+            summary = plan["summary"]
+            placed = []
+            for p in plan["placed"]:
+                if self.ipc_board_api.add_via(
+                    x=p["x"],
+                    y=p["y"],
+                    diameter=summary["via_size_mm"],
+                    drill=summary["via_drill_mm"],
+                    net_name=summary["gnd_net"],
+                    via_type="through",
