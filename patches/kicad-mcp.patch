diff --git a/python/commands/part_spacing.py b/python/commands/part_spacing.py
new file mode 100644
index 0000000..78f1697
--- /dev/null
+++ b/python/commands/part_spacing.py
@@ -0,0 +1,339 @@
+"""
+check_part_spacing (PowerLab patch): part-to-part spacing and keep-out areas, measured.
+
+The lab's library parts have no courtyard (by design), so KiCad's DRC and the courtyard
+checks can't see parts packed pad to pad. This measures what a person checks by eye:
+- the gap between the pads of neighbouring parts on the same side (minGap: 1 mm for hand
+  soldering, 0.5 mm for machine assembly; fineGap, 2 mm, round fine-pitch ICs for parts not
+  connected to them), and parts whose bodies overlap;
+- parts on the through pads of a part on the other side (thermal vias in a drain or exposed
+  pad, THT pins): copper on both sides, so a short when the nets differ;
+- parts inside keep-out areas: the board's rule areas that keep out footprints or pads
+  (on the side they are on), and areas given in the call (a circle or ring, a polygon),
+  each for the top, the bottom or both sides, with the parts it lets in (`allow`, reference
+  prefixes, e.g. passives under an encoder ring);
+- optionally, pads closer to the board edge than edgeGap.
+
+It reads the saved board file, so save in KiCad first.
+"""
+
+import math
+import re
+from typing import Any, Dict, List, Optional, Tuple
+
+MIN_GAP = 1.0  # mm pad to pad between parts (powerlab-visual-review: assembly spacing)
+FINE_GAP = 2.0  # mm round fine-pitch ICs
+FINE_PITCH = 0.8  # pads closer than this make a part fine pitch (as the router)
+FINE_PADS = 8  # ... when it has at least this many pads (an IC, not a 2-pad part)
+MAX_LISTED = 80
+ERR = 5000  # nm, polygon error
+
+
+def _mm(v: float) -> float:
+    import pcbnew
+
+    return pcbnew.ToMM(v)
+
+
+def _side(fp: Any) -> str:
+    return "B" if fp.IsFlipped() else "F"
+
+
+def _pad_polys(fp: Any) -> List[Any]:
+    import pcbnew
+
+    L = pcbnew.B_Cu if fp.IsFlipped() else pcbnew.F_Cu
+    out = []
+    for p in fp.Pads():
+        if p.IsOnLayer(L):
+            sp = pcbnew.SHAPE_POLY_SET()
+            p.TransformShapeToPolygon(sp, L, 0, ERR, pcbnew.ERROR_INSIDE)
+            out.append((p, sp))
+    return out
+
+
+def _body(fp: Any) -> Any:
+    """The part's body: its fab outline's box (or courtyard's), with its pads."""
+    import pcbnew
+
+    fab = pcbnew.B_Fab if fp.IsFlipped() else pcbnew.F_Fab
+    crt = pcbnew.B_CrtYd if fp.IsFlipped() else pcbnew.F_CrtYd
+    sp = pcbnew.SHAPE_POLY_SET()
+    for layer in (crt, fab):
+        box = None
+        for g in fp.GraphicalItems():
+            if g.GetLayer() == layer and g.Type() != pcbnew.PCB_TEXT_T and g.Type() != pcbnew.PCB_FIELD_T:
+                b = g.GetBoundingBox()
+                if box is None:
+                    box = pcbnew.BOX2I(b.GetPosition(), b.GetSize())
+                else:
+                    box.Merge(b)
+        if box is not None and box.GetWidth() > 0 and box.GetHeight() > 0:
+            sp.NewOutline()
+            for x, y in ((box.GetLeft(), box.GetTop()), (box.GetRight(), box.GetTop()),
+                         (box.GetRight(), box.GetBottom()), (box.GetLeft(), box.GetBottom())):
+                sp.Append(x, y)
+            break
+    for _p, pp in _pad_polys(fp):
+        sp.BooleanAdd(pp)
+    sp.Simplify()
+    return sp
+
+
+def _gap(a: Any, b: Any) -> float:
+    """Smallest distance (mm) between two polygon sets; 0 when they touch."""
+    if a.OutlineCount() == 0 or b.OutlineCount() == 0:
+        return 1e9
+    if a.Collide(b.Outline(0).CPoint(0)) or b.Collide(a.Outline(0).CPoint(0)):
+        return 0.0
+    best = 1e18
+    for i in range(a.OutlineCount()):
+        oa = a.Outline(i)
+        for j in range(b.OutlineCount()):
+            ob = b.Outline(j)
+            if oa.Intersects(ob):
+                return 0.0
+            for k in range(ob.PointCount()):
+                best = min(best, oa.Distance(ob.CPoint(k)))
+            for k in range(oa.PointCount()):
+                best = min(best, ob.Distance(oa.CPoint(k)))
+    return _mm(best)
+
+
+def _overlap(a: Any, b: Any) -> float:
+    """Overlapping area in mm2."""
+    import pcbnew
+
+    x = a.CloneDropTriangulation()
+    x.BooleanIntersection(b)
+    return x.Area() / 1e12 if x.OutlineCount() else 0.0
+
+
+def fine_pitch(fp: Any) -> bool:
+    """Two different pins of the same size closer than FINE_PITCH. Segments of one
+    exposed pad share a number and don't count."""
+    pads = [p for p in fp.Pads() if p.GetNumber()]
+    if len({p.GetNumber() for p in pads}) < FINE_PADS:
+        return False
+    pts = [(p.GetNumber(), (p.GetSizeX(), p.GetSizeY()), (_mm(p.GetPosition().x), _mm(p.GetPosition().y)))
+           for p in pads]
+    for i, (na, sa, a) in enumerate(pts):
+        for nb, sb, b in pts[i + 1:]:
+            if na != nb and sa == sb and 1e-3 < math.dist(a, b) < FINE_PITCH:
+                return True
+    return False
+
+
+def _net_tie(fp: Any) -> bool:
+    try:
+        return bool(fp.IsNetTie())
+    except Exception:
+        return "nettie" in str(fp.GetFPID().GetLibItemName()).lower().replace("_", "")
+
+
+def _prefix(ref: str) -> str:
+    """The letters of a reference: "C12" -> "C", "TP3" -> "TP"."""
+    m = re.match(r"[A-Za-z_]+", ref)
+    return m.group(0).upper() if m else ""
+
+
+def _area(spec: Dict[str, Any]) -> Tuple[str, Any, List[str]]:
+    """A keep-out given in the call -> (name, SHAPE_POLY_SET, sides)."""
+    import pcbnew
+
+    sides = [s.upper()[0] for s in (spec.get("sides") or ["F", "B"])]
+    sp = pcbnew.SHAPE_POLY_SET()
+    if spec.get("points"):
+        sp.NewOutline()
+        for p in spec["points"]:
+            sp.Append(pcbnew.FromMM(float(p["x"])), pcbnew.FromMM(float(p["y"])))
+    else:
+        c = spec.get("center") or {}
+        cx, cy = pcbnew.FromMM(float(c.get("x", 0))), pcbnew.FromMM(float(c.get("y", 0)))
+        r = pcbnew.FromMM(float(spec["diameter"]) / 2)
+        n = 96
+        sp.NewOutline()
+        for k in range(n):
+            a = 2 * math.pi * k / n
+            sp.Append(int(cx + r * math.cos(a)), int(cy + r * math.sin(a)))
+        inner = spec.get("innerDiameter")
+        if inner:  # a ring: the hole inside is free
+            hole = pcbnew.SHAPE_POLY_SET()
+            hole.NewOutline()
+            ri = pcbnew.FromMM(float(inner) / 2)
+            for k in range(n):
+                a = 2 * math.pi * k / n
+                hole.Append(int(cx + ri * math.cos(a)), int(cy + ri * math.sin(a)))
+            sp.BooleanSubtract(hole)
+    name = spec.get("name") or ("ring" if spec.get("innerDiameter") else "area")
+    return name, sp, sides
+
+
+def check(board_path: str, params: Dict[str, Any]) -> Dict[str, Any]:
+    import pcbnew
+
+    board = pcbnew.LoadBoard(board_path)
+    min_gap = float(params.get("minGap", MIN_GAP))
+    fine_gap = float(params.get("fineGap", FINE_GAP))
+    only = set(params.get("refs") or [])
+    allow = {frozenset(p) for p in (params.get("allowPairs") or []) if len(p) == 2}
+    fps = [fp for fp in board.GetFootprints() if len(fp.Pads()) or fp.GraphicalItems()]
+    info = {}
+    for fp in fps:
+        nets = {p.GetNetname() for p in fp.Pads() if p.GetNetname() and "GND" not in p.GetNetname().upper()}
+        info[fp.GetReference()] = {"fp": fp, "side": _side(fp), "pads": _pad_polys(fp), "body": _body(fp),
+                                   "fine": fine_pitch(fp), "tie": _net_tie(fp), "nets": nets}
+    refs = sorted(info)
+
+    # --- spacing -------------------------------------------------------------------------
+    spacing, bodies = [], []
+    for i, ra in enumerate(refs):
+        A = info[ra]
+        for rb in refs[i + 1:]:
+            B = info[rb]
+            if A["side"] != B["side"] or (only and ra not in only and rb not in only):
+                continue
+            if frozenset((ra, rb)) in allow or A["tie"] or B["tie"]:
+                continue
+            # round a fine-pitch IC, only parts it isn't connected to keep the wide gap: its own
+            # decoupling caps and pin passives belong right at its pins (design rules §3.2)
+            own = A["nets"] & B["nets"]
+            need = fine_gap if ((A["fine"] or B["fine"]) and not own) else min_gap
+            ba, bb = A["fp"].GetBoundingBox(False), B["fp"].GetBoundingBox(False)
+            if not ba.GetInflated(pcbnew.FromMM(need + 0.1)).Intersects(bb):
+                continue
+            ov = _overlap(A["body"], B["body"])
+            if ov > 0.01:
+                bodies.append({"refs": [ra, rb], "side": A["side"], "overlap_mm2": round(ov, 2)})
+            gap, at = 1e9, None
+            for pa, sa in A["pads"]:
+                for pb, sb in B["pads"]:
+                    g = _gap(sa, sb)
+                    if g < gap:
+                        gap = g
+                        p1, p2 = pa.GetPosition(), pb.GetPosition()
+                        at = {"x": round(_mm((p1.x + p2.x) / 2), 2), "y": round(_mm((p1.y + p2.y) / 2), 2)}
+            if gap < need:
+                spacing.append({"refs": [ra, rb], "side": A["side"], "gap_mm": round(gap, 2),
+                                "required_mm": need, "at": at})
+    spacing.sort(key=lambda s: s["gap_mm"] - s["required_mm"])
+
+    # --- through pads of parts on the other side (thermal vias in a drain pad, a THT pin) --
+    # They are copper on this side too: a part's pad over one of another net is a short, and
+    # over one of its own net solder runs into it.
+    through = []
+    thru_pads = []
+    for rb in refs:
+        B = info[rb]
+        for p in B["fp"].Pads():
+            if p.GetAttribute() in (pcbnew.PAD_ATTRIB_PTH, pcbnew.PAD_ATTRIB_NPTH):
+                thru_pads.append((rb, B["side"], p))
+    for ra in refs:
+        A = info[ra]
+        if only and ra not in only:
+            continue
+        L = pcbnew.B_Cu if A["side"] == "B" else pcbnew.F_Cu
+        for rb, side_b, p in thru_pads:
+            if rb == ra or side_b == A["side"]:
+                continue
+            sp = pcbnew.SHAPE_POLY_SET()
+            p.TransformShapeToPolygon(sp, L, 0, ERR, pcbnew.ERROR_INSIDE)
+            for pa, sa in A["pads"]:
+                g = _gap(sa, sp)
+                if g < min_gap:
+                    same = pa.GetNetname() == p.GetNetname() and pa.GetNetname() != ""
+                    through.append({"refs": [ra, rb], "side": A["side"], "gap_mm": round(g, 2),
+                                    "same_net": same, "short": g <= 0 and not same,
+                                    "at": {"x": round(_mm(p.GetPosition().x), 2), "y": round(_mm(p.GetPosition().y), 2)}})
+    seen, uniq = set(), []
+    for t in sorted(through, key=lambda t: (not t["short"], t["gap_mm"])):
+        k = (tuple(t["refs"]), t["same_net"])
+        if k not in seen:
+            seen.add(k); uniq.append(t)
+    through = uniq
+
+    # --- keep-out areas -------------------------------------------------------------------
+    areas = []
+    zones = list(board.Zones()) + [z for fp in board.GetFootprints() for z in fp.Zones()]
+    for z in zones:
+        if not z.GetIsRuleArea():
+            continue
+        parent = z.GetParentFootprint() if hasattr(z, "GetParentFootprint") else None
+        keep_fp = z.GetDoNotAllowFootprints()
+        keep_pads = z.GetDoNotAllowPads() if hasattr(z, "GetDoNotAllowPads") else False
+        if not (keep_fp or keep_pads):
+            continue
+        sides = [s for s, L in (("F", pcbnew.F_Cu), ("B", pcbnew.B_Cu)) if z.IsOnLayer(L)]
+        name = z.GetZoneName() or ("rule area of " + parent.GetReference() if parent else "rule area")
+        areas.append((name, z.Outline(), sides, "footprints" if keep_fp else "pads",
+                      parent.GetReference() if parent else None, set()))
+    for spec in params.get("keepouts") or []:
+        name, sp, sides = _area(spec)
+        areas.append((name, sp, sides, "footprints", None, {a.upper() for a in spec.get("allow") or []}))
+    inside = []
+    for name, sp, sides, what, owner, allowed in areas:
+        for ref in refs:
+            A = info[ref]
+            if ref == owner or A["side"] not in sides and not (what == "pads" and _through(A)):
+                continue
+            if _prefix(ref) in allowed:
+                continue
+            shape = A["body"] if what == "footprints" else _union(A["pads"])
+            ov = _overlap(shape, sp)
+            if ov > 0.005:
+                inside.append({"ref": ref, "side": A["side"], "area": name, "overlap_mm2": round(ov, 2)})
+
+    # --- edge -----------------------------------------------------------------------------
+    edge = []
+    edge_gap = float(params.get("edgeGap") or 0)
+    if edge_gap > 0:
+        outline = pcbnew.SHAPE_POLY_SET()
+        board.GetBoardPolygonOutlines(outline, False)
+        inner = outline.CloneDropTriangulation()
+        inner.Inflate(pcbnew.FromMM(-edge_gap), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+        for ref in refs:
+            A = info[ref]
+            pads = _union(A["pads"])
+            if pads.OutlineCount() == 0:
+                continue
+            out = pads.CloneDropTriangulation()
+            out.BooleanSubtract(inner)
+            if out.OutlineCount() and out.Area() / 1e12 > 0.005:
+                edge.append({"ref": ref, "side": A["side"], "required_mm": edge_gap})
+
+    ok = not (spacing or bodies or inside or edge or through)
+    shorts = sum(1 for t in through if t["short"])
+    summary = (f"{len(spacing)} part pairs closer than the spacing rule, {len(bodies)} with overlapping bodies, "
+               f"{len(inside)} parts in keep-out areas" + (f", {len(edge)} too close to the edge" if edge_gap else "")
+               + (f", {len(through)} parts on through pads of the other side ({shorts} shorts)" if through else ""))
+    return {
+        "success": True,
+        "ok": ok,
+        "message": "Spacing and keep-outs are clean" if ok else summary,
+        "rules": {"minGap_mm": min_gap, "fineGap_mm": fine_gap, "fine_pitch_parts": sorted(r for r in refs if info[r]["fine"]),
+                  "keepout_areas": [{"name": n, "sides": s, "keeps_out": w, "allowed": sorted(al)}
+                                    for n, _sp, s, w, _o, al in areas]},
+        "spacing": spacing[:MAX_LISTED],
+        "spacing_count": len(spacing),
+        "overlapping_bodies": bodies[:MAX_LISTED],
+        "in_keepouts": inside[:MAX_LISTED],
+        "in_keepouts_count": len(inside),
+        "near_edge": edge[:MAX_LISTED],
+        "on_through_pads": through[:MAX_LISTED],
+        "note": "Net-tie parts are skipped. Reads the saved board file: save in KiCad first.",
+    }
+
+
+def _through(A: Dict[str, Any]) -> bool:
+    import pcbnew
+
+    return any(p.GetAttribute() in (pcbnew.PAD_ATTRIB_PTH, pcbnew.PAD_ATTRIB_NPTH) for p, _sp in A["pads"])
+
+
+def _union(pads: List[Any]) -> Any:
+    import pcbnew
+
+    sp = pcbnew.SHAPE_POLY_SET()
+    for _p, pp in pads:
+        sp.BooleanAdd(pp)
+    return sp
diff --git a/python/commands/pour_nets.py b/python/commands/pour_nets.py
new file mode 100644
index 0000000..052abc5
--- /dev/null
+++ b/python/commands/pour_nets.py
@@ -0,0 +1,96 @@
+"""Leave nets to copper pours: Freerouting routes everything else (PowerLab patch).
+
+The DSN keeps the pour nets' existing wires and vias as obstacles under a pin-less
+placeholder net, drops the pour nets from the netlist so they aren't routed as tracks,
+and drops their planes so other nets can use those layers (refilled pours flow around
+the new tracks afterwards).
+
+Keepout pour nets are left out the same way, but their pours become keepouts: other
+nets route around them instead of cutting through a power pour.
+"""
+
+import re
+
+PLACEHOLDER_NET = "PLA_POUR_KEEP"
+
+
+def _end(text, start):
+    depth, quoted = 0, False
+    for i in range(start, len(text)):
+        c = text[i]
+        if c == '"':
+            quoted = not quoted
+        elif not quoted:
+            if c == "(":
+                depth += 1
+            elif c == ")":
+                depth -= 1
+                if depth == 0:
+                    return i + 1
+    raise ValueError("unbalanced DSN")
+
+
+def _name_at(text, pos):
+    m = re.compile(r'\s*("([^"]*)"|[^\s()]+)').match(text, pos)
+    return (m.group(2) if m.group(2) is not None else m.group(1)), m.end()
+
+
+def _quote(name):
+    return f'"{name}"' if re.search(r'[\s()"]', name) or not name else name
+
+
+def leave_to_pours(dsn, nets, keepout_nets=()):
+    """Return (new_dsn, dropped_net_count) with `nets` and `keepout_nets` left out of
+    routing; the planes of `keepout_nets` become keepouts on their layers."""
+    keepout_nets = set(keepout_nets)
+    nets = set(nets) | keepout_nets
+    out, i = [], 0
+    in_network = None
+    network_start = dsn.index("(network")
+    network_end = _end(dsn, network_start)
+    wiring_start = dsn.find("(wiring")
+    wiring_end = _end(dsn, wiring_start) if wiring_start >= 0 else -1
+    dropped = 0
+    for m in re.finditer(r"\((plane|net|class)\s", dsn):
+        if m.start() < i:
+            continue
+        kind = m.group(1)
+        inside_network = network_start < m.start() < network_end
+        inside_wiring = wiring_start >= 0 and wiring_start < m.start() < wiring_end
+        if kind == "plane" and not inside_network and not inside_wiring:
+            name, _ = _name_at(dsn, m.end() - 1)
+            if name in nets:
+                end = _end(dsn, m.start())
+                out.append(dsn[i:m.start()])
+                if name in keepout_nets:
+                    block = dsn[m.start():end]
+                    out.append('(keepout "" ' + block[block.index("(polygon"):])
+                i = end
+        elif kind == "net" and inside_network:
+            name, _ = _name_at(dsn, m.end() - 1)
+            if name in nets:
+                end = _end(dsn, m.start())
+                out.append(dsn[i:m.start()])
+                i = end
+                dropped += 1
+        elif kind == "net" and inside_wiring:
+            name, name_end = _name_at(dsn, m.end() - 1)
+            if name in nets:  # (net GND) inside a wire/via: keep it as an obstacle
+                out.append(dsn[i:m.start()])
+                out.append(f"(net {PLACEHOLDER_NET}")
+                i = name_end
+        elif kind == "class" and inside_network:
+            head_end = dsn.find("(", m.end())
+            tokens = re.findall(r'"[^"]*"|[^\s()]+', dsn[m.end():head_end])
+            kept = [tokens[0]] + [t for t in tokens[1:] if t.strip('"') not in nets]
+            out.append(dsn[i:m.start()])
+            out.append("(class " + " ".join(kept) + "\n      ")
+            i = head_end
+    out.append(dsn[i:])
+    text = "".join(out)
+    if wiring_start >= 0 and PLACEHOLDER_NET in text:
+        start = text.index("(network")
+        close = _end(text, start) - 1
+        text = text[:close] + f"(net {PLACEHOLDER_NET})\n    " + text[close:]
+    return text, dropped
+
diff --git a/python/commands/powerlab_route.py b/python/commands/powerlab_route.py
new file mode 100644
index 0000000..a1737d1
--- /dev/null
+++ b/python/commands/powerlab_route.py
@@ -0,0 +1,641 @@
+"""
+The PowerLab router as a background job (PowerLab patch).
+
+A run takes minutes (10-15 on a 2-layer ESP32 board), so powerlab_route starts the router
+(commands/powerlab_router/) in a KiCad Python process of its own, on a copy of the saved
+board, and the MCP's worker keeps answering. powerlab_route_status waits for it and
+reports progress. When it has finished, the result goes onto the board once: into KiCad's
+open board over the API and saved there (no File > Revert), or over the saved file when
+KiCad doesn't have the board open. The saved board from before the run is kept in
+autoroute-backup/, so undo_autoroute undoes it.
+
+Like tools/router_bench.py, the router routes the chosen nets from scratch: their unlocked
+tracks and vias are taken out first. Nets with locked copper are left alone (hand-routed).
+
+One job per board, in %TEMP%/powerlab-route/<board hash>/:
+  job.json        what to route (written by the worker)
+  status.json     state, phase and progress (written by the router process)
+  report.json     the router's report
+  log.txt         one line per connection event
+  input/          the saved board at the start, with its .kicad_pro and .kicad_dru
+  stripped/       the board with the nets taken out (DRC baseline)
+  result/         the routed board
+  live.json       with KiCad open: the copper last shown in KiCad while routing
+
+Live: with the board open in KiCad, the router process connects to KiCad itself and keeps
+KiCad's board showing its copper while it routes (every LIVE_GAP seconds at most, one
+commit each). The pours are unfilled meanwhile, so the new tracks can be seen; they are
+refilled when the result is applied. A run that fails or is stopped puts KiCad's copper
+back as it was saved.
+"""
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import traceback
+from typing import Any, Dict, List, Optional
+
+ROOT = os.path.join(tempfile.gettempdir(), "powerlab-route")
+DEFAULTS = {"pitch": 0.1, "turn": 1.5, "via": 4.0, "min_run": 2, "layers": [1.0, 1.2], "diagonal": 1.3,
+            "min_run_diag": 3, "max_nodes": 2000000}
+HEARTBEAT = 5  # s between status writes while the router works
+STALE = 600  # s without a status write: the router process is gone (a zone fill holds the GIL)
+PROJECT_FILES = (".kicad_pro", ".kicad_dru")
+LIVE_GAP = 2.0  # s between live updates in KiCad
+TIME_LIMIT_MIN = 15.0  # default minutes for routing the connections; the run then finishes what it has
+STALL = 180  # s without a newly routed connection while routing: reported as stalled
+
+_procs: Dict[str, subprocess.Popen] = {}  # job folder -> router process started by this worker
+
+
+def _norm(path: str) -> str:
+    return os.path.normcase(os.path.abspath(path))
+
+
+def job_dir(board_path: str) -> str:
+    return os.path.join(ROOT, hashlib.sha1(_norm(board_path).encode("utf-8")).hexdigest()[:16])
+
+
+def _sha1(path: str) -> str:
+    h = hashlib.sha1()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def _read(path: str) -> Optional[Dict[str, Any]]:
+    for _ in range(5):  # the router process may be replacing it
+        try:
+            with open(path, encoding="utf-8") as fh:
+                return json.load(fh)
+        except FileNotFoundError:
+            return None
+        except (OSError, ValueError):
+            time.sleep(0.1)
+    return None
+
+
+def _write(path: str, data: Dict[str, Any]) -> None:
+    tmp = path + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as fh:
+        json.dump(data, fh, indent=1)
+    for _ in range(20):
+        try:
+            os.replace(tmp, path)
+            return
+        except PermissionError:  # a reader has it open (Windows)
+            time.sleep(0.05)
+    os.replace(tmp, path)
+
+
+def _copy_project(board_path: str, folder: str) -> str:
+    """Copy the board and its project/rules files into folder; returns the board copy."""
+    os.makedirs(folder, exist_ok=True)
+    stem = os.path.splitext(os.path.basename(board_path))[0]
+    target = os.path.join(folder, stem + ".kicad_pcb")
+    shutil.copy2(board_path, target)
+    for ext in PROJECT_FILES:
+        src = os.path.splitext(board_path)[0] + ext
+        if os.path.isfile(src):
+            shutil.copy2(src, os.path.join(folder, stem + ext))
+    return target
+
+
+# ---------------------------------------------------------------------------
+# Worker side
+# ---------------------------------------------------------------------------
+
+
+def status(board_path: str) -> Dict[str, Any]:
+    """The job's status, with "alive" telling whether its router process still runs."""
+    folder = job_dir(board_path)
+    st = _read(os.path.join(folder, "status.json"))
+    if st is None:
+        return {"state": "none"}
+    if st.get("state") == "running":
+        proc = _procs.get(folder)
+        if proc is not None:
+            alive = proc.poll() is None
+        else:
+            alive = time.time() - st.get("updated", 0) < STALE
+        if not alive:
+            st = _read(os.path.join(folder, "status.json")) or st  # it may have just finished
+            if st.get("state") == "running":
+                st.update(state="failed", error="the router process ended without a result")
+                _write(os.path.join(folder, "status.json"), st)
+    if st.get("state") == "running" and st.get("phase") == "routing":
+        since = time.time() - st.get("last_routed_at", st.get("started", time.time()))
+        if since > STALL:
+            st["stalled_seconds"] = int(since)
+    return st
+
+
+def kicad_connection(kboard: Any) -> Optional[Dict[str, str]]:
+    """The socket and token of the KiCad that has kboard open, for the router process."""
+    client = getattr(kboard, "client", None)  # kipy's KiCadClient (or a KiCad that holds one)
+    client = getattr(client, "_client", client)
+    path = getattr(client, "_socket_path", None)
+    if not path:
+        return None
+    return {"socket": path, "token": getattr(client, "_kicad_token", "") or ""}
+
+
+def start(board_path: str, params: Dict[str, Any], kicad_cli: Optional[str], live: bool,
+          connection: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
+    folder = job_dir(board_path)
+    st = status(board_path)
+    if st.get("state") == "running":
+        return {
+            "success": False,
+            "message": "The PowerLab router is already routing this board",
+            "errorDetails": "Wait for it with powerlab_route_status, or stop it with powerlab_route_status cancel: true",
+        }
+    shutil.rmtree(folder, ignore_errors=True)
+    os.makedirs(folder)
+    board_copy = _copy_project(board_path, os.path.join(folder, "input"))
+    nets = params.get("nets")
+    job = {
+        "board_path": os.path.abspath(board_path),
+        "input": board_copy,
+        "input_sha1": _sha1(board_copy),
+        "nets": [str(n) for n in nets] if nets else None,
+        "pour_nets": [str(n) for n in (params.get("pourNets") or ["GND"])],
+        "kicad_cli": kicad_cli,
+        "live": live,
+        # live display while routing (default on with KiCad open; live: false turns it off)
+        "kicad": connection if live and params.get("live", True) is not False else None,
+        "pitch": float(params.get("gridPitch") or DEFAULTS["pitch"]),
+        "turn": float(params.get("turnCost") or DEFAULTS["turn"]),
+        "via": float(params.get("viaCost") or DEFAULTS["via"]),
+        "diagonal": float(params.get("diagonalCost") or DEFAULTS["diagonal"]),
+        "layers": [float(f) for f in (params.get("layerCosts") or DEFAULTS["layers"])],
+        # power rails get pours round their tracks; stitching vias tie the GND pours (§3.3, §3.5)
+        "power_pours": params.get("powerPours", True) is not False,
+        "solid_pour_nets": [str(n) for n in (params.get("solidPourNets") or [])],
+        "stitch_pitch": float(params.get("stitchPitch", 5.0) or 0.0),
+        "min_run": DEFAULTS["min_run"],
+        "min_run_diag": DEFAULTS["min_run_diag"],
+        "max_nodes": DEFAULTS["max_nodes"],
+        # copper layers to route on (default: all but inner planes)
+        "route_layers": [str(n) for n in params.get("routeLayers") or []] or None,
+        "time_limit": 60.0 * float(params.get("timeLimit") or TIME_LIMIT_MIN),
+    }
+    _write(os.path.join(folder, "job.json"), job)
+    now = time.time()
+    _write(os.path.join(folder, "status.json"),
+           {"state": "running", "phase": "starting", "started": now, "updated": now})
+    log = open(os.path.join(folder, "process.log"), "w", encoding="utf-8", errors="replace")
+    python_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    _procs[folder] = subprocess.Popen(
+        [sys.executable, "-u", os.path.abspath(__file__), folder],
+        cwd=python_dir,
+        stdout=log,
+        stderr=subprocess.STDOUT,
+        stdin=subprocess.DEVNULL,
+        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+    )
+    log.close()
+    return {"success": True, "job": folder}
+
+
+def wait(board_path: str, seconds: float) -> Dict[str, Any]:
+    deadline = time.time() + max(0.0, seconds)
+    while True:
+        st = status(board_path)
+        if st.get("state") != "running" or time.time() >= deadline:
+            return st
+        time.sleep(min(2.0, max(0.1, deadline - time.time())))
+
+
+def cancel(board_path: str) -> Dict[str, Any]:
+    folder = job_dir(board_path)
+    st = status(board_path)
+    if st.get("state") != "running":
+        return {"success": False, "message": f"No PowerLab router run in progress (state: {st.get('state')})"}
+    proc = _procs.pop(folder, None)
+    pid = proc.pid if proc else st.get("pid")
+    # ask first, so a live update in KiCad isn't cut off halfway through its commit
+    with open(os.path.join(folder, "cancel"), "w") as fh:
+        fh.write("1")
+    deadline = time.time() + 15
+    while time.time() < deadline and (_read(os.path.join(folder, "status.json")) or {}).get("state") == "running":
+        time.sleep(0.5)
+    st = _read(os.path.join(folder, "status.json")) or st
+    if st.get("state") == "running":  # busy in a long search: stop it the hard way
+        try:
+            if proc is not None:
+                proc.kill()
+                proc.wait(timeout=10)
+            elif pid:
+                os.kill(int(pid), 9)
+        except Exception as e:
+            return {"success": False, "message": f"Could not stop the router process: {e}"}
+    st.update(state="cancelled", updated=time.time())
+    _write(os.path.join(folder, "status.json"), st)
+    return {"success": True, "message": "Stopped the PowerLab router; the saved board is unchanged"}
+
+
+def report(board_path: str) -> Optional[Dict[str, Any]]:
+    return _read(os.path.join(job_dir(board_path), "report.json"))
+
+
+def _key_text(key: Any) -> str:
+    return json.dumps(key)
+
+
+def unsaved_changes(kboard: Any, board_path: str, shown: Optional[set] = None) -> Dict[str, int]:
+    """Copper and footprint positions in KiCad's open board that differ from the file.
+
+    Empty when KiCad shows what is saved (zone fills aren't compared). With `shown` (the
+    copper the live display last put in KiCad, as _key_text), the copper is compared with
+    that instead of the file."""
+    import pcbnew
+    from commands.freerouting_live import kipy_key, pcbnew_copper
+
+    board = pcbnew.LoadBoard(board_path)
+    live = {kipy_key(i) for i in list(kboard.get_tracks()) + list(kboard.get_vias())} - {None}
+    if shown is not None:
+        saved, live = set(shown), {_key_text(k) for k in live}
+    else:
+        saved = set(pcbnew_copper(board))
+    fps = {(fp.GetReference(), fp.GetPosition().x, fp.GetPosition().y) for fp in board.GetFootprints()}
+    live_fps = {(fp.reference_field.text.value, fp.position.x, fp.position.y) for fp in kboard.get_footprints()}
+    out = {}
+    if saved != live:
+        out["copper_items"] = len(saved ^ live)
+    if fps != live_fps:
+        out["footprints"] = len({f[0] for f in fps ^ live_fps})
+    return out
+
+
+def apply(board_path: str, kboard: Any = None) -> Dict[str, Any]:
+    """Put a finished job's routed board on the board (once).
+
+    With kboard (KiCad's open board, kipy), KiCad's copper is brought in line with the
+    result, zones are refilled and the board is saved in KiCad. Otherwise the result is
+    copied over the saved file."""
+    from commands import autoroute_backup
+
+    folder = job_dir(board_path)
+    job = _read(os.path.join(folder, "job.json")) or {}
+    st = status(board_path)
+    result = st.get("result")
+    if st.get("state") != "done" or not result or not os.path.isfile(result):
+        return {"success": False, "message": "No finished PowerLab router run to apply"}
+    if not os.path.isfile(board_path) or _sha1(board_path) != job.get("input_sha1"):
+        return {
+            "success": False,
+            "message": "The saved board changed after the run started, so the result wasn't applied",
+            "errorDetails": "The routed board would overwrite those changes. Start powerlab_route again.",
+        }
+    if kboard is not None:
+        changed = unsaved_changes(kboard, job["input"], live_shown(folder))
+        if changed:
+            return {
+                "success": False,
+                "message": "KiCad's board was edited after the run started, so the result wasn't applied",
+                "errorDetails": f"Differences from the routed board's starting point: {changed}. "
+                                "Save in KiCad (Ctrl+S) and start powerlab_route again.",
+            }
+    out: Dict[str, Any] = {"success": True}
+    try:
+        out["backupPath"] = autoroute_backup.keep(job["input"], board_path)
+        out["undo"] = "undo_autoroute puts back the board from before this run"
+    except OSError as e:
+        out["undo"] = f"no backup kept ({e}), so this run can't be undone"
+    synced = False
+    if kboard is not None:
+        try:
+            out["kicad"] = push_to_kicad(kboard, result, "PowerLab router")
+            synced = True
+        except Exception as e:
+            out["kicad_error"] = str(e)
+    if not synced:
+        shutil.copyfile(result, board_path)  # copyfile: a fresh modification time
+    out["saved_in_kicad"] = synced
+    st.update(state="applied", applied=time.time(), saved_in_kicad=synced)
+    _write(os.path.join(folder, "status.json"), st)
+    return out
+
+
+def live_shown(folder: str) -> Optional[set]:
+    """The copper the live display last put into KiCad (as _key_text), or None."""
+    data = _read(os.path.join(folder, "live.json"))
+    return set(data["shown"]) if data and "shown" in data else None
+
+
+def put_back(board_path: str, kboard: Any) -> Optional[Dict[str, Any]]:
+    """After a live run failed or was stopped: KiCad's copper back as saved, pours refilled.
+
+    Only once, and only while KiCad still shows what the live display put there (an edit
+    made meanwhile is never thrown away)."""
+    folder = job_dir(board_path)
+    shown = live_shown(folder)
+    st = status(board_path)
+    if kboard is None or shown is None or st.get("put_back"):
+        return None
+    job = _read(os.path.join(folder, "job.json")) or {}
+    if unsaved_changes(kboard, job["input"], shown):
+        return {"put_back": False, "why": "KiCad's board was edited during the run; use File > Revert"}
+    try:
+        sync = push_to_kicad(kboard, job["input"], "PowerLab router: back as saved", save=False)
+    except Exception as e:
+        return {"put_back": False, "why": f"{e}; use File > Revert"}
+    st.update(put_back=True)
+    _write(os.path.join(folder, "status.json"), st)
+    return {"put_back": True, **sync}
+
+
+def push_to_kicad(kboard: Any, board_file: str, message: str, save: bool = True) -> Dict[str, Any]:
+    """Make KiCad's open board's copper match board_file, refill zones, save in KiCad."""
+    import pcbnew
+    from commands.freerouting_live import LiveCopper, pcbnew_copper
+
+    t0 = time.time()
+    sync = LiveCopper(kboard).finish(pcbnew_copper(pcbnew.LoadBoard(board_file)), message)
+    kboard.refill_zones(block=True, max_poll_seconds=60.0)
+    if save:
+        kboard.save()
+    return {**sync, "seconds": round(time.time() - t0, 2)}
+
+
+# ---------------------------------------------------------------------------
+# Router process
+# ---------------------------------------------------------------------------
+
+
+class _Status:
+    """status.json, rewritten on every change and every HEARTBEAT seconds."""
+
+    def __init__(self, folder: str) -> None:
+        self.path = os.path.join(folder, "status.json")
+        self.data = _read(self.path) or {"started": time.time()}
+        self.data.update(state="running", pid=os.getpid())
+        self.lock = threading.Lock()
+        self.stop = threading.Event()
+        self.write()
+        threading.Thread(target=self._beat, daemon=True).start()
+
+    def write(self, **changes: Any) -> None:
+        with self.lock:
+            self.data.update(changes, updated=time.time())
+            _write(self.path, self.data)
+
+    def _beat(self) -> None:
+        while not self.stop.wait(HEARTBEAT):
+            try:
+                self.write()
+            except OSError:
+                pass
+
+
+class Cancelled(Exception):
+    pass
+
+
+class _Live:
+    """KiCad's open board, kept showing the router board's copper while it routes.
+
+    Connects to KiCad on its own (the MCP's worker stays free). Every push makes KiCad's
+    copper equal the router board's (one commit), at most every LIVE_GAP seconds, and
+    records what it showed in live.json, so apply() can tell the live copper from an edit.
+    If KiCad's copper stops matching what was last shown (the user edited it), the live
+    display stops: the run goes on, and apply() refuses to overwrite the edit."""
+
+    def __init__(self, folder: str, conn: Dict[str, str], board_path: str) -> None:
+        from kipy import KiCad
+        from commands.freerouting_live import LiveCopper
+
+        self.path = os.path.join(folder, "live.json")
+        self.kicad = KiCad(socket_path=conn["socket"], kicad_token=conn.get("token", ""),
+                           client_name=f"powerlab-router-{os.getpid()}", timeout_ms=20000)
+        self.kboard = self.kicad.get_board()
+        if os.path.normcase(os.path.abspath(self.kboard.name)) != os.path.normcase(os.path.abspath(board_path)) and \
+                os.path.basename(self.kboard.name) != os.path.basename(board_path):
+            raise RuntimeError("KiCad has another board open")
+        self.copper = LiveCopper(self.kboard)
+        self.last = 0.0
+        self.shown: Optional[set] = None
+        self.stopped = ""
+        self.pushes = 0
+        try:  # the old fill would hide the new tracks; the pours are refilled at the end
+            self.kicad.run_action("pcbnew.ZoneFiller.zoneUnfillAll")
+        except Exception:
+            pass
+
+    def push(self, board: Any, force: bool = False) -> None:
+        from commands.freerouting_live import kipy_key, pcbnew_copper
+
+        if self.stopped or (not force and time.time() - self.last < LIVE_GAP):
+            return
+        try:
+            if self.shown is not None:
+                now = {_key_text(kipy_key(i)) for i in list(self.kboard.get_tracks()) + list(self.kboard.get_vias())}
+                if now != self.shown:
+                    self.stopped = "KiCad's board was edited during the run"
+                    return
+            final = pcbnew_copper(board)
+            self.copper.finish(final, "PowerLab router (live)")
+            self.shown = {_key_text(k) for k in final}
+            _write(self.path, {"shown": sorted(self.shown), "updated": time.time()})
+            self.pushes += 1
+        except Exception as e:
+            self.stopped = f"live display stopped: {e}"
+        self.last = time.time()
+
+
+def pick_nets(board: Any, wanted: Optional[List[str]], pour_nets: List[str]):
+    """Nets to route, and the ones left out with why.
+
+    Default: every net of the Default class (routed from scratch), and the nets of the
+    other classes (power rails, USB...) that have no tracks yet. A power rail with tracks
+    was routed by hand, so it stays as it is unless `wanted` names it."""
+    ns = board.GetDesignSettings().m_NetSettings
+    on_pads = {p.GetNetname() for fp in board.GetFootprints() for p in fp.Pads() if p.GetNetname()}
+    locked = {t.GetNetname() for t in board.GetTracks() if t.IsLocked()}
+    tracked = {t.GetNetname() for t in board.GetTracks()}
+    if wanted:
+        candidates = list(dict.fromkeys(wanted))
+    else:
+        candidates = sorted(on_pads)
+    nets, skipped = [], {}
+    for n in candidates:
+        if n not in on_pads:
+            skipped[n] = "no pads on this net"
+        elif n in pour_nets:
+            skipped[n] = "pour net: the pour connects it"
+        elif n in locked:
+            skipped[n] = "has locked copper (routed by hand); unlock it to route it again"
+        elif not wanted and ns.GetEffectiveNetClass(n).GetName() != "Default" and n in tracked:
+            skipped[n] = "already has tracks (routed by hand); name it in nets to route it again"
+        else:
+            nets.append(n)
+    return nets, skipped
+
+
+def run(folder: str) -> None:
+    job = _read(os.path.join(folder, "job.json"))
+    st = _Status(folder)
+    log = open(os.path.join(folder, "log.txt"), "w", encoding="utf-8", errors="replace")
+    live: Optional[_Live] = None
+    live_note = ""
+    cancel_flag = os.path.join(folder, "cancel")
+    try:
+        import pcbnew
+        from commands.powerlab_router.router import Router
+        from commands.powerlab_router.search import Costs
+        from commands.route_cleanup import Drc
+
+        st.write(phase="loading the board")
+        board = pcbnew.LoadBoard(job["input"])
+        nets, skipped = pick_nets(board, job.get("nets"), job["pour_nets"])
+        if not nets:
+            raise ValueError(f"No nets to route; left out: {skipped}")
+        removed = 0
+        for t in list(board.GetTracks()):
+            if t.GetNetname() in nets and not t.IsLocked():
+                board.Delete(t)
+                removed += 1
+        pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+        stripped = os.path.join(folder, "stripped", os.path.basename(job["input"]))
+        os.makedirs(os.path.dirname(stripped))
+        for ext in PROJECT_FILES:
+            src = os.path.splitext(job["input"])[0] + ext
+            if os.path.isfile(src):
+                shutil.copy2(src, os.path.splitext(stripped)[0] + ext)
+        board.Save(stripped)
+        board = pcbnew.LoadBoard(stripped)
+        if job.get("kicad"):
+            try:
+                live = _Live(folder, job["kicad"], job["board_path"])
+                live.push(board, force=True)  # the old tracks of these nets go
+            except Exception as e:
+                live_note = f"no live display: {e}"
+        drc = Drc(stripped, job["kicad_cli"]) if job.get("kicad_cli") else None
+        if drc:
+            st.write(phase="DRC before routing")
+            base = drc.errors(board)
+
+        costs = Costs(turn=job["turn"], via=job["via"], min_run=job["min_run"],
+                      layer_factor=dict(enumerate(job["layers"])), max_nodes=job["max_nodes"],
+                      diagonal=job["diagonal"], min_run_diag=job["min_run_diag"])
+        router = Router(board, pitch=job["pitch"], pour_nets=job["pour_nets"], costs=costs, order="bus",
+                        ripup=True, finish=True, step_in=True, draw=True, layers=job.get("route_layers"),
+                        time_limit=job.get("time_limit"))
+        total = len(router.connections(nets))
+        done: Dict[str, bool] = {}
+        t_route = time.time()
+        st.write(phase="routing", nets=len(nets), connections=total, routed=0, last_routed_at=t_route,
+                 layers=[router.rb.layer_names[L] for L in router.rb.layers],
+                 time_limit_min=round(job.get("time_limit", 0) / 60.0, 1))
+
+        def progress(r: Dict[str, Any]) -> None:
+            if os.path.exists(cancel_flag):
+                raise Cancelled()
+            if "connection" in r:
+                before = sum(done.values())
+                done[r["connection"]] = bool(r.get("ok"))
+                log.write(f"{r['net']} {r['connection']} {r['event']}\n")
+                log.flush()
+                routed = sum(done.values())
+                minutes = max((time.time() - t_route) / 60.0, 1e-3)
+                rate = routed / minutes
+                more = {"last_routed_at": time.time()} if routed > before else {}
+                st.write(routed=routed, events=st.data.get("events", 0) + 1, last=r["event"][:120],
+                         per_minute=round(rate, 1),
+                         eta_minutes=round((total - routed) / rate, 1) if rate > 0 else None, **more)
+            if r.get("phase"):
+                st.write(phase=r["phase"])
+            if live:
+                live.push(board, force=bool(r.get("phase")))
+
+        rep = router.run(nets, log=progress)
+        from commands.powerlab_router import pours
+
+        if job.get("power_pours", True):
+            st.write(phase="power pours")
+            # every power rail with tracks: routed now, or by hand before (§3.3)
+            rails = sorted({t.GetNetname() for t in board.GetTracks() if t.GetNetname()} - set(job["pour_nets"]))
+            pour_drc = Drc(stripped, job["kicad_cli"]) if job.get("kicad_cli") else None
+            try:
+                rep["power_pours"] = pours.power_pours(router, [n for n in rails if router.is_power(n)],
+                                                      solid=job.get("solid_pour_nets") or [],
+                                                      check=(lambda: pour_drc.errors(board)) if pour_drc else None)
+            finally:
+                if pour_drc:
+                    pour_drc.close()
+            if live:
+                live.push(board, force=True)
+        if job.get("stitch_pitch", 5.0):
+            st.write(phase="stitching vias")
+            rep["stitching"] = pours.stitching_vias(router, float(job.get("stitch_pitch", 5.0)))
+        st.write(phase="refilling zones")
+        pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+        if live:
+            live.push(board, force=True)
+        result = os.path.join(folder, "result", os.path.basename(job["input"]))
+        os.makedirs(os.path.dirname(result))
+        board.Save(result)
+        new_drc = None
+        if drc:
+            st.write(phase="DRC after routing")
+            after = Drc(stripped, job["kicad_cli"])
+            new_drc = {}
+            for kind, _ in after.errors(pcbnew.LoadBoard(result)) - base:
+                new_drc[kind] = new_drc.get(kind, 0) + 1
+            after.close()
+            drc.close()
+        tracks = [t for t in board.GetTracks() if t.GetNetname() in nets]
+        rep.pop("connections_list", None)
+        for k in ("shapes", "finish", "drawn_whole", "nodes", "retries", "search_seconds"):
+            rep.pop(k, None)
+        rep.update(
+            nets=len(nets),
+            nets_left_out=skipped,
+            old_tracks_removed=removed,
+            track_mm=round(sum(pcbnew.ToMM(t.GetLength()) for t in tracks if t.Type() == pcbnew.PCB_TRACE_T), 1),
+            vias=sum(1 for t in tracks if t.Type() == pcbnew.PCB_VIA_T),
+            new_drc_errors=new_drc,
+            grid_pitch=job["pitch"],
+            costs={"turn": job["turn"], "via": job["via"], "diagonal": job["diagonal"], "layers": job["layers"]},
+            routing_seconds=rep.pop("seconds"),
+            seconds=round(time.time() - st.data["started"], 1),
+            live=({"updates": live.pushes, **({"stopped": live.stopped} if live.stopped else {})}
+                  if live else (live_note or None)),
+        )
+        _write(os.path.join(folder, "report.json"), rep)
+        st.write(state="done", phase="finished", result=result, routed=rep["routed"])
+    except Exception as e:
+        cancelled = isinstance(e, Cancelled)
+        if not cancelled:
+            log.write(traceback.format_exc())
+        if live and live.shown is not None and not live.stopped:
+            try:  # KiCad back as saved: its copper, and the pours refilled
+                import pcbnew
+                from commands.freerouting_live import pcbnew_copper
+
+                live.copper.finish(pcbnew_copper(pcbnew.LoadBoard(job["input"])), "PowerLab router: back as saved")
+                live.kboard.refill_zones(block=True, max_poll_seconds=60.0)
+                st.data["put_back"] = True
+            except Exception as e2:
+                log.write(f"KiCad not put back: {e2}\n")
+        if cancelled:
+            st.write(state="cancelled")
+        else:
+            st.write(state="failed", error=f"{type(e).__name__}: {e}")
+    finally:
+        st.stop.set()
+        log.close()
+
+
+if __name__ == "__main__":
+    # python/, not python/commands/ (whose module names could shadow others)
+    sys.path[0] = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    run(sys.argv[1])
