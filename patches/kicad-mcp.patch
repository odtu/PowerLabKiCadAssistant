+                "message": f"Removed {len(edge)} Edge.Cuts item(s) from KiCad's board",
+                "removed": len(edge),
+            }
+        except Exception as e:
+            logger.error(f"IPC clear_board_outline error: {e}")
+            return {"success": False, "message": "Failed to clear board outline", "errorDetails": str(e)}
 
