diff --git a/python/commands/freerouting_live.py b/python/commands/freerouting_live.py
new file mode 100644
index 0000000..a44f0b2
--- /dev/null
+++ b/python/commands/freerouting_live.py
@@ -0,0 +1,377 @@
+"""
+Live autorouting (PowerLab patch): show Freerouting's work in KiCad while it routes.
+
+Freerouting 2.4.1 runs as a local API server. Its partial session (SES) output is
+imported into a scratch copy of the board every few seconds, and the difference
+from the previous update is pushed into the open KiCad PCB editor over the IPC
+API (kipy), in one commit per update. Only copper this run added is touched;
+pre-existing and locked copper is never changed during routing.
+"""
+
+import base64
+import hashlib
+import json
+import logging
+import os
+import socket
+import subprocess
+import tempfile
+import time
+import urllib.error
+import urllib.request
+import uuid
+from typing import Any, Callable, Dict, Iterable, List, Optional, Tuple
+
+logger = logging.getLogger("kicad_interface")
+
+# Copper item key: everything that decides what the item looks like, so an
+# unchanged track or via keeps its key from one update to the next.
+Key = Tuple[Any, ...]
+
+_DONE_STATES = ("COMPLETED", "CANCELLED", "TERMINATED", "TIMED_OUT", "INVALID")
+
+
+def _free_port() -> int:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+class FreeroutingServer:
+    """A Freerouting API server on localhost for one autoroute run."""
+
+    def __init__(self, java_exe: str, jar_path: str, work_dir: str) -> None:
+        self.port = _free_port()
+        self.base = f"http://127.0.0.1:{self.port}/v1"
+        self.log_path = os.path.join(work_dir, "freerouting-api.log")
+        self._log = open(self.log_path, "w", encoding="utf-8", errors="replace")
+        flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
+        self.proc = subprocess.Popen(
+            [
+                java_exe,
+                "-jar",
+                jar_path,
+                "--gui.enabled=false",
+                "--api_server.enabled=true",
+                f"--api_server.endpoints=http://127.0.0.1:{self.port}",
+                # Local only, so no API key; Freerouting otherwise asks for one
+                "--api_server.authentication.enabled=false",
+                "--usage_and_diagnostic_data.disable_analytics=true",
+                "--feature_flags.save_jobs=false",
+            ],
+            stdout=self._log,
+            stderr=subprocess.STDOUT,
+            cwd=work_dir,
+            creationflags=flags,
+        )
+        self.headers = {
+            "Content-Type": "application/json",
+            "Freerouting-Profile-ID": str(uuid.uuid4()),
+            "Freerouting-Environment-Host": "KiCad/10.0",
+        }
+
+    def call(self, method: str, path: str, body: Any = None, timeout: float = 30) -> Tuple[int, str]:
+        data = json.dumps(body).encode() if body is not None else None
+        req = urllib.request.Request(self.base + path, data=data, method=method, headers=self.headers)
+        try:
+            with urllib.request.urlopen(req, timeout=timeout) as r:
+                return r.status, r.read().decode("utf-8", errors="replace")
+        except urllib.error.HTTPError as e:
+            return e.code, e.read().decode("utf-8", errors="replace")
+
+    def wait_ready(self, timeout: float = 60) -> None:
+        deadline = time.time() + timeout
+        while time.time() < deadline:
+            if self.proc.poll() is not None:
+                raise RuntimeError(f"Freerouting exited with code {self.proc.returncode}: {self.log_tail()}")
+            try:
+                if self.call("GET", "/system/status", timeout=2)[0] == 200:
+                    return
+            except (urllib.error.URLError, OSError):
+                pass
+            time.sleep(0.25)
+        raise RuntimeError(f"Freerouting API server did not start in {timeout:.0f}s")
+
+    def log_tail(self, chars: int = 800) -> str:
+        try:
+            self._log.flush()
+            with open(self.log_path, "r", encoding="utf-8", errors="replace") as fh:
+                return fh.read()[-chars:]
+        except OSError:
+            return ""
+
+    def close(self) -> None:
+        if self.proc.poll() is None:
+            self.proc.terminate()
+            try:
+                self.proc.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                self.proc.kill()
+        self._log.close()
+
+
+def _json(status_text: Tuple[int, str], what: str) -> Dict[str, Any]:
+    status, text = status_text
+    if status != 200:
+        raise RuntimeError(f"Freerouting {what} failed ({status}): {text[:300]}")
+    return json.loads(text)
+
+
+def _ses_text(payload: str) -> str:
+    return base64.b64decode(json.loads(payload)["data"]).decode("utf-8", errors="replace")
+
+
+def run_job(
+    server: FreeroutingServer,
+    dsn_path: str,
+    passes: int,
+    timeout: float,
+    interval: float,
+    on_partial: Callable[[str], None],
+) -> Dict[str, Any]:
+    """Route one DSN on the server, calling on_partial with each new partial SES.
+
+    Returns {"state", "ses" (final SES text or None), "elapsed", "updates", "log"}.
+    """
+    session = _json(server.call("POST", "/sessions/create", {}), "session")
+    job = _json(
+        server.call("POST", "/jobs/enqueue", {"session_id": session["id"], "name": "kicad", "priority": "NORMAL"}),
+        "enqueue",
+    )
+    jid = job["id"]
+    with open(dsn_path, "rb") as fh:
+        dsn = base64.b64encode(fh.read()).decode()
+    _json(server.call("POST", f"/jobs/{jid}/input", {"filename": os.path.basename(dsn_path), "data": dsn}), "input")
+    _json(server.call("POST", f"/jobs/{jid}/settings", {"max_passes": int(passes)}), "settings")
+    _json(server.call("PUT", f"/jobs/{jid}/start"), "start")
+
+    start = time.time()
+    last_hash = None
+    updates = 0
+    state = "RUNNING"
+    while True:
+        state = _json(server.call("GET", f"/jobs/{jid}"), "status").get("state", "")
+        if state in _DONE_STATES:
+            break
+        if time.time() - start > timeout:
+            server.call("PUT", f"/jobs/{jid}/cancel")
+            return {"state": "TIMED_OUT", "ses": None, "elapsed": time.time() - start, "updates": updates}
+        status, text = server.call("GET", f"/jobs/{jid}/output")
+        if status == 202 and text:
+            ses = _ses_text(text)
+            h = hashlib.sha1(ses.encode()).hexdigest()
+            if h != last_hash and "(wire" in ses:
+                last_hash = h
+                on_partial(ses)
+                updates += 1
+        time.sleep(interval)
+
+    ses = None
+    if state == "COMPLETED":
+        status, text = server.call("GET", f"/jobs/{jid}/output")
+        if status == 200:
+            ses = _ses_text(text)
+    log = ""
+    if ses is None:
+        status, text = server.call("GET", f"/jobs/{jid}/logs")
+        log = text[-1500:]
+    return {"state": state, "ses": ses, "elapsed": time.time() - start, "updates": updates, "log": log}
+
+
+# ---------------------------------------------------------------------------
+# Copper on both sides: pcbnew (scratch board) and kipy (KiCad's live board)
+# ---------------------------------------------------------------------------
+
+
+def _seg(layer: str, a: Tuple[int, int], b: Tuple[int, int]) -> Tuple[Any, ...]:
+    return (layer,) + (a + b if a <= b else b + a)
+
+
+def pcbnew_copper(board: Any, skip_nets: Iterable[str] = ()) -> Dict[Key, Dict[str, Any]]:
+    """Tracks, arcs and vias of a pcbnew board, keyed like kipy_key()."""
+    import pcbnew
+
+    skip = set(skip_nets)
+    out: Dict[Key, Dict[str, Any]] = {}
+    for t in board.GetTracks():
+        net = t.GetNetname()
+        if net in skip:
+            continue
+        kind = t.Type()
+        if kind == pcbnew.PCB_VIA_T:
+            p = t.GetPosition()
+            spec = {"kind": "via", "pos": (p.x, p.y), "dia": t.GetWidth(pcbnew.F_Cu),
+                    "drill": t.GetDrillValue(), "net": net}
+            key: Key = ("v", p.x, p.y, spec["dia"], spec["drill"], net)
+        else:
+            layer = pcbnew.BOARD.GetStandardLayerName(t.GetLayer())
+            s, e = t.GetStart(), t.GetEnd()
+            spec = {"layer": layer, "start": (s.x, s.y), "end": (e.x, e.y), "width": t.GetWidth(), "net": net}
+            if kind == pcbnew.PCB_ARC_T:
+                m = t.GetMid()
+                spec.update(kind="arc", mid=(m.x, m.y))
+                key = ("a",) + _seg(layer, (s.x, s.y), (e.x, e.y)) + ((m.x, m.y), spec["width"], net)
+            else:
+                spec["kind"] = "track"
+                key = ("t",) + _seg(layer, (s.x, s.y), (e.x, e.y)) + (spec["width"], net)
+        out[key] = spec
+    return out
+
+
+def _layer_name(layer: int) -> str:
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    return BoardLayer.Name(layer)[3:].replace("_", ".")
+
+
+def kipy_key(item: Any) -> Optional[Key]:
+    from kipy.board_types import ArcTrack, Track, Via
+
+    net = item.net.name if item.net else ""
+    if isinstance(item, Via):
+        p = item.position
+        return ("v", p.x, p.y, item.diameter, item.drill_diameter, net)
+    layer = _layer_name(item.layer)
+    s, e = item.start, item.end
+    if isinstance(item, ArcTrack):
+        m = item.mid
+        return ("a",) + _seg(layer, (s.x, s.y), (e.x, e.y)) + ((m.x, m.y), item.width, net)
+    if isinstance(item, Track):
+        return ("t",) + _seg(layer, (s.x, s.y), (e.x, e.y)) + (item.width, net)
+    return None
+
+
+class LiveCopper:
+    """Keeps KiCad's open board showing a changing set of copper items."""
+
+    def __init__(self, kboard: Any) -> None:
+        self.board = kboard
+        self.nets = {n.name: n for n in kboard.get_nets()}
+        self.shown: Dict[Key, Any] = {}
+        self.pushes: List[Dict[str, Any]] = []
+
+    def _build(self, spec: Dict[str, Any]) -> Any:
+        from kipy.board_types import ArcTrack, Track, Via
+        from kipy.geometry import Vector2
+        from kipy.proto.board.board_types_pb2 import BoardLayer, ViaType
+
+        if spec["kind"] == "via":
+            item = Via()
+            item.position = Vector2.from_xy(*spec["pos"])
+            item.type = ViaType.VT_THROUGH
+            item.diameter = spec["dia"]
+            item.drill_diameter = spec["drill"]
+        else:
+            item = ArcTrack() if spec["kind"] == "arc" else Track()
+            item.start = Vector2.from_xy(*spec["start"])
+            item.end = Vector2.from_xy(*spec["end"])
+            if spec["kind"] == "arc":
+                item.mid = Vector2.from_xy(*spec["mid"])
+            item.width = spec["width"]
+            item.layer = BoardLayer.Value("BL_" + spec["layer"].replace(".", "_"))
+        net = self.nets.get(spec["net"])
+        if net is not None:
+            item.net = net
+        return item
+
+    def _apply(self, remove: List[Any], add: List[Tuple[Key, Dict[str, Any]]], message: str) -> List[Any]:
+        t0 = time.time()
+        created: List[Any] = []
+        commit = self.board.begin_commit()
+        try:
+            if remove:
+                self.board.remove_items(remove)
+            if add:
+                created = self.board.create_items([self._build(spec) for _, spec in add])
+            self.board.push_commit(commit, message)
+        except Exception:
+            try:
+                self.board.drop_commit(commit)
+            except Exception:
+                pass
+            raise
+        self.pushes.append({"added": len(add), "removed": len(remove), "seconds": round(time.time() - t0, 3)})
+        return created
+
+    def show(self, specs: Dict[Key, Dict[str, Any]]) -> None:
+        """Make the copper this run added match specs (one undo step)."""
+        remove = [self.shown.pop(k) for k in [k for k in self.shown if k not in specs]]
+        add = [(k, s) for k, s in specs.items() if k not in self.shown]
+        if not remove and not add:
+            return
+        created = self._apply(remove, add, "Freerouting (live)")
+        for (k, _), item in zip(add, created):
+            self.shown[k] = item
+
+    def clear(self) -> None:
+        """Take this run's copper out of KiCad again."""
+        if self.shown:
+            self._apply(list(self.shown.values()), [], "Freerouting (live): cancelled")
+            self.shown.clear()
+
+    def finish(self, final: Dict[Key, Dict[str, Any]]) -> Dict[str, int]:
+        """Make KiCad's board copper match the routed result.
+
+        Copper already there with the same geometry is left alone, so locked
+        items keep their lock. Locked copper the result doesn't have is kept.
+        """
+        live: Dict[Key, List[Any]] = {}
+        for item in list(self.board.get_tracks()) + list(self.board.get_vias()):
+            k = kipy_key(item)
+            if k is not None:
+                live.setdefault(k, []).append(item)
+        remove: List[Any] = []
+        kept_locked = 0
+        for k, items in live.items():
+            extra = items if k not in final else items[1:]  # drop duplicates too
+            for item in extra:
+                if item.locked:
+                    kept_locked += 1
+                else:
+                    remove.append(item)
+        add = [(k, s) for k, s in final.items() if k not in live]
+        self._apply(remove, add, "Freerouting autoroute")
+        self.shown.clear()
+        return {"added": len(add), "removed": len(remove), "locked_kept": kept_locked}
+
+
+class LivePreview:
+    """Imports partial sessions into a scratch board and shows the new copper."""
+
+    def __init__(self, board_path: str, net_settings: Optional[Dict[str, Any]], live: LiveCopper,
+                 skip_nets: Iterable[str], repair: Callable[[Any], Any], work_dir: str) -> None:
+        import pcbnew
+
+        self.board = pcbnew.LoadBoard(board_path)
+        if net_settings:
+            try:
+                from utils.project_netclasses import apply_net_classes_to_board
+
+                apply_net_classes_to_board(self.board, net_settings)
+            except Exception as e:
+                logger.debug(f"Live preview: net classes not applied ({e})")
+        self.skip = set(skip_nets)
+        self.before = set(pcbnew_copper(self.board))
+        self.live = live
+        self.repair = repair
+        self.ses_path = os.path.join(work_dir, "partial.ses")
+        self.timings: List[float] = []
+        self.errors = 0
+
+    def update(self, ses_text: str) -> None:
+        import pcbnew
+
+        t0 = time.time()
+        try:
+            with open(self.ses_path, "w", encoding="utf-8") as fh:
+                fh.write(ses_text)
+            if not pcbnew.ImportSpecctraSES(self.board, self.ses_path):
+                raise RuntimeError("ImportSpecctraSES failed")
+            self.repair(self.board)
+            new = {k: s for k, s in pcbnew_copper(self.board, self.skip).items() if k not in self.before}
+            self.live.show(new)
+        except Exception as e:
+            # A bad partial update must not stop the routing; the final import decides.
+            self.errors += 1
+            logger.warning(f"Live autoroute update skipped: {e}")
+        self.timings.append(time.time() - t0)
