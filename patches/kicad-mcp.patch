+    def _ipc_add_outline_circle(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """A round board outline (Edge.Cuts circle) on KiCad's open board (PowerLab patch,
+        #68: the live handler wanted a points list, so circles failed with "At least 2
+        points required"). Centre: centerX/centerY, or x/y as the SWIG path reads them."""
+        try:
+            from kipy.board_types import BoardCircle
+            from kipy.geometry import Vector2
+            from kipy.proto.board.board_types_pb2 import BoardLayer
+            from kipy.util.units import from_mm
+
+            inner = params.get("params", params)
+            scale = {"mm": 1.0, "mil": 0.0254, "inch": 25.4}.get(inner.get("unit", "mm"), 1.0)
+            radius = inner.get("radius")
+            if radius is None and inner.get("diameter") is not None:
+                radius = inner["diameter"] / 2
+            if radius is None:
+                return {
+                    "success": False,
+                    "message": "Missing radius",
+                    "errorDetails": "Radius is required for circle",
+                }
+            cx = inner.get("centerX", inner.get("x", 0)) or 0
+            cy = inner.get("centerY", inner.get("y", 0)) or 0
+            cx, cy, radius = cx * scale, cy * scale, radius * scale
+
+            board = self.ipc_board_api._get_board()
+            circle = BoardCircle()
+            circle.center = Vector2.from_xy(from_mm(cx), from_mm(cy))
+            circle.radius_point = Vector2.from_xy(from_mm(cx + radius), from_mm(cy))
+            circle.layer = BoardLayer.BL_Edge_Cuts
+            circle.attributes.stroke.width = from_mm(inner.get("lineWidth", 0.1))
+            commit = board.begin_commit()
+            board.create_items(circle)
+            board.push_commit(commit, "Added round board outline")
+            return {
+                "success": True,
+                "message": f"Added round board outline, radius {radius:g} mm at ({cx:g}, {cy:g}) mm",
+                "center": {"x": cx, "y": cy, "unit": "mm"},
+                "radius": radius,
+            }
+        except Exception as e:
+            logger.error(f"IPC add_board_outline circle error: {e}")
+            return {"success": False, "message": str(e)}
+
