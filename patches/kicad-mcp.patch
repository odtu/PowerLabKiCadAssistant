+    def _handle_set_design_rules(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """set_design_rules writes the .kicad_pro and .kicad_dru (PowerLab patch).
+
+        The solder mask settings live in the board file: with KiCad open on the board,
+        KiCad saves, they are set on the saved file and KiCad reverts to it, like
+        LIVE_VIA_FILE_COMMANDS. pcbnew keeps the project it loaded first in memory, so
+        the tool's own copy is loaded again with the project re-read; otherwise its next
+        save would write the old values back. KiCad's own window can't be updated (its
+        API has no design settings call and reverting doesn't re-read the project), so
+        the answer says to reopen the project there.
+        """
+        from utils.design_rules_project import persist_design_rules_to_project
+
+        board_path = self._current_board_path() if getattr(self, "board", None) else None
+        if not board_path and not params.get("projectPath"):
+            return {
+                "success": False,
+                "message": "No board is loaded",
+                "errorDetails": "Open the board or project first, or pass projectPath",
+            }
+        mask = any(
+            params.get(k) is not None for k in ("preset", "solderMaskExpansion", "solderMaskMinWidth")
+        )
+        live = self._live_board_for_file_edit() if board_path else None
+        if live is not None and self._normalize_board_path(live[0]) != self._normalize_board_path(
+            board_path
+        ):
+            live = None
+        synced = True  # the tool's board matches the saved file
+        if live is not None and mask:
+            try:
+                live[1].save()
+            except Exception as e:
+                return {"success": False, "message": f"KiCad could not save the board: {e}"}
+            self._reload_board_file(board_path)
+        elif board_path and live is None:
+            status = self._auto_save_board()
+            synced = bool(status.get("saved"))
+            if not synced:
+                logger.warning(f"set_design_rules: board not saved first ({status})")
+
+        result = self.design_rule_commands.set_design_rules(params)
+        values = result.pop("_values", None) if isinstance(result, dict) else None
+        if not (isinstance(result, dict) and result.get("success")) or not board_path:
+            return result
+
+        warnings = list(result.get("warnings") or [])
+        if not synced:
+            warnings.append(
+                "The tool's copy of the board differs from the saved file, so the solder "
+                "mask settings are only in its memory until save_board."
+            )
+        else:
+            if mask and values and values.get("boardFile"):
+                with preserve_project_settings(board_path):
+                    pcbnew.SaveBoard(board_path, self.board)
+                # SaveBoard also wrote the tool's stale project settings; write ours again.
+                persist_design_rules_to_project(result["projectFile"], values)
+            self._reload_board_with_project(board_path, warnings)
+            if live is not None and mask:
+                try:
+                    live[1].revert()
+                except Exception as e:
+                    warnings.append(
+                        f"KiCad did not reload the board ({e}): use File > Revert in KiCad "
+                        "before editing or saving there."
+                    )
+        if live is not None:
+            result["_backend"] = "ipc"
+            result["liveNote"] = (
+                "KiCad has this project open. KiCad 10 reads the design rules only when it "
+                "opens a project, and its API can't change them, so Board Setup still shows "
+                "the old values"
+                + (" (the solder mask settings are already in KiCad)" if mask else "")
+                + ". Board Setup shows the new values the next time the project is opened "
+                "in KiCad (tell the user; don't ask them to close anything). Until then KiCad "
+                "routes with its old net classes, so pass the track width explicitly, and "
+                "nobody should press OK in Board Setup or change net classes there: KiCad would "
+                "write its old values back over these. get_design_rules reads the files. "
+                "run_drc already uses them (kicad-cli reads the files)"
+                + (
+                    ", and KiCad's own DRC takes the minimums from the \"Lab minimums\" "
+                    "rule in the .kicad_dru."
+                    if any("Lab minimums" in line for line in result.get("set", []))
+                    else "."
+                )
+            )
+        if warnings:
+            result["warnings"] = warnings
+        return result
+
+    def _reload_board_with_project(self, board_path: str, warnings: List[str]) -> None:
+        """Load the board again with its .kicad_pro re-read (PowerLab patch).
+
+        pcbnew.LoadBoard reuses a project this process already loaded, even after the
+        file changed, and SaveBoard writes that copy back over the file. Unloading the
+        project first makes LoadBoard read the file."""
+        try:
+            pro = str(Path(board_path).with_suffix(".kicad_pro"))
+            manager = pcbnew.GetSettingsManager()
+            project = manager.GetProject(pro) or manager.GetProject(os.path.abspath(pro))
+            if project is not None:
+                manager.UnloadProject(project, False)
+        except Exception as e:
+            warnings.append(f"The tool kept its old copy of the project settings ({e}).")
+            return
+        board = self._safe_load_board(board_path)
+        if board is None:  # the old board's project is gone: don't keep using it
+            self._clear_swig_board_state()
+            warnings.append("Could not load the board again: call open_project.")
+            return
+        self.board = board
+        self._update_command_handlers()
+        self._record_board_signature()
+
