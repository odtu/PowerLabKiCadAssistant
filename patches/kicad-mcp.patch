new file mode 100644
index 0000000..677d178
--- /dev/null
+++ b/tests/test_powerlab_board_text.py
@@ -0,0 +1,311 @@
+"""PowerLab patch: board text can be listed, edited and deleted (#70).
+
+Text placed with add_board_text could never be changed or removed: live, list_graphics and
+delete_graphic read only KiCad's shapes (#56), and no tool edited board text at all. These
+tests pin the live handlers with kipy objects and the offline ones with mocks, plus a real
+pcbnew round trip when KICAD_USE_REAL_PCBNEW=1.
+"""
+
+import os
+import sys
+from pathlib import Path
+from typing import Any
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent.parent / "python"))
+
+
+def _iface() -> Any:
+    with patch("kicad_interface.USE_IPC_BACKEND", True):
+        from kicad_interface import KiCADInterface
+
+        iface = KiCADInterface.__new__(KiCADInterface)
+    iface.use_ipc = True
+    iface.board = MagicMock()
+    iface.ipc_board_api = MagicMock()
+    iface.session_backend = "ipc"
+    iface.session_board_path = None
+    return iface
+
+
+def _live_text(value="Rev A", x=10.0, y=5.0, layer="BL_F_SilkS", size=1.0):
+    from kipy.board_types import BoardText
+    from kipy.geometry import Vector2
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    text = BoardText()
+    text._proto.id.value = "text-1"
+    text.value = value
+    text.position = Vector2.from_xy(int(x * 1e6), int(y * 1e6))
+    text.layer = BoardLayer.Value(layer)
+    text.attributes.size = Vector2.from_xy(int(size * 1e6), int(size * 1e6))
+    text.attributes.stroke_width = 150_000
+    return text
+
+
+def _live_board(shapes=(), texts=()):
+    board = MagicMock()
+    board.get_shapes.return_value = list(shapes)
+    board.get_text.return_value = list(texts)
+    return board
+
+
+def test_edit_board_text_is_a_live_command():
+    from kicad_interface import KiCADInterface
+
+    assert KiCADInterface.IPC_CAPABLE_COMMANDS["edit_board_text"] == "_ipc_edit_board_text"
+    assert "edit_board_text" in KiCADInterface._BOARD_MUTATING_COMMANDS
+
+
+def test_live_list_graphics_lists_text():
+    iface = _iface()
+    iface.ipc_board_api._get_board.return_value = _live_board(texts=[_live_text()])
+    result = iface._ipc_list_graphics({})
+    assert result["success"] and result["count"] == 1
+    entry = result["graphics"][0]
+    assert entry["uuid"] == "text-1"
+    assert entry["type"] == "BoardText"
+    assert entry["text"] == "Rev A"
+    assert entry["layer"] == "F.SilkS"
+    assert entry["position"] == {"x": 10.0, "y": 5.0, "unit": "mm"}
+    assert entry["size"] == 1.0
+    assert entry["thickness"] == 0.15
+
+
+def test_live_list_graphics_layer_filter_takes_kicad_names():
+    iface = _iface()
+    iface.ipc_board_api._get_board.return_value = _live_board(texts=[_live_text()])
+    assert iface._ipc_list_graphics({"layer": "F.Silkscreen"})["count"] == 1
+    assert iface._ipc_list_graphics({"layer": "F.SilkS"})["count"] == 1
+    assert iface._ipc_list_graphics({"layer": "B.SilkS"})["count"] == 0
+
+
+def test_live_delete_graphic_deletes_text():
+    iface = _iface()
+    text = _live_text()
+    board = _live_board(texts=[text])
+    iface.ipc_board_api._get_board.return_value = board
+    result = iface._ipc_delete_graphic({"uuid": "text-1"})
+    assert result["success"]
+    board.remove_items.assert_called_once_with([text])
+    board.push_commit.assert_called_once()
+
+
+def test_live_edit_board_text_changes_everything_in_one_commit():
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    iface = _iface()
+    text = _live_text()
+    board = _live_board(texts=[text])
+    iface.ipc_board_api._get_board.return_value = board
+    result = iface._ipc_edit_board_text(
+        {
+            "uuid": "text-1",
+            "text": "Rev B",
+            "position": {"x": 20, "y": 30, "unit": "mm"},
+            "layer": "B.Silkscreen",
+            "size": 1.5,
+            "thickness": 0.2,
+            "rotation": 90,
+            "mirrored": True,
+        }
+    )
+    assert result["success"], result
+    assert text.value == "Rev B"
+    assert (text.position.x, text.position.y) == (20_000_000, 30_000_000)
+    assert text.layer == BoardLayer.BL_B_SilkS
+    assert (text.attributes.size.x, text.attributes.size.y) == (1_500_000, 1_500_000)
+    assert text.attributes.stroke_width == 200_000
+    assert text.attributes.angle == 90
+    assert text.attributes.mirrored is True
+    board.update_items.assert_called_once_with([text])
+    board.begin_commit.assert_called_once()
+    board.push_commit.assert_called_once()
+    assert result["graphic"]["text"] == "Rev B"
+
+
+def test_live_edit_board_text_unknown_uuid_fails():
+    iface = _iface()
+    board = _live_board(texts=[_live_text()])
+    iface.ipc_board_api._get_board.return_value = board
+    result = iface._ipc_edit_board_text({"uuid": "nope", "text": "x"})
+    assert result["success"] is False
+    board.update_items.assert_not_called()
+
+
+def test_live_edit_board_text_bad_layer_changes_nothing():
+    iface = _iface()
+    board = _live_board(texts=[_live_text()])
+    iface.ipc_board_api._get_board.return_value = board
+    result = iface._ipc_edit_board_text({"uuid": "text-1", "layer": "Nowhere"})
+    assert result["success"] is False
+    board.update_items.assert_not_called()
+
+
+def test_live_add_text_keeps_size_and_rotation_and_gives_the_uuid():
+    """add_board_text live ignored `size` and `rotation` (BoardText has no `angle`)."""
+    from kicad_api.ipc_backend import IPCBoardAPI
+    from kipy.proto.board.board_types_pb2 import BoardLayer
+
+    api = IPCBoardAPI.__new__(IPCBoardAPI)
+    api._notify = MagicMock()
+    board = MagicMock()
+
+    def create(item):
+        item._proto.id.value = "new-1"
+        return [item]
+
+    board.create_items.side_effect = create
+    api._get_board = MagicMock(return_value=board)
+    assert api.add_text("Rev A", 10, 5, layer="F.Fab", size=1.5, rotation=90, thickness=0.2)
+    item = board.create_items.call_args[0][0]
+    assert item.attributes.angle == 90
+    assert item.attributes.size.x == 1_500_000
+    assert item.attributes.stroke_width == 200_000
+    assert item.layer == BoardLayer.BL_F_Fab  # it fell back to F.SilkS for any other layer
+    assert api.last_text_uuid == "new-1"
+
+
+def test_live_add_board_text_reports_the_uuid():
+    iface = _iface()
+    iface.ipc_board_api.add_text.return_value = True
+    iface.ipc_board_api.last_text_uuid = "new-1"
+    result = iface._ipc_add_text(
+        {"text": "Rev A", "position": {"x": 400, "y": 200, "unit": "mil"}, "size": 40}
+    )
+    assert result["success"] and result["uuid"] == "new-1"
+    kwargs = iface.ipc_board_api.add_text.call_args.kwargs
+    assert kwargs["x"] == pytest.approx(10.16) and kwargs["size"] == pytest.approx(1.016)
+
+
+# --- offline (SWIG) ----------------------------------------------------------
+
+
+class PCB_TEXT(MagicMock):
+    """Named like pcbnew's class: the handlers tell text from shapes by type name."""
+
+
+def _swig_text():
+    text = PCB_TEXT()
+    text.m_Uuid.AsString.return_value = "text-1"
+    text.GetLayer.return_value = 5
+    text.GetText.return_value = "Rev A"
+    text.GetPosition.return_value = MagicMock(x=10_000_000, y=5_000_000)
+    text.GetTextSize.return_value = MagicMock(x=1_000_000, y=1_000_000)
+    text.GetTextThickness.return_value = 150_000
+    text.GetTextAngleDegrees.return_value = 0.0
+    text.IsMirrored.return_value = False
+    return text
+
+
+def _swig_board(items):
+    board = MagicMock()
+    board.GetDrawings.return_value = items
+    board.GetLayerID.side_effect = lambda name: {
+        "F.SilkS": 5,
+        "F.Silkscreen": 5,
+        "B.SilkS": 7,
+        "B.Silkscreen": 7,
+    }.get(name, -1)
+    board.GetLayerName.side_effect = lambda layer: {5: "F.Silkscreen", 7: "B.Silkscreen"}[layer]
+    return board
+
+
+def test_offline_list_graphics_gives_text_details_and_filters_by_either_layer_name():
+    from commands.board.outline import BoardOutlineCommands
+
+    cmd = BoardOutlineCommands(board=_swig_board([_swig_text()]))
+    for layer in ("F.SilkS", "F.Silkscreen"):
+        result = cmd.list_graphics({"layer": layer})
+        assert result["count"] == 1, layer
+    entry = result["graphics"][0]
+    assert entry["text"] == "Rev A"
+    assert entry["size"] == 1.0
+    assert entry["thickness"] == 0.15
+    assert entry["angle"] == 0.0
+    assert entry["mirrored"] is False
+    assert cmd.list_graphics({"layer": "B.SilkS"})["count"] == 0
+
+
+def test_offline_edit_board_text():
+    from commands.board.outline import BoardOutlineCommands
+
+    text = _swig_text()
+    cmd = BoardOutlineCommands(board=_swig_board([text]))
+    with patch("commands.board.outline.pcbnew") as pcbnew:
+        pcbnew.VECTOR2I.side_effect = lambda x, y: (x, y)
+        result = cmd.edit_board_text(
+            {
+                "uuid": "text-1",
+                "text": "Rev B",
+                "position": {"x": 20, "y": 30, "unit": "mm"},
+                "layer": "B.SilkS",
+                "size": 1.5,
+                "thickness": 0.2,
+                "rotation": 90,
+                "mirrored": True,
+            }
+        )
+    assert result["success"], result
+    text.SetText.assert_called_once_with("Rev B")
+    text.SetPosition.assert_called_once_with((20_000_000, 30_000_000))
+    text.SetLayer.assert_called_once_with(7)
+    text.SetTextSize.assert_called_once_with((1_500_000, 1_500_000))
+    text.SetTextThickness.assert_called_once_with(200_000)
+    text.SetTextAngleDegrees.assert_called_once_with(90.0)
+    text.SetMirrored.assert_called_once_with(True)
+
+
+def test_offline_edit_board_text_refuses_shapes_and_unknown_layers():
+    from commands.board.outline import BoardOutlineCommands
+
+    shape = MagicMock()
+    shape.m_Uuid.AsString.return_value = "shape-1"
+    text = _swig_text()
+    cmd = BoardOutlineCommands(board=_swig_board([shape, text]))
+    assert cmd.edit_board_text({"uuid": "shape-1", "text": "x"})["success"] is False
+    assert cmd.edit_board_text({"uuid": "text-1", "layer": "Nowhere"})["success"] is False
+    text.SetLayer.assert_not_called()
+
+
+@pytest.mark.skipif(
+    os.environ.get("KICAD_USE_REAL_PCBNEW") != "1",
+    reason="real pcbnew round trip requires KICAD_USE_REAL_PCBNEW=1",
+)
+def test_offline_text_round_trip_with_real_pcbnew(tmp_path):
+    import pcbnew
+    from commands.board.outline import BoardOutlineCommands
+
+    path = str(tmp_path / "t.kicad_pcb")
+    pcbnew.SaveBoard(path, pcbnew.NewBoard(path))
+    board = pcbnew.LoadBoard(path)
+    cmd = BoardOutlineCommands(board=board)
+    added = cmd.add_text(
+        {"text": "Rev A", "position": {"x": 10, "y": 5, "unit": "mm"}, "layer": "F.SilkS"}
+    )
+    assert added["success"], added
+    uuid = added["text"]["uuid"]
+
+    listed = cmd.list_graphics({"layer": "F.SilkS"})
+    assert [g["uuid"] for g in listed["graphics"]] == [uuid]
+
+    edited = cmd.edit_board_text(
+        {"uuid": uuid, "text": "Rev B", "layer": "B.SilkS", "rotation": 90, "mirrored": True,
+         "size": 1.5, "position": {"x": 20, "y": 30}}
+    )
+    assert edited["success"], edited
+    pcbnew.SaveBoard(path, board)
+    board = pcbnew.LoadBoard(path)
+    cmd = BoardOutlineCommands(board=board)
+    (entry,) = cmd.list_graphics({})["graphics"]
+    assert entry["text"] == "Rev B"
+    assert entry["layer"] == "B.Silkscreen"
+    assert entry["angle"] == 90.0
+    assert entry["mirrored"] is True
+    assert entry["size"] == 1.5
+    assert entry["position"]["x"] == 20.0
+
+    assert cmd.delete_graphic({"uuid": uuid})["success"]
+    assert cmd.list_graphics({})["count"] == 0
