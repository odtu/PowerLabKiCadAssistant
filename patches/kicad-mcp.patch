+++ b/python/commands/route_cleanup.py
@@ -0,0 +1,431 @@
+"""Clean up tracks after autorouting (PowerLab patch).
+
+Freerouting leaves zero-length and tiny stubs, dead-end segments, tracks narrower than
+their net class (it writes every net at the default width) and some 90 degree corners.
+This removes the leftovers, widens tracks to their net-class width and chamfers 90
+degree corners to 45 degrees. Every change that adds copper is checked with kicad-cli
+DRC on a copy of the board, with zones refilled and every error of each track reported,
+and taken back if it adds an error.
+Locked tracks are never touched.
+
+Ported from the post-route scripts of odtu/PCBDesignWClaude (hardware/tools/pcb).
+"""
+
+import json
+import math
+import os
+import shutil
+import subprocess
+import tempfile
+from collections import defaultdict
+
+import pcbnew
+
+STEPS = ("stubs", "dangling", "widths", "miter")
+MM = pcbnew.FromMM
+STUB = MM(0.1)  # a segment shorter than this between two others is a router leftover
+
+
+def _delete(board, item):
+    """Board.Delete keeps ownership in C++; Remove() corrupts SWIG on KiCad 10 (#247)."""
+    if callable(getattr(board, "Delete", None)):
+        board.Delete(item)
+    else:
+        board.Remove(item)
+        item.thisown = False
+
+
+def _tracks(board):
+    return [t for t in board.GetTracks() if t.Type() == pcbnew.PCB_TRACE_T]
+
+
+def _vias(board):
+    return [t for t in board.GetTracks() if t.Type() == pcbnew.PCB_VIA_T]
+
+
+def _pads(board):
+    return [p for fp in board.GetFootprints() for p in fp.Pads()]
+
+
+def _xy(p):
+    return (p.x, p.y)
+
+
+def _mm(p):
+    return {"x": round(pcbnew.ToMM(p[0]), 3), "y": round(pcbnew.ToMM(p[1]), 3)}
+
+
+class Drc:
+    """kicad-cli DRC on a copy of the board next to copies of its project and rules."""
+
+    def __init__(self, board_path, kicad_cli):
+        self.cli = kicad_cli
+        self.dir = tempfile.mkdtemp(prefix="pla_cleanup_")
+        stem = os.path.splitext(os.path.basename(board_path))[0]
+        for ext in (".kicad_pro", ".kicad_dru"):
+            src = os.path.splitext(board_path)[0] + ext
+            if os.path.isfile(src):
+                shutil.copy(src, os.path.join(self.dir, stem + ext))
+        self.path = os.path.join(self.dir, stem + ".kicad_pcb")
+        self.runs = 0
+
+    def errors(self, board):
+        """{(violation type, item uuids)}: one entry per error-severity violation."""
+        board.Save(self.path)
+        out = self.path + ".json"
+        if os.path.exists(out):
+            os.remove(out)
+        subprocess.run(
+            # all track errors: by default a track already in one error hides its others
+            [self.cli, "pcb", "drc", "--all-track-errors", "--refill-zones", "--severity-error",
+             "--format", "json", "-o", out, self.path],
+            capture_output=True, timeout=900,
+        )
+        self.runs += 1
+        if not os.path.isfile(out):
+            raise RuntimeError("kicad-cli DRC wrote no report")
+        with open(out, encoding="utf-8") as fh:
+            report = json.load(fh)
+        return {
+            (v.get("type"), frozenset(it.get("uuid") for it in v.get("items", [])))
+            for v in report.get("violations", [])
+        }
+
+    def new_items(self, board, baseline):
+        """uuids of the items in violations that aren't in `baseline`."""
+        return {u for kind, uuids in self.errors(board) - baseline for u in uuids}
+
+    def close(self):
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+
+def remove_stubs(board):
+    """Zero-length tracks go; a stub < 0.1 mm is folded into its neighbours.
+
+    Returns (counts, undo): folding moves a neighbour's end, so each fold can be undone.
+    """
+    tracks = [t for t in _tracks(board) if not t.IsLocked()]
+    zero = [t for t in tracks if t.GetLength() < MM(0.001)]
+    for t in zero:
+        _delete(board, t)
+    tracks = [t for t in _tracks(board)]
+    alive = {id(t): t for t in tracks}
+    vias = {_xy(v.GetPosition()) for v in _vias(board)}
+    pads = _pads(board)
+
+    def ends():
+        m = defaultdict(list)
+        for t in alive.values():
+            m[(t.GetLayer(),) + _xy(t.GetStart())].append((t, "S"))
+            m[(t.GetLayer(),) + _xy(t.GetEnd())].append((t, "E"))
+        return m
+
+    into_pad = joined = 0
+    undo = []
+
+    def fold(t, moves):
+        """Move the neighbours' ends, delete stub `t`, and remember how to undo it."""
+        undo.append({
+            "moves": [(o, e, o.GetStart() if e == "S" else o.GetEnd()) for o, e, _ in moves],
+            "stub": (t.GetStart(), t.GetEnd(), t.GetWidth(), t.GetLayer(), t.GetNet()),
+        })
+        for o, e, pt in moves:
+            (o.SetStart if e == "S" else o.SetEnd)(pt)
+        del alive[id(t)]
+        _delete(board, t)
+
+    for t in sorted(tracks, key=lambda k: k.GetLength()):
+        if id(t) not in alive or t.IsLocked() or not (0 < t.GetLength() < STUB):
+            continue
+        m = ends()
+        layer, net = t.GetLayer(), t.GetNetCode()
+        ka, kb = (layer,) + _xy(t.GetStart()), (layer,) + _xy(t.GetEnd())
+        sa = [(o, e) for o, e in m[ka] if o is not t]
+        sb = [(o, e) for o, e in m[kb] if o is not t]
+        # the stub's far end is inside its own pad: extend the neighbour into the pad
+        done = False
+        for near, far_k, far_pt in ((sa, kb, t.GetEnd()), (sb, ka, t.GetStart())):
+            if len(near) != 1 or len(m[far_k]) != 1 or near[0][0].IsLocked():
+                continue
+            o, e = near[0]
+            if o.GetNetCode() != net or o.GetLength() <= MM(0.2):
+                continue
+            if any(p.GetNetCode() == net and p.IsOnLayer(layer) and p.HitTest(far_pt) for p in pads):
+                fold(t, [(o, e, far_pt)])
+                into_pad += 1
+                done = True
+                break
+        if done:
+            continue
+        # between two segments: join them where their lines cross
+        if len(sa) != 1 or len(sb) != 1 or ka[1:] in vias or kb[1:] in vias:
+            continue
+        (a, ea), (c, ec) = sa[0], sb[0]
+        if a.IsLocked() or c.IsLocked() or a.GetNetCode() != net or c.GetNetCode() != net:
+            continue
+        pa, qa = (a.GetStart(), a.GetEnd()) if ea == "E" else (a.GetEnd(), a.GetStart())
+        pc, qc = (c.GetStart(), c.GetEnd()) if ec == "E" else (c.GetEnd(), c.GetStart())
+        d1, d2 = (qa.x - pa.x, qa.y - pa.y), (qc.x - pc.x, qc.y - pc.y)
+        den = d1[0] * d2[1] - d1[1] * d2[0]
+        if abs(den) < 1e-6:
+            continue
+        u = ((pc.x - pa.x) * d2[1] - (pc.y - pa.y) * d2[0]) / den
+        ix, iy = pa.x + u * d1[0], pa.y + u * d1[1]
+        mx, my = (t.GetStart().x + t.GetEnd().x) / 2, (t.GetStart().y + t.GetEnd().y) / 2
+        if math.hypot(ix - mx, iy - my) > MM(0.3):
+            continue
+        ip = pcbnew.VECTOR2I(int(round(ix)), int(round(iy)))
+        fold(t, [(a, "E" if ea == "E" else "S", ip), (c, "E" if ec == "E" else "S", ip)])
+        joined += 1
+    return {"zero_length": len(zero), "merged_into_pad": into_pad, "joined": joined}, undo
+
+
+def check_stubs(board, drc, baseline, undo):
+    """Put back the folds whose moved neighbours are in a new DRC error."""
+    if not undo:
+        return 0
+    bad = drc.new_items(board, baseline)
+    back = 0
+    for u in undo:
+        if any(o.m_Uuid.AsString() in bad for o, e, pt in u["moves"]):
+            for o, e, pt in u["moves"]:
+                (o.SetStart if e == "S" else o.SetEnd)(pt)
+            start, end, width, layer, net = u["stub"]
+            stub = pcbnew.PCB_TRACK(board)
+            stub.SetStart(start)
+            stub.SetEnd(end)
+            stub.SetWidth(width)
+            stub.SetLayer(layer)
+            stub.SetNet(net)
+            board.Add(stub)
+            back += 1
+    return back
+
+
+def remove_dangling(board):
+    """Delete unlocked tracks with a free end, repeating until none is left.
+
+    An end is connected when it touches same-net copper on its layer within half the
+    track width: a pad, a via, another track or a zone fill.
+    """
+    pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+    by_net = defaultdict(lambda: {"tracks": [], "other": [], "zones": []})
+    for t in _tracks(board):
+        by_net[t.GetNetCode()]["tracks"].append(t)
+    for v in _vias(board):
+        by_net[v.GetNetCode()]["other"].append(v)
+    for p in _pads(board):
+        by_net[p.GetNetCode()]["other"].append(p)
+    for z in board.Zones():
+        if not z.GetIsRuleArea():
+            by_net[z.GetNetCode()]["zones"].append(z)
+
+    removed = 0
+    for net, g in by_net.items():
+        if net <= 0 or not g["tracks"]:
+            continue
+        alive = list(g["tracks"])
+        while True:
+            exact = defaultdict(int)
+            for t in alive:
+                exact[(t.GetLayer(),) + _xy(t.GetStart())] += 1
+                exact[(t.GetLayer(),) + _xy(t.GetEnd())] += 1
+            gone = []
+            for t in alive:
+                if t.IsLocked():
+                    continue
+                layer, r = t.GetLayer(), t.GetWidth() // 2
+                for pt in (t.GetStart(), t.GetEnd()):
+                    if exact[(layer,) + _xy(pt)] > 1:
+                        continue
+                    if any(o.IsOnLayer(layer) and o.HitTest(pt, r) for o in g["other"]):
+                        continue
+                    if any(o is not t and o.GetLayer() == layer and o.HitTest(pt, r) for o in alive):
+                        continue
+                    if any(z.IsOnLayer(layer) and z.HitTestFilledArea(layer, pt, r) for z in g["zones"]):
+                        continue
+                    gone.append(t)
+                    break
+            if not gone:
+                break
+            for t in gone:
+                alive.remove(t)
+                _delete(board, t)
+                removed += 1
+    return {"removed": removed}
+
+
+def widen_tracks(board, drc, baseline):
+    """Widen unlocked tracks to their net-class width; keep what DRC accepts.
+
+    Tracks the full width doesn't fit get halfway, then their old width back, so a
+    track only stays narrow right where something forces it.
+    """
+    ns = board.GetDesignSettings().m_NetSettings
+    want = {}
+    for t in _tracks(board):
+        if t.IsLocked() or t.GetNetCode() <= 0:
+            continue
+        target = ns.GetEffectiveNetClass(t.GetNetname()).GetTrackWidth()
+        if t.GetWidth() < target - 1000:
+            want[t.m_Uuid.AsString()] = (t, t.GetWidth(), target)
+    counts = {"candidates": len(want), "full_width": 0, "partly": 0, "kept": 0}
+    pending = set(want)
+    # A kept change has no new error while every other candidate is still widened,
+    # so it stays clean when the rejected ones go back.
+    for label, width in (("full_width", lambda old, target: target),
+                         ("partly", lambda old, target: (old + target) // 2)):
+        if not pending:
+            break
+        for u in pending:
+            t, old, target = want[u]
+            t.SetWidth(width(old, target))
+        bad = drc.new_items(board, baseline)
+        for u in list(pending):
+            if u in bad:
+                want[u][0].SetWidth(want[u][1])
+            else:
+                counts[label] += 1
+                pending.discard(u)
+    counts["kept"] = len(pending)
+    return counts
+
+
+def _corners(board, max_chamfer, only=None, scale=1.0):
+    """Chamfer joints of two same-width tracks meeting at 80-100 degrees."""
+    ends = defaultdict(list)
+    for t in _tracks(board):
+        ends[(t.GetLayer(),) + _xy(t.GetStart())].append((t, "S"))
+        ends[(t.GetLayer(),) + _xy(t.GetEnd())].append((t, "E"))
+    vias = {_xy(v.GetPosition()) for v in _vias(board)}
+    made, skipped_widths = [], 0
+    for key, lst in ends.items():
+        if len(lst) != 2 or key[1:] in vias or (only is not None and key not in only):
+            continue
+        (t1, e1), (t2, e2) = lst
+        if t1.IsLocked() or t2.IsLocked() or t1.GetNetCode() != t2.GetNetCode():
+            continue
+        x, y = key[1:]
+        q1 = t1.GetEnd() if e1 == "S" else t1.GetStart()
+        q2 = t2.GetEnd() if e2 == "S" else t2.GetStart()
+        v1, v2 = (q1.x - x, q1.y - y), (q2.x - x, q2.y - y)
+        l1, l2 = math.hypot(*v1), math.hypot(*v2)
+        if not l1 or not l2:
+            continue
+        ang = math.degrees(math.acos(max(-1, min(1, (v1[0] * v2[0] + v1[1] * v2[1]) / (l1 * l2)))))
+        if not 80 <= ang <= 100:
+            continue
+        if t1.GetWidth() != t2.GetWidth():  # a narrower diagonal would neck the wider track
+            skipped_widths += 1
+            continue
+        c = min(max_chamfer, 0.45 * min(l1, l2)) * scale
+        if c < MM(0.03):
+            continue
+        p = pcbnew.VECTOR2I(x, y)
+        a = pcbnew.VECTOR2I(int(x + v1[0] / l1 * c), int(y + v1[1] / l1 * c))
+        b = pcbnew.VECTOR2I(int(x + v2[0] / l2 * c), int(y + v2[1] / l2 * c))
+        (t1.SetStart if e1 == "S" else t1.SetEnd)(a)
+        (t2.SetStart if e2 == "S" else t2.SetEnd)(b)
+        d = pcbnew.PCB_TRACK(board)
+        d.SetStart(a)
+        d.SetEnd(b)
+        d.SetWidth(t1.GetWidth())
+        d.SetLayer(key[0])
+        d.SetNet(t1.GetNet())
+        board.Add(d)
+        made.append({"key": key, "point": p, "t1": (t1, e1), "t2": (t2, e2), "diag": d,
+                     "uuid": d.m_Uuid.AsString()})
+    return made, skipped_widths
+
+
+def miter_corners(board, drc, baseline, max_chamfer=MM(0.6), rounds=4):
+    """Chamfer 90 degree corners; a chamfer DRC rejects is retried at half size, then undone."""
+    total, only, scale, skipped = 0, None, 1.0, 0
+    for rnd in range(rounds):
+        made, skipped_widths = _corners(board, max_chamfer, only, scale)
+        if rnd == 0:
+            skipped = skipped_widths
+        if not made:
+            break
+        bad = drc.new_items(board, baseline)
+        back = set()
+        for m in made:
+            if m["uuid"] in bad:
+                for t, e in (m["t1"], m["t2"]):
+                    (t.SetStart if e == "S" else t.SetEnd)(m["point"])
+                _delete(board, m["diag"])
+                back.add(m["key"])
+        total += len(made) - len(back)
+        if not back:
+            break
+        only, scale = back, scale * 0.5
+    return {"mitered": total, "rounds": rnd + 1, "skipped_width_change": skipped}
+
+
+def sharp_corners(board, limit=30):
+    """Joints sharper than a 45 degree bend that aren't buried in a pad or via."""
+    ends = defaultdict(list)
+    for t in _tracks(board):
+        for p, q in ((t.GetStart(), t.GetEnd()), (t.GetEnd(), t.GetStart())):
+            ends[(t.GetLayer(),) + _xy(p)].append((t, q))
+    buried = defaultdict(list)
+    for item in _pads(board) + _vias(board):
+        buried[item.GetNetCode()].append(item)
+    found = []
+    for key, lst in ends.items():
+        if len(lst) != 2:
+            continue
+        (t1, q1), (t2, q2) = lst
+        p = pcbnew.VECTOR2I(key[1], key[2])
+        if any(i.IsOnLayer(key[0]) and i.HitTest(p) for i in buried[t1.GetNetCode()]):
+            continue
+        a1 = math.atan2(q1.y - p.y, q1.x - p.x)
+        a2 = math.atan2(q2.y - p.y, q2.x - p.x)
+        ang = abs(math.degrees(a1 - a2)) % 360
+        ang = min(ang, 360 - ang)  # 180 = straight, 135 = a 45 degree bend
+        if ang < 134:
+            found.append({"net": t1.GetNetname(), "layer": board.GetLayerName(key[0]),
+                          "angle": round(180 - ang), **_mm(key[1:])})
+    found.sort(key=lambda c: -c["angle"])
+    return {"count": len(found), "corners": found[:limit]}
+
+
+def thin_tracks(board, limit=30):
+    """Tracks still below the board's minimum track width."""
+    floor = board.GetDesignSettings().m_TrackMinWidth
+    thin = [t for t in _tracks(board) if t.GetWidth() < floor - 10]
+    return {
+        "count": len(thin),
+        "min_track_mm": round(pcbnew.ToMM(floor), 3),
+        "tracks": [{"net": t.GetNetname(), "layer": t.GetLayerName(),
+                    "width_mm": round(pcbnew.ToMM(t.GetWidth()), 3), **_mm(_xy(t.GetStart()))}
+                   for t in thin[:limit]],
+    }
+
+
+def clean_up(board, board_path, kicad_cli, steps=STEPS, max_chamfer_mm=0.6):
+    """Run the selected steps on `board` (not saved here). Returns the report."""
+    unknown = [s for s in steps if s not in STEPS]
+    if unknown:
+        raise ValueError(f"Unknown steps {unknown}; use {list(STEPS)}")
+    report = {"steps": [s for s in STEPS if s in steps]}
+    drc = Drc(board_path, kicad_cli)
+    try:
+        baseline = drc.errors(board)
+        report["drc_errors_before"] = len(baseline)
+        if "stubs" in steps:
+            report["stubs"], undo = remove_stubs(board)
+            report["stubs"]["put_back"] = check_stubs(board, drc, baseline, undo)
+        if "dangling" in steps:
+            report["dangling"] = remove_dangling(board)
+        if "widths" in steps:
+            report["widths"] = widen_tracks(board, drc, baseline)
+        if "miter" in steps:
+            report["miter"] = miter_corners(board, drc, baseline, MM(max_chamfer_mm))
+        report["drc_runs"] = drc.runs
+    finally:
+        drc.close()
+    pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+    report["sharp_corners_left"] = sharp_corners(board)
+    report["thin_tracks_left"] = thin_tracks(board)
+    return report
