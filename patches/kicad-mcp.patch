+
+def _duplicate(item: Any) -> Any:
+    """A detached copy of a track/via for board.Add() (KiCad 10 needs the argument)."""
+    try:
+        return item.Duplicate(False)
+    except TypeError:
+        return item.Duplicate()
+
+
+def _repair_via_drills(board: Any) -> Dict[str, int]:
+    """Give session vias the board's minimum annular ring back (PowerLab patch).
+
+    The SES import can pair a via's diameter with a larger drill from the net class.
+    """
+    import pcbnew
+
+    ds = board.GetDesignSettings()
+    ring, min_drill = ds.m_ViasMinAnnularWidth, ds.m_MinThroughDrill
+    fixed = unfixable = 0
+    for v in board.GetTracks():
+        if v.Type() != pcbnew.PCB_VIA_T or v.IsLocked():
+            continue
+        width = v.GetWidth(pcbnew.F_Cu)
+        if width - v.GetDrillValue() >= 2 * ring - 10:
+            continue
+        if width - 2 * ring >= min_drill:
+            v.SetDrill(width - 2 * ring)
+            fixed += 1
+        else:
+            unfixable += 1
+    return {"fixed": fixed, "too_small": unfixable}
+
 logger = logging.getLogger("kicad_interface")
 
