index 0000000..9b08bd0
--- /dev/null
+++ b/python/commands/powerlab_router2/search_nb.py
@@ -0,0 +1,205 @@
+"""The A* of search.search() compiled with numba, when numba is there (PowerLab router 2).
+
+The same states, moves, costs and tie-breaks as the Python loop, so it returns the same way;
+only faster (the Python loop runs about 100k nodes a second, most of a run's time). numba
+comes from the installer's own folder (%LOCALAPPDATA%\\PowerLabKiCadAssistant\\pylib, or
+POWERLAB_PYLIB), never from KiCad's site-packages. Without it, AVAILABLE is False and
+search.py uses its Python loop.
+"""
+
+import os
+import sys
+
+import numpy as np
+
+AVAILABLE = False
+_why = None
+
+
+def _paths():
+    out = []
+    if os.environ.get("POWERLAB_PYLIB"):
+        out.append(os.environ["POWERLAB_PYLIB"])
+    if os.environ.get("LOCALAPPDATA"):
+        out.append(os.path.join(os.environ["LOCALAPPDATA"], "PowerLabKiCadAssistant", "pylib"))
+    return out
+
+
+try:
+    for _p in _paths():
+        if os.path.isdir(_p) and _p not in sys.path:
+            sys.path.append(_p)
+    from numba import njit
+
+    AVAILABLE = os.environ.get("POWERLAB_NO_NUMBA") != "1"
+except Exception as e:  # no numba, or one that doesn't load: the Python loop does the work
+    _why = str(e)
+
+
+if AVAILABLE:
+    @njit(cache=True, inline="always")
+    def _less(hf, hg, hs, a, b):
+        """Heap order: (f, g, s) as Python compares the tuples, so ties break the same way."""
+        if hf[a] != hf[b]:
+            return hf[a] < hf[b]
+        if hg[a] != hg[b]:
+            return hg[a] < hg[b]
+        return hs[a] < hs[b]
+
+    @njit(cache=True)
+    def _push(hf, hg, hs, n, f, g, s):
+        if n == hf.shape[0]:
+            nf = np.empty(n * 2)
+            ng = np.empty(n * 2)
+            ns = np.empty(n * 2, np.int64)
+            nf[:n] = hf
+            ng[:n] = hg
+            ns[:n] = hs
+            hf, hg, hs = nf, ng, ns
+        k = n
+        hf[k] = f
+        hg[k] = g
+        hs[k] = s
+        while k > 0:
+            p = (k - 1) >> 1
+            if _less(hf, hg, hs, k, p):
+                hf[k], hf[p] = hf[p], hf[k]
+                hg[k], hg[p] = hg[p], hg[k]
+                hs[k], hs[p] = hs[p], hs[k]
+                k = p
+            else:
+                break
+        return hf, hg, hs, n + 1
+
+    @njit(cache=True)
+    def _pop(hf, hg, hs, n):
+        f, g, s = hf[0], hg[0], hs[0]
+        n -= 1
+        hf[0], hg[0], hs[0] = hf[n], hg[n], hs[n]
+        k = 0
+        while True:
+            a = 2 * k + 1
+            if a >= n:
+                break
+            b = a + 1
+            m = b if b < n and _less(hf, hg, hs, b, a) else a
+            if _less(hf, hg, hs, m, k):
+                hf[k], hf[m] = hf[m], hf[k]
+                hg[k], hg[m] = hg[m], hg[k]
+                hs[k], hs[m] = hs[m], hs[k]
+                k = m
+            else:
+                break
+        return f, g, s, n
+
+
+if AVAILABLE:
+    @njit(cache=True)
+    def _astar(w, h, NL, block, cost, via_ok, via_cost, hl, gmask, gcost, start_s, start_c, step, dx, dy,
+               turn, max_nodes, max_cost):
+        """block/cost/hl/gmask/gcost: flat per (layer, cell); via_ok/via_cost: flat per cell.
+        gmask: bit k = the goal may be reached moving in direction k (0: not a goal).
+        step: flat per (layer, direction), a layer's preferred direction cheaper.
+        Returns (found state or -1, its cost, nodes, path states)."""
+        FREE = 8
+        wh = w * h
+        n_states = NL * wh * 9
+        best = np.full(n_states, 1e18)
+        parent = np.full(n_states, -1, np.int64)
+        hf = np.empty(1024)
+        hg = np.empty(1024)
+        hs = np.empty(1024, np.int64)
+        hn = 0
+        for t in range(start_s.shape[0]):
+            s = start_s[t]
+            c = start_c[t]
+            cell = s // 9
+            if block[cell]:
+                continue
+            if c < best[s]:
+                best[s] = c
+                parent[s] = -1
+                hf, hg, hs, hn = _push(hf, hg, hs, hn, c + hl[cell], c, s)
+        nodes = 0
+        found = np.int64(-1)
+        gfound = 0.0
+        while hn > 0:
+            f, g, s, hn = _pop(hf, hg, hs, hn)
+            if g > best[s]:
+                continue
+            nodes += 1
+            if nodes > max_nodes:
+                break
+            if f > max_cost:
+                break
+            d = s % 9
+            cell = s // 9
+            L = cell // wh
+            xy = cell - L * wh
+            jj = xy // w
+            ii = xy - jj * w
+            gm = gmask[cell]
+            if gm != 0 and d != FREE and (gm >> d) & 1:
+                found = s
+                gfound = g
+                break
+            base = L * wh
+            if d == FREE:
+                n_opt = 8
+            else:
+                n_opt = 3
+            for o in range(n_opt):
+                if d == FREE:
+                    k = o
+                elif o == 0:
+                    k = d
+                elif o == 1:
+                    k = (d + 1) & 7
+                else:
+                    k = (d - 1) & 7
+                ni = ii + dx[k]
+                nj = jj + dy[k]
+                if ni < 0 or nj < 0 or ni >= w or nj >= h:
+                    continue
+                nxy = nj * w + ni
+                if block[base + nxy]:
+                    continue
+                if k & 1 and (block[base + jj * w + ni] or block[base + nj * w + ii]):
+                    continue  # a diagonal past a blocked cell would cut its corner
+                ng = g + step[L * 8 + k] * cost[base + nxy]
+                if d != FREE and k != d:
+                    ng += turn
+                ncell = base + nxy
+                gm2 = gmask[ncell]
+                if gm2 != 0 and (gm2 >> k) & 1:
+                    ng += gcost[ncell]
+                ns = ncell * 9 + k
+                if ng < best[ns]:
+                    best[ns] = ng
+                    parent[ns] = s
+                    hf, hg, hs, hn = _push(hf, hg, hs, hn, ng + hl[ncell], ng, ns)
+            if NL > 1 and d != FREE and via_ok[xy]:
+                vc = via_cost[xy]
+                for L2 in range(NL):
+                    if L2 == L or block[L2 * wh + xy]:
+                        continue
+                    ncell = L2 * wh + xy
+                    ns = ncell * 9 + FREE
+                    ng = g + vc
+                    if ng < best[ns]:
+                        best[ns] = ng
+                        parent[ns] = s
+                        hf, hg, hs, hn = _push(hf, hg, hs, hn, ng + hl[ncell], ng, ns)
+        if found < 0:
+            return found, 0.0, nodes, np.zeros(0, np.int64)
+        n = 0
+        s = found
+        while s >= 0:
+            n += 1
+            s = parent[s]
+        path = np.zeros(n, np.int64)
+        s = found
+        for m in range(n - 1, -1, -1):
+            path[m] = s
+            s = parent[s]
+        return found, gfound, nodes, path
diff --git a/python/commands/powerlab_router2/shape.py b/python/commands/powerlab_router2/shape.py
new file mode 100644
index 0000000..96887ab
--- /dev/null
+++ b/python/commands/powerlab_router2/shape.py
@@ -0,0 +1,365 @@
+"""From a grid path to copper a person would draw (PowerLab router 2). No pcbnew.
+
+1. pieces: the path's cells, split at vias, reduced to their corners;
+2. straighten: as by hand, a stretch is redrawn as one straight run or one 45 degree dogleg
+   when that is clear and cheaper (length, plus a cost per bend); the lanes into the pads
+   keep their direction;
+3. chamfers: two 45 degree bends a cell apart read as a square corner, so the short piece
+   between them grows to min(1 mm, a third of the runs beside it) where that is clear;
+4. anchor: the first and last runs are moved onto the pads' axes (or a turned pad's stub
+   end), so a track ends exactly at the pad centre although the grid doesn't pass there.
+"""
+
+import math
+
+from commands.powerlab_router2.geom import (DIRS, SQ2, corners, direction, doglegs, length, meet, turn_deg,
+                                           unit)
+
+BEND = 1.0  # mm of track a bend is worth
+DIAGONAL = 1.1  # a 45 degree mm costs this much (hand routing runs H/V, diagonals as corners)
+CHAMFER = 1.0  # mm, the largest chamfer leg run
+
+
+def pieces(path, grid):
+    """[(layer, [points mm])], [via points], [(first dir, last dir)] per piece."""
+    out, vias, dirs = [], [], []
+    cur = [path[0]]
+    for a, b in zip(path, path[1:]):
+        if b[2] != a[2]:
+            out.append(cur)
+            vias.append(grid.at(a[0], a[1]))
+            cur = [b]
+        else:
+            cur.append(b)
+    out.append(cur)
+    res = []
+    for p in out:
+        pts = corners([grid.at(s[0], s[1]) for s in p])
+        if len(pts) == 1:
+            pts = [pts[0], pts[0]]
+        first = next((s[3] for s in p[1:] if s[3] != 8), p[0][3] if p[0][3] != 8 else None)
+        last = p[-1][3] if p[-1][3] != 8 else None
+        res.append((p[0][2], pts))
+        dirs.append((first, last))
+    return res, vias, dirs
+
+
+def cost(pts, bend=BEND):
+    c = 0.0
+    for a, b in zip(pts, pts[1:]):
+        d = math.dist(a, b)
+        k = direction(a, b)
+        c += d * (DIAGONAL if k is not None and k % 2 else 1.0)
+    for a, b, cc in zip(pts, pts[1:], pts[2:]):
+        t = turn_deg(a, b, cc)
+        if t > 1.0:
+            c += bend
+        if t > 46.0:
+            c += 100.0  # never: a corner over 45 degrees
+    return c
+
+
+def _turn_ok(a, b, c):
+    return turn_deg(a, b, c) <= 46.0
+
+
+def straighten(pts, clear, first=None, last=None, keep=(), before=None, after=None):
+    """Redraw stretches of `pts` as straight runs or doglegs.
+
+    clear(points) -> whether a centre line there is free; first/last: the direction the first
+    run must leave in / the last run must arrive in (the pad lanes), or None; keep: indices of
+    points that must stay (where other tracks of the net join); before/after: the points just
+    outside the ends (the lane's pad centre), for the turn there."""
+    keep = set(keep)
+    for _pass in range(3):
+        n = len(pts)
+        out = [pts[0]]
+        i = 0
+        changed = False
+        while i < n - 1:
+            done = False
+            for j in range(n - 1, i + 1, -1):
+                if any(k in keep for k in range(i + 1, j)):
+                    continue
+                old = pts[i:j + 1]
+                prev = out[-2] if len(out) >= 2 else before
+                nxt = pts[j + 1] if j + 1 < n else after
+                for cand in doglegs(pts[i], pts[j]):
+                    if i == 0 and first is not None and direction(cand[0], cand[1]) != first:
+                        continue
+                    if j == n - 1 and last is not None and direction(cand[-2], cand[-1]) != last:
+                        continue
+                    if prev is not None and not _turn_ok(prev, cand[0], cand[1]):
+                        continue
+                    if nxt is not None and not _turn_ok(cand[-2], cand[-1], nxt):
+                        continue
+                    ctx_old = ([prev] if prev else []) + old + ([nxt] if nxt else [])
+                    ctx_new = ([prev] if prev else []) + cand + ([nxt] if nxt else [])
+                    if cost(ctx_new) < cost(ctx_old) - 1e-6 and clear(cand):
+                        out.extend(cand[1:])
+                        i = j
+                        done = changed = True
+                        break
+                if done:
+                    break
+            if not done:
+                out.append(pts[i + 1])
+                i += 1
+        keep_pts = {pts[k] for k in keep}
+        pts = corners(out)
+        keep = {k for k, p in enumerate(pts) if p in keep_pts}
+        if not changed:
+            break
+    return pts
+
+
+def chamfers(pts, clear, fixed_ends=True):
+    """Grow short pieces between two bends the same way (a square corner drawn as two 45s a
+    cell apart) to a proper chamfer, where it's clear."""
+    pts = list(pts)
+    # a square corner at one point: cut it at 45 degrees
+    k = 1
+    while k + 1 < len(pts):
+        a, c, d = pts[k - 1], pts[k], pts[k + 1]
+        t = turn_deg(a, c, d)
+        if 80.0 < t < 100.0:
+            u_in, u_out = _u(a, c), _u(c, d)
+            room_in = math.dist(a, c) - (0.3 if k - 1 == 0 and fixed_ends else 0.0)
+            room_out = math.dist(c, d) - (0.3 if k + 1 == len(pts) - 1 and fixed_ends else 0.0)
+            for leg in (CHAMFER, 0.7, 0.5, 0.35, 0.25, 0.15):
+                leg = min(leg, room_in / 2.0, room_out / 2.0)
+                if leg < 0.1:
+                    break
+                nb = (c[0] - u_in[0] * leg, c[1] - u_in[1] * leg)
+                nc = (c[0] + u_out[0] * leg, c[1] + u_out[1] * leg)
+                if clear([a, nb, nc, d]):
+                    pts[k:k + 1] = [nb, nc]
+                    k += 1
+                    break
+        k += 1
+    k = 1
+    while k + 2 < len(pts):
+        a, b, c, d = pts[k - 1], pts[k], pts[k + 1], pts[k + 2]
+        mid = math.dist(b, c)
+        t1 = _signed(a, b, c)
+        t2 = _signed(b, c, d)
+        if mid < 0.6 and t1 * t2 > 0 and abs(t1) > 1 and abs(t2) > 1:
+            u_in = _u(a, b)
+            u_out = _u(c, d)
+            corner = meet(b, u_in, c, u_out)
+            if corner is not None:
+                room_in = math.dist(a, corner) - (0.0 if k - 1 > 0 or not fixed_ends else 0.3)
+                room_out = math.dist(corner, d) - (0.0 if k + 2 < len(pts) - 1 or not fixed_ends else 0.3)
+                for leg in (CHAMFER, 0.7, 0.5, 0.35, 0.25):
+                    leg = min(leg, room_in / 2.0, room_out / 2.0)
+                    if leg <= math.dist(b, corner) + 1e-6:
+                        break
+                    nb = (corner[0] - u_in[0] * leg, corner[1] - u_in[1] * leg)
+                    nc = (corner[0] + u_out[0] * leg, corner[1] + u_out[1] * leg)
+                    if clear([a, nb, nc, d]):
+                        pts[k], pts[k + 1] = nb, nc
+                        break
+        k += 1
+    return corners(pts)
+
+
+SLIVER = 0.12  # mm: a piece this short between two bends is an artefact of the alignment
+
+
+def despike(pts, clear=None):
+    """Remove what the alignment leaves at off-grid ends: a run that doubles back on itself
+    (a spike), and slivers shorter than SLIVER between two bends. A sliver is folded into
+    the intersection of the runs beside it when that is near, else its corner is dropped.
+    The two end points (pad centres, vias) stay."""
+    pts = list(pts)
+    changed = True
+    rounds = 0
+    while changed and len(pts) > 2 and rounds < 20:
+        changed = False
+        rounds += 1
+        # spikes: a turn of more than 135 degrees at an inner point
+        for k in range(1, len(pts) - 1):
+            if turn_deg(pts[k - 1], pts[k], pts[k + 1]) > 135.0:
+                del pts[k]
+                changed = True
+                break
+        if changed:
+            continue
+        for k in range(1, len(pts) - 2):
+            a, b, c, d = pts[k - 1], pts[k], pts[k + 1], pts[k + 2]
+            if math.dist(b, c) >= SLIVER or math.dist(a, b) < 1e-9 or math.dist(c, d) < 1e-9:
+                continue
+            t1, t2 = _signed(a, b, c), _signed(b, c, d)
+            new = None
+            if t1 * t2 > 0:
+                # two bends the same way: a tiny chamfer. Folded into one corner only where
+                # that corner is still 45 degrees at most
+                if abs(t1 + t2) <= 46.0:
+                    m = meet(a, _u(a, b), d, _u(d, c))
+                    if m is not None and math.dist(m, b) < 0.3:
+                        new = pts[:k] + [m] + pts[k + 2:]
+            else:
+                # an S-jog between two parallel runs: move one whole run onto the other's line
+                # (the run after, up to the next corner; or the run before, from the one before)
+                opts = []
+                if k + 3 < len(pts):
+                    e = pts[k + 3]
+                    m = meet(a, _u(a, b), e, _u(e, d))
+                    if m is not None:
+                        opts.append((pts[:k] + [m] + pts[k + 3:], [a, m, e]))
+                if k - 2 >= 0:
+                    z = pts[k - 2]
+                    m = meet(z, _u(z, a), d, _u(d, c))
+                    if m is not None:
+                        opts.append((pts[:k - 1] + [m] + pts[k + 2:], [z, m, d]))
+                for cand, check in opts:
+                    ok_turns = all(turn_deg(p, q, r) <= 46.0 for p, q, r in zip(cand, cand[1:], cand[2:]))
+                    if ok_turns and (clear is None or clear(check)):
+                        new = cand
+                        break
+            if new is not None:
+                pts = new
+                changed = True
+                break
+        # a sliver right at an end (the last or first piece): drop its inner point
+        if not changed and len(pts) > 2:
+            for k in (1, len(pts) - 2):
+                if 0 < k < len(pts) - 1 and min(math.dist(pts[k - 1], pts[k]), math.dist(pts[k], pts[k + 1])) < 0.02:
+                    del pts[k]
+                    changed = True
+                    break
+    return corners(pts) if len(pts) > 2 else pts
+
+
+TIDY = 0.01  # mm: points closer than this are one point
+
+
+def tidy(pts):
+    """The last step for every polyline: merge points closer than TIDY (the alignment's
+    leftovers, which read as 170 degree corners and zero-length jogs on turned parts) and
+    drop points that lie on the line through their neighbours. The two ends stay."""
+    if len(pts) < 3:
+        return list(pts)
+    out = [pts[0]]
+    for p in pts[1:-1]:
+        if math.dist(p, out[-1]) >= TIDY:
+            out.append(p)
+    if len(out) > 1 and math.dist(out[-1], pts[-1]) < TIDY:
+        out[-1] = pts[-1]
+    else:
+        out.append(pts[-1])
+    k = 1
+    while k + 1 < len(out):
+        a, b, c = out[k - 1], out[k], out[k + 1]
+        ac = math.dist(a, c)
+        off = abs((c[0] - a[0]) * (b[1] - a[1]) - (c[1] - a[1]) * (b[0] - a[0])) / ac if ac > 1e-9 else 0.0
+        if off < TIDY / 2 and turn_deg(a, b, c) < 90.0:
+            del out[k]
+        else:
+            k += 1
+    return out
+
+
+def _u(a, b):
+    d = math.dist(a, b)
+    return ((b[0] - a[0]) / d, (b[1] - a[1]) / d) if d > 1e-9 else (1.0, 0.0)
+
+
+def _signed(a, b, c):
+    u, v = (b[0] - a[0], b[1] - a[1]), (c[0] - b[0], c[1] - b[1])
+    cr = u[0] * v[1] - u[1] * v[0]
+    return math.copysign(turn_deg(a, b, c), cr) if abs(cr) > 1e-12 else 0.0
+
+
+def anchor_start(pts, p):
+    """Move the first run onto the line through `p` (same direction), keeping the second
+    run's line: the first corner slides along it. Returns the new points (starting at p)."""
+    if len(pts) < 2 or math.dist(pts[0], pts[1]) < 1e-9:
+        return [p] + pts[1:]
+    u = _u(pts[0], pts[1])
+    if len(pts) == 2:
+        return [p, pts[1]]  # one run: the caller moves the far end
+    v = _u(pts[1], pts[2])
+    m = meet(p, u, pts[1], v)
+    if m is None:
+        return [p] + pts[1:]
+    return [p, m] + pts[2:]
+
+
+def anchor_end(pts, p):
+    return anchor_start(pts[::-1], p)[::-1]
+
+
+def project(p, a, u):
+    """p projected onto the line through a along u."""
+    t = (p[0] - a[0]) * u[0] + (p[1] - a[1]) * u[1]
+    return (a[0] + t * u[0], a[1] + t * u[1])
+
+
+def fit_runs(pcs, vias, start, end):
+    """Anchor a connection's pieces at `start` and `end` (exact points). A piece that is one
+    run between a pad and a via moves whole, via and all, and the next piece is anchored at
+    the moved via. Where a single straight run joins two exact points that aren't at a
+    multiple of 45 degrees, the via before it slides along its run to square it, or the run
+    gets a dogleg. pcs: [(layer, points)], changed in place."""
+    n = len(pcs)
+    anchor = start
+    for k in range(n):
+        L, pts = pcs[k]
+        if anchor is None:
+            break
+        if len(pts) >= 3 or k == n - 1:
+            pcs[k] = (L, anchor_start(pts, anchor))
+            break
+        # one run ending at a via: move it onto the anchor's line
+        u = _u(pts[0], pts[1])
+        v_new = project(pts[1], anchor, u) if math.dist(pts[0], pts[1]) > 1e-9 else anchor
+        pcs[k] = (L, [anchor, v_new])
+        vias[k] = v_new
+        anchor = v_new
+    anchor = end
+    for k in range(n - 1, -1, -1):
+        L, pts = pcs[k]
+        if len(pts) >= 3 or k == 0:
+            pcs[k] = (L, anchor_end(pts, anchor))
+            break
+        u = _u(pts[-1], pts[-2])
+        v_new = project(pts[-2], anchor, u)
+        pcs[k] = (L, [v_new, anchor])
+        vias[k - 1] = v_new
+        pl, pp = pcs[k - 1]
+        pcs[k - 1] = (pl, pp[:-1] + [v_new])
+        anchor = v_new
+        if len(pp) >= 3:
+            pcs[k - 1] = (pl, anchor_end(pp, v_new))
+            break
+    # a straight run between two exact points off 45 degrees
+    for k in range(n):
+        L, pts = pcs[k]
+        for m in range(len(pts) - 1):
+            a, b = pts[m], pts[m + 1]
+            if math.dist(a, b) < 1e-6 or direction(a, b) is not None:
+                continue
+            ang = math.degrees(math.atan2(b[1] - a[1], b[0] - a[0]))
+            err = abs(ang / 45.0 - round(ang / 45.0)) * 45.0
+            if err < 0.3:
+                continue  # a hair off: straight is better than a jog
+            if m == 0 and k > 0 and len(pcs[k - 1][1]) >= 2:
+                # slide the via before along its own run
+                pl, pp = pcs[k - 1]
+                ua = _u(pp[-2], pp[-1])
+                dm = unit(int(round(ang / 45.0)) % 8)
+                cr = ua[0] * dm[1] - ua[1] * dm[0]
+                r = (b[0] - a[0], b[1] - a[1])
+                if abs(cr) > 1e-9:
+                    t = (r[0] * dm[1] - r[1] * dm[0]) / cr
+                    if abs(t) < 0.4:
+                        na = (a[0] + t * ua[0], a[1] + t * ua[1])
+                        pcs[k - 1] = (pl, pp[:-1] + [na])
+                        vias[k - 1] = na
+                        pts[0] = na
+                        continue
+            dl = doglegs(a, b)
+            pts[m:m + 2] = dl[0]
+        pcs[k] = (L, corners(pts) if len(pts) > 2 else pts)
+    return pcs, vias
