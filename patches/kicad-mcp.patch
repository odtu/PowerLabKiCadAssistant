+            half = float(region["size"]) / 2
+            x0, y0 = float(region["x"]) - half, float(region["y"]) - half
+            x1, y1 = float(region["x"]) + half, float(region["y"]) + half
+        else:
+            x0, y0, x1, y1 = (float(region[k]) for k in ("x0", "y0", "x1", "y1"))
+    except (KeyError, TypeError, ValueError):
+        return "region needs x0, y0, x1, y1 (mm), or x, y and size"
+    x0, x1 = min(x0, x1), max(x0, x1)
+    y0, y1 = min(y0, y1), max(y0, y1)
+    if x1 - x0 < 0.5 or y1 - y0 < 0.5:
+        return "region is smaller than 0.5 mm"
+    with open(svg_path, encoding="utf-8") as fh:
