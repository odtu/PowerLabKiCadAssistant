+
+            path = self.ipc_backend.get_open_board_path()
+            if not path or not os.path.isfile(str(path)):
+                return {
+                    "success": False,
+                    "message": "No saved board is open in KiCad",
+                    "errorDetails": "Open the board in KiCad and save it first",
+                }
+            board = pcbnew.LoadBoard(str(path))
