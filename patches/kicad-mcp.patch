+    def _handle_powerlab_route(self, params: Dict[str, Any]) -> Dict[str, Any]:
+        """Start the PowerLab router on the saved board, in the background (PowerLab patch)."""
+        board_path = params.get("boardPath") or self._authoritative_board_path()
+        if not board_path or not os.path.isfile(str(board_path)):
+            return {
+                "success": False,
+                "message": "No saved board",
+                "errorDetails": "Open the board with open_board, or pass boardPath",
+            }
+        board_path = os.path.abspath(str(board_path))
+        kboard = self._live_kicad_board(board_path)
+        if kboard is not None:
+            changed = powerlab_route.unsaved_changes(kboard, board_path)
+            if changed:
+                return {
+                    "success": False,
+                    "message": "KiCad's board has changes that aren't saved",
+                    "errorDetails": f"Differences from the saved file: {changed}. The router routes the saved "
+                                    "file, so save in KiCad (Ctrl+S) and call powerlab_route again.",
+                }
+        started = powerlab_route.start(board_path, params, self._find_kicad_cli_static(), kboard is not None,
+                                       powerlab_route.kicad_connection(kboard) if kboard is not None else None)
+        if not started.get("success"):
+            return started
+        live = kboard is not None and params.get("live", True) is not False
+        return {
+            "success": True,
+            "message": "The PowerLab router is routing the saved board in the background"
+                       + (", and KiCad shows its copper as it goes" if live else ""),
+            "boardPath": board_path,
+            "kicad_open": kboard is not None,
+            "live": live,
+            "next_steps": (
+                "Call powerlab_route_status to wait for it and see its progress; repeat until it says "
+                "the run is finished. A 2-layer board with ~50 connections takes about 10-15 minutes. "
+                "Don't edit or save the board meanwhile: a changed board is not overwritten, so the run "
+                "would be wasted."
+            ),
+        }
