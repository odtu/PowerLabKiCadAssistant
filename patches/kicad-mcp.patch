+            backend = getattr(self, "ipc_backend", None)
+            if backend and backend.is_connected() and self._ipc_board_path_matches(board_path):
+                try:
+                    fr.live_board = backend._kicad.get_board()
+                except Exception as e:
+                    logger.warning(f"Live autoroute: no board from KiCad: {e}")
+        try:
+            return fr.autoroute(params)
+        finally:
+            fr.live_board = None
