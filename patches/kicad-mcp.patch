+                        + new_block[vm.end(1) :]
+                    )
+
+            if new_block != block:
+                content = content[:start] + new_block + content[end:]
+                changed += 1
+
+        if changed:
+            Path(schematic_path).write_text(content, encoding="utf-8")
+        return changed
+
