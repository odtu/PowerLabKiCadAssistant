index 0000000..4d59b97
--- /dev/null
+++ b/python/commands/powerlab_router/groups.py
@@ -0,0 +1,75 @@
+"""Routing groups in the lab order (design rules §3.4; plan §5). No pcbnew.
+
+Power first, then switching and clocks, differential pairs, sensitive analog, and the
+rest. Names are matched on the net's last path segment, ignoring case; KiCad's automatic
+names (Net-(R1-Pad2)) only go by net class. The user can move nets between groups.
+"""
+
+import fnmatch
+import re
+
+GROUPS = ("power", "switching and clocks", "differential pairs", "sensitive analog", "other")
+
+POWER_CLASSES = ("power", "gnd", "hv")
+POWER = ("+*", "-*", "vbus*", "vcc*", "vdd*", "vin*", "vbat*")
+SWITCHING = ("*gate*", "*pwm*", "*boot*", "*_ho*", "*_lo*", "gh?", "gl?", "*_sw", "sw_*", "*sw_node*",
+             "*clk*", "*sck*", "*xtal*", "*osc*")
+ANALOG = ("*sense*", "*sens_*", "*sns*", "*isen*", "*ref*", "*adc*", "*ain*", "*sensor*", "*kelvin*")
+PAIR_SUFFIXES = (("_p", "_n"), ("+", "-"), ("_h", "_l"), ("_dp", "_dn"), ("usb_dp", "usb_dn"))
+
+
+CLOCKS = ("*clk*", "*sck*", "*xtal*", "*osc*")
+
+
+def is_clock(net):
+    return _match(_short(net), CLOCKS)
+
+
+def _short(net):
+    return net.rsplit("/", 1)[-1].lower()
+
+
+def _match(name, patterns):
+    return any(fnmatch.fnmatchcase(name, p) for p in patterns)
+
+
+def pairs(nets):
+    """{net: partner} for differential pairs found by suffix (USB_DP/USB_DN, CAN_H/CAN_L...)."""
+    by_short = {_short(n): n for n in nets}
+    out = {}
+    for n in nets:
+        s = _short(n)
+        for a, b in PAIR_SUFFIXES:
+            if s.endswith(a) and len(s) > len(a):
+                partner = by_short.get(s[: -len(a)] + b)
+                if partner and partner != n:
+                    out[n] = partner
+                    out[partner] = n
+    return out
+
+
+def classify(nets, netclass_of, overrides=None):
+    """{net: group index}. `netclass_of(net)` gives the net class name; `overrides` maps
+    a net to a group index or name."""
+    overrides = overrides or {}
+    paired = pairs(nets)
+    out = {}
+    for n in nets:
+        if n in overrides:
+            g = overrides[n]
+            out[n] = GROUPS.index(g) if isinstance(g, str) else int(g)
+            continue
+        s = _short(n)
+        auto = s.startswith("net-(") or re.match(r"unconnected-", s)
+        cls = (netclass_of(n) or "").lower()
+        if cls in POWER_CLASSES or (not auto and _match(s, POWER)):
+            out[n] = 0
+        elif not auto and _match(s, SWITCHING):
+            out[n] = 1
+        elif n in paired or cls in ("usb", "diff", "differential"):
+            out[n] = 2
+        elif not auto and _match(s, ANALOG):
+            out[n] = 3
+        else:
+            out[n] = 4
+    return out
diff --git a/python/commands/powerlab_router/model.py b/python/commands/powerlab_router/model.py
new file mode 100644
index 0000000..16ec7a6
--- /dev/null
+++ b/python/commands/powerlab_router/model.py
@@ -0,0 +1,929 @@
+"""Board side of the PowerLab router (pcbnew): obstacles, pad entry lanes, results as tracks.
+
+Clearances are KiCad's: the larger of the two net classes' clearances and the board
+minimum, overridden by the board's custom rules (.kicad_dru, see rules.py). Edge and hole
+clearances come from the board constraints. Pour nets aren't obstacles (the pour refills
+around new copper). Copper of the net being routed isn't an obstacle either.
+
+The grids are kept per "key" (net class, track width, via size; plus the net when rules
+compare net names): one raster per net and layer, and a count of nets per cell. A net's
+obstacles are then the cells some other net covers, and new copper is stamped in
+without rebuilding anything. The board's own copper and the router's are kept apart, so
+the router's copper of some nets can be "soft" for a rip-up search: passable at a cost.
+"""
+
+import copy
+import math
+import os
+import time
+
+import numpy as np
+import pcbnew
+
+from commands.powerlab_router import search
+from commands.powerlab_router.grid import Grid, Patch
+from commands.powerlab_router.rules import Rules, net_name_patterns
+
+MM, T = pcbnew.FromMM, pcbnew.ToMM
+VIA_TO_PAD = 0.25  # via ring to a pad edge (§3.5)
+FINE_PITCH = 0.8  # pads closer than this are fine pitch: leave straight out (§3.4)
+UNDER_BODY = 1.5  # extra cost (mm) for a lane that leaves a pad under its part
+DIAGONAL_ENTRY = 0.3  # extra cost (mm) for entering a pad that has axes at 45 degrees
+TEE_PAD_MM = 1.0  # a track joins its net's track no closer than this to a pad centre (§3.4)
+USED_LANE = 3.0  # extra cost (mm) for a lane another track of the net already leaves by
+LANE_TRIES = 6  # exit lengths tried per lane, one grid cell apart
+PLANE_SHARE = 0.5  # an inner layer this much covered by zones is a plane: no tracks on it
+ERR = MM(0.005)
+TYPES = {pcbnew.PCB_PAD_T: "Pad", pcbnew.PCB_TRACE_T: "Track", pcbnew.PCB_ARC_T: "Track",
+         pcbnew.PCB_VIA_T: "Via", pcbnew.PCB_ZONE_T: "Zone"}
+
+
+def _polys(sps):
+    out = []
+    for i in range(sps.OutlineCount()):
+        o = sps.Outline(i)
+        outline = [(T(o.CPoint(k).x), T(o.CPoint(k).y)) for k in range(o.PointCount())]
+        holes = []
+        for h in range(sps.HoleCount(i)):
+            hc = sps.Hole(i, h)
+            holes.append([(T(hc.CPoint(k).x), T(hc.CPoint(k).y)) for k in range(hc.PointCount())])
+        out.append((outline, holes))
+    return out
+
+
+def _grown(item, layer, by_mm):
+    sp = pcbnew.SHAPE_POLY_SET()
+    item.TransformShapeToPolygon(sp, layer, MM(by_mm), ERR, pcbnew.ERROR_OUTSIDE)
+    return sp
+
+
+def is_round(pad, layer):
+    try:
+        shape = pad.GetShape(layer)
+    except TypeError:
+        shape = pad.GetShape()
+    return shape == pcbnew.PAD_SHAPE_CIRCLE
+
+
+def _uuid(item):
+    return item.m_Uuid.AsString()
+
+
+class Lane:
+    """A straight way into a pad: from its centre along `direction` to the exit point."""
+
+    def __init__(self, pad, layer, direction, centre, exit_mm, cell, cost):
+        self.pad, self.layer, self.direction = pad, layer, direction
+        self.centre, self.exit, self.cell, self.cost = centre, exit_mm, cell, cost
+
+
+class _Occupancy:
+    """The grids for one key: per net and layer, where that net's copper keeps a track
+    centre (and a via centre) of the key's nets away; and per cell, how many nets do.
+    A net's own rasters are Patches (just the box round its copper); only the counts
+    cover the whole board."""
+
+    def __init__(self, rb, key):
+        self.rb, self.key = rb, key
+        g = rb.grid
+        n = len(rb.layers)
+        self.fixed_t, self.fixed_v = {}, {}  # net -> [Patch or None per layer]: the board's copper
+        self.new_t, self.new_v = {}, {}  # the router's copper
+        self.track, self.via = {}, {}  # both
+        self.t_count = [np.zeros((g.ny, g.nx), np.uint16) for _ in range(n)]
+        self.v_count = [np.zeros((g.ny, g.nx), np.uint16) for _ in range(n)]
+        self.own_via = {}
+        _cls, w, vd, _net = key
+        edge, hole = rb.edge_clearance, rb.hole_clearance
+        inside_t = rb.inside(edge + w / 2)
+        inside_v = rb.inside(edge + vd / 2)
+        keep = rb.keepouts(w, vd)
+        self.static_t = [~inside_t | k for k in keep[0]]
+        self.static_v = ~inside_v
+        for k in keep[1]:
+            self.static_v |= k
+        fixed, new = {}, {}
+        for item, net in rb.copper_items():
+            (new if _uuid(item) in rb.router_items else fixed).setdefault(net, []).append(item)
+        for net, items in fixed.items():
+            self.fixed_t[net], self.fixed_v[net] = self._raster(items)
+        for net, items in new.items():
+            self.new_t[net], self.new_v[net] = self._raster(items)
+        for net in set(fixed) | set(new):
+            self._update(net)
+
+    def _raster(self, items):
+        rb = self.rb
+        _cls, w, vd, _net = self.key
+        tp = {L: [] for L in rb.layers}
+        vp = {L: [] for L in rb.layers}
+        for it in items:
+            for L in rb.layers:
+                if not it.IsOnLayer(L) or (it.Type() == pcbnew.PCB_PAD_T and it.GetAttribute() == pcbnew.PAD_ATTRIB_NPTH):
+                    continue
+                c_t = rb.clearance_to(it, self.key, "Track", L)
+                c_v = rb.clearance_to(it, self.key, "Via", L)
+                if it.Type() == pcbnew.PCB_ZONE_T:
+                    for by, dst in ((c_t + w / 2, tp), (c_v + vd / 2, vp)):
+                        sp = it.GetFilledPolysList(L).CloneDropTriangulation()
+                        sp.Inflate(MM(by), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+                        dst[L] += _polys(sp)
+                    continue
+                tp[L] += _polys(_grown(it, L, c_t + w / 2))
+                if it.Type() == pcbnew.PCB_PAD_T:
+                    c_v = max(c_v, VIA_TO_PAD)
+                vp[L] += _polys(_grown(it, L, c_v + vd / 2))
+            if it.Type() == pcbnew.PCB_PAD_T and (it.HasHole() or it.GetAttribute() == pcbnew.PAD_ATTRIB_NPTH):
+                for by, dst in ((rb.hole_clearance + w / 2, tp), (rb.hole_clearance + vd / 2, vp)):
+                    hole = pcbnew.SHAPE_POLY_SET()
+                    it.TransformHoleToPolygon(hole, MM(by), ERR, pcbnew.ERROR_OUTSIDE)
+                    for L in rb.layers:
+                        dst[L] += _polys(hole)
+        # copper on layers the router doesn't route (inner planes) still keeps vias away
+        for it in items:
+            if it.Type() == pcbnew.PCB_ZONE_T:
+                continue  # a plane's fill opens round a via
+            for L in rb.via_only_layers:
+                if not it.IsOnLayer(L) or (it.Type() == pcbnew.PCB_PAD_T and it.GetAttribute() == pcbnew.PAD_ATTRIB_NPTH):
+                    continue
+                if any(it.IsOnLayer(M) for M in rb.layers):
+                    continue  # a through pad or via: already there on the routed layers
+                c_v = rb.clearance_to(it, self.key, "Via", L)
+                vp[rb.layers[0]] += _polys(_grown(it, L, c_v + vd / 2))
+        g = rb.grid
+        return [g.raster_box(tp[L]) for L in rb.layers], [g.raster_box(vp[L]) for L in rb.layers]
+
+    def _update(self, net):
+        """Recount `net` after its fixed or new copper changed."""
+        n = len(self.t_count)
+        none = [None] * n
+        ft, nt = self.fixed_t.get(net, none), self.new_t.get(net, none)
+        fv, nv = self.fixed_v.get(net, none), self.new_v.get(net, none)
+        track = [Patch.union(ft[i], nt[i]) for i in range(n)]
+        via = [Patch.union(fv[i], nv[i]) for i in range(n)]
+        old_t, old_v = self.track.get(net), self.via.get(net)
+        for i in range(n):
+            if old_t is not None:
+                if old_t[i] is not None:
+                    old_t[i].view(self.t_count[i])[...] -= old_t[i].a
+                if old_v[i] is not None:
+                    old_v[i].view(self.v_count[i])[...] -= old_v[i].a
+            if track[i] is not None:
+                track[i].view(self.t_count[i])[...] += track[i].a
+            if via[i] is not None:
+                via[i].view(self.v_count[i])[...] += via[i].a
+        self.track[net], self.via[net] = track, via
+
+    def stamp(self, net, items):
+        """Add the router's new copper of `net`."""
+        t, v = self._raster(items)
+        if net in self.new_t:
+            t = [Patch.union(a, b) for a, b in zip(self.new_t[net], t)]
+            v = [Patch.union(a, b) for a, b in zip(self.new_v[net], v)]
+        self.new_t[net], self.new_v[net] = t, v
+        self._update(net)
+
+    def set_new(self, net, items):
+        """Replace the router's copper of `net` (after a rip-up)."""
+        if items:
+            self.new_t[net], self.new_v[net] = self._raster(items)
+        else:
+            self.new_t.pop(net, None)
+            self.new_v.pop(net, None)
+        self._update(net)
+
+    def blocked(self, net, soft=()):
+        """(track bytes, via_ok bytes, soft masks or None). `soft`: nets whose router copper
+        doesn't block, but is returned as masks so the search can price it."""
+        mine_t = self.track.get(net)
+        mine_v = self.via.get(net)
+        out_t, out_soft = [], []
+        via_block = self.static_v.copy()
+        def sub(arr, p):
+            if p is not None:
+                p.view(arr)[...] -= p.a
+
+        def add(arr, p):
+            if p is not None:
+                p.view(arr)[...] += p.a
+
+        for i in range(len(self.t_count)):
+            t = self.t_count[i].astype(np.int32)
+            if mine_t is not None:
+                sub(t, mine_t[i])
+            soft_any = np.zeros(t.shape, bool)
+            for s in soft:
+                if s == net or s not in self.new_t:
+                    continue
+                sub(t, self.track[s][i])
+                if s in self.fixed_t:
+                    add(t, self.fixed_t[s][i])
+                p = self.new_t[s][i]
+                if p is not None:
+                    p.view(soft_any)[...] |= p.a
+            hard = (t > 0) | self.static_t[i]
+            out_t.append(hard.astype(np.uint8).tobytes())
+            out_soft.append(soft_any & ~hard)
+            v = self.v_count[i].astype(np.int32)
+            if mine_v is not None:
+                sub(v, mine_v[i])
+            via_block |= v > 0
+        own = self._own_via(net)
+        if own is not None:
+            own.view(via_block)[...] |= own.a
+        return out_t, (~via_block).astype(np.uint8).tobytes(), (out_soft if soft else None)
+
+    def _own_via(self, net):
+        """A via keeps VIA_TO_PAD from the net's own pads too (§3.5)."""
+        if net not in self.own_via:
+            rb = self.rb
+            vd = self.key[2]
+            polys = []
+            for p in rb.pads:
+                if p.GetNetname() != net:
+                    continue
+                for L in rb.layers:
+                    if p.IsOnLayer(L):
+                        polys += _polys(_grown(p, L, VIA_TO_PAD + vd / 2))
+            self.own_via[net] = rb.grid.raster_box(polys)
+        return self.own_via[net]
+
+
+def plane_layers(board, share=PLANE_SHARE):
+    """Inner copper layers that are planes: copper zones cover at least `share` of the
+    board there. Tracks don't go on them (they would cut the plane); vias pass through."""
+    outline = pcbnew.SHAPE_POLY_SET()
+    board.GetBoardPolygonOutlines(outline, False)
+    area = outline.Area()
+    out = []
+    for L in list(board.GetEnabledLayers().CuStack())[1:-1]:
+        sp = pcbnew.SHAPE_POLY_SET()
+        for z in board.Zones():
+            if not z.GetIsRuleArea() and z.IsOnLayer(L):
+                sp.BooleanAdd(z.Outline())
+        sp.BooleanIntersection(outline)
+        if area and sp.Area() >= share * area:
+            out.append(L)
+    return out
+
+
+class RouterBoard:
+    def __init__(self, board, pitch=0.1, pour_nets=("GND",), rules=None, layers=None):
+        """`layers`: names of the copper layers to route on; by default every copper layer
+        except inner planes (plane_layers)."""
+        self.board = board
+        self.pour_nets = set(pour_nets)
+        self.all_layers = list(board.GetEnabledLayers().CuStack())
+        self.layer_names = {L: board.GetLayerName(L) for L in self.all_layers}
+        if layers:
+            wanted = set(layers)
+            self.layers = [L for L in self.all_layers if self.layer_names[L] in wanted]
+            if not self.layers:
+                raise ValueError(f"none of the layers {sorted(wanted)} is a copper layer of this board")
+        else:
+            planes = set(plane_layers(board))
+            self.layers = [L for L in self.all_layers if L not in planes]
+        self.via_only_layers = [L for L in self.all_layers if L not in self.layers]
+        ds = board.GetDesignSettings()
+        self.ns = ds.m_NetSettings
+        self.min_clearance = T(ds.m_MinClearance)
+        self.edge_clearance = T(ds.m_CopperEdgeClearance)
+        self.hole_clearance = T(ds.m_HoleClearance)
+        if rules is None:
+            dru = os.path.splitext(board.GetFileName())[0] + ".kicad_dru"
+            rules = Rules.load(dru) if os.path.isfile(dru) else Rules()
+        self.rules = rules
+        self.outline = pcbnew.SHAPE_POLY_SET()
+        board.GetBoardPolygonOutlines(self.outline, False)
+        bb = board.GetBoardEdgesBoundingBox()
+        self.grid = Grid(T(bb.GetLeft()), T(bb.GetTop()), T(bb.GetRight()), T(bb.GetBottom()), pitch)
+        self.pads = [p for fp in board.GetFootprints() for p in fp.Pads()]
+        self._props = {}
+        self._groups = None  # net -> the net standing for its group (see _net_groups)
+        self.deadline = None  # time.time() after which searches give up (Router.connection_limit)
+        self._occ = {}
+        self.router_items = set()  # uuids of the copper this router added
+        self._others = {}
+        self._inside = {}
+
+    # --- rules -------------------------------------------------------------------------
+    def netclass(self, net):
+        return self.ns.GetEffectiveNetClass(net)
+
+    def widths(self, net):
+        nc = self.netclass(net)
+        return T(nc.GetTrackWidth()), T(nc.GetViaDiameter()), T(nc.GetViaDrill())
+
+    def key(self, net, extra=0.0):
+        w, vd, _drill = self.widths(net)
+        name = self.net_group(net) if self.rules.uses_net_names else None
+        return (self.netclass(net).GetName(), round(w + 2 * extra, 4), round(vd + 2 * extra, 4), name)
+
+    def net_group(self, net):
+        """The net that stands for `net`'s group: nets the rules can't tell apart share
+        their grids. Before, rules naming nets gave every net grids of its own: gigabytes,
+        and each commit drawn into all of them."""
+        if self._groups is None:
+            self._groups = self._net_groups()
+        return self._groups.get(net, net)
+
+    def _net_groups(self):
+        """Nets whose new copper gets the same clearance to everything: to every item on
+        the board and to every group's new copper, on every layer, as track and as via.
+        NetName only reaches a condition through its comparisons with the rules' patterns,
+        so first the nets that match the same patterns are put together, then those groups
+        are compared by evaluating the rules."""
+        nets = sorted({p.GetNetname() for p in self.pads} | {t.GetNetname() for t in self.board.GetTracks()}
+                      | {z.GetNetname() for z in self.board.Zones() if not z.GetIsRuleArea()})
+        nets = [n for n in nets if n]
+        pats = net_name_patterns(self.rules)
+        if pats is None:  # a rule compares two net names: each net is its own group
+            return {n: n for n in nets}
+        from commands.powerlab_router.rules import _wild
+        first = {}
+        for n in nets:
+            k = (self.key_base(n), tuple(_wild(n, p) for p in pats))
+            first.setdefault(k, n)
+        rep = {n: first[(self.key_base(n), tuple(_wild(n, p) for p in pats))] for n in nets}
+        reps = sorted(set(rep.values()))
+        # the other side of every clearance: board items, nets standing for their group
+        others = {}
+        for it, net in self.copper_items():
+            p = dict(self.props(it))
+            if net in rep:
+                p["NetName"] = rep[net]
+                p["NetClass"] = self.netclass(rep[net]).GetName()
+            frozen = tuple(sorted((k, tuple(v) if isinstance(v, list) else v) for k, v in p.items()))
+            if frozen not in others:
+                others[frozen] = (p, T(self.netclass(net).GetClearance()) if net else self.min_clearance)
+        for r in reps:
+            cls, w, vd, _ = self.key_base(r) + (None,)
+            for kind in ("Track", "Via"):
+                p = self.routed_props((cls, w, vd, r), kind)
+                others[("routed", r, kind)] = (p, T(self.netclass(r).GetClearance()))
+        names = [self.layer_names[L] for L in self.layers]
+        final, seen = {}, {}
+        for r in reps:
+            cls, w, vd = self.key_base(r)
+            mine = T(self.ns.GetNetClassByName(cls).GetClearance()) if cls else self.min_clearance
+            vec = []
+            for kind in ("Track", "Via"):
+                a = self.routed_props((cls, w, vd, r), kind)
+                for p, theirs in others.values():
+                    default = max(theirs, mine, self.min_clearance)
+                    for name in names:
+                        vec.append(self.rules.clearance(p, a, name, default))
+            k = ((cls, w, vd), tuple(vec))
+            final[r] = seen.setdefault(k, r)
+        return {n: final[rep[n]] for n in nets}
+
+    def past_deadline(self):
+        return self.deadline is not None and time.time() > self.deadline
+
+    def key_base(self, net):
+        w, vd, _drill = self.widths(net)
+        return (self.netclass(net).GetName(), round(w, 4), round(vd, 4))
+
+    def props(self, item):
+        u = _uuid(item)
+        if u not in self._props:
+            net = item.GetNetname()
+            p = {"Type": TYPES.get(item.Type(), "Other"), "NetName": net,
+                 "NetClass": self.netclass(net).GetName() if net else "Default",
+                 "Layers": [self.layer_names[L] for L in self.all_layers if item.IsOnLayer(L)], "Footprint": None}
+            if item.Type() in (pcbnew.PCB_TRACE_T, pcbnew.PCB_ARC_T):
+                p["Width"] = T(item.GetWidth())
+            if item.Type() == pcbnew.PCB_PAD_T:
+                p["Footprint"] = item.GetParentFootprint().GetReference()
+                p["Plated"] = item.GetAttribute() != pcbnew.PAD_ATTRIB_NPTH
+            self._props[u] = p
+        return self._props[u]
+
+    def routed_props(self, key, kind):
+        cls, w, _vd, net = key
+        p = {"Type": kind, "NetName": net, "NetClass": cls, "Footprint": None,
+             "Layers": list(self.layer_names.values())}
+        if kind == "Track":
+            p["Width"] = w
+        return p
+
+    def clearance_to(self, item, key, kind, layer):
+        """Clearance between `item` and new copper (`kind` "Track"/"Via") of the key's nets."""
+        ip = self.props(item)
+        a = T(self.netclass(ip["NetName"]).GetClearance()) if ip["NetName"] else self.min_clearance
+        b = T(self.ns.GetNetClassByName(key[0]).GetClearance()) if key[0] else self.min_clearance
+        default = max(a, b, self.min_clearance)
+        return self.rules.clearance(ip, self.routed_props(key, kind), self.layer_names[layer], default)
+
+    # --- geometry ------------------------------------------------------------------------
+    def inside(self, by):
+        """Cells at least `by` mm inside the board outline. Pillow fills the cells under a
+        polygon's outline too, which errs outward here, so the outline shrinks a cell more."""
+        k = round(by, 4)
+        if k not in self._inside:
+            sp = self.outline.CloneDropTriangulation()
+            sp.Inflate(MM(-(by + self.grid.pitch)), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+            self._inside[k] = self.grid.raster(_polys(sp))
+        return self._inside[k]
+
+    def keepouts(self, w, vd):
+        """Rule areas that keep tracks out: per layer, for track centres and for vias. The
+        board's own and the footprints' (a module's antenna keepout comes with its footprint)."""
+        t = [np.zeros((self.grid.ny, self.grid.nx), bool) for _ in self.layers]
+        v = [np.zeros((self.grid.ny, self.grid.nx), bool) for _ in self.layers]
+        zones = list(self.board.Zones()) + [z for fp in self.board.GetFootprints() for z in fp.Zones()]
+        for z in zones:
+            if not z.GetIsRuleArea():
+                continue
+            for i, L in enumerate(self.layers):
+                if not z.IsOnLayer(L):
+                    continue
+                if z.GetDoNotAllowTracks():
+                    sp = z.Outline().CloneDropTriangulation()
+                    sp.Inflate(MM(w / 2), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+                    t[i] |= self.grid.raster(_polys(sp))
+                if z.GetDoNotAllowVias():
+                    sp = z.Outline().CloneDropTriangulation()
+                    sp.Inflate(MM(vd / 2), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, ERR)
+                    v[i] |= self.grid.raster(_polys(sp))
+        return t, v
+
+    def copper_items(self):
+        """(item, net) for everything that can be in a new track's way."""
+        out = [(p, p.GetNetname()) for p in self.pads]
+        out += [(t, t.GetNetname()) for t in self.board.GetTracks()]
+        out += [(z, z.GetNetname()) for z in self.board.Zones()
+                if not z.GetIsRuleArea() and z.GetNetname() not in self.pour_nets]
+        return out
+
+    # --- obstacles -------------------------------------------------------------------------
+    def occupancy(self, key):
+        if key not in self._occ:
+            self._occ[key] = _Occupancy(self, key)
+        return self._occ[key]
+
+    def obstacles(self, net, extra=0.0):
+        """Per layer: flat bytes, 1 where this net's track centre can't go; and where a via can.
+        `extra` (mm) keeps everything that much further away, for a retry after the exact check."""
+        return self.occupancy(self.key(net, extra)).blocked(net)[:2]
+
+    def obstacles_soft(self, net, soft, extra=0.0):
+        """Like obstacles(), with the router's copper of the `soft` nets left passable;
+        also returns where that copper is, per layer (bool arrays)."""
+        return self.occupancy(self.key(net, extra)).blocked(net, soft)
+
+    # --- pad entry lanes ---------------------------------------------------------------
+    def lanes(self, pad, blocked, net, exact=True, ignore=None):
+        """Straight ways out of a pad along its axes, on each of its copper layers.
+        Under the part only at a cost; at fine pitch only straight out of the pin row.
+        With exact=False, only the grid is asked (cheap, for ordering)."""
+        w = self.widths(net)[0]
+        g = self.grid
+        fp = pad.GetParentFootprint()
+        me = _uuid(pad)
+        cx, cy = T(pad.GetPosition().x), T(pad.GetPosition().y)
+        fine = any(_uuid(p) != me and 1e-3 < math.hypot(T(p.GetPosition().x) - cx, T(p.GetPosition().y) - cy) < FINE_PITCH
+                   for p in fp.Pads())
+        # the body's centre, not the pads' average: a USB-C receptacle's pins sit at its back
+        bbox = fp.GetBoundingBox(False)
+        out = (cx - T(bbox.GetCenter().x), cy - T(bbox.GetCenter().y))
+        out_len = math.hypot(*out)
+        theta = pad.GetOrientation().AsDegrees()
+        result = []
+        for L_idx, L in enumerate(self.layers):
+            if not pad.IsOnLayer(L):
+                continue
+            pts = [pt for outline, _h in _polys(_grown(pad, L, 0.0)) for pt in outline]
+            # a round pad has no axis: every 45 degree direction goes straight to its centre.
+            # Other pads are entered along an axis, or at 45 degrees to their centre where
+            # they aren't fine pitch (as by hand: no extra bend just to come in square)
+            for k in range(8):
+                a = theta + 45 * k
+                if k % 2 and not is_round(pad, L) and fine:
+                    continue
+                d8 = a / 45.0
+                if abs(d8 - round(d8)) > 1e-3:
+                    continue  # pad not at a multiple of 45 degrees
+                d = int(round(d8)) % 8
+                ux, uy = math.cos(math.radians(a)), math.sin(math.radians(a))
+                penalty = DIAGONAL_ENTRY if k % 2 and not is_round(pad, L) else 0.0
+                if out_len > 0.05:
+                    dot = (ux * out[0] + uy * out[1]) / out_len
+                    if fine and dot < 0.7:
+                        continue
+                    if dot < -0.3:
+                        penalty += UNDER_BODY  # under the part: fine for a module's edge pads
+                extent = max((px - cx) * ux + (py - cy) * uy for px, py in pts)
+                preferred = extent + max(w, 0.5 if fine else 0.3)
+                # the lane is checked exactly (the grid is too coarse between fine-pitch pads);
+                # only its exit cell, where the search starts, must be free on the grid, so a
+                # few lengths are tried: the preferred one and longer, then shorter ones down
+                # to a track width beyond the pad (the grid errs by about a cell at a pin row)
+                longer = [preferred + k * g.pitch for k in range(LANE_TRIES)]
+                shorter = []
+                s = preferred - g.pitch
+                while s >= extent + w - 1e-9:
+                    shorter.append(s)
+                    s -= g.pitch
+                for length in longer + shorter:
+                    ex, ey = cx + ux * length, cy + uy * length
+                    cell = g.cell(ex, ey)
+                    if not (0 <= cell[0] < g.nx and 0 <= cell[1] < g.ny):
+                        continue
+                    if blocked[L_idx][cell[1] * g.nx + cell[0]]:
+                        continue
+                    if not exact or self.clear(net, L, (cx, cy), (ex, ey), w, ignore):
+                        result.append(Lane(pad, L_idx, d, (cx, cy), (ex, ey), cell, length + penalty))
+                        break
+        return result
+
+    def lane_shape(self, lane, net):
+        """Where a track of `net` can't go without blocking `lane` (for reserving it): the
+        lane from the pad's edge to its exit, grown by the clearance and half a track."""
+        w = self.widths(net)[0]
+        c = self.clearance_to(lane.pad, self.key(net), "Track", self.layers[lane.layer])
+        (cx, cy), (ex, ey) = lane.centre, lane.exit
+        L = math.hypot(ex - cx, ey - cy) or 1.0
+        ux, uy = (ex - cx) / L, (ey - cy) / L
+        half = w + c  # the lane's own half width (w/2) plus clearance plus half the other track
+        nx_, ny_ = -uy * half, ux * half
+        return ([(cx + nx_, cy + ny_), (ex + ux * half + nx_, ey + uy * half + ny_),
+                 (ex + ux * half - nx_, ey + uy * half - ny_), (cx - nx_, cy - ny_)], [])
+
+    # --- one connection ----------------------------------------------------------------
+    def route(self, net, pad_a, pad_b, blocked, via_ok, costs, margins=(3.0, 10.0, None), penalty=None,
+              ignore=None, via_costs=None, tree=None, used=None):
+        """`penalty`: per layer bytes of extra cost per cell; `ignore`: uuids of other nets'
+        copper the exact lane checks may pass through (it's being ripped up); `via_costs`:
+        lanes -> ({cell index: via cost}, via cost elsewhere).
+        `tree`: [(layer index, p, q)], the net's own tracks already joined to pad_b. The way
+        may end on one of them instead of at pad_b, as a person joins a track to the net's
+        track that is already there instead of running a second one beside it (info["tee"]
+        is then the index of that track). It joins at an angle, never along the track, and
+        not within TEE_PAD_MM of a pad (the pad is the junction there, §3.4).
+        `used`: {(pad uuid, layer index, direction)} lanes the net's tracks already leave by;
+        a second track there would lie on the first, so those lanes cost USED_LANE more."""
+        g = self.grid
+        la, lb = self.lanes(pad_a, blocked, net, ignore=ignore), self.lanes(pad_b, blocked, net, ignore=ignore)
+        info = {"lanes": (len(la), len(lb)), "nodes": 0, "seconds": 0.0}
+        if not la or not lb:
+            info["fail"] = "no free entry lane"
+            return None, info
+        if used:
+            for l in la + lb:
+                if (_uuid(l.pad), l.layer, l.direction) in used:
+                    l.cost += USED_LANE
+        starts = [(l.cell[0], l.cell[1], l.layer, l.direction, l.cost) for l in la]
+        goals = {(l.cell[0], l.cell[1], l.layer): ((l.direction + 4) % 8, l.cost) for l in lb}
+        tree_at = self._tree_goals(net, tree, blocked, goals) if tree else {}
+        for key in tree_at:
+            goals[key] = (tree_at[key][2], 0.0)
+        back = [(l.cell[0], l.cell[1], l.layer, 0, 0) for l in lb]
+        if (search.enclosed(blocked, via_ok, g.nx, g.ny, starts, goals)
+                or search.enclosed(blocked, via_ok, g.nx, g.ny, back, {(l.cell[0], l.cell[1], l.layer): None for l in la})):
+            info["fail"] = "closed pocket"
+            return None, info
+        cells = [l.cell for l in la + lb]
+        # the cheapest a way could be: the octilinear distance between the lane exits
+        lower = min(math.dist(a.exit, b.exit) for a in la for b in lb)
+        if tree_at:
+            lower = min([lower] + [math.dist(a.exit, t[1]) for a in la for t in list(tree_at.values())[::8]])
+        t0 = time.time()
+        path = None
+        vc = via_costs(la + lb) if via_costs else None
+        budget = costs.node_limit(math.dist(la[0].centre, lb[0].centre))
+        for margin in margins:
+            if margin is None:
+                window = (0, 0, g.nx - 1, g.ny - 1)
+            else:
+                m = int(margin / g.pitch)
+                window = (max(0, min(c[0] for c in cells) - m), max(0, min(c[1] for c in cells) - m),
+                          min(g.nx - 1, max(c[0] for c in cells) + m), min(g.ny - 1, max(c[1] for c in cells) + m))
+            found, stats = search.search(blocked, via_ok, g.nx, g.ny, g.pitch, starts, goals, window, costs,
+                                         max_nodes=budget, penalty=penalty, via_cost=vc, deadline=self.deadline)
+            info["nodes"] += stats["nodes"]
+            # a path that comes back to a cell it has been on (a loop through two vias at one
+            # spot, to turn where the corner rules don't allow it): no via there, search again
+            for _retry in range(3):
+                spots = _loops(found)
+                if not spots:
+                    break
+                via_ok = bytearray(via_ok)
+                for i, j in spots:
+                    via_ok[j * g.nx + i] = 0
+                found, stats = search.search(blocked, bytes(via_ok), g.nx, g.ny, g.pitch, starts, goals, window,
+                                             costs, max_nodes=budget, penalty=penalty, via_cost=vc, deadline=self.deadline)
+                info["nodes"] += stats["nodes"]
+            if found and _loops(found):
+                found = None
+            if found and (path is None or stats["cost_mm"] < info["cost_mm"]):
+                path = found
+                info["window_mm"] = margin
+                info["cost_mm"] = stats["cost_mm"]
+            # a way much dearer than its length paid for something (an inductor, a pour, a
+            # rip-up): a bigger window may have one around it
+            if path and info["cost_mm"] <= 2.0 * lower + 3.0 * costs.via:
+                break
+            if path:
+                budget *= 3  # a dear way inside: the way round, if any, needs a wider search
+            if stats.get("limit"):
+                info["limit"] = not path  # gave up: a bigger window won't be cheaper
+                break
+        info["seconds"] = round(time.time() - t0, 3)
+        if not path and (costs.diagonal > 1.0 or costs.min_run_diag > costs.min_run) and not self.past_deadline():
+            # by hand, diagonals are short corners; where it's too tight for that (a fine-pitch
+            # connector), any 45 degree way is better than none
+            plain = copy.copy(costs)
+            plain.diagonal, plain.min_run_diag = 1.0, costs.min_run
+            again, more = self.route(net, pad_a, pad_b, blocked, via_ok, plain, margins, penalty, ignore, via_costs,
+                                     tree, used)
+            more["nodes"] += info["nodes"]
+            more["seconds"] = round(more["seconds"] + info["seconds"], 3)
+            more["plain_diagonals"] = True
+            return again, more
+        if not path:
+            info["fail"] = "node limit" if info.get("limit") else "no path"
+            return None, info
+        first = path[0]
+        start = next(l for l in la if (l.cell, l.layer, l.direction) == ((first[0], first[1]), first[2], first[3]))
+        last = path[-1]
+        key = (last[0], last[1], last[2])
+        if key in tree_at:  # joins the net's track
+            idx, _pt, _dirs = tree_at[key]
+            _L, p, q = tree[idx]
+            c = g.at(last[0], last[1])
+            e = _meet(c, search.DIRS[last[3]], p, q) or _pt
+            goal = Lane(None, last[2], (last[3] + 4) % 8, e, e, (last[0], last[1]), 0.0)
+            info["tee"] = idx
+        else:
+            goal = next(l for l in lb if (l.cell, l.layer) == ((last[0], last[1]), last[2]))
+        return self._geometry(path, start, goal), info
+
+    def _tree_goals(self, net, tree, blocked, goals):
+        """{(i, j, layer): (track index, point on it, directions it may be joined from)}."""
+        g = self.grid
+        pads = [(T(p.GetPosition().x), T(p.GetPosition().y)) for p in self.pads if p.GetNetname() == net]
+        out = {}
+        for idx, (L, p, q) in enumerate(tree):
+            length = math.dist(p, q)
+            if length < 1e-6:
+                continue
+            d8 = math.degrees(math.atan2(q[1] - p[1], q[0] - p[0])) / 45.0
+            d = int(round(d8)) % 8 if abs(d8 - round(d8)) < 1e-3 else None
+            dirs = frozenset(k for k in range(8) if d is None or k % 4 != d % 4)
+            n = max(1, int(length / (g.pitch / 2)))
+            for s in range(n + 1):
+                x, y = p[0] + (q[0] - p[0]) * s / n, p[1] + (q[1] - p[1]) * s / n
+                if any(math.dist((x, y), c) < TEE_PAD_MM for c in pads):
+                    continue
+                i, j = g.cell(x, y)
+                if not (0 <= i < g.nx and 0 <= j < g.ny) or blocked[L][j * g.nx + i] or (i, j, L) in goals:
+                    continue
+                out.setdefault((i, j, L), (idx, (x, y), dirs))
+        return out
+
+    def _geometry(self, path, start, goal):
+        """Grid path -> [(layer index, [points mm])], [via points], ending at both pad centres.
+        The first and last straight runs are moved onto the pads' axes, so the entry is exact
+        even when the pad centre isn't on the grid (see _align)."""
+        g = self.grid
+        pieces, vias = [], []
+        cur_layer, pts = path[0][2], [g.at(path[0][0], path[0][1])]
+        for a, b in zip(path, path[1:]):
+            if b[2] != a[2]:
+                pieces.append((cur_layer, pts))
+                vias.append(g.at(a[0], a[1]))
+                cur_layer, pts = b[2], [g.at(b[0], b[1])]
+            else:
+                pts.append(g.at(b[0], b[1]))
+        pieces.append((cur_layer, pts))
+        pieces = [[L, _corners(p)] for L, p in pieces]
+        _align(pieces, vias, start.exit)
+        rev = [[L, p[::-1]] for L, p in pieces[::-1]]
+        rvias = vias[::-1]
+        _align(rev, rvias, goal.exit)
+        pieces = [(L, p[::-1]) for L, p in rev[::-1]]
+        vias = rvias[::-1]
+        _square_middles(pieces, vias)
+        pieces[0] = (pieces[0][0], [start.centre] + pieces[0][1])
+        if goal.pad is not None:  # a pad; else the point where it joins the net's track
+            pieces[-1] = (pieces[-1][0], pieces[-1][1] + [goal.centre])
+        return pieces, vias
+
+    def add(self, net, pieces, vias):
+        """Put the copper on the board (not yet in the grids, see commit()); returns the items."""
+        w, vd, drill = self.widths(net)
+        n = self.board.FindNet(net)
+        items = []
+        for L_idx, pts in pieces:
+            for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
+                if math.hypot(x1 - x0, y1 - y0) < 1e-4:
+                    continue
+                t = pcbnew.PCB_TRACK(self.board)
+                t.SetStart(pcbnew.VECTOR2I(MM(x0), MM(y0)))
+                t.SetEnd(pcbnew.VECTOR2I(MM(x1), MM(y1)))
+                t.SetWidth(MM(w))
+                t.SetLayer(self.layers[L_idx])
+                t.SetNet(n)
+                self.board.Add(t)
+                items.append(t)
+        for x, y in vias:
+            v = pcbnew.PCB_VIA(self.board)
+            v.SetPosition(pcbnew.VECTOR2I(MM(x), MM(y)))
+            v.SetWidth(MM(vd))
+            v.SetDrill(MM(drill))
+            v.SetNet(n)
+            self.board.Add(v)
+            items.append(v)
+        self.router_items.update(_uuid(it) for it in items)
+        self._others = {}
+        return items
+
+    def commit(self, net, items):
+        """Stamp accepted copper into every key's grids."""
+        for occ in self._occ.values():
+            occ.stamp(net, items)
+
+    def uncommit(self, net, items_left):
+        """After a rip-up: `net`'s router copper is now only `items_left`."""
+        for occ in self._occ.values():
+            occ.set_new(net, items_left)
+
+    def remove(self, items):
+        for it in items:
+            self.router_items.discard(_uuid(it))
+            self.board.Delete(it)
+        self._others = {}
+
+    # --- exact checks ------------------------------------------------------------------
+    def _other_items(self, net):
+        """Other nets' copper with its bounding box, cached until the copper changes."""
+        if net not in self._others:
+            out = []
+            for o, n in self.copper_items():
+                if n != net and o.Type() != pcbnew.PCB_ZONE_T:
+                    out.append((o, o.GetBoundingBox()))
+            self._others[net] = out
+        return self._others[net]
+
+    def _hits(self, net, item, layer, ignore=None):
+        key = self.key(net)
+        kind = "Via" if item.Type() == pcbnew.PCB_VIA_T else "Track"
+        mine = _grown(item, layer, 0.0)
+        box = mine.BBox()
+        box.Inflate(MM(2.0))  # more than any clearance the lab uses
+        hits = []
+        for o, bb in self._other_items(net):
+            if not o.IsOnLayer(layer) or not box.Intersects(bb):
+                continue
+            if ignore and _uuid(o) in ignore:
+                continue
+            c = self.clearance_to(o, key, kind, layer)
+            if mine.Collide(_grown(o, layer, c - 0.001)):
+                hits.append(o)
+        return hits
+
+    def clear(self, net, layer, a, b, width, ignore=None):
+        """Whether a track from a to b keeps its clearance to every other net (exact)."""
+        t = pcbnew.PCB_TRACK(self.board)
+        t.SetStart(pcbnew.VECTOR2I(MM(a[0]), MM(a[1])))
+        t.SetEnd(pcbnew.VECTOR2I(MM(b[0]), MM(b[1])))
+        t.SetWidth(MM(width))
+        t.SetLayer(layer)
+        return not self._hits(net, t, layer, ignore) and not self._off_edge(t)
+
+    def violations(self, net, items):
+        """Exact check of new copper against other nets' copper and the board edge:
+        [(item, other)] too close; other is None for the edge."""
+        bad = []
+        for it in items:
+            for L in self.layers:
+                if it.IsOnLayer(L):
+                    bad += [(it, o) for o in self._hits(net, it, L)]
+            if self._off_edge(it):
+                bad.append((it, None))
+        return bad
+
+    def _off_edge(self, item):
+        """Whether `item` comes closer to the board edge than the edge clearance."""
+        L = next(L for L in self.layers if item.IsOnLayer(L))
+        grown = _grown(item, L, self.edge_clearance - 0.001)
+        grown.BooleanSubtract(self.outline)
+        return grown.OutlineCount() > 0 and grown.Area() > MM(0.001) ** 2
+
+
+def _square_middles(pieces, vias, most=0.3):
+    """A straight run between two vias that both ends' alignment (_align) left a little
+    off a 45 degree multiple (pad -> via -> other layer -> via -> pad, every piece one run,
+    both pads off the grid): slide the two vias along the runs that reach them, by the
+    least that squares the middle run, so no track is a few degrees skew."""
+    def unit(a, b):
+        n = math.dist(a, b)
+        return ((b[0] - a[0]) / n, (b[1] - a[1]) / n) if n > 1e-9 else None
+    cross = lambda u, v: u[0] * v[1] - u[1] * v[0]
+    for k in range(1, len(pieces) - 1):
+        L, pts = pieces[k]
+        if len(pts) != 2:
+            continue
+        a, b = pts
+        r = (b[0] - a[0], b[1] - a[1])
+        ang = math.degrees(math.atan2(r[1], r[0]))
+        if abs(ang / 45.0 - round(ang / 45.0)) * 45.0 < 0.05:
+            continue
+        dm = (math.cos(math.radians(round(ang / 45.0) * 45)), math.sin(math.radians(round(ang / 45.0) * 45)))
+        before, after = pieces[k - 1][1], pieces[k + 1][1]
+        ua, ub = unit(before[-2], before[-1]), unit(after[1], after[0])
+        if ua is None or ub is None:
+            continue
+        # cross(r + tb*ub - ta*ua, dm) = 0, the smallest (ta, tb)
+        g = (-cross(ua, dm), cross(ub, dm))
+        gg = g[0] * g[0] + g[1] * g[1]
+        if gg < 1e-12:
+            continue
+        c = cross(r, dm)
+        ta, tb = -c * g[0] / gg, -c * g[1] / gg
+        if abs(ta) > most or abs(tb) > most:
+            continue
+        na = (a[0] + ta * ua[0], a[1] + ta * ua[1])
+        nb = (b[0] + tb * ub[0], b[1] + tb * ub[1])
+        if math.dist(before[-2], na) < 0.05 or math.dist(after[1], nb) < 0.05:
+            continue
+        before[-1], after[0] = na, nb
+        pieces[k] = (L, [na, nb])
+        vias[k - 1], vias[k] = na, nb
+
+
+def _meet(c, u, p, q):
+    """Where the line from c along u meets the track from p to q, or None (parallel, or
+    past the track's ends)."""
+    vx, vy = q[0] - p[0], q[1] - p[1]
+    det = -u[0] * vy + u[1] * vx
+    if abs(det) < 1e-12:
+        return None
+    rx, ry = p[0] - c[0], p[1] - c[1]
+    t = (-rx * vy + vx * ry) / det
+    s = (u[0] * ry - u[1] * rx) / det
+    if not -0.01 <= s <= 1.01:
+        return None
+    return (c[0] + t * u[0], c[1] + t * u[1])
+
+
+def _loops(path):
+    """Cells where a grid path changes layer more than once, or that it visits twice on a layer."""
+    if not path:
+        return []
+    seen, vias, out = set(), {}, set()
+    for a, b in zip(path, path[1:]):
+        if a[2] != b[2]:
+            vias[(a[0], a[1])] = vias.get((a[0], a[1]), 0) + 1
+    out |= {c for c, n in vias.items() if n > 1}
+    for s in path:
+        key = (s[0], s[1], s[2])
+        if key in seen:
+            out.add((s[0], s[1]))
+        seen.add(key)
+    return sorted(out)
+
+
+def _corners(pts):
+    if len(pts) < 3:
+        return pts
+    out = [pts[0]]
+    for a, b, c in zip(pts, pts[1:], pts[2:]):
+        d1 = (round(b[0] - a[0], 6), round(b[1] - a[1], 6))
+        d2 = (round(c[0] - b[0], 6), round(c[1] - b[1], 6))
+        if d1[0] * d2[1] - d1[1] * d2[0] != 0 or d1[0] * d2[0] + d1[1] * d2[1] < 0:
+            out.append(b)
+    out.append(pts[-1])
+    return out
+
+
+def _align(pieces, vias, exact, k=0):
+    """Make piece k start at `exact` (off the grid) without bending any run: the first
+    corner slides along the second run. A run that ends at a via moves whole, via and
+    all, and the next piece is lined up from the moved via."""
+    L, pts = pieces[k]
+    if len(pts) >= 3 or k == len(pieces) - 1:
+        pieces[k][1] = _snap_end(pts, exact)
+        return
+    off = (exact[0] - pts[0][0], exact[1] - pts[0][1])
+    moved = [(x + off[0], y + off[1]) for x, y in pts]
+    pieces[k][1] = moved
+    vias[k] = moved[-1]
+    _align(pieces, vias, moved[-1], k + 1)
+
+
+def _snap_end(pts, exact):
+    """Replace pts[0] (a grid cell) by `exact` and move the first corner so the first run
+    keeps its direction and the second run still reaches its far end."""
+    if len(pts) < 3:
+        return [exact] + pts[1:]
+    (x0, y0), (x1, y1), (x2, y2) = pts[0], pts[1], pts[2]
+    v0, v1 = (x1 - x0, y1 - y0), (x2 - x1, y2 - y1)
+    det = v0[0] * (-v1[1]) - v0[1] * (-v1[0])
+    if abs(det) < 1e-12:
+        return [exact] + pts[1:]
+    rx, ry = x1 - exact[0], y1 - exact[1]
+    t = (rx * (-v1[1]) - ry * (-v1[0])) / det
+    corner = (exact[0] + t * v0[0], exact[1] + t * v0[1])
+    return [exact, corner] + pts[2:]
diff --git a/python/commands/powerlab_router/patterns.py b/python/commands/powerlab_router/patterns.py
new file mode 100644
index 0000000..96e3f70
--- /dev/null
+++ b/python/commands/powerlab_router/patterns.py
@@ -0,0 +1,111 @@
+"""Hand-drawn shapes for a run of track (plan §15 follow-up). No pcbnew.
+
+A person routes a run between two fixed points (a pin's stub, a via) with a few long
+straight segments: straight, one bend, or a Z of up to three bends, every bend 45 degrees.
+These are those shapes, as lists of points: segment directions are multiples of 45
+degrees and each turns by exactly 45 from the last. The run leaves `a` heading `da` and
+arrives at `b` heading `db` (direction indices 0-7, 45 degrees apart, 0 = +x, 2 = +y;
+None = any, e.g. at a via).
+
+The free parameters (where the middle segments lie) are sampled every `step` mm, so
+parallel tracks can sit on a regular pitch.
+"""
+
+import math
+
+DIRS = [(math.cos(math.radians(45 * k)), math.sin(math.radians(45 * k))) for k in range(8)]
+EPS = 1e-6
+
+
+def _solve2(u, v, r):
+    """l, m with l*u + m*v = r, or None if u and v are parallel."""
+    det = u[0] * v[1] - u[1] * v[0]
+    if abs(det) < EPS:
+        return None
+    return ((r[0] * v[1] - r[1] * v[0]) / det, (u[0] * r[1] - u[1] * r[0]) / det)
+
+
+def _sequences(da, db, most):
+    """Direction sequences from da to db, each step turning by 45 degrees, up to `most` segments."""
+    starts = [da] if da is not None else list(range(8))
+    out = []
+
+    def grow(seq):
+        if db is None or seq[-1] == db:
+            out.append(list(seq))
+        if len(seq) == most:
+            return
+        for turn in (1, -1):
+            grow(seq + [(seq[-1] + turn) % 8])
+
+    for s in starts:
+        grow([s])
+    return out
+
+
+def shapes(a, da, b, db, most=4, step=0.1, min_segment=0.3, reach=1.5):
+    """Point lists from a to b (a and b included) for every direction sequence of up to
+    `most` segments; the middle segments' lengths are sampled every `step` mm up to
+    `reach` times the distance. Segments other than the first and last are at least
+    `min_segment` long; the first and last may be 0 (a bend right at a or b)."""
+    r = (b[0] - a[0], b[1] - a[1])
+    dist = math.hypot(*r)
+    if dist < EPS:
+        return []
+    top = max(dist * reach, 1.0)
+    samples = [k * step for k in range(int(top / step) + 1)]
+    out = []
+    for seq in _sequences(da, db, most):
+        u = [DIRS[d] for d in seq]
+        n = len(seq)
+        if n == 1:
+            if abs(u[0][0] * r[1] - u[0][1] * r[0]) < EPS * max(1, dist) and u[0][0] * r[0] + u[0][1] * r[1] > 0:
+                out.append([a, b])
+            continue
+        # two segments whose lengths are solved for; the others are sampled
+        pairs = [(0, n - 1)] + [(i, j) for i in range(n) for j in range(i + 1, n) if (i, j) != (0, n - 1)]
+        solve = next(((i, j) for i, j in pairs if abs(u[i][0] * u[j][1] - u[i][1] * u[j][0]) > EPS), None)
+        if solve is None:
+            continue
+        free = [k for k in range(n) if k not in solve]
+        for vals in _grid(samples, len(free)):
+            lengths = [0.0] * n
+            for k, v in zip(free, vals):
+                lengths[k] = v
+            rest = (r[0] - sum(lengths[k] * u[k][0] for k in free), r[1] - sum(lengths[k] * u[k][1] for k in free))
+            ends = _solve2(u[solve[0]], u[solve[1]], rest)
+            if ends is None:
+                continue
+            lengths[solve[0]], lengths[solve[1]] = ends
+            if any(L < -EPS for L in lengths):
+                continue
+            if any(lengths[k] < min_segment for k in range(1, n - 1)):
+                continue  # a middle segment too short to draw
+            pts = [a]
+            for d, L in zip(u, lengths):
+                if L > EPS:
+                    pts.append((pts[-1][0] + d[0] * L, pts[-1][1] + d[1] * L))
+            pts[-1] = b  # exact end
+            out.append(pts)
+    return out
+
+
+def _grid(samples, k):
+    if k == 0:
+        yield ()
+        return
+    for v in samples:
+        for rest in _grid(samples, k - 1):
+            yield (v,) + rest
+
+
+def bends(pts):
+    """Changes of direction along a point list; points on a straight line (a pad's lane
+    exit, the end of a stub) are not bends."""
+    n = 0
+    for a, b, c in zip(pts, pts[1:], pts[2:]):
+        ux, uy, vx, vy = b[0] - a[0], b[1] - a[1], c[0] - b[0], c[1] - b[1]
+        lu, lv = math.hypot(ux, uy), math.hypot(vx, vy)
+        if lu > EPS and lv > EPS and abs(ux * vy - uy * vx) > 1e-3 * lu * lv:
+            n += 1
+    return n
diff --git a/python/commands/powerlab_router/pours.py b/python/commands/powerlab_router/pours.py
new file mode 100644
index 0000000..9133690
--- /dev/null
+++ b/python/commands/powerlab_router/pours.py
@@ -0,0 +1,200 @@
+"""After routing: pours round the power rails, and GND stitching vias (design rules §3.3, §3.5).
+
+Power polygons (§3.3, "power rails are copper areas, not traces"): every power rail with
+tracks gets a pour on each layer it runs on, drawn round its tracks and pads with a margin
+(POWER_MARGINS), above the GND pour, so it widens the rail wherever there is room and the
+GND pour flows round it. A pour that adds a DRC error is tried with a smaller margin, then
+left out. The track stays inside it, so the rail stays connected even
+where the pour can't fill. Pads join the pour with thermal reliefs; only the high-current
+nets the user names connect solid (§3.3, pour quality). A layer that already has a pour
+of that net is left alone.
+
+Stitching vias (§3.5): GND vias about `pitch` apart where every GND pour layer is filled
+round the via, kept clear of other nets (the router's via grid and the exact check), of
+the escape room at fine-pitch pins, and of the GND vias already there.
+"""
+
+import math
+
+import pcbnew
+
+from commands.powerlab_router.model import MM, T, _Occupancy, _polys
+
+POWER_MARGINS = (1.0, 0.5, 0.25)  # mm of pour beyond a power track's or pad's edge, tried in turn
+OUTLINE_ERR = 0.05  # mm: corner error of the pour outlines (fewer points than the copper)
+THERMAL_GAP = 0.3
+STITCH_SEARCH = 0.25  # mm steps when looking near a grid point for a free spot
+STITCH_FILL_MARGIN = 0.15  # mm of filled pour round a stitching via's pad, on every layer
+
+
+def _zones(board, net, L):
+    return [z for z in board.Zones() if not z.GetIsRuleArea() and z.GetNetname() == net and z.IsOnLayer(L)]
+
+
+def _gnd_quality(router):
+    """(minus the summed largest-piece share, pieces) of the pour nets' fill, all zones
+    refilled: like Router._pour_quality, but with every zone filled, so a higher-priority
+    pour of another net is cut out of the GND pour as KiCad does it."""
+    rb = router.rb
+    pcbnew.ZONE_FILLER(rb.board).Fill(rb.board.Zones())
+    count, share = 0, 0.0
+    for z in rb.board.Zones():
+        if z.GetIsRuleArea() or z.GetNetname() not in rb.pour_nets:
+            continue
+        for L in z.GetLayerSet().CuStack():
+            f = z.GetFilledPolysList(L)
+            areas = [f.Outline(i).Area() / 1e12 for i in range(f.OutlineCount())]
+            count += len([a for a in areas if a >= 2.0])
+            share += max(areas) / sum(areas) if areas else 1.0
+    return (-round(share / 0.02) * 0.02, count)
+
+
+def power_pours(router, nets, solid=(), margins=POWER_MARGINS, check=None):
+    """Pours round the power rails' tracks; returns {net: [layer names]} and what was skipped.
+
+    Not on a GND plane layer (the bottom of a 2-layer board, an inner layer with a GND
+    pour on more layers), where the GND pour is the return plane: rails go on the parts
+    layer (§3.3). There the rail's pour may divide the GND pour of that layer; the plane
+    stays whole, and the stitching vias tie the pieces to it. The report gives the GND
+    pour before and after (_gnd_quality).
+    `check()`: the board's DRC errors (a set). A pour that adds one (a pad whose thermal
+    spokes don't fit, a GND island it cuts off) is tried again with the next, smaller
+    margin, then left out."""
+    rb = router.rb
+    board = rb.board
+    if len(rb.all_layers) == 2:
+        plane = {rb.all_layers[-1]}
+    else:
+        plane = {L for L in rb.all_layers[1:-1] if any(_zones(board, n, L) for n in rb.pour_nets)}
+    before = _gnd_quality(router)
+    base = check() if check else None
+    solid = set(solid)
+    pour_zones = [z for z in board.Zones() if not z.GetIsRuleArea() and z.GetNetname() in rb.pour_nets]
+    priority = max([z.GetAssignedPriority() for z in pour_zones] + [0]) + 1
+    min_width = min([T(z.GetMinThickness()) for z in pour_zones] + [0.25])
+    clip = rb.outline.CloneDropTriangulation()
+    clip.Inflate(MM(-rb.edge_clearance), pcbnew.CORNER_STRATEGY_CHAMFER_ALL_CORNERS, MM(OUTLINE_ERR))
+    made, skipped = {}, {}
+
+    def place(net, info, L, items, margin, w):
+        sp = pcbnew.SHAPE_POLY_SET()
+        for it in items:
+            it.TransformShapeToPolygon(sp, L, MM(margin), MM(OUTLINE_ERR), pcbnew.ERROR_OUTSIDE)
+        sp.Simplify()
+        sp.BooleanIntersection(clip)
+        added = []
+        for i in range(sp.OutlineCount()):
+            z = pcbnew.ZONE(board)
+            z.SetLayer(L)
+            z.SetNet(info)
+            z.SetAssignedPriority(priority)
+            z.SetZoneName(f"{net} pour")
+            z.SetPadConnection(pcbnew.ZONE_CONNECTION_FULL if net in solid else pcbnew.ZONE_CONNECTION_THERMAL)
+            z.SetThermalReliefGap(MM(THERMAL_GAP))
+            z.SetThermalReliefSpokeWidth(MM(max(min_width, min(w, 0.5))))
+            z.SetMinThickness(MM(min_width))
+            z.SetIslandRemovalMode(pcbnew.ISLAND_REMOVAL_MODE_ALWAYS)
+            # copied into the zone's own outline: SetOutline() would keep a pointer to a
+            # polygon Python frees later
+            z.Outline().AddOutline(sp.Outline(i))
+            board.Add(z)
+            added.append(z)
+        return added
+
+    for net in nets:
+        tracks = [t for t in board.GetTracks() if t.GetNetname() == net and t.Type() != pcbnew.PCB_VIA_T]
+        pads = [p for p in rb.pads if p.GetNetname() == net]
+        info = board.FindNet(net)
+        if not tracks or info is None:
+            continue
+        w = rb.widths(net)[0]
+        for L in rb.layers:
+            on = [t for t in tracks if t.IsOnLayer(L)]
+            if not on:
+                continue
+            name = rb.layer_names[L]
+            if L in plane:
+                skipped.setdefault(net, []).append(f"{name}: the GND plane layer")
+                continue
+            if _zones(board, net, L):
+                skipped.setdefault(net, []).append(f"{name}: has a pour already")
+                continue
+            why = "no room"
+            for margin in margins:
+                added = place(net, info, L, on + [p for p in pads if p.IsOnLayer(L)], margin, w)
+                pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+                if added and any(z.GetFilledPolysList(L).OutlineCount() for z in added):
+                    errors = check() - base if check else set()
+                    if not errors:
+                        made.setdefault(net, []).append(name)
+                        break
+                    why = "it would add DRC errors: " + ", ".join(sorted({kind for kind, _u in errors}))
+                for z in added:
+                    board.Delete(z)  # Remove() would leave Python owning it (#247)
+            else:
+                skipped.setdefault(net, []).append(f"{name}: {why}")
+    pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+    after = _gnd_quality(router)
+    router._q = None
+    return {"added": {n: sorted(set(v)) for n, v in made.items() if v}, "skipped": skipped,
+            "pad_connection": {n: ("solid" if n in solid else "thermal reliefs") for n in made},
+            "gnd_pour": {"before": before, "after": after}}
+
+
+def stitching_vias(router, pitch=5.0):
+    """GND stitching vias on a `pitch` grid, each moved to a free spot nearby."""
+    rb = router.rb
+    board = rb.board
+    net = router.pour_net
+    layers = [L for L in rb.layers if _zones(board, net, L)] if net else []
+    if not net or len(layers) < 2:
+        return {"added": 0, "why": "no pour net with pours on two layers"}
+    pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+    _cls, _w, vd, _name = key = rb.key(net)
+    # a fresh grid: the power pours added after routing are copper of other nets now
+    occ = _Occupancy(rb, key)
+    g = rb.grid
+    via_ok = occ.blocked(net)[1]
+    fills = []
+    for L in layers:
+        f = pcbnew.SHAPE_POLY_SET()
+        for z in _zones(board, net, L):
+            f.BooleanAdd(z.GetFilledPolysList(L))
+        f.Deflate(MM(vd / 2 + STITCH_FILL_MARGIN), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, MM(0.01))
+        fills.append(f)
+    escape = [e > 0 for e in router.lab.escape_total] if getattr(router, "lab", None) else None
+    vias = [(T(t.GetPosition().x), T(t.GetPosition().y)) for t in board.GetTracks()
+            if t.Type() == pcbnew.PCB_VIA_T and t.GetNetname() == net]
+    spacing = 0.6 * pitch
+
+    def free(x, y):
+        i, j = g.cell(x, y)
+        if not (0 <= i < g.nx and 0 <= j < g.ny) or not via_ok[j * g.nx + i]:
+            return False
+        if escape is not None and any(e[j, i] for e in escape):
+            return False
+        if any(math.dist((x, y), v) < spacing for v in vias):
+            return False
+        p = pcbnew.VECTOR2I(MM(x), MM(y))
+        return all(f.Contains(p) for f in fills)
+
+    added = []
+    x0, y0, x1, y1 = g.x0 + pitch / 2, g.y0 + pitch / 2, g.x0 + g.nx * g.pitch, g.y0 + g.ny * g.pitch
+    reach = int(pitch / 2 / STITCH_SEARCH)
+    y = y0
+    while y < y1:
+        x = x0
+        while x < x1:
+            spots = sorted(((dx, dy) for dx in range(-reach, reach + 1) for dy in range(-reach, reach + 1)),
+                           key=lambda d: d[0] * d[0] + d[1] * d[1])
+            for dx, dy in spots:
+                v = (round(x + dx * STITCH_SEARCH, 3), round(y + dy * STITCH_SEARCH, 3))
+                if free(*v) and router._via_fits(net, v):
+                    items = rb.add(net, [], [v])
+                    rb.commit(net, items)
+                    vias.append(v)
+                    added.append(v)
+                    break
+            x += pitch
+        y += pitch
+    return {"added": len(added), "pitch_mm": pitch, "via": [vd, rb.widths(net)[2]]}
diff --git a/python/commands/powerlab_router/router.py b/python/commands/powerlab_router/router.py
new file mode 100644
index 0000000..dbb248f
--- /dev/null
+++ b/python/commands/powerlab_router/router.py
@@ -0,0 +1,1323 @@
+"""The PowerLab router's main loop (plan §4.2-4.6).
+
+Connections are the edges of a minimum spanning tree over each net's pads. Groups are
+routed in the lab order; inside a group the shortest connection goes next (or the most
+constrained, with order="constrained": fewest free entry lanes, then fine pitch).
+
+Each connection: search, exact check, and on a clearance error a retry with 0.05 mm and
+then 0.1 mm extra margin. Accepted copper is stamped into the grids.
+
+When a connection finds no way, it may rip up (plan §4.6): it searches again with the
+router's copper of the same or later groups passable at a cost, rips up the connections
+that copper belongs to, takes the way, and the ripped connections queue again. Copper of
+earlier groups, locked copper and the board's own copper are never ripped up. Cells
+fought over get a growing "history" cost, so the same fight doesn't repeat (PathFinder).
+Each connection is ripped up at most MAX_RIPPED times and rips others up at most
+MAX_RIPS times, within an overall budget.
+"""
+
+import math
+import time
+
+import numpy as np
+import pcbnew
+
+from commands.powerlab_router.costs import HUG, LabCosts, labels, pieces
+from commands.powerlab_router.groups import GROUPS, classify, is_clock
+from commands.powerlab_router.model import FINE_PITCH, MM, USED_LANE, RouterBoard, _grown, _polys, is_round
+from commands.powerlab_router import bus as river
+from commands.powerlab_router.patterns import DIRS, bends, shapes
+from commands.powerlab_router.search import Costs
+
+T = pcbnew.ToMM
+RETRY_MARGINS = (0.05, 0.1)
+NEAR = 3.0  # mm: lane counts are refreshed for pads this close to new copper
+SOFT = 10  # penalty units (Costs.unit mm) per cell of copper that would be ripped up
+HISTORY = 4  # penalty units added per rip-up to the cells fought over
+CUT = 60  # penalty units on cells where a track cut a pour in pieces
+POUR_PIECE_MM2 = 2.0  # pour pieces smaller than this don't count
+REPAIR_ROUNDS = 3  # passes of the pour repair after routing
+BEND = 1.5  # mm: what a bend costs a hand-drawn shape (few long segments, like hand routing)
+SHORT = 1.5  # mm extra for a segment shorter than SHORT_MM (a jog or a hook)
+SHORT_MM = 0.5
+SHAPE_TRIES = 40  # grid-free shapes scored per run, cheapest first
+BUS_MIN = 3  # connections between two parts that make a bus
+DRAW_VIA_FACTOR = 1.0  # times Costs.via, for each via of a whole-connection shape
+STRAIGHT_OFFSET = 0.6  # mm: pads at most this far off one line may get one straight track
+BEND_PER_VIA = 2  # a via counts as this many corners when bus plans are compared
+VIA_COLUMN_EXTRA = (0.0, 0.5, 1.0, 1.5)  # mm beyond the closest via column that are tried
+POUR_BLOCK = 1  # the pour grid already keeps the zone's minimum width
+IMPROVE_DETOUR = 1.6  # a track this many times its straight distance gets a second look
+IMPROVE_BENDS = 6  # so does one with more corners than this
+IMPROVE_MAX = 15  # tracks looked at again, the worst first
+CONNECTION_SECONDS = 90.0  # one connection's searches give up after this (a hard way round takes ~50 s)
+MAX_RIPPED = 3
+MAX_RIPS = 3
+BUDGET = 2  # rip-ups per connection overall
+
+
+def _xy(item):
+    p = item.GetPosition()
+    return (T(p.x), T(p.y))
+
+
+def _name(pad):
+    return f"{pad.GetParentFootprint().GetReference()}.{pad.GetNumber()}"
+
+
+def _uuid(item):
+    return item.m_Uuid.AsString()
+
+
+class Connection:
+    def __init__(self, net, a, b, group):
+        self.net, self.a, self.b, self.group = net, a, b, group
+        self.length = math.dist(_xy(a), _xy(b))
+        self.fine = any(_fine(p) for p in (a, b))
+        self.lanes = None  # fewest free lanes at either end, from the grid
+        self.items = []  # its copper on the board
+        self.geo = None  # its geometry: ([(layer index, points)], [vias])
+        self.ripped = 0  # times its copper was ripped up
+        self.rips = 0  # times it ripped others up
+        self.reason = None
+        self.bus, self.bus_size, self.bus_rank = None, 0, 0  # see Router._buses
+        self.tee = None  # the connection whose track this one ends on (a T-junction), if any
+
+    def name(self):
+        return f"{_name(self.a)}-{_name(self.b)}"
+
+
+def _fine(pad):
+    c = _xy(pad)
+    me = _uuid(pad)
+    return any(_uuid(p) != me and 1e-3 < math.dist(c, _xy(p)) < FINE_PITCH
+               for p in pad.GetParentFootprint().Pads())
+
+
+def _direction(p, q):
+    """Index (0-7, 45 degrees apart) of the direction from p to q."""
+    return int(round(math.degrees(math.atan2(q[1] - p[1], q[0] - p[0])) / 45.0)) % 8
+
+
+def _mst(pads):
+    pts = [_xy(p) for p in pads]
+    inside, edges = {0}, []
+    while len(inside) < len(pads):
+        d, i, j = min((math.dist(pts[i], pts[j]), i, j) for i in inside for j in range(len(pads)) if j not in inside)
+        edges.append((i, j))
+        inside.add(j)
+    return edges
+
+
+class Router:
+    def __init__(self, board, pitch=0.1, pour_nets=("GND",), costs=None, rules=None, groups=None,
+                 order="bus", ripup=True, finish=True, step_in=True, draw=True, layers=None,
+                 time_limit=None, connection_limit=CONNECTION_SECONDS):
+        """`layers`: copper layer names to route on (default: all but inner planes).
+        `time_limit`: seconds for routing the connections; when it runs out, the ones left
+        are reported as left ("time limit") and the run goes on to finish what it has, so a
+        board that is too hard still comes back with its routed part to finish by hand.
+        `connection_limit`: seconds one connection may take with its retries; after that it
+        doesn't rip anything up and is left."""
+        self.step_in, self.draw = step_in, draw
+        self.order, self.ripup, self.finish = order, ripup, finish
+        self.time_limit, self.connection_limit = time_limit, connection_limit
+        self.rb = RouterBoard(board, pitch=pitch, pour_nets=pour_nets, rules=rules, layers=layers)
+        self.costs = costs or Costs(layer_factor={1: 1.2} if len(self.rb.layers) == 2 else None)
+        self.group_overrides = groups or {}
+
+    def is_power(self, net):
+        """Whether the net is in the power group (Power/GND/HV class, +*, VBUS*...)."""
+        return classify([net], lambda n: self.rb.netclass(n).GetName(), self.group_overrides)[net] == 0
+
+    def connections(self, nets):
+        rb = self.rb
+        group = classify(nets, lambda n: rb.netclass(n).GetName(), self.group_overrides)
+        out = []
+        for net in nets:
+            pads = [p for p in rb.pads if p.GetNetname() == net]
+            if len(pads) >= 2:
+                out += [Connection(net, pads[i], pads[j], group[net]) for i, j in _mst(pads)]
+        return out
+
+    def _buses(self, conns):
+        """Connections between the same two parts (BUS_MIN or more, in one group) are a bus:
+        routed together, one after the other in the order of their pins along the row, as
+        a person routes a fan-out from a module to a header. Routed apart, unrelated
+        connections take the channel first and the later pins have to dodge."""
+        sets = {}
+        for c in conns:
+            parts = tuple(sorted((c.a.GetParentFootprint().GetReference(), c.b.GetParentFootprint().GetReference())))
+            if parts[0] != parts[1]:
+                sets.setdefault((c.group, parts), []).append(c)
+        for (group, parts), members in sets.items():
+            if len(members) < BUS_MIN:
+                continue
+            ref = parts[0]
+            pins = [_xy(c.a if c.a.GetParentFootprint().GetReference() == ref else c.b) for c in members]
+            xs, ys = [p[0] for p in pins], [p[1] for p in pins]
+            axis = 0 if max(xs) - min(xs) >= max(ys) - min(ys) else 1
+            for rank, (c, _p) in enumerate(sorted(zip(members, pins), key=lambda m: m[1][axis])):
+                c.bus, c.bus_size, c.bus_rank = "-".join(parts), len(members), rank
+
+    def _river_all(self, conns):
+        """Route each bus between two parallel pin rows the way it is drawn by hand; returns
+        the connections it placed:
+        1. as a river on the layer both rows share (bus.py), each track in the first free
+           slot of the channel, a pitch beside the one before;
+        2. the rest, when the near row is on one layer and the far row on both: a short
+           stub from each pin to an escape via, the vias in one column beside the pin row,
+           then a river on the other layer from the via column into the far row.
+        The planner has a few real choices (step-in or not, which side and how far out the
+        via column goes). Each is placed, the pours measured, and taken out again; the one
+        that leaves the pours most whole wins, then the one that places most. A pin row is
+        itself a wall to a pour (its gaps are too narrow to fill), so a bus placed without
+        looking can close the last way round a part. What doesn't fit goes to the search."""
+        placed = []
+        buses = {}
+        for c in conns:
+            if c.bus:
+                buses.setdefault(c.bus, []).append(c)
+        for _name, members in sorted(buses.items(), key=lambda kv: -len(kv[1])):
+            options = self._bus_options(members)
+            if not options:
+                continue
+            best, best_key = None, None
+            for opt in options:
+                done = self._place_option(members, opt)
+                # pours first, then how many it places; then, like a person, the plan with
+                # fewer corners and vias (the step-in jogs cost area and look worse)
+                drawn = sum(bends(pts) for c in done for _L, pts in c.geo[0]) + \
+                    BEND_PER_VIA * sum(len(c.geo[1]) for c in done)
+                key = (self._pour_quality() if self.pour_net else (0, 0), -len(done), drawn)
+                for c in done:
+                    self._unroute(c)
+                if best_key is None or key < best_key:
+                    best, best_key = opt, key
+            placed += self._place_option(members, best)
+        self._q = None
+        return placed
+
+    def _bus_options(self, members):
+        """Candidate plans for a bus: [(step_in, top shapes, bottom shapes, vias, layers)]."""
+        rb = self.rb
+        ends = [self._near_far(c) for c in members]
+        shared = [L for L in rb.layers if all(a.IsOnLayer(L) and b.IsOnLayer(L) for a, b in ends)]
+        if not shared:
+            return []
+        L = shared[0]
+        key = rb.key(members[0].net)
+        w, vd = key[1], key[2]
+        pitch = w + max(rb.clearance_to(o, key, "Track", L) for c in members for o in (c.a, c.b))
+        pairs = [(_xy(a), _xy(b)) for a, b in ends]
+        axis = self._row_axis([p[0] for p in pairs])
+        a_pads, b_pads = [a for a, _b in ends], [b for _a, b in ends]
+        edge_a = self._row_edge(a_pads, axis, key, L, w)
+        edge_b = self._row_edge(b_pads, axis, key, L, w)
+        others = [M for M in rb.layers if M != L and all(b.IsOnLayer(M) for _a, b in ends)]
+        one_layer = not any(len([M for M in rb.layers if a.IsOnLayer(M)]) > 1 for a in a_pads)
+        n = self._toward(pairs, axis)  # unit vector from the near row to the far row
+        options = []
+        for step_in in ((True, False) if self.step_in else (False,)):
+            top = river.plan(pairs, pitch, edge_a, edge_b, clear=self._clear_on(members, L, w),
+                             round_b=all(is_round(b, L) for b in b_pads), step_in=step_in)
+            options.append((step_in, top, {}, {}, (L, None)))
+            rest = [i for i in range(len(members)) if i not in top]
+            if len(rest) < 2 or not others or not one_layer:
+                continue
+            M = others[0]
+            # the via column beyond the pins or on the channel side, at a few distances: a
+            # column further out leaves more room for the bundle on the other layer
+            for side, extra in [(s, x) for s in (-1.0, 1.0) for x in VIA_COLUMN_EXTRA]:
+                vias, ok = {}, []
+                for i in rest:
+                    a, _b = ends[i]
+                    off = self._half_across(a, axis) + 0.25 + vd / 2 + 0.05 + extra  # ring 0.25 mm off the pad (§3.5)
+                    v = (_xy(a)[0] + side * n[0] * off, _xy(a)[1] + side * n[1] * off)
+                    if rb.clear(members[i].net, L, _xy(a), v, w) and self._via_fits(members[i].net, v):
+                        vias[i] = v
+                        ok.append(i)
+                if len(ok) < 2:
+                    continue
+                sub = [(vias[i], _xy(ends[i][1])) for i in ok]
+                edge_v = vd / 2 + max(rb.clearance_to(o, key, "Via", M) for c in members for o in (c.a, c.b)) + w / 2
+                plan = river.plan(sub, pitch, edge_v, self._row_edge(b_pads, axis, key, M, w),
+                                  clear=self._clear_on([members[i] for i in ok], M, w),
+                                  round_b=all(is_round(b, M) for b in b_pads), step_in=step_in)
+                bottom = {ok[j]: pts for j, pts in plan.items()}
+                if bottom:
+                    options.append((step_in, top, bottom, {i: vias[i] for i in bottom}, (L, M)))
+        return options
+
+    def _place_option(self, members, opt):
+        rb = self.rb
+        _step, top, bottom, vias, (L, M) = opt
+        ends = [self._near_far(c) for c in members]
+        done = self._place(members, top, lambda i, pts: ([(rb.layers.index(L), pts)], []))
+        if bottom:
+            done += self._place(members, bottom, lambda i, pts: (
+                [(rb.layers.index(L), [_xy(ends[i][0]), vias[i]]), (rb.layers.index(M), pts)], [vias[i]]))
+        self._q = None
+        return done
+
+    def _near_far(self, c):
+        """(near pad, far pad): the near one on the part with pads on one layer only (the
+        module side of a module-to-header bus), so escape vias go beside it."""
+        one = lambda p: len([L for L in self.rb.layers if p.IsOnLayer(L)]) == 1
+        return (c.a, c.b) if one(c.a) or not one(c.b) else (c.b, c.a)
+
+    @staticmethod
+    def _row_axis(points):
+        xs, ys = [p[0] for p in points], [p[1] for p in points]
+        return 1 if (max(ys) - min(ys)) >= (max(xs) - min(xs)) else 0  # 1: rows along y
+
+    @staticmethod
+    def _toward(pairs, axis):
+        across = 0 if axis == 1 else 1
+        d = sum(b[across] - a[across] for a, b in pairs)
+        u = [0.0, 0.0]
+        u[across] = 1.0 if d > 0 else -1.0
+        return tuple(u)
+
+    @staticmethod
+    def _half_across(pad, axis):
+        bb = pad.GetBoundingBox()
+        return T(bb.GetWidth() if axis == 1 else bb.GetHeight()) / 2
+
+    def _row_edge(self, pads, axis, key, L, w):
+        """How far a track centre stays from a row's centre line while it runs or bends in
+        the channel: off the pads (the widest pad's half width across the row plus half a
+        track). The exact clearance check decides the rest: a 45 degree bend may start just
+        past a pad's edge when it heads away from the neighbouring pad, as by hand."""
+        return max(self._half_across(p, axis) for p in pads) + w / 2 + 0.05
+
+    def _clear_on(self, members, L, w):
+        """clear(index, points) for bus.plan: the shape keeps its clearance on layer L and
+        stays out of the rule areas (the exact clearance check doesn't see them)."""
+        rb = self.rb
+        li = rb.layers.index(L)
+
+        def clear(i, pts):  # the grid's keepouts first: much cheaper than the exact check
+            return (self._outside_keepouts(pts, li, w, rb.key(members[i].net)[2])
+                    and all(rb.clear(members[i].net, L, p, q, w) for p, q in zip(pts, pts[1:])))
+        return clear
+
+    def _via_fits(self, net, v):
+        rb = self.rb
+        vd = rb.key(net)[2]
+        if ("via", vd) not in self._keep:  # rule areas that keep vias out, per layer
+            self._keep[("via", vd)] = rb.keepouts(vd, vd)[1]
+        i, j = rb.grid.cell(*v)
+        if not (0 <= i < rb.grid.nx and 0 <= j < rb.grid.ny) or any(m[j, i] for m in self._keep[("via", vd)]):
+            return False
+        items = rb.add(net, [], [v])
+        bad = rb.violations(net, items)
+        rb.remove(items)
+        return not bad
+
+    def _place(self, members, shapes_, geo_of):
+        rb = self.rb
+        done = []
+        for i in sorted(shapes_, key=lambda i: members[i].bus_rank):
+            c = members[i]
+            geo = geo_of(i, shapes_[i])
+            items = rb.add(c.net, *geo)
+            if rb.violations(c.net, items):
+                rb.remove(items)
+                continue
+            rb.commit(c.net, items)
+            c.items, c.geo = items, geo
+            for it in items:
+                self.owner[_uuid(it)] = c
+            done.append(c)
+        return done
+
+    def _lanes(self, conn, cache):
+        if conn.net not in cache:
+            cache[conn.net] = self.rb.obstacles(conn.net)[0]
+        blocked = cache[conn.net]
+        return min(len(self.rb.lanes(p, blocked, conn.net, exact=False)) for p in (conn.a, conn.b))
+
+    def _penalty(self, conn, blocked, soft=None, pour=True):
+        """The lab costs, the history, and SOFT where copper would be ripped up. With
+        pour=False without the pour's hug and sliver costs (the finishing pass checks the
+        pour on KiCad's fill instead)."""
+        clocks = {c.net for c in self.owner.values() if is_clock(c.net)}
+        clock_items = [it for c in set(self.owner.values()) if c.net in clocks for it in c.items]
+        return self.lab.penalty(conn, blocked, self.hist, soft, SOFT, clocks | ({conn.net} if is_clock(conn.net) else set()),
+                                clock_items, pour=pour)
+
+    @staticmethod
+    def _free_end(conn, point):
+        """Whether the track end at `point` (a pad centre of conn) may leave its lane: any
+        pad that isn't fine pitch may be entered at 45 degrees (finish.py)."""
+        for pad in (conn.a, conn.b):
+            if math.dist(_xy(pad), point) < 1e-3:
+                return not _fine(pad)
+        return False
+
+    def _via_costs(self, conn):
+        return lambda lanes: self.lab.via_costs(conn, lanes, self.costs.via)
+
+    def run(self, nets, log=None):
+        rb = self.rb
+        t_start = time.perf_counter()  # time.time() ticks every ~15 ms on Windows
+        conns = self.connections(nets)
+        pending = list(conns)
+        g = rb.grid
+        self.hist = [np.zeros((g.ny, g.nx), np.uint8) for _ in rb.layers]  # rip-ups add to it
+        self.lab = LabCosts(self)
+        self._keep = {}  # (width, via) -> keepout masks per layer
+        self.tidy_stats = {"runs": 0, "replaced": 0, "no_cheaper_shape": 0, "all_blocked": 0, "dearer_or_not_clear": 0}
+        self._q = None
+        self._pour_setup()
+        self.owner = {}  # copper uuid -> connection
+        totals = {"nodes": 0, "search_s": 0.0, "retries": 0, "exact_left": 0, "ripups": 0, "ripped": 0}
+        budget = BUDGET * len(conns)
+        cache = {}
+        if self.order == "constrained":
+            for c in pending:
+                c.lanes = self._lanes(c, cache)
+        self._buses(conns)
+        for c in self._river_all(conns):
+            pending.remove(c)
+            if log:
+                log({"net": c.net, "connection": c.name(), "group": c.group, "ok": True,
+                     "event": f"routed as part of the bus {c.bus}"})
+        timed_out = 0
+        while pending:
+            if self.time_limit and time.perf_counter() - t_start > self.time_limit:
+                for c in pending:
+                    c.reason = "time limit"
+                timed_out = len(pending)
+                if log:
+                    log({"phase": "routing", "event": f"time limit: {timed_out} connections left for hand routing"})
+                break
+            group = min(c.group for c in pending)
+            here = [c for c in pending if c.group == group]
+            if self.order == "constrained":
+                conn = min(here, key=lambda c: (c.lanes, not c.fine, c.length))
+            elif self.order == "bus":
+                # buses first, the biggest first, each in its pin-row order; then the rest by length
+                conn = min(here, key=lambda c: (c.bus is None, -c.bus_size, c.bus or "", c.bus_rank, c.length))
+            else:
+                conn = min(here, key=lambda c: c.length)
+            pending.remove(conn)
+            rb.deadline = time.time() + self.connection_limit if self.connection_limit else None
+            ok, info = self._route_whole(conn, totals)
+            event = "routed" if ok else info.get("fail", "no path")
+            if info.get("pour"):
+                event += f" ({info['pour']})"
+            victims = []
+            if not ok and rb.past_deadline():
+                event += f"; no rip-up (over {self.connection_limit:g} s)"
+                totals["slow"] = totals.get("slow", 0) + 1
+            elif not ok and self.ripup and conn.rips < MAX_RIPS and totals["ripups"] < budget:
+                victims, why, routed = self._rip_up(conn, totals)
+                if routed:
+                    ok, event = True, "routed (way found by the rip-up search, nothing in it)"
+                elif not victims:
+                    event += f"; no rip-up ({why})"
+                if victims:
+                    ok, info2 = self._route_whole(conn, totals)
+                    event = f"ripped up {len(victims)}: " + ", ".join(v.name() for v in victims) + \
+                            ("; routed" if ok else "; " + info2.get("fail", "no path"))
+                    pending += victims
+            rb.deadline = None
+            conn.reason = None if ok else info.get("fail", "no path")
+            if log:
+                log({"net": conn.net, "connection": conn.name(), "group": conn.group, "ok": ok, "event": event,
+                     "nodes": info.get("nodes"), "seconds": info.get("seconds")})
+            if ok and self.order == "constrained":
+                xs = [x for it in conn.items for x in (T(it.GetStart().x), T(it.GetEnd().x))]
+                ys = [y for it in conn.items for y in (T(it.GetStart().y), T(it.GetEnd().y))]
+                cache = {}
+                for c in pending:
+                    if any(min(xs) - NEAR <= x <= max(xs) + NEAR and min(ys) - NEAR <= y <= max(ys) + NEAR
+                           for x, y in (_xy(c.a), _xy(c.b))):
+                        c.lanes = self._lanes(c, cache)
+        if log:
+            log({"phase": "keeping the pours whole"})
+        repair = self._repair_pours(totals, log) if self.pour_net else None
+        finish = improve = None
+        if self.finish:
+            from commands.powerlab_router.finish import shortcut
+            t0 = time.time()
+            if log:
+                log({"phase": "straightening"})
+            finish = shortcut(self, [c for c in conns if c.items])
+            if log:
+                log({"phase": "second look at detours"})
+            improve = self._improve(conns, totals, log)
+            if improve["moved"]:
+                shortcut(self, improve.pop("changed"))
+            improve.pop("changed", None)
+            finish["seconds"] = round(time.time() - t0, 1)
+        merged = self._merge_overlaps(nets)
+        by_group = {}
+        for c in conns:
+            gr = by_group.setdefault(GROUPS[c.group], {"routed": 0, "left": 0})
+            gr["routed" if c.items else "left"] += 1
+        return {
+            "connections": len(conns),
+            "routed": sum(1 for c in conns if c.items),
+            "left": [{"net": c.net, "connection": c.name(), "reason": c.reason or "ripped up, not rerouted"}
+                     for c in conns if not c.items],
+            "groups": by_group,
+            "seconds": round(time.perf_counter() - t_start, 1),
+            "layers": [rb.layer_names[L] for L in rb.layers],
+            "time_limit_left": timed_out,
+            "over_connection_limit": totals.get("slow", 0),
+            "search_seconds": round(totals["search_s"], 1),
+            "nodes": totals["nodes"],
+            "retries": totals["retries"],
+            "drawn_whole": totals.get("drawn", 0),
+            "ripups": totals["ripups"],
+            "pour_cuts_kept": totals.get("pour_cuts", 0),
+            "connections_ripped": totals["ripped"],
+            "exact_violations_left": totals["exact_left"],
+            "pour_repair": repair,
+            "shapes": dict(self.tidy_stats),
+            "finish": finish,
+            "second_look": improve,
+            "overlaps_merged": merged,
+            "t_junctions": sum(1 for c in conns if c.items and c.tee is not None),
+            "rules_not_understood": rb.rules.unsupported,
+            "connections_list": conns,
+        }
+
+    # --- a second look, and overlaps ----------------------------------------------------------
+    def _shape_score(self, c):
+        """Length, BEND per corner and the via cost per via: what a person would call a
+        worse track (a detour, a loop round something, extra corners)."""
+        pieces, vias = c.geo
+        return sum(math.dist(p, q) for _L, pts in pieces for p, q in zip(pts, pts[1:])) + \
+            BEND * sum(bends(pts) for _L, pts in pieces) + self.costs.via * len(vias)
+
+    def _improve(self, conns, totals, log=None):
+        """Route the worst tracks again on the finished board: those that go a long way
+        round (IMPROVE_DETOUR times the straight distance) or bend often. Copper routed
+        after them may leave a better way now, e.g. no U-turn round a via. The new track is
+        kept only if it scores better (_shape_score) and leaves the pour as whole."""
+        def octilinear(c):
+            (x0, y0), (x1, y1) = _xy(c.a), _xy(c.b)
+            dx, dy = abs(x1 - x0), abs(y1 - y0)
+            return max(dx, dy) + (math.sqrt(2) - 1) * min(dx, dy)
+        worst = []
+        for c in conns:
+            if not c.items or c.bus or any(d.tee is c and d.items for d in conns):
+                continue
+            length = sum(math.dist(p, q) for _L, pts in c.geo[0] for p, q in zip(pts, pts[1:]))
+            detour = length / max(octilinear(c), 0.5)
+            turns = sum(bends(pts) for _L, pts in c.geo[0])
+            if (detour > IMPROVE_DETOUR and length > 3.0) or turns > IMPROVE_BENDS:
+                worst.append((detour + 0.1 * turns, c))
+        moved, changed = 0, []
+        for _bad, c in sorted(worst, key=lambda w: -w[0])[:IMPROVE_MAX]:
+            before_q = self._pour_quality() if self.pour_net else None
+            old_geo, old_tee, old = c.geo, c.tee, self._shape_score(c)
+            self._unroute(c)
+            ok, _info = self._attempt(c, totals)
+            if ok and self._shape_score(c) < old - 0.5 and (before_q is None or self._pour_quality() <= before_q):
+                moved += 1
+                changed.append(c)
+                if log:
+                    log({"net": c.net, "connection": c.name(), "group": c.group, "ok": True,
+                         "event": f"routed again: score {old:.1f} -> {self._shape_score(c):.1f}"})
+                continue
+            if c.items:
+                self._unroute(c)
+            self._restore(c, old_geo)
+            c.tee = old_tee
+        return {"looked_at": min(len(worst), IMPROVE_MAX), "moved": moved, "changed": changed}
+
+    def _merge_overlaps(self, nets):
+        """Tracks of one net lying on each other on one layer (two tracks leaving a pad by
+        the same lane, a track drawn twice) become one: collinear overlapping segments are
+        merged into their union. Only the router's own copper is touched."""
+        rb = self.rb
+        nets = set(nets)
+        groups = {}
+        for t in rb.board.GetTracks():
+            if t.Type() != pcbnew.PCB_TRACE_T or t.GetNetname() not in nets or _uuid(t) not in rb.router_items:
+                continue
+            a, b = (T(t.GetStart().x), T(t.GetStart().y)), (T(t.GetEnd().x), T(t.GetEnd().y))
+            length = math.dist(a, b)
+            if length < 1e-4:
+                continue
+            ux, uy = (b[0] - a[0]) / length, (b[1] - a[1]) / length
+            if ux < -1e-9 or (abs(ux) < 1e-9 and uy < 0):
+                ux, uy = -ux, -uy
+            offset = round(-uy * a[0] + ux * a[1], 3)  # the line's distance from the origin
+            key = (t.GetNetname(), t.GetLayer(), round(ux, 4), round(uy, 4), offset)
+            (s0, p0), (s1, p1) = sorted(((ux * a[0] + uy * a[1], pcbnew.VECTOR2I(t.GetStart())),
+                                         (ux * b[0] + uy * b[1], pcbnew.VECTOR2I(t.GetEnd()))), key=lambda e: e[0])
+            groups.setdefault(key, []).append((s0, s1, t, p0, p1))
+        merged = 0
+        for (net, layer, ux, uy, offset), segs in groups.items():
+            if len(segs) < 2:
+                continue
+            segs.sort(key=lambda s: s[0])
+            runs, cur = [], [segs[0]]
+            for s in segs[1:]:
+                if s[0] < max(x[1] for x in cur) - 1e-4:  # overlaps (touching end to end is fine)
+                    cur.append(s)
+                else:
+                    runs.append(cur)
+                    cur = [s]
+            runs.append(cur)
+            for run in runs:
+                if len(run) < 2:
+                    continue
+                first = min(run, key=lambda s: s[0])
+                last = max(run, key=lambda s: s[1])
+                keep = max(run, key=lambda s: s[1] - s[0])[2]
+                start, end = pcbnew.VECTOR2I(first[3]), pcbnew.VECTOR2I(last[4])  # exact ends, not rebuilt
+                keep.SetStart(start)
+                keep.SetEnd(end)
+                keep.SetWidth(max(s[2].GetWidth() for s in run))
+                for s in run:
+                    if s[2] is not keep:
+                        rb.router_items.discard(_uuid(s[2]))
+                        rb.board.Delete(s[2])
+                        merged += 1
+        if merged:
+            rb._others = {}
+        return merged
+
+    # --- pours kept whole (§3.3) -----------------------------------------------------------
+    def _pour_setup(self):
+        """Where the pour nets' pours could fill: the inside of their zone outlines, less
+        what other nets' copper keeps them from (the pour net's own grid, kept up to date)."""
+        rb = self.rb
+        zones = [z for z in rb.board.Zones() if not z.GetIsRuleArea() and z.GetNetname() in rb.pour_nets]
+        self.pour_net = zones[0].GetNetname() if zones else None
+        self.pour_area = []
+        for L in rb.layers:
+            polys = []
+            for z in zones:
+                if z.IsOnLayer(L):
+                    polys += _polys(z.Outline())
+            self.pour_area.append(rb.grid.raster(polys) if polys else None)
+        self.min_piece = int(POUR_PIECE_MM2 / rb.grid.pitch ** 2)
+        if self.pour_net:
+            # where the pour can be: a strip of the zone's minimum width, at the zone's
+            # clearance from other copper (not where a pour-net track would fit)
+            z = zones[0]
+            _cls, _w, vd, name = rb.key(self.pour_net)
+            self.pour_key = (rb.netclass(self.pour_net).GetName(), round(T(z.GetMinThickness()), 4), vd, name)
+            rb.occupancy(self.pour_key)  # built now, so commits keep it current
+        self.pour_breaks = self._pour_breaks(zones)
+        self.pour_zones = zones
+
+    def _pour_free(self, i):
+        g = self.rb.grid
+        blocked = self.rb.occupancy(self.pour_key).blocked(self.pour_net)[0]
+        hard = np.frombuffer(blocked[i], np.uint8).reshape((g.ny, g.nx)).astype(bool)
+        return self.pour_area[i] & ~hard & ~self.pour_breaks[i]
+
+    def _pour_breaks(self, zones):
+        """Per layer, the pour-net pads the pour can't flow across. A pad that joins the pour
+        with thermal reliefs (or not at all) is a hole in KiCad's fill, grown by the thermal
+        gap; the pour reaches it only through spokes, so pieces that meet only at such a pad
+        are separate polygons. A pad that joins solid is part of the pour. The connection
+        comes from the pad, then its footprint, then the custom rules (zone_connection),
+        then the zone."""
+        rb = self.rb
+        g = rb.grid
+        out = []
+        names = {pcbnew.ZONE_CONNECTION_FULL: "solid", pcbnew.ZONE_CONNECTION_THERMAL: "thermal_reliefs",
+                 pcbnew.ZONE_CONNECTION_NONE: "none"}
+        for L in rb.layers:
+            polys = []
+            for z in zones:
+                if not z.IsOnLayer(L):
+                    continue
+                for pad in rb.pads:
+                    if pad.GetNetname() != z.GetNetname() or not pad.IsOnLayer(L):
+                        continue
+                    how = self._connection(pad, z, L, names)
+                    if how == "solid":
+                        continue
+                    gap = T(pad.GetLocalThermalGapOverride() or 0) if how == "thermal_reliefs" else 0.0
+                    gap = gap or T(z.GetThermalReliefGap())
+                    if how == "none":
+                        gap = max(gap, T(z.GetLocalClearance() or 0) if hasattr(z, "GetLocalClearance") else 0.0)
+                    polys += _polys(_grown(pad, L, gap))
+            out.append(g.raster(polys) if polys else np.zeros((g.ny, g.nx), bool))
+        return out
+
+    def _connection(self, pad, zone, L, names):
+        inherited = pcbnew.ZONE_CONNECTION_INHERITED
+        own = pad.GetLocalZoneConnection()
+        if own == inherited:
+            own = pad.GetParentFootprint().GetLocalZoneConnection()
+        if own != inherited and own in names:
+            return names[own]
+        rule = self.rb.rules.zone_connection(self.rb.props(pad), self.rb.props(zone), self.rb.layer_names[L])
+        if rule:
+            return rule
+        z = zone.GetPadConnection()
+        if z == pcbnew.ZONE_CONNECTION_THT_THERMAL:
+            return "thermal_reliefs" if pad.GetAttribute() == pcbnew.PAD_ATTRIB_PTH else "solid"
+        return names.get(z, "thermal_reliefs")
+
+    def _route_whole(self, conn, totals):
+        """Route `conn`; if it cuts a pour into more pieces, try once more with the cut cells
+        expensive, and keep whichever leaves the pour in fewer pieces."""
+        if not self.pour_net:
+            return self._attempt(conn, totals)
+        before = self._pour_quality()
+        ok, info = self._attempt(conn, totals)
+        if not ok:
+            return ok, info
+        first_q = self._pour_quality()
+        if first_q <= before:
+            return ok, info
+        first, first_tee = conn.geo, conn.tee
+        self._unroute(conn)
+        self._add_history(self._shadow(first), layers=self._pour_layers(), amount=CUT)
+        ok2, info2 = self._attempt(conn, totals)
+        if ok2:
+            q = self._pour_quality()
+            if q < first_q:
+                info2["pour"] = "rerouted so the pour stays whole" if q <= before else "rerouted, pour still cut"
+                return True, info2
+            self._unroute(conn)
+        totals["pour_cuts"] = totals.get("pour_cuts", 0) + 1
+        self._restore(conn, first)  # nothing else moved meanwhile, so it fits
+        conn.tee = first_tee
+        info["pour"] = "cuts the pour, no better way"
+        return True, info
+
+    def _pour_quality(self):
+        """Smaller is better: (minus the summed share of each pour layer's largest piece,
+        rounded to 0.02 so a sliver doesn't count, then the number of pieces of 2 mm2 or
+        more). Measured on KiCad's own fill of the pour zones (about 0.1 s on TestPCB): a
+        grid estimate can't tell whether a neck right at the pour's minimum width fills,
+        and KiCad's fill also leaves thermal pads as holes. Cached until the copper
+        changes."""
+        if self._q is not None:
+            return self._q
+        if not self.pour_zones:
+            self._q = (0.0, 0)
+            return self._q
+        pcbnew.ZONE_FILLER(self.rb.board).Fill(self.pour_zones)
+        count, share = 0, 0.0
+        for z in self.pour_zones:
+            for L in z.GetLayerSet().CuStack():
+                if L not in self.rb.layers:
+                    continue
+                f = z.GetFilledPolysList(L)
+                areas = [f.Outline(i).Area() / 1e12 for i in range(f.OutlineCount())]
+                big = [a for a in areas if a >= POUR_PIECE_MM2]
+                count += len(big)
+                share += max(areas) / sum(areas) if areas else 1.0
+        self._q = (-round(share / 0.02) * 0.02, count)
+        return self._q
+
+    def _repair_pours(self, totals, log=None):
+        """After routing, break the walls that cut a pour into pieces. A wall is usually
+        several tracks, so taking out one at a time joins nothing: take out every connection
+        whose copper on that layer touches two of its pieces, check that the pour joins,
+        then put them back one by one. One that splits the pour again is routed again with
+        its old cells expensive. All or nothing per wall: if a connection would be lost or
+        the pour doesn't come out better, the wall goes back exactly as it was."""
+        start = self._pour_quality()
+        moved = tried = 0
+        for _round in range(REPAIR_ROUNDS):
+            better = False
+            for i in self._pour_layers():
+                wall = self._wall(i)
+                if not wall:
+                    continue
+                before = self._pour_quality()
+                # with the tracks that end on the wall's tracks; they go back after them
+                wall = self._dependents(wall)
+                snapshot = {c: c.geo for c in wall}
+                tees = {c: c.tee for c in wall}
+                for c in wall:
+                    self._unroute(c)
+                if self._pour_quality() >= before:  # not this wall
+                    for c in wall:
+                        self._restore(c, snapshot[c])
+                    continue
+                changed = []
+                for c in sorted(wall, key=lambda c: (self._depth(c), c.length)):
+                    now = self._pour_quality()
+                    parent = tees[c]
+                    # a track that ended on a moved track can't go back where it was
+                    if parent is not None and (parent.geo is not snapshot.get(parent, parent.geo) or not parent.items):
+                        pass
+                    elif self._restore(c, snapshot[c], check=True) and self._pour_quality() <= now:
+                        c.tee = parent
+                        continue
+                    if c.items:
+                        self._unroute(c)
+                    tried += 1
+                    self._add_history(self._shadow(snapshot[c]), layers=[i], amount=CUT)
+                    ok, _info = self._attempt(c, totals)
+                    if ok:
+                        changed.append(c)
+                    elif (parent is None or (parent.items and parent.geo is snapshot.get(parent, parent.geo))) \
+                            and self._restore(c, snapshot[c], check=True):
+                        c.tee = parent
+                lost = [c for c in wall if not c.items]
+                if lost or self._pour_quality() >= before:
+                    for c in wall:  # back exactly as it was
+                        if c.items:
+                            self._unroute(c)
+                    for c in wall:
+                        self._restore(c, snapshot[c])
+                        c.tee = tees[c]
+                    continue
+                moved += len(changed)
+                better = True
+                if log:
+                    for c in changed:
+                        log({"net": c.net, "connection": c.name(), "group": c.group, "ok": True,
+                             "event": "rerouted to keep the pour whole"})
+            if not better:
+                break
+        return {"before": start, "after": self._pour_quality(), "connections_tried": tried,
+                "connections_moved": moved}
+
+    def _wall(self, i):
+        """Connections whose copper on pour layer i touches two or more big pour pieces."""
+        rb = self.rb
+        lab, sizes = labels(self._pour_free(i), self.min_piece, block=POUR_BLOCK)
+        if len(sizes) < 2:
+            return []
+        out = []
+        L = rb.layers[i]
+        for c in {c for c in self.owner.values() if c.items}:
+            items = [it for it in c.items if it.IsOnLayer(L)]
+            if not items:
+                continue
+            polys = [p for it in items for p in _polys(_grown(it, L, 0.6))]
+            mask = rb.grid.raster(polys)
+            b = POUR_BLOCK
+            ny, nx = lab.shape[0] * b, lab.shape[1] * b
+            coarse = mask[:ny, :nx].reshape(lab.shape[0], b, lab.shape[1], b).any(axis=(1, 3))
+            if len(set(np.unique(lab[coarse])) - {0}) >= 2:
+                out.append(c)
+        return out
+
+    def _pour_layers(self):
+        return [i for i, a in enumerate(self.pour_area) if a is not None]
+
+    def _layers_of(self, conn):
+        return {L for L, _pts in conn.geo[0]} if conn.geo else set()
+
+    def _restore(self, conn, geo, check=False):
+        """Put `geo` back for `conn`. With check=True only if it still fits (the space may
+        have been taken meanwhile); returns whether it went back."""
+        items = self.rb.add(conn.net, *geo)
+        if check and self.rb.violations(conn.net, items):
+            self.rb.remove(items)
+            return False
+        self.rb.commit(conn.net, items)
+        conn.items, conn.geo = items, geo
+        for it in items:
+            self.owner[_uuid(it)] = conn
+        self._q = None
+        return True
+
+    def _unroute(self, conn):
+        self._q = None
+        rb = self.rb
+        for it in conn.items:
+            self.owner.pop(_uuid(it), None)
+        rb.remove(conn.items)
+        conn.items, conn.geo = [], None
+        left = [it for c in set(self.owner.values()) if c.net == conn.net for it in c.items]
+        rb.uncommit(conn.net, left)
+
+    def _shadow(self, geo):
+        """Temporary copper for a geometry, only to rasterise it (not on the board)."""
+        rb = self.rb
+        out = []
+        for L_idx, pts in geo[0]:
+            for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
+                t = pcbnew.PCB_TRACK(rb.board)
+                t.SetStart(pcbnew.VECTOR2I(MM(x0), MM(y0)))
+                t.SetEnd(pcbnew.VECTOR2I(MM(x1), MM(y1)))
+                t.SetWidth(MM(0.2))
+                t.SetLayer(rb.layers[L_idx])
+                out.append(t)
+        return out
+
+    # --- a net's tracks joined to each other (no second track beside the first) ----------------
+    def _routed(self, net, but=None):
+        return [c for c in set(self.owner.values()) if c.net == net and c.items and c is not but]
+
+    def _tree(self, conn):
+        """(tracks, owners, used lanes) for `conn`: the net's routed tracks already joined to
+        conn.b, which the search may end on (model.route's `tree`), with the connection each
+        belongs to; and the lanes the net's tracks leave its pads by. When only conn.a's side
+        has copper, a and b are swapped first."""
+        routed = self._routed(conn.net, conn)
+        if not routed:
+            return [], [], set()
+        parent = {}
+
+        def find(x):
+            while parent.setdefault(x, x) != x:
+                parent[x] = parent[parent[x]]
+                x = parent[x]
+            return x
+        for c in routed:
+            parent[find(_uuid(c.a))] = find(_uuid(c.b))
+        side = lambda pad: [c for c in routed if find(_uuid(c.a)) == find(_uuid(pad))]
+        near_b = side(conn.b)
+        if not near_b and side(conn.a):
+            conn.a, conn.b = conn.b, conn.a
+            near_b = side(conn.b)
+        tracks, owners = [], []
+        for c in near_b:
+            for L, pts in c.geo[0]:
+                for p, q in zip(pts, pts[1:]):
+                    tracks.append((L, p, q))
+                    owners.append(c)
+        used = set()
+        for c in routed:
+            used |= self._lanes_used(c)
+        return tracks, owners, used
+
+    @staticmethod
+    def _lanes_used(c):
+        """{(pad uuid, layer index, direction)}: the lanes c's track leaves its pads by."""
+        out = set()
+        pieces = c.geo[0]
+        for pad in (c.a, c.b):
+            centre = _xy(pad)
+            for L, pts in (pieces[0], pieces[-1]):
+                if len(pts) < 2:
+                    continue
+                if math.dist(pts[0], centre) < 1e-3:
+                    out.add((_uuid(pad), L, _direction(pts[0], pts[1])))
+                if math.dist(pts[-1], centre) < 1e-3:
+                    out.add((_uuid(pad), L, _direction(pts[-1], pts[-2])))
+        return out
+
+    def _dependents(self, conns):
+        """`conns` and every routed connection that ends on one of their tracks, and so on."""
+        out = list(conns)
+        while True:
+            more = [c for c in set(self.owner.values()) if c.items and c.tee in out and c not in out]
+            if not more:
+                return out
+            out += more
+
+    @staticmethod
+    def _depth(c):
+        n = 0
+        while c.tee is not None and n < 50:
+            c, n = c.tee, n + 1
+        return n
+
+    def _attempt(self, conn, totals):
+        """Route `conn` around everything; on success its copper is on the board and stamped."""
+        rb = self.rb
+        items, geo, info = [], None, {}
+        for extra in (0.0,) + RETRY_MARGINS:
+            if extra:
+                totals["retries"] += 1
+                rb.remove(items)
+                items = []
+            conn.tee = None
+            tree, owners, used = self._tree(conn)
+            blocked, via_ok = rb.obstacles(conn.net, extra)
+            penalty = self._penalty(conn, blocked)
+            geo = self._draw(conn, blocked, via_ok, penalty) if self.draw else None
+            if geo is not None:
+                info = {"nodes": 0, "seconds": 0.0, "drawn": True}
+            if geo is None or geo[1] or tree:
+                # a drawn shape with vias may only be the best of a few shapes: going round
+                # on one layer needs more bends than they have; the search decides. So it
+                # does when the net has a track to join: the shapes only go pin to pin
+                found, sinfo = rb.route(conn.net, conn.a, conn.b, blocked, via_ok, self.costs,
+                                        penalty=penalty, via_costs=self._via_costs(conn), tree=tree, used=used)
+                if found is not None and (geo is None or sinfo.get("cost_mm", 1e18) < self._drawn_cost):
+                    geo, info = found, sinfo
+                    if sinfo.get("tee") is not None:
+                        conn.tee = owners[sinfo["tee"]]
+                elif geo is None:
+                    info = sinfo
+                else:
+                    info["nodes"], info["seconds"] = sinfo["nodes"], sinfo["seconds"]
+            if info.get("drawn"):
+                totals["drawn"] = totals.get("drawn", 0) + 1
+            totals["nodes"] += info["nodes"]
+            totals["search_s"] += info["seconds"]
+            if geo is None:
+                return False, info
+            geo = self._tidy(conn, geo, blocked, penalty)
+            items = rb.add(conn.net, *geo)
+            if not rb.violations(conn.net, items):
+                break
+        else:
+            totals["exact_left"] += 1  # still too close after the last retry: take it out
+            rb.remove(items)
+            info["fail"] = "clearance after retries"
+            return False, info
+        rb.commit(conn.net, items)
+        conn.items, conn.geo = items, geo
+        for it in items:
+            self.owner[_uuid(it)] = conn
+        self._q = None
+        return True, info
+
+    # --- hand-drawn shapes ------------------------------------------------------------------
+    def _tidy(self, conn, geo, blocked, penalty):
+        """Redraw each run of the search's way (lane exit or via to via or lane exit) as the
+        simplest hand-drawn shape that fits: straight, one bend, or a Z of up to three 45
+        degree bends (patterns.py). Scored by length, the lab costs, BEND per bend and SHORT
+        per jog; the search's own run competes on the same score. Lanes and vias stay."""
+        rb, g = self.rb, self.rb.grid
+        pieces, vias = geo
+        w = rb.widths(conn.net)[0]
+        out = []
+        for k, (L, pts) in enumerate(pieces):
+            lo = 1 if k == 0 else 0
+            # the last run ends in a pad's lane, or (a T-junction) on the net's track
+            hi = len(pts) - 2 if k == len(pieces) - 1 and conn.tee is None else len(pts) - 1
+            if hi - lo < 1:
+                out.append((L, pts))
+                continue
+            a, b = pts[lo], pts[hi]
+            st = self.tidy_stats
+            st["runs"] += 1
+            da = _direction(pts[0], pts[1]) if k == 0 else None
+            db = _direction(pts[-2], pts[-1]) if k == len(pieces) - 1 else None
+            score = self._scorer(L, blocked, penalty)
+            best, best_score = pts[lo:hi + 1], score(pts[lo:hi + 1])
+            cands = []
+            for s in shapes(a, da, b, db, most=4, step=0.1 if math.dist(a, b) < 4 else 0.2):
+                rough = sum(math.dist(p, q) for p, q in zip(s, s[1:])) + BEND * (len(s) - 2)
+                if rough < best_score:
+                    cands.append((rough, s))
+            cands.sort(key=lambda c: c[0])
+            if not cands:
+                st["no_cheaper_shape"] += 1
+            scored = []
+            for _rough, s in cands:
+                if not self._grid_free(s, L, blocked):
+                    continue
+                scored.append((score(s), s))
+                if len(scored) >= SHAPE_TRIES:
+                    break
+            if cands and not scored:
+                st["all_blocked"] += 1
+            layer = rb.layers[L]
+            replaced = False
+            for sc, s in sorted(scored, key=lambda c: c[0]):
+                if sc >= best_score:
+                    break
+                if all(rb.clear(conn.net, layer, p, q, w) for p, q in zip(s, s[1:])):
+                    best, best_score = s, sc
+                    replaced = True
+                    break
+            if replaced:
+                st["replaced"] += 1
+            elif scored:
+                st["dearer_or_not_clear"] += 1
+            out.append((L, pts[:lo] + best + pts[hi + 1:]))
+        return out, vias
+
+    def _draw(self, conn, blocked, via_ok, penalty):
+        """The ways a person would draw one connection, tried before the search: on one
+        layer, pin to pin as a straight line, one bend or a Z (patterns.py); or with an
+        escape via at one pin or at both and the shape on the other layer. Every way is
+        scored like the search's (length, the lab costs, BEND per bend, SHORT per jog, the
+        vias) and the cheapest that fits is taken, unless even that is much dearer than
+        a straight line: then the search is better placed to find a way round."""
+        rb, g = self.rb, self.rb.grid
+        net = conn.net
+        la, lb = rb.lanes(conn.a, blocked, net, exact=False), rb.lanes(conn.b, blocked, net, exact=False)
+        if not la or not lb:
+            return None
+        used = set()
+        for c in self._routed(net, conn):
+            used |= self._lanes_used(c)
+        for lane in la + lb:  # a lane another track of the net leaves by: the two would lie on each other
+            if (_uuid(lane.pad), lane.layer, lane.direction) in used:
+                lane.cost += USED_LANE
+        _cls, w, vd, _n = rb.key(net)
+        # a via costs in full here: weighed against a bend, a person draws the bend more often
+        # (the hand-routed TestPCB has 23 vias, the router had 39)
+        via_cost = self.costs.via * DRAW_VIA_FACTOR
+        pour_cells = self.lab.via_pour(net)
+        scorers = {}
+
+        def via_price(v):
+            """The via, and the pour it cuts on every layer (LabCosts.via_pour)."""
+            i, j = g.cell(*v)
+            if penalty is None or not (0 <= i < g.nx and 0 <= j < g.ny):
+                return via_cost
+            return via_cost + pour_cells * self.costs.unit * sum(int(p[j * g.nx + i]) for p in penalty)
+
+        def score_of(L):
+            if L not in scorers:
+                scorers[L] = self._scorer(L, blocked, penalty)
+            return scorers[L]
+
+        def via_at(lane):
+            ux, uy = lane.exit[0] - lane.centre[0], lane.exit[1] - lane.centre[1]
+            n = math.hypot(ux, uy) or 1.0
+            out = vd / 2 + 0.05
+            v = (lane.exit[0] + ux / n * out, lane.exit[1] + uy / n * out)
+            i, j = g.cell(*v)
+            return v if 0 <= i < g.nx and 0 <= j < g.ny and via_ok[j * g.nx + i] else None
+
+        layers = range(len(rb.layers))
+        cands = []  # (rough cost, pieces, vias)
+        # straight lines between nearly aligned pads, and one-layer shapes at a fine-pitch
+        # pin: right at the pin row the grid is more careful than the exact check, so the
+        # exact check decides (and the keepouts, which it doesn't see)
+        exact_only = set()
+        for A in la:
+            for B in lb:
+                if A.layer == B.layer:  # one layer, pin to pin
+                    for s in shapes(A.exit, A.direction, B.exit, (B.direction + 4) % 8, most=3, step=0.2):
+                        pieces = [(A.layer, [A.centre] + s + [B.centre])]
+                        if conn.fine:  # a short jog right at a fine-pitch row, as by hand
+                            exact_only.add(id(pieces))
+                        cands.append((A.cost + B.cost, pieces, []))
+                    if conn.fine:
+                        # between a fine-pitch pin and a part right beside it the lanes can
+                        # use up the gap: bend just past the pad edges, as a person does
+                        ea, eb = self._edge_exit(conn.a, A, w), self._edge_exit(conn.b, B, w)
+                        if ea and eb:
+                            for s in shapes(ea, A.direction, eb, (B.direction + 4) % 8, most=3, step=0.05):
+                                pieces = [(A.layer, [A.centre] + s + [B.centre])]
+                                exact_only.add(id(pieces))
+                                cands.append((A.cost + B.cost, pieces, []))
+                    for line in self._straights(conn, A, B, w):
+                        pieces = [(A.layer, line)]
+                        exact_only.add(id(pieces))
+                        cands.append((A.cost + B.cost, pieces, []))
+            va = via_at(A)
+            if va is None:
+                continue
+            for L2 in layers:
+                if L2 == A.layer:
+                    continue
+                for B in lb:
+                    if B.layer == L2:  # escape via at a, the far pin on the other layer
+                        for s in shapes(va, None, B.exit, (B.direction + 4) % 8, most=3, step=0.2):
+                            cands.append((A.cost + B.cost + via_price(va),
+                                          [(A.layer, [A.centre, va]), (L2, s + [B.centre])], [va]))
+                    elif B.layer != L2:  # escape vias at both pins
+                        vb = via_at(B)
+                        if vb is None:
+                            continue
+                        for s in shapes(va, None, vb, None, most=3, step=0.2):
+                            cands.append((A.cost + B.cost + via_price(va) + via_price(vb),
+                                          [(A.layer, [A.centre, va]), (L2, s), (B.layer, [vb, B.centre])], [va, vb]))
+        if not cands:
+            return None
+        straight = math.dist(_xy(conn.a), _xy(conn.b))
+        # in the open pour every mm of track costs more on purpose (costs.HUG), so allow for
+        # that; a way that crosses something really dear (an inductor, a pin's escape room)
+        # still goes to the search, which can go round it
+        open_factor = 1.0 + HUG * self.costs.unit / self.rb.grid.pitch
+        limit = (1.4 * straight + 3 * BEND) * open_factor + 2 * via_cost + 2.0
+
+        def rough(c):
+            base, pieces, vias = c
+            return base + sum(math.dist(p, q) for _L, pts in pieces for p, q in zip(pts, pts[1:])) + \
+                BEND * sum(bends(pts) for _L, pts in pieces)
+        cands.sort(key=rough)
+        scored = []
+        for c in cands:
+            if rough(c) > limit:
+                break
+            base, pieces, vias = c
+            if (all(self._outside_keepouts(pts, L, w, vd) for L, pts in pieces) if id(pieces) in exact_only
+                    else all(self._grid_free(pts, L, blocked) for L, pts in pieces)):
+                cost = base + sum(score_of(L)(pts) for L, pts in pieces)
+                if cost <= limit:
+                    scored.append((cost, pieces, vias))
+            if len(scored) >= SHAPE_TRIES:
+                break
+        for cost, pieces, vias in sorted(scored, key=lambda c: c[0]):
+            if all(rb.clear(net, rb.layers[L], p, q, w) for L, pts in pieces for p, q in zip(pts, pts[1:])) and \
+                    all(self._via_fits(net, v) for v in vias):
+                self._drawn_cost = cost
+                return pieces, vias
+        return None
+
+    def _scorer(self, L, blocked, penalty):
+        g = self.rb.grid
+        pen = penalty[L] if penalty is not None else None
+        unit, factor = self.costs.unit, self.costs.layer_factor.get(L, 1.0)
+
+        diagonal = self.costs.diagonal
+
+        def segment(p, q):
+            d = math.dist(p, q)
+            diag = abs(abs(q[0] - p[0]) - abs(q[1] - p[1])) < 1e-6 and abs(q[0] - p[0]) > 1e-6
+            total = d * factor * (diagonal if diag else 1.0) + (SHORT if d < SHORT_MM else 0.0)
+            if pen is not None and d > 1e-6:
+                n = max(1, int(d / (g.pitch / 2)))
+                for k in range(n):
+                    i, j = g.cell(p[0] + (q[0] - p[0]) * (k + 0.5) / n, p[1] + (q[1] - p[1]) * (k + 0.5) / n)
+                    if 0 <= i < g.nx and 0 <= j < g.ny:
+                        total += pen[j * g.nx + i] * unit * (d / n) / g.pitch
+            return total
+
+        def score(pts):
+            return sum(segment(p, q) for p, q in zip(pts, pts[1:])) + BEND * bends(pts)
+        return score
+
+    def _straights(self, conn, A, B, w):
+        """Straight tracks between two pads that face each other along one axis but are a
+        little off it (a resistor below a transistor's pin, a CC resistor above a USB-C
+        pin): a person draws one line that lands inside both pads, not two jogs to hit both
+        centres exactly. Tried: the line through either pad's centre (a narrow connector
+        pin stays centred) and the one halfway; each must end with its whole width on
+        both pads."""
+        if A.direction != (B.direction + 4) % 8:
+            return []
+        ux, uy = DIRS[A.direction]
+        rx, ry = B.centre[0] - A.centre[0], B.centre[1] - A.centre[1]
+        along, off = ux * rx + uy * ry, ux * ry - uy * rx
+        if along <= 0 or abs(off) < 1e-6 or abs(off) > STRAIGHT_OFFSET:
+            return []
+        nx_, ny_ = -uy, ux  # across the line
+
+        def on_pad(pad, p):
+            return all(pad.HitTest(pcbnew.VECTOR2I(MM(p[0] + nx_ * s), MM(p[1] + ny_ * s)), 0)
+                       for s in (0.0, -(w / 2 - 0.02), w / 2 - 0.02))  # a track as wide as the pin fits it
+        out = []
+        for share in (0.0, 0.5, 1.0):  # of the offset taken at A's end
+            pa = (A.centre[0] + nx_ * off * share, A.centre[1] + ny_ * off * share)
+            pb = (B.centre[0] - nx_ * off * (1 - share), B.centre[1] - ny_ * off * (1 - share))
+            if on_pad(conn.a, pa) and on_pad(conn.b, pb):
+                out.append([pa, pb])
+        return out
+
+    @staticmethod
+    def _edge_exit(pad, lane, w):
+        """Half a track width past the pad's edge, straight out along the lane; None for a
+        45 degree lane (a round pad has no edge on that axis)."""
+        if lane.direction % 2:
+            return None
+        bb = pad.GetBoundingBox()
+        half = T(bb.GetWidth()) / 2 if lane.direction % 4 == 0 else T(bb.GetHeight()) / 2
+        ux, uy = DIRS[lane.direction]
+        return (lane.centre[0] + ux * (half + w / 2), lane.centre[1] + uy * (half + w / 2))
+
+    def _outside_keepouts(self, pts, L, w, vd):
+        """Whether a run's track centres stay out of the rule areas (grid, like the search).
+        Bus planning asks this tens of thousands of times, so the points are checked at once."""
+        g = self.rb.grid
+        if (w, vd) not in self._keep:
+            masks = self._keep[(w, vd)] = self.rb.keepouts(w, vd)[0]
+            self._keep[("any", w, vd)] = [bool(m.any()) for m in masks]
+        mask = self._keep[(w, vd)][L]
+        any_keepout = self._keep[("any", w, vd)][L]
+        for p, q in zip(pts, pts[1:]):
+            n = max(1, int(math.dist(p, q) / (g.pitch / 2)))
+            t = np.linspace(0.0, 1.0, n + 1)
+            i = np.rint((p[0] + (q[0] - p[0]) * t - g.x0) / g.pitch).astype(int)
+            j = np.rint((p[1] + (q[1] - p[1]) * t - g.y0) / g.pitch).astype(int)
+            if i.min() < 0 or j.min() < 0 or i.max() >= g.nx or j.max() >= g.ny:
+                return False
+            if any_keepout and mask[j, i].any():
+                return False
+        return True
+
+    def _grid_free(self, pts, L, blocked):
+        g = self.rb.grid
+        row = blocked[L]
+        for p, q in zip(pts, pts[1:]):
+            d = math.dist(p, q)
+            n = max(1, int(d / (g.pitch / 2)))
+            for k in range(1, n):  # the ends are a lane exit or a via: free by construction
+                i, j = g.cell(p[0] + (q[0] - p[0]) * k / n, p[1] + (q[1] - p[1]) * k / n)
+                if not (0 <= i < g.nx and 0 <= j < g.ny) or row[j * g.nx + i]:
+                    return False
+        return True
+
+    def _rip_up(self, conn, totals):
+        """Find the way through the router's copper of the same or later groups, rip up the
+        connections in it, and return (them, why not, routed). When that way touches no
+        copper at all, it is simply taken: routed is True."""
+        rb = self.rb
+        ripable = [c for c in set(self.owner.values())
+                   if c.group >= conn.group and c.net != conn.net and c.ripped < MAX_RIPPED and c.items]
+        if not ripable:
+            return [], "nothing that may be ripped up", False
+        soft = {c.net for c in ripable}
+        # nets with copper that can't be ripped stay hard: their other connections
+        hard_nets = {c.net for c in set(self.owner.values()) if c.items and c not in ripable}
+        soft -= hard_nets
+        ripable = [c for c in ripable if c.net in soft]
+        if not ripable:
+            return [], "only copper that may not be ripped up", False
+        ignore = {_uuid(it) for c in ripable for it in c.items}
+        why = ""
+        for extra in (0.0,) + RETRY_MARGINS:
+            blocked, via_ok, masks = rb.obstacles_soft(conn.net, soft, extra)
+            geo, info = rb.route(conn.net, conn.a, conn.b, blocked, via_ok, self.costs,
+                                 penalty=self._penalty(conn, blocked, masks), ignore=ignore,
+                                 via_costs=self._via_costs(conn))
+            totals["nodes"] += info["nodes"]
+            totals["search_s"] += info["seconds"]
+            if geo is None:
+                return [], "no way even through ripable copper: " + info.get("fail", "no path"), False
+            trial = rb.add(conn.net, *geo)
+            hits = rb.violations(conn.net, trial)
+            if not hits:  # the normal grid was too pessimistic: this way is free as it is
+                self._q = None
+                rb.commit(conn.net, trial)
+                conn.items, conn.geo = trial, geo
+                for it in trial:
+                    self.owner[_uuid(it)] = conn
+                return [], "", True
+            victims, hard = set(), False
+            for _it, other in hits:
+                owner = self.owner.get(_uuid(other)) if other is not None else None
+                if owner is not None and owner in ripable:
+                    victims.add(owner)
+                else:
+                    hard = True
+            if not hard:
+                self._add_history(trial)
+                rb.remove(trial)
+                break
+            rb.remove(trial)  # grazes copper that stays: try again with a margin
+            why = "the way touches copper that may not be ripped up"
+        else:
+            return [], why, False
+        conn.rips += 1
+        totals["ripups"] += 1
+        self._q = None
+        # a track that ends on a ripped-up one would be left hanging: it goes too
+        victims = set(self._dependents(list(victims)))
+        for v in victims:
+            v.tee = None if v.tee in victims else v.tee
+            for it in v.items:
+                self.owner.pop(_uuid(it), None)
+            rb.remove(v.items)
+            v.items, v.geo = [], None
+            v.ripped += 1
+            totals["ripped"] += 1
+            left = [it for c in set(self.owner.values()) if c.net == v.net for it in c.items]
+            rb.uncommit(v.net, left)
+        return sorted(victims, key=lambda c: c.length), "", False
+
+    def _add_history(self, items, layers=None, amount=HISTORY):
+        rb = self.rb
+        for i, L in enumerate(rb.layers):
+            if layers is not None and i not in layers:
+                continue
+            polys = []
+            for it in items:
+                if it.IsOnLayer(L):
+                    polys += _polys(_grown(it, L, 0.2))
+            if polys:
+                cells = rb.grid.raster(polys)
+                self.hist[i] = np.minimum(self.hist[i].astype(np.int32) + cells * amount, 200).astype(np.uint8)
