+    def test_t_on_unbroken_wire_keeps_junction(self) -> None:
+        """PowerLab patch (#62): KiCad draws a T as a wire ending on the middle of another
+        wire. Its junction must survive a sync."""
+        from commands.wire_manager import WireManager
+
+        data = self._base_data()
+        data.insert(1, self._wire(0, 0, 20, 0))  # not split at (10, 0)
+        data.insert(1, self._wire(10, -10, 10, 0))
+        data.insert(1, self._junction(10, 0))
+
+        added, removed = WireManager.sync_junctions(data)
+
+        assert (added, removed) == (0, 0)
+        assert len(_find_elements(data, "junction")) == 1
+
+    def test_t_on_unbroken_wire_gets_junction(self) -> None:
+        """A wire ending on the middle of another gets the junction KiCad would add."""
+        from commands.wire_manager import WireManager
+
+        data = self._base_data()
+        data.insert(1, self._wire(0, 0, 20, 0))
+        data.insert(1, self._wire(10, -10, 10, 0))
+
+        added, removed = WireManager.sync_junctions(data)
+
+        assert (added, removed) == (1, 0)
+
+    def test_t_on_diagonal_wire_keeps_junction(self) -> None:
+        from commands.wire_manager import WireManager
+
+        data = self._base_data()
+        data.insert(1, self._wire(0, 0, 20, 20))
+        data.insert(1, self._wire(10, 10, 10, 0))
+        data.insert(1, self._junction(10, 10))
+
+        assert WireManager.sync_junctions(data) == (0, 0)
+
+    def test_wire_crossing_without_junction_stays_unconnected(self) -> None:
+        """Two wires crossing (no wire ends there) get no junction."""
+        from commands.wire_manager import WireManager
+
+        data = self._base_data()
+        data.insert(1, self._wire(0, 0, 20, 0))
+        data.insert(1, self._wire(10, -10, 10, 10))
+
+        assert WireManager.sync_junctions(data) == (0, 0)
+
+    def test_sheet_pin_counts_as_connection(self) -> None:
+        """Two wires ending on a hierarchical sheet pin keep their junction."""
+        from commands.wire_manager import WireManager
+
+        data = self._base_data()
+        sheet = [
+            Symbol("sheet"),
+            [Symbol("at"), 30, -10],
+            [Symbol("size"), 20, 20],
+            [Symbol("pin"), "IN", Symbol("input"), [Symbol("at"), 30, 0, 180]],
+        ]
+        data.insert(1, sheet)
+        data.insert(1, self._wire(20, 0, 30, 0))
+        data.insert(1, self._wire(30, 0, 30, 10))
+        data.insert(1, self._junction(30, 0))
+
+        assert WireManager.sync_junctions(data) == (0, 0)
