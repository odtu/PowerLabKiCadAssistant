+# powerlab-pcb-design-rules §2.6 (1 oz) and the 2 oz columns of §2.2-§2.4.
+LAB_PRESETS: Dict[str, Dict[str, Any]] = {
+    "1oz": {
+        "minClearance": 0.15,
+        "minTrackWidth": 0.15,
+        "minConnectionWidth": 0.15,
+        "minAnnularWidth": 0.15,
+        "minViaDiameter": 0.6,
+        "holeClearance": 0.25,
+        "copperEdgeClearance": 0.5,
+        "minThroughHole": 0.3,
+        "holeToHoleMin": 0.4,
+        "allowMicrovias": False,
+        "allowBlindVias": False,
+        "solderMaskExpansion": 0.05,
+        "solderMaskMinWidth": 0.1,
+        "minSilkTextHeight": 1.0,
+        "minSilkThickness": 0.15,
+        "defaultTrackWidth": 0.15,
+        "defaultClearance": 0.2,
+        "defaultViaDiameter": 0.6,
+        "defaultViaDrill": 0.3,
+        "powerClass": {"track_width": 0.5, "clearance": 0.3, "via_diameter": 0.8, "via_drill": 0.4},
+    },
+    "2oz": {
+        "minClearance": 0.2,
+        "minTrackWidth": 0.18,
+        "minConnectionWidth": 0.18,
+        "minAnnularWidth": 0.2,
+        "minViaDiameter": 0.7,
+        "holeClearance": 0.25,
+        "copperEdgeClearance": 0.5,
+        "minThroughHole": 0.3,
+        "holeToHoleMin": 0.4,
+        "allowMicrovias": False,
+        "allowBlindVias": False,
+        "solderMaskExpansion": 0.05,
+        "solderMaskMinWidth": 0.13,
+        "minSilkTextHeight": 1.0,
+        "minSilkThickness": 0.15,
+        "defaultTrackWidth": 0.18,
+        "defaultClearance": 0.25,
+        "defaultViaDiameter": 0.7,
+        "defaultViaDrill": 0.3,
+        "powerClass": {"track_width": 0.5, "clearance": 0.3, "via_diameter": 0.85, "via_drill": 0.4},
+    },
+}
+
+# §1.6 / §2.6: the lab's Power and GND classes (schematic colour, 0.3 mm = 12 mil wires).
+LAB_CLASSES: Tuple[Tuple[str, Tuple[str, ...], str], ...] = (
+    ("Power", ("+*", "-*", "VBUS*"), "rgba(255, 0, 0, 1.000)"),
+    ("GND", ("*GND*",), "rgba(0, 0, 255, 1.000)"),
+)
+LAB_WIRE_WIDTH_MILS = 12
+
+LAB_MINIMUMS_RULE = "Lab minimums"
+NO_VIAS_RULE = "Lab: no micro or blind vias"
+
+# .kicad_dru constraint <- board.design_settings.rules key. Clearance stays out: an
+# unconditional clearance rule would override every net class clearance.
+_DRU_MINIMUMS: Tuple[Tuple[str, str], ...] = (
+    ("track_width", "min_track_width"),
+    ("connection_width", "min_connection"),
+    ("annular_width", "min_via_annular_width"),
+    ("via_diameter", "min_via_diameter"),
+    ("hole_size", "min_through_hole_diameter"),
+    ("hole_clearance", "min_hole_clearance"),
+    ("hole_to_hole", "min_hole_to_hole"),
+    ("edge_clearance", "min_copper_edge_clearance"),
+)
+
+# Fallback when the project has no Default class to clone (KiCad 10's own Default).
+_CLASS_TEMPLATE = {
+    "bus_width": 12,
+    "clearance": 0.2,
+    "diff_pair_gap": 0.25,
+    "diff_pair_via_gap": 0.25,
+    "diff_pair_width": 0.2,
+    "line_style": 0,
+    "microvia_diameter": 0.3,
+    "microvia_drill": 0.1,
+    "pcb_color": "rgba(0, 0, 0, 0.000)",
+    "priority": 0,
+    "schematic_color": "rgba(0, 0, 0, 0.000)",
+    "track_width": 0.2,
+    "tuning_profile": "",
+    "via_diameter": 0.6,
+    "via_drill": 0.3,
+    "wire_width": 6,
+}
+
+
+def _number(name: str, value: Any) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ValueError(f"{name} must be a number in mm (got {value!r})")
+    if not math.isfinite(value) or value < 0 or value > 100:
+        raise ValueError(f"{name} must be between 0 and 100 mm (got {value!r})")
+    return round(float(value), 6)
+
+
+def _flag(name: str, value: Any) -> bool:
+    if isinstance(value, bool):
+        return value
+    raise ValueError(f"{name} must be true or false (got {value!r})")
+
+
+def _copper(value: Any) -> str:
+    text = str(value or "1oz").lower().replace(" ", "")
+    if text in ("1", "1oz", "35um", "35µm"):
+        return "1oz"
+    if text in ("2", "2oz", "70um", "70µm"):
+        return "2oz"
+    raise ValueError(f"copper must be '1oz' or '2oz' (got {value!r}); for 3 oz set the values")
+
+
+def _pick(params: Dict[str, Any], name: str, aliases: Tuple[str, ...]) -> Tuple[Any, Optional[str]]:
+    for key in (name,) + aliases:
+        if params.get(key) is not None:
+            return params[key], key
+    return None, None
+
+
+def unknown_parameters(params: Dict[str, Any]) -> List[str]:
+    """Parameters set_design_rules doesn't know: they are reported, not used. (The names
+    are spelled out here so tests/test_schema_param_names.py sees them read.)"""
+    known = {
+        "preset",
+        "copper",
+        "labNetClasses",
+        "projectPath",
+        "minClearance",
+        "clearance",
+        "minTrackWidth",
+        "minConnectionWidth",
+        "minAnnularWidth",
+        "minViaDiameter",
+        "holeClearance",
+        "copperEdgeClearance",
+        "minThroughHole",
+        "minViaDrill",
+        "minHoleDiameter",
+        "holeToHoleMin",
+        "minMicroViaDiameter",
+        "minMicroViaDrill",
+        "microViaDiameter",
+        "microViaDrill",
+        "minSilkTextHeight",
+        "minSilkThickness",
+        "silkClearance",
+        "defaultTrackWidth",
+        "trackWidth",
+        "defaultClearance",
+        "defaultViaDiameter",
+        "viaDiameter",
+        "defaultViaDrill",
+        "viaDrill",
+        "solderMaskExpansion",
+        "solderMaskMinWidth",
+        "allowMicrovias",
+        "allowBlindVias",
+    }
+    return sorted(k for k in (params or {}) if k not in known and not str(k).startswith("_"))
+
+
+def resolve_design_rule_params(params: Dict[str, Any]) -> Dict[str, Any]:
+    """Turn set_design_rules' parameters into what gets written. Raises ValueError.
+
+    Returns ``{"rules": {rules_key: mm}, "defaultClass": {field: mm},
+    "boardFile": {param: mm}, "vias": {"allowMicrovias": bool, ...},
+    "labClasses": {...} | None, "preset": str | None, "copper": str | None}``.
+    Explicit parameters win over the preset; old parameter names still work.
+    """
+    params = dict(params or {})
+    preset_name = params.get("preset")
+    base: Dict[str, Any] = {}
+    copper = None
+    if preset_name is not None:
+        if str(preset_name).lower() != "powerlab":
+            raise ValueError(f"unknown preset {preset_name!r}; the only preset is 'powerlab'")
+        copper = _copper(params.get("copper"))
+        base = dict(LAB_PRESETS[copper])
+    elif params.get("copper") is not None:
+        raise ValueError("copper only goes with preset: 'powerlab'")
+
+    def value(name: str, aliases: Tuple[str, ...] = ()) -> Any:
+        given, key = _pick(params, name, aliases)
+        if key is not None:
+            return given, key
+        return base.get(name), name
+
+    out: Dict[str, Any] = {
+        "rules": {},
+        "defaultClass": {},
+        "boardFile": {},
+        "vias": {},
+        "labClasses": None,
+        "preset": "powerlab" if preset_name is not None else None,
+        "copper": copper,
+    }
+    for name, aliases, key, _member, _words in RULE_PARAMS:
+        given, used = value(name, aliases)
+        if given is not None:
+            out["rules"][key] = _number(used, given)
+    for name, aliases, key in CLASS_PARAMS:
+        given, used = value(name, aliases)
+        if given is not None:
+            out["defaultClass"][key] = _number(used, given)
+    for name, _member, _words in BOARD_FILE_PARAMS:
+        given, used = value(name)
+        if given is not None:
+            out["boardFile"][name] = _number(used, given)
+    for name in VIA_PERMISSIONS:
+        given, used = value(name)
+        if given is not None:
+            out["vias"][name] = _flag(used, given)
+    if preset_name is not None and params.get("labNetClasses", True) is not False:
+        out["labClasses"] = dict(base["powerClass"])
+
+    dc = out["defaultClass"]
+    if "via_diameter" in dc and "via_drill" in dc and dc["via_drill"] >= dc["via_diameter"]:
+        raise ValueError("the Default class via drill must be smaller than its diameter")
+    if not (out["rules"] or dc or out["boardFile"] or out["vias"] or out["labClasses"]):
+        raise ValueError(
+            "nothing to set: pass preset 'powerlab' or at least one rule "
+            "(e.g. minClearance, minTrackWidth, defaultTrackWidth)"
+        )
+    return out
+
+
+def _classes(data: Dict[str, Any]) -> List[Dict[str, Any]]:
+    net_settings = data.get("net_settings")
+    if not isinstance(net_settings, dict):
+        net_settings = {}
+        data["net_settings"] = net_settings
+    if not isinstance(net_settings.get("classes"), list):
+        net_settings["classes"] = []
+    return net_settings["classes"]
+
+
+def _class(data: Dict[str, Any], name: str) -> Tuple[Dict[str, Any], bool]:
+    classes = _classes(data)
+    found = next((c for c in classes if isinstance(c, dict) and c.get("name") == name), None)
+    if found is not None:
+        return found, False
+    template = next((c for c in classes if isinstance(c, dict) and c.get("name") == "Default"), None)
+    cls = dict(template) if template else dict(_CLASS_TEMPLATE)
+    cls["name"] = name
+    cls["priority"] = 2147483647 if name == "Default" else 0
+    classes.append(cls)
+    return cls, True
+
+
+def _fmt(mm: float) -> str:
+    return f"{mm:g} mm"
+
+
+def apply_design_rules_to_project(data: Dict[str, Any], values: Dict[str, Any]) -> List[str]:
+    """Write ``values`` (from resolve_design_rule_params) into a parsed .kicad_pro dict.
+    Pure: changes ``data`` in place and returns what it set, in words."""
+    done: List[str] = []
+    board = data.get("board")
+    if not isinstance(board, dict):
+        board = {}
+        data["board"] = board
+    ds = board.get("design_settings")
+    if not isinstance(ds, dict):
+        ds = {}
+        board["design_settings"] = ds
+    rules = ds.get("rules")
+    if not isinstance(rules, dict):
+        rules = {}
+        ds["rules"] = rules
+
+    words = {key: w for _n, _a, key, _m, w in RULE_PARAMS}
+    set_rules = []
+    for key, mm in values.get("rules", {}).items():
+        rules[key] = mm
+        set_rules.append(f"{words.get(key, key)} {_fmt(mm)}")
+    if set_rules:
+        done.append("Constraints: " + ", ".join(set_rules))
+
+    # New silkscreen items must pass the silk minimums: raise the defaults, never lower them.
+    defaults = ds.get("defaults")
+    if not isinstance(defaults, dict):
+        defaults = {}
+        ds["defaults"] = defaults
+    raised = []
+    thick = values.get("rules", {}).get("min_text_thickness")
+    if thick:
+        for key in ("silk_line_width", "silk_text_thickness"):
+            if float(defaults.get(key) or 0) < thick:
+                defaults[key] = thick
+                raised.append(f"{key} {_fmt(thick)}")
+    height = values.get("rules", {}).get("min_text_height")
+    if height:
+        for key in ("silk_text_size_h", "silk_text_size_v"):
+            if float(defaults.get(key) or 0) < height:
+                defaults[key] = height
+                raised.append(f"{key} {_fmt(height)}")
+    if raised:
+        done.append("Text & graphics defaults: " + ", ".join(raised))
+
+    dc = values.get("defaultClass") or {}
+    if dc:
+        cls, _new = _class(data, "Default")
+        for key, mm in dc.items():
+            cls[key] = mm
+        done.append("Default net class: " + _class_words(cls))
+
+    lab = values.get("labClasses")
+    if lab:
+        net_settings = data["net_settings"]
+        if not isinstance(net_settings.get("netclass_patterns"), list):
+            net_settings["netclass_patterns"] = []
+        patterns = net_settings["netclass_patterns"]
+        taken = {p.get("pattern") for p in patterns if isinstance(p, dict)}
+        for name, pats, colour in LAB_CLASSES:
+            cls, new = _class(data, name)
+            for key, floor in lab.items():  # sized for current: raise to the lab floor only
+                if new or float(cls.get(key) or 0) < floor:
+                    cls[key] = floor
+            if new or cls.get("schematic_color") in (None, "rgba(0, 0, 0, 0.000)"):
+                cls["schematic_color"] = colour
+            if new or int(cls.get("wire_width") or 0) < LAB_WIRE_WIDTH_MILS:
+                cls["wire_width"] = LAB_WIRE_WIDTH_MILS
+            added = []
+            for pattern in pats:
+                if pattern not in taken:
+                    patterns.append({"netclass": name, "pattern": pattern})
+                    taken.add(pattern)
+                    added.append(pattern)
+            text = f"{name} net class{' (new)' if new else ''}: " + _class_words(cls)
+            if added:
+                text += ", patterns " + " ".join(added)
+            done.append(text)
+    return done
+
+
+def _class_words(cls: Dict[str, Any]) -> str:
+    return (
+        f"track {_fmt(float(cls.get('track_width', 0)))}, "
+        f"clearance {_fmt(float(cls.get('clearance', 0)))}, "
+        f"via {_fmt(float(cls.get('via_diameter', 0)))} / {_fmt(float(cls.get('via_drill', 0)))} drill"
+    )
+
+
+def read_design_rules_from_project(data: Dict[str, Any]) -> Dict[str, Any]:
+    """What the .kicad_pro holds, with set_design_rules' parameter names (mm)."""
+    ds = ((data.get("board") or {}).get("design_settings")) or {}
+    rules = ds.get("rules") or {}
+    out: Dict[str, Any] = {}
+    for name, _aliases, key, _member, _words in RULE_PARAMS:
+        if isinstance(rules.get(key), (int, float)):
+            out[name] = rules[key]
+    defaults = ds.get("defaults") or {}
+    silk = {
+        k: defaults[k]
+        for k in ("silk_line_width", "silk_text_size_h", "silk_text_size_v", "silk_text_thickness")
+        if k in defaults
+    }
+    classes = []
+    for cls in ((data.get("net_settings") or {}).get("classes")) or []:
+        if isinstance(cls, dict) and cls.get("name"):
+            classes.append(
+                {
+                    k: cls.get(k)
+                    for k in ("name", "track_width", "clearance", "via_diameter", "via_drill")
+                }
+            )
+    patterns = [
+        {"pattern": p.get("pattern"), "netClass": p.get("netclass")}
+        for p in ((data.get("net_settings") or {}).get("netclass_patterns")) or []
+        if isinstance(p, dict)
+    ]
+    return {"rules": out, "silkDefaults": silk, "netClasses": classes, "netClassPatterns": patterns}
+
+
+def _find_rule(text: str, name: str) -> Tuple[int, int]:
+    start = text.find(f'(rule "{name}"')
+    if start == -1:
+        return -1, -1
+    depth = 0
+    quoted = False
+    for i in range(start, len(text)):
+        c = text[i]
+        if c == '"' and text[i - 1] != "\\":
+            quoted = not quoted
+        elif not quoted and c == "(":
+            depth += 1
+        elif not quoted and c == ")":
+            depth -= 1
+            if depth == 0:
+                return start, i + 1
+    return -1, -1
+
+
+def set_dru_rule(text: str, name: str, rule: Optional[str]) -> str:
+    """Replace, add or (rule None) remove the named rule in .kicad_dru text. Pure."""
+    start, end = _find_rule(text, name)
+    if start != -1:
+        if rule is None:
+            head = text[:start].rstrip()
+            tail = text[end:].strip()
+            return head + ("\n\n" + tail if tail else "") + "\n"
+        return text[:start] + rule + text[end:]
+    if rule is None:
+        return text
+    body = text.strip() or "(version 1)"
+    return body + "\n\n" + rule + "\n"
+
+
+def lab_minimums_rule(rules: Dict[str, Any]) -> Optional[str]:
+    """The "Lab minimums" .kicad_dru rule for the project's minimums (None if all are 0)."""
+    lines = []
+    for constraint, key in _DRU_MINIMUMS:
+        mm = rules.get(key)
+        if isinstance(mm, (int, float)) and not isinstance(mm, bool) and mm > 0:
+            lines.append(f"\t(constraint {constraint} (min {mm:g}mm))")
+    if not lines:
+        return None
+    return f'(rule "{LAB_MINIMUMS_RULE}"\n' + "\n".join(lines) + ")"
+
+
+def no_vias_rule(allow_micro: bool, allow_blind: bool) -> Optional[str]:
+    """A disallow rule for the via types that aren't allowed (None if both are).
+
+    KiCad 10 has no "allow micro/blind vias" switch any more; kicad-cli accepts these
+    three keywords (an unknown one drops the whole file)."""
+    kinds = []
+    if not allow_micro:
+        kinds.append("micro_via")
+    if not allow_blind:
+        kinds += ["blind_via", "buried_via"]
+    if not kinds:
+        return None
+    return f'(rule "{NO_VIAS_RULE}"\n\t(constraint disallow {" ".join(kinds)}))'
+
+
+def _write_atomic(path: str, text: str) -> None:
+    directory = os.path.dirname(path) or "."
+    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".design-rules-", suffix=".tmp")
+    try:
+        # No byte-order mark and LF: KiCad drops a .kicad_dru that starts with a BOM.
+        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
+            handle.write(text)
+        os.replace(tmp, path)
+    except Exception:
+        try:
+            os.remove(tmp)
+        except OSError:
+            pass
+        raise
+
+
+def persist_design_rules_to_project(
+    pro_path: str, values: Dict[str, Any]
+) -> Tuple[List[str], Dict[str, Any]]:
+    """Read/modify/write the .kicad_pro, keeping everything else. Raises on failure.
+    Returns (what was set, in words; the project's board.design_settings.rules after it)."""
+    with open(pro_path, "r", encoding="utf-8") as handle:
+        data = json.load(handle)
+    done = apply_design_rules_to_project(data, values)
+    _write_atomic(pro_path, json.dumps(data, indent=2, sort_keys=True) + "\n")
+    return done, dict(data["board"]["design_settings"]["rules"])
+
+
+def dru_minimums_changed(values: Dict[str, Any]) -> bool:
+    """Whether the call set a minimum that the "Lab minimums" rule carries."""
+    return any(key in values.get("rules", {}) for _c, key in _DRU_MINIMUMS)
+
+
+def persist_dru_rules(
+    dru_path: str,
+    project_rules: Dict[str, Any],
+    vias: Optional[Dict[str, bool]],
+    minimums: bool = True,
+) -> List[str]:
+    """Write the "Lab minimums" rule (from the project's final minimums; only when
+    ``minimums``, so a call that sets e.g. only the clearance leaves a hand-written rule
+    alone) and, when the call said so, the no-micro/blind-vias rule. Returns the rule
+    names written."""
+    text = ""
+    if os.path.exists(dru_path):
+        with open(dru_path, "r", encoding="utf-8-sig") as handle:
+            text = handle.read()
+    written = []
+    rule = lab_minimums_rule(project_rules) if minimums else None
+    if rule:
+        text = set_dru_rule(text, LAB_MINIMUMS_RULE, rule)
+        written.append(LAB_MINIMUMS_RULE)
+    if vias:
+        rule = no_vias_rule(vias.get("allowMicrovias", True), vias.get("allowBlindVias", True))
+        text = set_dru_rule(text, NO_VIAS_RULE, rule)
+        if rule:
+            written.append(NO_VIAS_RULE)
+    if written or vias:
+        _write_atomic(dru_path, text if text.strip() else "(version 1)\n")
+    return written
diff --git a/python/utils/region_box.py b/python/utils/region_box.py
new file mode 100644
index 0000000..a15e7d3
--- /dev/null
+++ b/python/utils/region_box.py
@@ -0,0 +1,95 @@
+"""A rectangle in board mm from the shapes callers write it in (PowerLab patch, #81).
+
+get_board_2d_view's `region` took only {x0, y0, x1, y1} or {x, y, size}. Claude also
+writes {x, y, width, height}, {xmin, ymin, xmax, ymax}, {left, top, right, bottom} or a
+4-number list; the zod schema dropped the unknown keys and the tool answered "Bad region"
+with no reason. No pcbnew import, so it can be tested on its own.
+"""
+
+from typing import Any, Dict, Tuple
+
+ACCEPTED = (
+    "{x0, y0, x1, y1}, {x1, y1, x2, y2}, {x, y, width, height} (x, y = top-left corner), "
+    "{x, y, w, h}, {xmin, ymin, xmax, ymax} (or minX/minY/maxX/maxY), "
+    "{left, top, right, bottom}, {x, y, size} (a square round x, y), "
+    "{cx, cy, width, height} (centre), or [x0, y0, x1, y1]; all in board mm"
+)
+
+_CORNER_KEYS = (
+    ("x0", "y0", "x1", "y1"),
+    ("xmin", "ymin", "xmax", "ymax"),
+    ("minx", "miny", "maxx", "maxy"),
+    ("left", "top", "right", "bottom"),
+    ("x1", "y1", "x2", "y2"),
+)
+
+_TO_MM = {"mm": 1.0, "mil": 0.0254, "mils": 0.0254, "inch": 25.4, "in": 25.4}
+
+
+def region_box(region: Any) -> Tuple[float, float, float, float]:
+    """(x0, y0, x1, y1) in mm with x0 < x1 and y0 < y1. Raises ValueError saying what
+    was wrong and which shapes work."""
+    if isinstance(region, (list, tuple)):
+        if len(region) != 4:
+            raise ValueError(f"a region list needs 4 numbers [x0, y0, x1, y1], got {len(region)}")
+        return _ordered(*(_number(v, f"[{i}]") for i, v in enumerate(region)))
+    if not isinstance(region, dict):
+        raise ValueError(f"region must be an object or a list, got {type(region).__name__}")
+    # keys are matched without case, '_' or '-' (minX, min_x, MinX all work)
+    r = {str(k).lower().replace("_", "").replace("-", ""): v for k, v in region.items()}
+    unit = str(r.pop("unit", "mm") or "mm").lower()
+    if unit not in _TO_MM:
+        raise ValueError(f"unknown unit {unit!r}; use mm, mil or inch")
+    scale = _TO_MM[unit]
+
+    def num(key: str) -> float:
+        return _number(r[key], key) * scale
+
+    if "size" in r and "x" in r and "y" in r:
+        half = num("size") / 2
+        x, y = num("x"), num("y")
+        return _ordered(x - half, y - half, x + half, y + half)
+    for w_key, h_key in (("width", "height"), ("w", "h")):
+        if w_key in r and h_key in r:
+            w, h = num(w_key), num(h_key)
+            if "cx" in r and "cy" in r:
+                cx, cy = num("cx"), num("cy")
+                return _ordered(cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2)
+            for x_key, y_key in (("x", "y"), ("x0", "y0"), ("left", "top"), ("xmin", "ymin")):
+                if x_key in r and y_key in r:
+                    x, y = num(x_key), num(y_key)
+                    return _ordered(x, y, x + w, y + h)
+    for keys in _CORNER_KEYS:
+        if all(k in r for k in keys):
+            return _ordered(*(num(k) for k in keys))
+    got = ", ".join(sorted(region)) or "no keys"
+    raise ValueError(f"region has {got}; use one of {ACCEPTED}")
+
+
+def checked_region_box(region: Any, smallest: float = 0.5) -> Tuple[float, float, float, float]:
+    """region_box, and the region must be at least `smallest` mm on each side."""
+    x0, y0, x1, y1 = region_box(region)
+    if x1 - x0 < smallest or y1 - y0 < smallest:
+        raise ValueError(
+            f"region is {x1 - x0:.3g} x {y1 - y0:.3g} mm; it must be at least {smallest} mm "
+            f"on each side (for a square round a point use {{x, y, size}})"
+        )
+    return x0, y0, x1, y1
+
+
+def _number(value: Any, key: str) -> float:
+    if isinstance(value, bool):
+        raise ValueError(f"region {key} must be a number, got {value!r}")
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"region {key} must be a number, got {value!r}") from None
+
+
+def _ordered(x0: float, y0: float, x1: float, y1: float) -> Tuple[float, float, float, float]:
+    return min(x0, x1), min(y0, y1), max(x0, x1), max(y0, y1)
+
+
+def region_dict(box: Tuple[float, float, float, float]) -> Dict[str, Any]:
+    x0, y0, x1, y1 = box
+    return {"x0": round(x0, 4), "y0": round(y0, 4), "x1": round(x1, 4), "y1": round(y1, 4), "unit": "mm"}
diff --git a/python/utils/track45.py b/python/utils/track45.py
new file mode 100644
index 0000000..2d30edb
--- /dev/null
+++ b/python/utils/track45.py
@@ -0,0 +1,469 @@
+"""Tracks the way a careful PCB designer draws them (PowerLab patch).
+
+Pure geometry, no pcbnew or kipy: route_trace and route_pad_to_pad build their polyline
+here, in both modes. Coordinates are in mm, y pointing down as on the board.
+
+- Every piece runs at 0, 45 or 90 degrees: a run between two points that isn't on one of
+  those angles becomes straight + 45 degree diagonal (+ straight).
+- Where an end is a pad, the track comes out of its centre straight along one of its
+  axes (the long one first), far enough to clear the pad before it turns. A pad that isn't
+  fine pitch may also be entered at 45 degrees straight to its centre, and a round pad from
+  any 45 degree direction. No bend just before a pad.
+- Corners that turn more than 45 degrees (90 and sharper) are cut with 45 degree chamfers:
+  about min(1 mm, a third of the shorter neighbouring piece).
+- joint_chamfer() gives the cut for a corner with a track that is already on the board,
+  where a new track starts or ends on its end.
+
+A pad is a dict: x, y (centre), w, h (size in the pad's own frame), angle (KiCad's
+orientation in degrees, counter-clockwise on screen), shape ("circle", "oval", "rect",
+"roundrect", ...), fine (bool: another pad of its part closer than 0.8 mm) and body
+(optional (x, y) of the part's centre, so a track doesn't leave towards the part's body).
+"""
+
+import math
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+Point = Tuple[float, float]
+
+TOL_DEG = 0.5  # a piece within this of a multiple of 45 degrees counts as on the grid
+EPS = 1e-4  # mm; shorter pieces are dropped
+MAX_CHAMFER = 1.0  # mm
+FINE_PITCH = 0.8  # mm; as the PowerLab router (powerlab_router/model.py)
+
+# Costs, in mm of track length, of what a designer avoids.
+_BEND = ((TOL_DEG, 0.0), (45 + TOL_DEG, 0.2), (90 + TOL_DEG, 0.5), (135 + TOL_DEG, 1.5))
+_U_TURN = 50.0
+_OFF_AXIS = 10.0  # leaving a pad in a direction none of its edges is square to
+_SHORT_AXIS = 0.1  # leaving across the long edge instead of along the long axis
+_DIAGONAL = 0.5  # leaving at 45 degrees (allowed where the pad isn't fine pitch)
+_FINE_DIAGONAL = 8.0
+_FINE_ROW = 8.0  # along a fine-pitch pin row: only straight to the next pin (_NEXT_PIN)
+_NEXT_PIN = FINE_PITCH  # a fine-pitch pin's neighbour is closer than this
+_UNDER_BODY = 1.0
+_KINK = 3.0  # a bend before the track has cleared the pad
+_SLIVER = 0.5  # a piece shorter than _SLIVER_LEN between two bends
+_SLIVER_LEN = 0.1
+_INEXACT = 0.25  # a piece within TOL_DEG of the grid but not on it (ends that aren't aligned)
+_EXACT_DEG = 0.01
+
+
+# --- vectors ------------------------------------------------------------------------------
+def _sub(a: Point, b: Point) -> Point:
+    return (a[0] - b[0], a[1] - b[1])
+
+
+def _add(a: Point, b: Point, k: float = 1.0) -> Point:
+    return (a[0] + b[0] * k, a[1] + b[1] * k)
+
+
+def _len(v: Point) -> float:
+    return math.hypot(v[0], v[1])
+
+
+def _unit(v: Point) -> Point:
+    n = _len(v)
+    return (v[0] / n, v[1] / n) if n > 0 else (0.0, 0.0)
+
+
+def _rot(v: Point, deg: float) -> Point:
+    a = math.radians(deg)
+    c, s = math.cos(a), math.sin(a)
+    return (v[0] * c - v[1] * s, v[0] * s + v[1] * c)
+
+
+def _dir(deg: float) -> Point:
+    return (math.cos(math.radians(deg)), math.sin(math.radians(deg)))
+
+
+def _angle(v: Point) -> float:
+    """Direction of v in degrees, board frame (y down), in [0, 360)."""
+    return math.degrees(math.atan2(v[1], v[0])) % 360.0
+
+
+def _turn(u: Point, v: Point) -> float:
+    """Signed turn in degrees from direction u to direction v, in (-180, 180]."""
+    a = math.degrees(math.atan2(u[0] * v[1] - u[1] * v[0], u[0] * v[0] + u[1] * v[1]))
+    return 180.0 if a <= -180.0 + 1e-9 else a
+
+
+def is_octilinear(dx: float, dy: float, tol: float = TOL_DEG) -> bool:
+    """True when (dx, dy) runs at a multiple of 45 degrees (within tol)."""
+    if math.hypot(dx, dy) < EPS:
+        return True
+    a = math.degrees(math.atan2(dy, dx)) / 45.0
+    return abs(a - round(a)) * 45.0 <= tol
+
+
+def _bend_cost(turn: float) -> float:
+    t = abs(turn)
+    for limit, cost in _BEND:
+        if t <= limit:
+            return cost
+    return _U_TURN if t > 180 - TOL_DEG else 1.5 + (t - 135) / 10.0
+
+
+# --- pads ---------------------------------------------------------------------------------
+def _pad_axes(pad: Dict[str, Any]) -> Tuple[Point, Point]:
+    """The pad's own x and y axes on the board (KiCad turns counter-clockwise on screen)."""
+    a = math.radians(float(pad.get("angle") or 0.0))
+    return (math.cos(a), -math.sin(a)), (math.sin(a), math.cos(a))
+
+
+def is_round(pad: Dict[str, Any]) -> bool:
+    shape = str(pad.get("shape") or "").lower()
+    w, h = float(pad.get("w") or 0), float(pad.get("h") or 0)
+    return shape == "circle" or (shape == "oval" and abs(w - h) < 1e-6)
+
+
+def pad_extent(pad: Dict[str, Any], u: Point) -> float:
+    """How far the pad reaches from its centre in direction u."""
+    w, h = float(pad.get("w") or 0) / 2, float(pad.get("h") or 0) / 2
+    if is_round(pad):
+        return max(w, h)
+    ex, ey = _pad_axes(pad)
+    return abs(u[0] * ex[0] + u[1] * ex[1]) * w + abs(u[0] * ey[0] + u[1] * ey[1]) * h
+
+
+def pad_contains(pad: Dict[str, Any], x: float, y: float, margin: float = 0.0) -> bool:
+    """True when (x, y) is on the pad (its bounding shape, grown by margin)."""
+    d = (x - float(pad["x"]), y - float(pad["y"]))
+    w, h = float(pad.get("w") or 0) / 2 + margin, float(pad.get("h") or 0) / 2 + margin
+    if is_round(pad):
+        return _len(d) <= max(w, h)
+    ex, ey = _pad_axes(pad)
+    return abs(d[0] * ex[0] + d[1] * ex[1]) <= w and abs(d[0] * ey[0] + d[1] * ey[1]) <= h
+
+
+def escape_length(pad: Dict[str, Any], u: Point, width: float) -> float:
+    """How far a track leaving the pad's centre along u runs straight before it may turn
+    (like the PowerLab router's pad lanes)."""
+    return pad_extent(pad, u) + max(width, 0.5 if pad.get("fine") else 0.3)
+
+
+def entry_directions(pad: Dict[str, Any]) -> List[Tuple[Point, float]]:
+    """Directions (unit vectors, out of the pad's centre) a track may leave or enter the
+    pad by, with their cost: along its long axis, square to an edge, at 45 degrees where
+    the pad isn't fine pitch, any of the eight for a round pad."""
+    ex, _ey = _pad_axes(pad)
+    base = _angle(ex)
+    w, h = float(pad.get("w") or 0), float(pad.get("h") or 0)
+    rnd = is_round(pad)
+    fine = bool(pad.get("fine"))
+    out = None
+    body = pad.get("body")
+    if body is not None:
+        o = (float(pad["x"]) - float(body[0]), float(pad["y"]) - float(body[1]))
+        if _len(o) > 0.05:
+            out = _unit(o)
+    result = []
+    for k in range(8):
+        u = _dir(base + 45 * k)
+        if rnd:
+            cost = 0.0
+        elif k % 2:
+            cost = _FINE_DIAGONAL if fine else _DIAGONAL
+        else:
+            along_x = k % 4 == 0
+            long_x = w >= h
+            cost = 0.0 if abs(w - h) < 1e-6 or along_x == long_x else _SHORT_AXIS
+        if out is not None:
+            dot = u[0] * out[0] + u[1] * out[1]
+            if dot < -0.3:
+                cost += _UNDER_BODY
+            if fine and not rnd and dot < 0.7:
+                cost += _FINE_ROW
+        result.append((u, cost))
+    return result
+
+
+def _pad_dir_cost(pad: Dict[str, Any], u: Point, entries=None, next_pin: bool = False) -> float:
+    """Cost of leaving the pad along u. next_pin: the track runs straight to a pad right
+    beside it, which may be along a fine-pitch pin row (the pad is the junction, §3.4)."""
+    best = _OFF_AXIS
+    for d, cost in entries if entries is not None else entry_directions(pad):
+        if abs(_turn(d, u)) <= TOL_DEG:
+            if next_pin and cost >= _FINE_ROW:
+                cost = cost - _FINE_ROW + _SHORT_AXIS
+            best = min(best, cost)
+    return best
+
+
+# --- polylines ----------------------------------------------------------------------------
+def cleanup(points: Sequence[Point]) -> List[Point]:
+    """Drop repeated points and points in the middle of a straight run."""
+    pts: List[Point] = []
+    for p in points:
+        p = (float(p[0]), float(p[1]))
+        if pts and _len(_sub(p, pts[-1])) < EPS:
+            continue
+        pts.append(p)
+    changed = True
+    while changed and len(pts) > 2:
+        changed = False
+        for i in range(1, len(pts) - 1):
+            a, b = _sub(pts[i], pts[i - 1]), _sub(pts[i + 1], pts[i])
+            if abs(_turn(a, b)) < 1e-3:
+                del pts[i]
+                changed = True
+                break
+    return pts
+
+
+def _octilinear_paths(p: Point, q: Point, splits: Sequence[float] = ()) -> List[List[Point]]:
+    """Ways from p to q made of 0/45/90 degree pieces: straight + 45 (+ straight), the
+    45 first, 45 between two straights (split evenly, or at `splits` mm from p), straight
+    between two 45s, and the two L shapes (their corner is chamfered later)."""
+    dx, dy = q[0] - p[0], q[1] - p[1]
+    if math.hypot(dx, dy) < EPS:
+        return [[p]]
+    out: List[List[Point]] = []
+    if is_octilinear(dx, dy):
+        out.append([p, q])
+    if not is_octilinear(dx, dy, _EXACT_DEG):  # also the exact way when only near the grid
+        sx, sy = math.copysign(1.0, dx), math.copysign(1.0, dy)
+        diag = min(abs(dx), abs(dy))
+        if abs(dx) > abs(dy):
+            o, lo = (sx, 0.0), abs(dx) - diag
+        else:
+            o, lo = (0.0, sy), abs(dy) - diag
+        dv = (sx * diag, sy * diag)  # the whole 45 degree part
+        out.append([p, _add(p, o, lo), q])
+        out.append([p, _add(p, dv), q])
+        for a in [lo / 2] + [s for s in splits if 0 < s < lo]:
+            m = _add(p, o, a)
+            out.append([p, m, _add(m, dv), q])
+        m = _add(p, dv, 0.5)
+        out.append([p, m, _add(m, o, lo), q])
+    if abs(dx) > EPS and abs(dy) > EPS:
+        out.append([p, (q[0], p[1]), q])
+        out.append([p, (p[0], q[1]), q])
+    return out
+
+
+def _path_cost(path, width, pad_a, dir_a, pad_b, dir_b, ent_a=None, ent_b=None, room=0.5) -> float:
+    pts = cleanup(path)
+    if len(pts) < 2:
+        return 0.0
+    cost = sum(_len(_sub(pts[i + 1], pts[i])) for i in range(len(pts) - 1))
+    turns = [_turn(_sub(pts[i], pts[i - 1]), _sub(pts[i + 1], pts[i])) for i in range(1, len(pts) - 1)]
+    cost += sum(_bend_cost(t) for t in turns)
+    last_i = len(pts) - 2
+    for i in range(last_i + 1):
+        d = _sub(pts[i + 1], pts[i])
+        pad_end = (i == 0 and pad_a is not None) or (i == last_i and pad_b is not None)
+        if not is_octilinear(d[0], d[1]):
+            if not pad_end:
+                cost += _OFF_AXIS  # only a pad's own axis may be off the 45 degree grid
+        elif not pad_end and not is_octilinear(d[0], d[1], _EXACT_DEG):
+            cost += _INEXACT
+        if last_i > 0 and _len(d) < _SLIVER_LEN:
+            cost += _SLIVER
+    # a corner that will be chamfered needs room beyond the pad's escape for the cut
+    room_a = room if turns and abs(turns[0]) > 45 + TOL_DEG else 0.0
+    room_b = room if turns and abs(turns[-1]) > 45 + TOL_DEG else 0.0
+    first = _sub(pts[1], pts[0])
+    last = _sub(pts[-1], pts[-2])
+    next_pin = len(pts) == 2 and pad_a is not None and pad_b is not None and _len(first) < _NEXT_PIN
+    if pad_a is not None:
+        u = _unit(first)
+        cost += _pad_dir_cost(pad_a, u, ent_a, next_pin)
+        # a bend under the pad's own copper doesn't show: only one just outside it is a kink
+        if (len(pts) > 2 and _len(first) < escape_length(pad_a, u, width) + room_a - 1e-6
+                and not pad_contains(pad_a, *pts[1])):
+            cost += _KINK
+    if dir_a is not None:
+        cost += _bend_cost(_turn(dir_a, first))
+    if pad_b is not None:
+        u = _unit((-last[0], -last[1]))
+        cost += _pad_dir_cost(pad_b, u, ent_b, next_pin)
+        if (len(pts) > 2 and _len(last) < escape_length(pad_b, u, width) + room_b - 1e-6
+                and not pad_contains(pad_b, *pts[-2])):
+            cost += _KINK
+    if dir_b is not None:
+        cost += _bend_cost(_turn(last, dir_b))
+    return cost
+
+
+def _segment(p, q, width, pad_a=None, dir_a=None, pad_b=None, dir_b=None, room=0.5):
+    """The best 0/45/90 degree way from p to q, given what each end must respect."""
+    def leads(pad, at, other):
+        """(first point out of the pad, escape length) per entry direction: just clear of
+        the pad, with room for a chamfer, and where the rest lines up with the 45 degree
+        grid towards `other`."""
+        if pad is None:
+            return [(None, 0.0)]
+        out = [(None, 0.0)]
+        r = _sub(other, at)
+        for u, cost in entry_directions(pad):
+            if cost >= _OFF_AXIS:
+                continue
+            e = escape_length(pad, u, width)
+            lengths = {e, e + room}
+            if is_octilinear(u[0], u[1], _EXACT_DEG):  # off the grid: only just out of the pad
+                for num, den in ((r[0], u[0]), (r[1], u[1]), (r[0] - r[1], u[0] - u[1]),
+                                 (r[0] + r[1], u[0] + u[1])):
+                    if abs(den) > 1e-9 and e < num / den < _len(r):
+                        lengths.add(num / den)
+            for length in sorted(lengths):
+                out.append((_add(at, u, length), e))
+        return out
+
+    ent_a = entry_directions(pad_a) if pad_a is not None else None
+    ent_b = entry_directions(pad_b) if pad_b is not None else None
+    candidates: List[List[Point]] = [[p, q]]  # straight, e.g. along both pads' axis
+    for a, ea in leads(pad_a, p, q):
+        for b, eb in leads(pad_b, q, p):
+            s = a or p
+            t = b or q
+            splits = [x for x in (ea, eb) if x > 0]
+            dx, dy = t[0] - s[0], t[1] - s[1]
+            lo = abs(abs(dx) - abs(dy))
+            splits = splits + [lo - x for x in splits]
+            for mid in _octilinear_paths(s, t, splits):
+                path = ([p] if a else []) + mid + ([q] if b else [])
+                candidates.append(path)
+    best, best_cost = None, None
+    for path in candidates:
+        c = _path_cost(path, width, pad_a, dir_a, pad_b, dir_b, ent_a, ent_b, room)
+        if best_cost is None or c < best_cost - 1e-9:
+            best, best_cost = path, c
+    return cleanup(best or [p, q])
+
+
+def chamfer(points: Sequence[Point], max_chamfer: float = MAX_CHAMFER,
+            keep_first: float = 0.0, keep_last: float = 0.0) -> List[Point]:
+    """Cut every corner that turns more than 45 degrees with 45 degree pieces (one for a
+    90 degree corner, two for 135). The cut runs back about min(max_chamfer, a third of
+    the shorter neighbouring piece) along each piece; the first and last pieces keep at
+    least keep_first / keep_last mm straight (a pad's escape) where they are long enough."""
+    pts = cleanup(points)
+    n = len(pts)
+    if n < 3:
+        return pts
+    lens = [_len(_sub(pts[i + 1], pts[i])) for i in range(n - 1)]
+
+    def avail(i: int) -> float:
+        keep = keep_first if i == 0 else keep_last if i == n - 2 else 0.0
+        if keep > 0 and lens[i] - keep > 0.01:
+            return lens[i] - keep
+        return lens[i] / 3.0
+
+    out: List[Point] = [pts[0]]
+    for i in range(1, n - 1):
+        u_in = _unit(_sub(pts[i], pts[i - 1]))
+        u_out = _unit(_sub(pts[i + 1], pts[i]))
+        t = _turn(u_in, u_out)
+        if abs(t) <= 45 + TOL_DEG or abs(t) >= 180 - TOL_DEG:
+            out.append(pts[i])
+            continue
+        c = min(max_chamfer, avail(i - 1), avail(i))
+        if c < EPS:
+            out.append(pts[i])
+            continue
+        out.extend(_cut(pts[i], u_in, u_out, t, c))
+    out.append(pts[-1])
+    return cleanup(out)
+
+
+def _cut(v: Point, u_in: Point, u_out: Point, t: float, c: float) -> List[Point]:
+    """Points replacing corner v: c back along the way in, c on along the way out, with
+    pieces between that turn at most 45 degrees each."""
+    steps = int(math.ceil((abs(t) - TOL_DEG) / 45.0))
+    dirs = [_rot(u_in, t * j / steps) for j in range(1, steps)]
+    a = _add(v, u_in, -c)
+    b = _add(v, u_out, c)
+    total = (sum(d[0] for d in dirs), sum(d[1] for d in dirs))
+    s = _len(_sub(b, a)) / _len(total) if _len(total) > 0 else 0.0
+    pts = [a]
+    for d in dirs[:-1]:
+        pts.append(_add(pts[-1], d, s))
+    pts.append(b)
+    return pts
+
+
+def joint_chamfer(far: Point, joint: Point, nxt: Point, max_chamfer: float = MAX_CHAMFER,
+                  keep_next: float = 0.0) -> Optional[Dict[str, Any]]:
+    """The cut for the corner at `joint`, where a track already on the board (from `far`)
+    meets a new track's first piece (towards `nxt`). None when that corner turns 45
+    degrees or less. Otherwise {"existing_end": the point the existing track now ends at,
+    "points": the new track's first points from there, ending on its first piece}: the new
+    track becomes points + its points after the joint."""
+    u_in = _unit(_sub(joint, far))
+    u_out = _unit(_sub(nxt, joint))
+    if _len(u_in) == 0 or _len(u_out) == 0:
+        return None
+    t = _turn(u_in, u_out)
+    if abs(t) <= 45 + TOL_DEG or abs(t) >= 180 - TOL_DEG:
+        return None
+    l_in, l_out = _len(_sub(joint, far)), _len(_sub(nxt, joint))
+    a_out = l_out - keep_next if keep_next > 0 and l_out - keep_next > 0.01 else l_out / 3.0
+    c = min(max_chamfer, l_in / 3.0, a_out)
+    if c < EPS:
+        return None
+    pts = _cut(joint, u_in, u_out, t, c)
+    return {"existing_end": pts[0], "points": pts, "turn": abs(t), "cut": c}
+
+
+def route(points: Sequence[Point], width: float = 0.25,
+          start_pad: Optional[Dict[str, Any]] = None, end_pad: Optional[Dict[str, Any]] = None,
+          start_dir: Optional[Point] = None, end_dir: Optional[Point] = None,
+          max_chamfer: float = MAX_CHAMFER) -> List[Point]:
+    """A 0/45/90 degree polyline through `points` (start, waypoints..., end, in mm), with
+    its corners chamfered.
+
+    start_pad / end_pad: the pad at that end (dict, see the module doc); the end moves to
+    the pad's centre and the track leaves it straight along an axis. start_dir / end_dir:
+    the direction of travel of a track already ending there (into the start, out of the
+    end), so the new track goes on that way where it can."""
+    pts = [(float(p[0]), float(p[1])) for p in points]
+    if len(pts) < 2:
+        return pts
+    if start_pad is not None:
+        pts[0] = (float(start_pad["x"]), float(start_pad["y"]))
+    if end_pad is not None:
+        pts[-1] = (float(end_pad["x"]), float(end_pad["y"]))
+    sd = _unit(start_dir) if start_dir is not None and _len(start_dir) > 0 else None
+    ed = _unit(end_dir) if end_dir is not None and _len(end_dir) > 0 else None
+    out: List[Point] = [pts[0]]
+    n = len(pts) - 1
+    for i in range(n):
+        p = out[-1]
+        q = pts[i + 1]
+        dir_a = sd if i == 0 else (_unit(_sub(out[-1], out[-2])) if len(out) > 1 else None)
+        seg = _segment(
+            p, q, width,
+            pad_a=start_pad if i == 0 else None, dir_a=dir_a,
+            pad_b=end_pad if i == n - 1 else None, dir_b=ed if i == n - 1 else None,
+            room=min(max_chamfer, 0.5),
+        )
+        out.extend(seg[1:])
+    out = cleanup(out)
+    keep_first = keep_last = 0.0
+    if start_pad is not None and len(out) > 1:
+        keep_first = escape_length(start_pad, _unit(_sub(out[1], out[0])), width)
+    if end_pad is not None and len(out) > 1:
+        keep_last = escape_length(end_pad, _unit(_sub(out[-2], out[-1])), width)
+    out = chamfer(out, max_chamfer, keep_first, keep_last)
+    return [(round(x, 6), round(y, 6)) for x, y in out]
+
+
+def segments(points: Sequence[Point]) -> List[Dict[str, Any]]:
+    """The pieces of a polyline: start, end, length and angle (degrees, 0 = right,
+    90 = up on screen, as KiCad shows angles)."""
+    out = []
+    for a, b in zip(points, points[1:]):
+        d = _sub(b, a)
+        out.append({
+            "start": {"x": round(a[0], 6), "y": round(a[1], 6), "unit": "mm"},
+            "end": {"x": round(b[0], 6), "y": round(b[1], 6), "unit": "mm"},
+            "length": round(_len(d), 4),
+            "angle": round(math.degrees(math.atan2(-d[1], d[0])) % 360.0, 2),
+        })
+    return out
+
+
+def max_turn(points: Sequence[Point]) -> float:
+    """The sharpest turn along a polyline, in degrees (for checks)."""
+    pts = cleanup(points)
+    return max((abs(_turn(_sub(pts[i], pts[i - 1]), _sub(pts[i + 1], pts[i])))
+                for i in range(1, len(pts) - 1)), default=0.0)
