+++ b/python/commands/powerlab_router/patterns.py
@@ -0,0 +1,111 @@
+"""Hand-drawn shapes for a run of track (plan §15 follow-up). No pcbnew.
+
+A person routes a run between two fixed points (a pin's stub, a via) with a few long
+straight segments: straight, one bend, or a Z of up to three bends, every bend 45 degrees.
+These are those shapes, as lists of points: segment directions are multiples of 45
+degrees and each turns by exactly 45 from the last. The run leaves `a` heading `da` and
+arrives at `b` heading `db` (direction indices 0-7, 45 degrees apart, 0 = +x, 2 = +y;
+None = any, e.g. at a via).
+
+The free parameters (where the middle segments lie) are sampled every `step` mm, so
+parallel tracks can sit on a regular pitch.
+"""
+
+import math
+
+DIRS = [(math.cos(math.radians(45 * k)), math.sin(math.radians(45 * k))) for k in range(8)]
+EPS = 1e-6
+
+
+def _solve2(u, v, r):
+    """l, m with l*u + m*v = r, or None if u and v are parallel."""
+    det = u[0] * v[1] - u[1] * v[0]
+    if abs(det) < EPS:
+        return None
+    return ((r[0] * v[1] - r[1] * v[0]) / det, (u[0] * r[1] - u[1] * r[0]) / det)
+
+
+def _sequences(da, db, most):
+    """Direction sequences from da to db, each step turning by 45 degrees, up to `most` segments."""
+    starts = [da] if da is not None else list(range(8))
+    out = []
+
+    def grow(seq):
+        if db is None or seq[-1] == db:
+            out.append(list(seq))
+        if len(seq) == most:
+            return
+        for turn in (1, -1):
+            grow(seq + [(seq[-1] + turn) % 8])
+
+    for s in starts:
+        grow([s])
+    return out
+
+
+def shapes(a, da, b, db, most=4, step=0.1, min_segment=0.3, reach=1.5):
+    """Point lists from a to b (a and b included) for every direction sequence of up to
+    `most` segments; the middle segments' lengths are sampled every `step` mm up to
+    `reach` times the distance. Segments other than the first and last are at least
+    `min_segment` long; the first and last may be 0 (a bend right at a or b)."""
+    r = (b[0] - a[0], b[1] - a[1])
+    dist = math.hypot(*r)
+    if dist < EPS:
+        return []
+    top = max(dist * reach, 1.0)
+    samples = [k * step for k in range(int(top / step) + 1)]
+    out = []
+    for seq in _sequences(da, db, most):
+        u = [DIRS[d] for d in seq]
+        n = len(seq)
+        if n == 1:
+            if abs(u[0][0] * r[1] - u[0][1] * r[0]) < EPS * max(1, dist) and u[0][0] * r[0] + u[0][1] * r[1] > 0:
+                out.append([a, b])
+            continue
+        # two segments whose lengths are solved for; the others are sampled
+        pairs = [(0, n - 1)] + [(i, j) for i in range(n) for j in range(i + 1, n) if (i, j) != (0, n - 1)]
+        solve = next(((i, j) for i, j in pairs if abs(u[i][0] * u[j][1] - u[i][1] * u[j][0]) > EPS), None)
+        if solve is None:
+            continue
+        free = [k for k in range(n) if k not in solve]
+        for vals in _grid(samples, len(free)):
+            lengths = [0.0] * n
+            for k, v in zip(free, vals):
+                lengths[k] = v
+            rest = (r[0] - sum(lengths[k] * u[k][0] for k in free), r[1] - sum(lengths[k] * u[k][1] for k in free))
+            ends = _solve2(u[solve[0]], u[solve[1]], rest)
+            if ends is None:
+                continue
+            lengths[solve[0]], lengths[solve[1]] = ends
+            if any(L < -EPS for L in lengths):
+                continue
+            if any(lengths[k] < min_segment for k in range(1, n - 1)):
+                continue  # a middle segment too short to draw
+            pts = [a]
+            for d, L in zip(u, lengths):
+                if L > EPS:
+                    pts.append((pts[-1][0] + d[0] * L, pts[-1][1] + d[1] * L))
+            pts[-1] = b  # exact end
+            out.append(pts)
+    return out
+
+
+def _grid(samples, k):
+    if k == 0:
+        yield ()
+        return
+    for v in samples:
+        for rest in _grid(samples, k - 1):
+            yield (v,) + rest
+
+
+def bends(pts):
+    """Changes of direction along a point list; points on a straight line (a pad's lane
+    exit, the end of a stub) are not bends."""
+    n = 0
+    for a, b, c in zip(pts, pts[1:], pts[2:]):
+        ux, uy, vx, vy = b[0] - a[0], b[1] - a[1], c[0] - b[0], c[1] - b[1]
+        lu, lv = math.hypot(ux, uy), math.hypot(vx, vy)
+        if lu > EPS and lv > EPS and abs(ux * vy - uy * vx) > 1e-3 * lu * lv:
+            n += 1
+    return n
diff --git a/python/commands/powerlab_router/pours.py b/python/commands/powerlab_router/pours.py
new file mode 100644
index 0000000..8df2566
--- /dev/null
+++ b/python/commands/powerlab_router/pours.py
@@ -0,0 +1,200 @@
+"""After routing: pours round the power rails, and GND stitching vias (design rules §3.3, §3.5).
+
+Power polygons (§3.3, "power rails are copper areas, not traces"): every power rail with
+tracks gets a pour on each layer it runs on, drawn round its tracks and pads with a margin
+(POWER_MARGINS), above the GND pour, so it widens the rail wherever there is room and the
+GND pour flows round it. A pour that adds a DRC error is tried with a smaller margin, then
+left out. The track stays inside it, so the rail stays connected even
+where the pour can't fill. Pads join the pour with thermal reliefs; only the high-current
+nets the user names connect solid (§3.3, pour quality). A layer that already has a pour
+of that net is left alone.
+
+Stitching vias (§3.5): GND vias about `pitch` apart where every GND pour layer is filled
+round the via, kept clear of other nets (the router's via grid and the exact check), of
+the escape room at fine-pitch pins, and of the GND vias already there.
+"""
+
+import math
+
+import pcbnew
+
+from commands.powerlab_router.model import MM, T, _Occupancy, _polys
+
+POWER_MARGINS = (1.0, 0.5, 0.25)  # mm of pour beyond a power track's or pad's edge, tried in turn
+OUTLINE_ERR = 0.05  # mm: corner error of the pour outlines (fewer points than the copper)
+THERMAL_GAP = 0.3
+STITCH_SEARCH = 0.25  # mm steps when looking near a grid point for a free spot
+STITCH_FILL_MARGIN = 0.15  # mm of filled pour round a stitching via's pad, on every layer
+
+
+def _zones(board, net, L):
+    return [z for z in board.Zones() if not z.GetIsRuleArea() and z.GetNetname() == net and z.IsOnLayer(L)]
+
+
+def _gnd_quality(router):
+    """(minus the summed largest-piece share, pieces) of the pour nets' fill, all zones
+    refilled: like Router._pour_quality, but with every zone filled, so a higher-priority
+    pour of another net is cut out of the GND pour as KiCad does it."""
+    rb = router.rb
+    pcbnew.ZONE_FILLER(rb.board).Fill(rb.board.Zones())
+    count, share = 0, 0.0
+    for z in rb.board.Zones():
+        if z.GetIsRuleArea() or z.GetNetname() not in rb.pour_nets:
+            continue
+        for L in z.GetLayerSet().CuStack():
+            f = z.GetFilledPolysList(L)
+            areas = [f.Outline(i).Area() / 1e12 for i in range(f.OutlineCount())]
+            count += len([a for a in areas if a >= 2.0])
+            share += max(areas) / sum(areas) if areas else 1.0
+    return (-round(share / 0.02) * 0.02, count)
+
+
+def power_pours(router, nets, solid=(), margins=POWER_MARGINS, check=None):
+    """Pours round the power rails' tracks; returns {net: [layer names]} and what was skipped.
+
+    Not on a GND plane layer (the bottom of a 2-layer board, an inner layer with a GND
+    pour on more layers), where the GND pour is the return plane: rails go on the parts
+    layer (§3.3). There the rail's pour may divide the GND pour of that layer; the plane
+    stays whole, and the stitching vias tie the pieces to it. The report gives the GND
+    pour before and after (_gnd_quality).
+    `check()`: the board's DRC errors (a set). A pour that adds one (a pad whose thermal
+    spokes don't fit, a GND island it cuts off) is tried again with the next, smaller
+    margin, then left out."""
+    rb = router.rb
+    board = rb.board
+    if len(rb.layers) == 2:
+        plane = {rb.layers[-1]}
+    else:
+        plane = {L for L in rb.layers[1:-1] if any(_zones(board, n, L) for n in rb.pour_nets)}
+    before = _gnd_quality(router)
+    base = check() if check else None
+    solid = set(solid)
+    pour_zones = [z for z in board.Zones() if not z.GetIsRuleArea() and z.GetNetname() in rb.pour_nets]
+    priority = max([z.GetAssignedPriority() for z in pour_zones] + [0]) + 1
+    min_width = min([T(z.GetMinThickness()) for z in pour_zones] + [0.25])
+    clip = rb.outline.CloneDropTriangulation()
+    clip.Inflate(MM(-rb.edge_clearance), pcbnew.CORNER_STRATEGY_CHAMFER_ALL_CORNERS, MM(OUTLINE_ERR))
+    made, skipped = {}, {}
+
+    def place(net, info, L, items, margin, w):
+        sp = pcbnew.SHAPE_POLY_SET()
+        for it in items:
+            it.TransformShapeToPolygon(sp, L, MM(margin), MM(OUTLINE_ERR), pcbnew.ERROR_OUTSIDE)
+        sp.Simplify()
+        sp.BooleanIntersection(clip)
+        added = []
+        for i in range(sp.OutlineCount()):
+            z = pcbnew.ZONE(board)
+            z.SetLayer(L)
+            z.SetNet(info)
+            z.SetAssignedPriority(priority)
+            z.SetZoneName(f"{net} pour")
+            z.SetPadConnection(pcbnew.ZONE_CONNECTION_FULL if net in solid else pcbnew.ZONE_CONNECTION_THERMAL)
+            z.SetThermalReliefGap(MM(THERMAL_GAP))
+            z.SetThermalReliefSpokeWidth(MM(max(min_width, min(w, 0.5))))
+            z.SetMinThickness(MM(min_width))
+            z.SetIslandRemovalMode(pcbnew.ISLAND_REMOVAL_MODE_ALWAYS)
+            # copied into the zone's own outline: SetOutline() would keep a pointer to a
+            # polygon Python frees later
+            z.Outline().AddOutline(sp.Outline(i))
+            board.Add(z)
+            added.append(z)
+        return added
+
+    for net in nets:
+        tracks = [t for t in board.GetTracks() if t.GetNetname() == net and t.Type() != pcbnew.PCB_VIA_T]
+        pads = [p for p in rb.pads if p.GetNetname() == net]
+        info = board.FindNet(net)
+        if not tracks or info is None:
+            continue
+        w = rb.widths(net)[0]
+        for L in rb.layers:
+            on = [t for t in tracks if t.IsOnLayer(L)]
+            if not on:
+                continue
+            name = rb.layer_names[L]
+            if L in plane:
+                skipped.setdefault(net, []).append(f"{name}: the GND plane layer")
+                continue
+            if _zones(board, net, L):
+                skipped.setdefault(net, []).append(f"{name}: has a pour already")
+                continue
+            why = "no room"
+            for margin in margins:
+                added = place(net, info, L, on + [p for p in pads if p.IsOnLayer(L)], margin, w)
+                pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+                if added and any(z.GetFilledPolysList(L).OutlineCount() for z in added):
+                    errors = check() - base if check else set()
+                    if not errors:
+                        made.setdefault(net, []).append(name)
+                        break
+                    why = "it would add DRC errors: " + ", ".join(sorted({kind for kind, _u in errors}))
+                for z in added:
+                    board.Remove(z)
+            else:
+                skipped.setdefault(net, []).append(f"{name}: {why}")
+    pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+    after = _gnd_quality(router)
+    router._q = None
+    return {"added": {n: sorted(set(v)) for n, v in made.items() if v}, "skipped": skipped,
+            "pad_connection": {n: ("solid" if n in solid else "thermal reliefs") for n in made},
+            "gnd_pour": {"before": before, "after": after}}
+
+
+def stitching_vias(router, pitch=5.0):
+    """GND stitching vias on a `pitch` grid, each moved to a free spot nearby."""
+    rb = router.rb
+    board = rb.board
+    net = router.pour_net
+    layers = [L for L in rb.layers if _zones(board, net, L)] if net else []
+    if not net or len(layers) < 2:
+        return {"added": 0, "why": "no pour net with pours on two layers"}
+    pcbnew.ZONE_FILLER(board).Fill(board.Zones())
+    _cls, _w, vd, _name = key = rb.key(net)
+    # a fresh grid: the power pours added after routing are copper of other nets now
+    occ = _Occupancy(rb, key)
+    g = rb.grid
+    via_ok = occ.blocked(net)[1]
+    fills = []
+    for L in layers:
+        f = pcbnew.SHAPE_POLY_SET()
+        for z in _zones(board, net, L):
+            f.BooleanAdd(z.GetFilledPolysList(L))
+        f.Deflate(MM(vd / 2 + STITCH_FILL_MARGIN), pcbnew.CORNER_STRATEGY_ROUND_ALL_CORNERS, MM(0.01))
+        fills.append(f)
+    escape = [e > 0 for e in router.lab.escape_total] if getattr(router, "lab", None) else None
+    vias = [(T(t.GetPosition().x), T(t.GetPosition().y)) for t in board.GetTracks()
+            if t.Type() == pcbnew.PCB_VIA_T and t.GetNetname() == net]
+    spacing = 0.6 * pitch
+
+    def free(x, y):
+        i, j = g.cell(x, y)
+        if not (0 <= i < g.nx and 0 <= j < g.ny) or not via_ok[j * g.nx + i]:
+            return False
+        if escape is not None and any(e[j, i] for e in escape):
+            return False
+        if any(math.dist((x, y), v) < spacing for v in vias):
+            return False
+        p = pcbnew.VECTOR2I(MM(x), MM(y))
+        return all(f.Contains(p) for f in fills)
+
+    added = []
+    x0, y0, x1, y1 = g.x0 + pitch / 2, g.y0 + pitch / 2, g.x0 + g.nx * g.pitch, g.y0 + g.ny * g.pitch
+    reach = int(pitch / 2 / STITCH_SEARCH)
+    y = y0
+    while y < y1:
+        x = x0
+        while x < x1:
+            spots = sorted(((dx, dy) for dx in range(-reach, reach + 1) for dy in range(-reach, reach + 1)),
+                           key=lambda d: d[0] * d[0] + d[1] * d[1])
+            for dx, dy in spots:
+                v = (round(x + dx * STITCH_SEARCH, 3), round(y + dy * STITCH_SEARCH, 3))
+                if free(*v) and router._via_fits(net, v):
+                    items = rb.add(net, [], [v])
+                    rb.commit(net, items)
+                    vias.append(v)
+                    added.append(v)
+                    break
+            x += pitch
+        y += pitch
+    return {"added": len(added), "pitch_mm": pitch, "via": [vd, rb.widths(net)[2]]}
