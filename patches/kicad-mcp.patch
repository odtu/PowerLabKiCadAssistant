+"""Board design rules in the project file, and the METU PowerLab preset (PowerLab patch).
+
+KiCad 10 keeps Board Setup -> Design Rules -> Constraints in ``<project>.kicad_pro``
+(``board.design_settings.rules``), the net classes in ``net_settings.classes``, and only
+the solder mask settings in the board file (``(setup (pad_to_mask_clearance ...)
+(solder_mask_min_width ...))``). ``set_design_rules`` used to change the tool's in-memory
+board only, so nothing reached Board Setup.
+
+What KiCad 10.0.5 does with the file (tested on a scratch copy of TestPCB2):
+
+* Its API has no call for board design settings. ``SetNetClasses`` exists, but KiCad's
+  next save after it ends in "An unhandled exception occurred", so it isn't used.
+* It reads ``.kicad_pro`` only when it opens the project: neither File > Revert nor the
+  API's revert reloads it, and Board Setup keeps showing the old values.
+* A board save doesn't rewrite ``.kicad_pro`` while KiCad's project settings are
+  unchanged, so the file keeps the new values. Once anything in them changes (Board
+  Setup closed with OK, even unchanged), the next save writes KiCad's old values back.
+* ``pcbnew.LoadBoard`` in a long-lived Python process behaves the same way: it reuses the
+  project it loaded first, so the process has to unload the project to see the file.
+* A ``.kicad_dru`` file is read again on every DRC run, in KiCad and in kicad-cli. One
+  unknown keyword, or a byte-order mark, makes both drop the whole file silently.
+
+So the values are written into the files, the minimums also go into a "Lab minimums"
+rule in the ``.kicad_dru`` (so DRC enforces them while KiCad still shows the old ones),
+and the caller is told to reopen the project in KiCad.
+
+Pure functions here; no pcbnew or kipy imports, so the tests can load this file alone.
+"""
+
+import json
+import math
+import os
+import tempfile
+from typing import Any, Dict, List, Optional, Tuple
+
+# (parameter, older names still accepted, key in board.design_settings.rules,
+#  BOARD_DESIGN_SETTINGS member, words for the summary)
+RULE_PARAMS: Tuple[Tuple[str, Tuple[str, ...], str, str, str], ...] = (
+    ("minClearance", ("clearance",), "min_clearance", "m_MinClearance", "min clearance"),
+    ("minTrackWidth", (), "min_track_width", "m_TrackMinWidth", "min track width"),
+    ("minConnectionWidth", (), "min_connection", "m_MinConn", "min connection width"),
+    ("minAnnularWidth", (), "min_via_annular_width", "m_ViasMinAnnularWidth", "min annular width"),
+    ("minViaDiameter", (), "min_via_diameter", "m_ViasMinSize", "min via diameter"),
+    ("holeClearance", (), "min_hole_clearance", "m_HoleClearance", "copper to hole"),
+    (
+        "copperEdgeClearance",
+        (),
+        "min_copper_edge_clearance",
+        "m_CopperEdgeClearance",
+        "copper to edge",
+    ),
+    (
+        "minThroughHole",
+        ("minViaDrill", "minHoleDiameter"),
+        "min_through_hole_diameter",
+        "m_MinThroughDrill",
+        "min through hole",
+    ),
+    ("holeToHoleMin", (), "min_hole_to_hole", "m_HoleToHoleMin", "hole to hole"),
+    (
+        "minMicroViaDiameter",
+        ("microViaDiameter",),
+        "min_microvia_diameter",
+        "m_MicroViasMinSize",
+        "min uVia diameter",
+    ),
+    (
+        "minMicroViaDrill",
+        ("microViaDrill",),
+        "min_microvia_drill",
+        "m_MicroViasMinDrill",
+        "min uVia hole",
+    ),
+    ("minSilkTextHeight", (), "min_text_height", "m_MinSilkTextHeight", "min silk text height"),
+    (
+        "minSilkThickness",
+        (),
+        "min_text_thickness",
+        "m_MinSilkTextThickness",
+        "min silk text thickness",
+    ),
+    ("silkClearance", (), "min_silk_clearance", "m_SilkClearance", "silk clearance"),
+)
+
+# Default net class fields: (parameter, older names, key in net_settings.classes)
+CLASS_PARAMS: Tuple[Tuple[str, Tuple[str, ...], str], ...] = (
+    ("defaultTrackWidth", ("trackWidth",), "track_width"),
+    ("defaultClearance", (), "clearance"),
+    ("defaultViaDiameter", ("viaDiameter",), "via_diameter"),
+    ("defaultViaDrill", ("viaDrill",), "via_drill"),
+)
+
+# Board-file settings: (parameter, BOARD_DESIGN_SETTINGS member, words)
+BOARD_FILE_PARAMS: Tuple[Tuple[str, str, str], ...] = (
+    ("solderMaskExpansion", "m_SolderMaskExpansion", "solder mask expansion"),
+    ("solderMaskMinWidth", "m_SolderMaskMinWidth", "solder mask min web"),
+)
