+        lib_fields = self._extract_lib_fields(schematic_path, library_name, symbol_name)
+        if not lib_fields:
+            return 0
+        lib_value = next((f["value"] for f in lib_fields if f["name"] == "Value"), "")
+        lib_pos = self._extract_lib_property_positions(schematic_path, library_name, symbol_name)
+        content = Path(schematic_path).read_text(encoding="utf-8")
+
+        lib_start = content.find("(lib_symbols")
+        lib_end = (
+            lib_start + len(self._extract_paren_block(content, lib_start))
+            if lib_start != -1
+            else -1
+        )
+        lib_id = escape_sexpr_string(f"{library_name}:{symbol_name}")
+        spans = []
+        for m in re.finditer(r'\(lib_id\s+"' + re.escape(lib_id) + r'"\s*\)', content):
+            if lib_start <= m.start() < lib_end:
+                continue
+            start = content.rfind("(symbol", 0, m.start())
+            if start == -1:
+                continue
+            spans.append((start, start + len(self._extract_paren_block(content, start))))
+
+        def _fmt(n: float) -> str:
+            n = round(n, 3)
+            return str(int(n)) if float(n).is_integer() else str(n)
+
+        changed = 0
+        for start, end in reversed(spans):
+            block = content[start:end]
+            props = {
+                unescape_sexpr_string(m.group(1)): m
+                for m in re.finditer(r"\(property\s+" + QUOTED_VALUE + r"\s+" + QUOTED_VALUE, block)
+            }
+            new_block = block
+            value_match = props.get("Value")
+
+            missing = [
+                f
+                for f in lib_fields
+                if f["name"] not in props and not f["name"].startswith("ki_")
+            ]
+            if missing:
+                at = re.search(r"\(at\s+([-\d.]+)\s+([-\d.]+)(?:\s+([-\d.]+))?\)", block)
+                sx, sy = (float(at.group(1)), float(at.group(2))) if at else (0.0, 0.0)
+                # Anchor: the instance's Value position, angle and justification.
+                # Field angles are stored relative to the symbol, so a rating
+                # copies the Value's angle to read the same way on a rotated part.
+                vx, vy, vangle, justify = sx, sy, 0.0, ""
+                if value_match:
+                    vblock = self._extract_paren_block(block, value_match.start())
+                    vat = re.search(r"\(at\s+([-\d.]+)\s+([-\d.]+)(?:\s+([-\d.]+))?", vblock)
+                    if vat:
+                        vx, vy = float(vat.group(1)), float(vat.group(2))
+                        vangle = float(vat.group(3) or 0)
+                    jm = re.search(r"\(justify[^)]*\)", vblock)
+                    justify = jm.group(0) if jm else ""
+                # Ratings stack on the side of the Value away from the Reference:
+                # below it normally, above it where the Value sits above.
+                direction = 1.0
+                ref_match = props.get("Reference")
+                if ref_match:
+                    rat = re.search(
+                        r"\(at\s+[-\d.]+\s+([-\d.]+)",
+                        self._extract_paren_block(block, ref_match.start()),
+                    )
+                    if rat and float(rat.group(1)) > vy:
+                        direction = -1.0
+                lv = lib_pos.get("Value")
+                added = []
+                for f in missing:
+                    pos = lib_pos.get(f["name"])
+                    hidden = pos[4] if pos else True
+                    eff = pos[3] if pos else "(effects (font (size 1.27 1.27)))"
+                    angle = 0.0
+                    if hidden or not (pos and lv):
+                        px, py = sx, sy
+                    else:
+                        # Library y-up offset from the Value, drawn y-down.
+                        px = vx + (pos[0] - lv[0])
+                        py = vy + direction * abs(pos[1] - lv[1])
+                        angle = vangle
+                        eff = re.sub(r"\s*\(justify[^)]*\)", "", eff)
+                        if justify:
+                            eff = eff[:-1].rstrip() + f" {justify})"
+                    eff = re.sub(r"\s*\(hide\s+[^)]*\)", "", eff)
+                    added.append(
+                        f'    (property "{escape_sexpr_string(f["name"])}"'
+                        f' "{escape_sexpr_string(f["value"])}"\n'
+                        f"      (at {_fmt(px)} {_fmt(py)} {_fmt(angle)})\n"
+                        + ("      (hide yes)\n" if hidden else "")
+                        + f"      (show_name {'yes' if f['show_name'] else 'no'})\n"
+                        f"      (do_not_autoplace no)\n"
+                        f"      {eff}\n"
+                        f"    )"
+                    )
+                # After the last existing property, before the pins/instances.
+                last = max(props.values(), key=lambda m: m.start(), default=None)
+                if last is not None:
+                    insert_at = last.start() + len(self._extract_paren_block(block, last.start()))
+                else:
+                    insert_at = block.rfind(")")
+                new_block = block[:insert_at] + "\n" + "\n".join(added) + block[insert_at:]
+
+            # Value last: the insertions above used offsets into the original block.
+            if value_match and unescape_sexpr_string(value_match.group(2)) == symbol_name != lib_value:
+                vm = re.search(r'\(property\s+"Value"\s+' + QUOTED_VALUE, new_block)
+                if vm and lib_value:
