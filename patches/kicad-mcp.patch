+def _kicad_path_variables() -> Dict[str, str]:
+    """User path variables from kicad_common.json (newest KiCad config first)."""
+    if sys.platform == "win32":
+        base = Path(os.environ.get("APPDATA", "")) / "kicad"
+    elif sys.platform == "darwin":
+        base = Path.home() / "Library" / "Preferences" / "kicad"
+    else:
+        base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "kicad"
+    for version in ("10.0", "9.0", "8.0"):
+        try:
+            with open(base / version / "kicad_common.json", encoding="utf-8") as f:
+                variables = (json.load(f).get("environment") or {}).get("vars") or {}
+            return {k: str(v) for k, v in variables.items() if v}
+        except (OSError, ValueError, AttributeError):
+            continue
+    return {}
+
