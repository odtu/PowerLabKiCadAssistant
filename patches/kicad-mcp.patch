+++ b/python/commands/pour_nets.py
@@ -0,0 +1,96 @@
+"""Leave nets to copper pours: Freerouting routes everything else (PowerLab patch).
+
+The DSN keeps the pour nets' existing wires and vias as obstacles under a pin-less
+placeholder net, drops the pour nets from the netlist so they aren't routed as tracks,
+and drops their planes so other nets can use those layers (refilled pours flow around
+the new tracks afterwards).
+
+Keepout pour nets are left out the same way, but their pours become keepouts: other
+nets route around them instead of cutting through a power pour.
+"""
+
+import re
+
+PLACEHOLDER_NET = "PLA_POUR_KEEP"
+
+
+def _end(text, start):
+    depth, quoted = 0, False
+    for i in range(start, len(text)):
+        c = text[i]
+        if c == '"':
+            quoted = not quoted
+        elif not quoted:
+            if c == "(":
+                depth += 1
+            elif c == ")":
+                depth -= 1
+                if depth == 0:
+                    return i + 1
+    raise ValueError("unbalanced DSN")
+
+
+def _name_at(text, pos):
+    m = re.compile(r'\s*("([^"]*)"|[^\s()]+)').match(text, pos)
+    return (m.group(2) if m.group(2) is not None else m.group(1)), m.end()
+
+
+def _quote(name):
+    return f'"{name}"' if re.search(r'[\s()"]', name) or not name else name
+
+
+def leave_to_pours(dsn, nets, keepout_nets=()):
+    """Return (new_dsn, dropped_net_count) with `nets` and `keepout_nets` left out of
+    routing; the planes of `keepout_nets` become keepouts on their layers."""
+    keepout_nets = set(keepout_nets)
+    nets = set(nets) | keepout_nets
+    out, i = [], 0
+    in_network = None
+    network_start = dsn.index("(network")
+    network_end = _end(dsn, network_start)
+    wiring_start = dsn.find("(wiring")
+    wiring_end = _end(dsn, wiring_start) if wiring_start >= 0 else -1
+    dropped = 0
+    for m in re.finditer(r"\((plane|net|class)\s", dsn):
+        if m.start() < i:
+            continue
+        kind = m.group(1)
+        inside_network = network_start < m.start() < network_end
+        inside_wiring = wiring_start >= 0 and wiring_start < m.start() < wiring_end
+        if kind == "plane" and not inside_network and not inside_wiring:
+            name, _ = _name_at(dsn, m.end() - 1)
+            if name in nets:
+                end = _end(dsn, m.start())
+                out.append(dsn[i:m.start()])
+                if name in keepout_nets:
+                    block = dsn[m.start():end]
+                    out.append('(keepout "" ' + block[block.index("(polygon"):])
+                i = end
+        elif kind == "net" and inside_network:
+            name, _ = _name_at(dsn, m.end() - 1)
+            if name in nets:
+                end = _end(dsn, m.start())
+                out.append(dsn[i:m.start()])
+                i = end
+                dropped += 1
+        elif kind == "net" and inside_wiring:
+            name, name_end = _name_at(dsn, m.end() - 1)
+            if name in nets:  # (net GND) inside a wire/via: keep it as an obstacle
+                out.append(dsn[i:m.start()])
+                out.append(f"(net {PLACEHOLDER_NET}")
+                i = name_end
+        elif kind == "class" and inside_network:
+            head_end = dsn.find("(", m.end())
+            tokens = re.findall(r'"[^"]*"|[^\s()]+', dsn[m.end():head_end])
+            kept = [tokens[0]] + [t for t in tokens[1:] if t.strip('"') not in nets]
+            out.append(dsn[i:m.start()])
+            out.append("(class " + " ".join(kept) + "\n      ")
+            i = head_end
+    out.append(dsn[i:])
+    text = "".join(out)
+    if wiring_start >= 0 and PLACEHOLDER_NET in text:
+        start = text.index("(network")
+        close = _end(text, start) - 1
+        text = text[:close] + f"(net {PLACEHOLDER_NET})\n    " + text[close:]
+    return text, dropped
+
